# nicotina — a TX.WTF client, written as Ariadne documents.
#
# Sign in to an instance (username, password and the emailed second factor), then show the
# profile as the TX.WTF web app lays it out: the banner, the card, and the Posts, Replies and
# Balances tabs. The same document runs in stock hosts, unmodified:
#
#   ari run   --net-allow https://tx.wtf --credential-store PATH main.ari [--instance URL]
#   ari run   --backend tvision ... main.ari
#   arigl run --net-allow https://tx.wtf --credential-store PATH main.ari
#
# bin/nicotina passes those flags. In a browser, the arigl-web and ari pages load it with
# ?src=main.ari, and their ariadne.config.json passes --net.
#
# The terminal comes first: every window is laid out for an 80x24 terminal, and ImGui only adds
# to it (the Details window). The windows are in ui/signin.ari and ui/home.ari.
#
# The host holds the session token, never this document. Sign-in uses capture_auth, so the host
# takes the token out of the reply and keeps it; every later request names the credential with
# auth: and the host adds the header. Sign-out drops it with net-auth-forget. With
# --credential-store the host keeps it across runs, and the next start signs in from it.

meta:
  name: nicotina
  description: A TX.WTF client
  version: 0.0.1
  min_libcvc: 3.7.5

args:
  instance: {type: string, default: "https://tx.wtf", help: "The TX.WTF instance (its base URL)"}
  user: {type: string, help: "Fill in this username on the sign-in form"}
  start: {type: string, default: feed, help: "The first screen once signed in: feed or profile"}

# Without --net (or --net-allow) the host has no http-request and keeps no credentials, and the
# load fails here, naming what is missing.
requires:
  - net
  - net.auth
  - {name: net.auth.persist, optional: true}
  - {name: spinner, optional: true}    # turns while a request is out; without it, the text alone
  - {name: open-url, optional: true}   # "In browser" on a post; without it, the post's URL shown
  - {name: image.url, optional: true}  # the account's pictures; without it, placeholders
  - json-parse
  - state-set-tree

import:
  - ui/signin.ari
  - ui/home.ari
  - ui/feed.ari

init: |
  (set base (string.trim (state-get "args.instance")))
  (while (string.ends-with base "/")
    (set base (string.substring base 0 (- (string.length base) 1))))
  (state-set "app.base" base)
  ;; The instance's host, as a handle names it: no scheme, no path, no default port.
  (set host (string.lower (car (string.split
              (string.replace (string.replace base "https://" "") "http://" "") "/"))))
  (if (and (string.starts-with base "https://") (string.ends-with host ":443"))
    (set host (string.substring host 0 (- (string.length host) 4))))
  (if (and (string.starts-with base "http://") (string.ends-with host ":80"))
    (set host (string.substring host 0 (- (string.length host) 3))))
  (state-set "app.host" host)
  ;; The origin, for the root-relative URLs txwtf gives pictures (/uploads/..., /static/...).
  (state-set "app.origin"
    (if (string.contains base "://")
      (let ((parts (string.split base "://")))
        (str-concat (car parts) "://" (car (string.split (nth parts 1) "/"))))
      base))
  ;; The banner placeholder's row: the profile window's inner width (76 columns, less its frame).
  (set row "")
  (while (< (string.length row) 74) (set row (str-concat row "█")))
  (state-set "ui.banner_row" row)
  (state-set "ui.tab" "Posts")
  (state-set "ui.start" (if (= (string.lower (state-get "args.start")) "profile") "profile" "feed"))
  (state-set-tree "feed" (dict "items" (list) "mode" "Following" "more" "" "before" "" "empty" ""
                               "tail" "" "who" ""))
  (state-set-tree "post" (dict "lines" (list) "media" (list)))
  (state-set-tree "tab" (dict "rows" (list " " " " " " " " " ") "offset" 0 "more" "" "page" ""))
  (state-set "login.username" (if (state-exists "args.user") (state-get "args.user") ""))
  (state-set "login.password" "")
  (state-set "login.code" "")
  (state-set "login.challenge" "")
  (state-set "ui.busy" "")
  (if (or (string.starts-with base "https://") (string.starts-with base "http://"))
    (begin
      (state-set "ui.screen" "boot")
      (state-set "ui.msg" "")
      (state-set "ui.err" "")
      (state-set "ui.cmd" "resume"))
    (begin
      (state-set "ui.screen" "signin")
      (state-set "ui.msg" "The instance must be an http:// or https:// URL.")
      (state-set "ui.err" "1")
      (state-set "ui.cmd" "")))

# The controller. Buttons and menu items only set ui.cmd; this resident runs the command on the
# next frame, so the requests and the replies' handling live in one place. A resident has no
# per-action step budget, and while a request is out it is parked, not spinning.
#
#   resume   sign in from a credential the host already holds (--credential-store), if any
#   login    POST /user/login, capturing the token
#   verify   POST /user/login/2fa with the emailed code, capturing the token
#   back     leave the code screen for the sign-in form
#   refresh  on the feed: GET /user/ and the feed's first page again; on the profile: GET
#            /user/, /billing/scrip/balance and the tab's first page again
#   profile  the profile (the balance, the tab's first page); to-feed, back to the feed
#   feed     the feed feed.mode names (Following, Everyone): its first page
#   more     the feed's next page, added below
#   open     the post post.want names, whole (GET /social/posts/{id}); back-to-feed leaves it
#   tab      the tab ui.tab names: its first page (Posts, Replies), or nothing to load (Balances)
#   older    the tab's next page; newer, the one before
#   signout  POST /user/logout, then drop the credential
on_tick: |
  (if (and (!= (state-get "ui.cmd") "") (!= (state-get "ui.busy") "1"))
    (begin
      (set cmd (state-get "ui.cmd"))
      (state-set "ui.cmd" "")
      (state-set "ui.busy" "1")

      (defun base () (state-get "app.base"))
      ;; The profile window's widths, in columns: inside its frame, and the card's text beside
      ;; the avatar. A tab's page is five rows.
      (set WIDE 74)
      (set CARD 65)
      (set PAGE 5)
      (defun clip (s n)
        (if (> (string.length s) n) (str-concat (string.substring s 0 (- n 3)) "...") s))
      ;; The status line: one row of at most 60 characters, the windows' width.
      (defun say (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" ""))
      (defun fail (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" "1"))
      ;; d's value at k, or dflt when d is no dict, lacks k, or holds null there.
      (defun opt (d k dflt)
        (if (= (type-of d) "dict")
          (try (let ((v (get-attr d k))) (if (= (type-of v) "nil") dflt v)) (catch (e) dflt))
          dflt))
      ;; str quotes a string, so only non-strings go through it.
      (defun text (v) (if (is-string v) v (str v)))
      (defun reply-json (r) (try (json-parse (get-attr r "body")) (catch (e) (dict))))
      (defun status (r) (get-attr r "status"))
      (defun ok? (r) (and (>= (status r) 200) (< (status r) 300)))

      (defun post-json (path payload capture)
        (let ((o (dict "headers" (dict "Content-Type" "application/json"
                                       "Accept" "application/json")
                       "body" (json-encode payload))))
          (begin
            (if capture (set-attr o "capture_auth" (dict "name" "txwtf" "field" "token")))
            (http-request "POST" (str-concat (base) path) o))))
      (defun get-authed (path)
        (http-get (str-concat (base) path)
                  (dict "auth" "txwtf" "headers" (dict "Accept" "application/json"))))

      ;; A decimal string as people write it: 1234.5678900000 -> 1234.56789. One in exponent
      ;; form (0E-10) becomes a float, which state-set-tree writes in its shortest form (0).
      (defun plain-number (s)
        (begin
          (set s (text s))
          (if (or (string.contains s "E") (string.contains s "e"))
            (float s)
            (begin
              (if (string.contains s ".")
                (begin
                  (while (string.ends-with s "0")
                    (set s (string.substring s 0 (- (string.length s) 1))))
                  (if (string.ends-with s ".")
                    (set s (string.substring s 0 (- (string.length s) 1))))))
              s))))
      (defun dollars (cents)
        (let ((c (int cents)) (sign ""))
          (begin
            (if (< c 0) (begin (set sign "-") (set c (- 0 c))))
            (set r (% c 100))
            (str-concat sign "$" (str (int (/ (- c r) 100))) "." (if (< r 10) "0" "") (str r)))))

      (defun to-signin (msg is-error)
        (begin
          (state-set "login.password" "")
          (state-set "login.code" "")
          (state-set "login.challenge" "")
          (state-set-tree "me" (dict))
          (state-set-tree "scrip" (dict))
          (state-set "ui.tab" "Posts") ;; the next profile opens at Posts, as the web app's does
          (state-set-tree "feed" (dict "items" (list) "mode" "Following" "more" "" "before" ""
                                       "empty" "" "tail" "" "who" ""))
          (state-set-tree "post" (dict "lines" (list) "media" (list)))
          (state-set-tree "tab" (dict "rows" (list " " " " " " " " " ") "offset" 0 "more" "" "page" ""))
          (state-set "ui.screen" "signin")
          (if is-error (fail msg) (say msg))))
      ;; The host refused the token (it expired, or was signed out elsewhere), or holds none.
      (defun session-over? (r)
        (or (= (status r) 401) (= (status r) 403)
            (and (= (status r) 0) (string.contains (get-attr r "error") "no credential"))))
      (defun session-over ()
        (begin
          (net-auth-forget "txwtf")
          (to-signin "Your session has expired. Sign in again." true)))
      (defun unreachable (r)
        (fail (str-concat "Can't reach " (state-get "app.host") ": " (get-attr r "error"))))

      ;; The full handle: @user@host. A brokered (federated) account's username already ends
      ;; in its home instance (txwtf names it <user>@<home domain>), so it keeps that one.
      (defun handle (u)
        (str-concat "@" u (if (string.contains u "@") "" (str-concat "@" (state-get "app.host")))))
      ;; The card's first row: the handle, then as much of the display name as fits.
      (defun header (h name)
        (let ((room (- CARD (string.length h) 2)))
          (if (or (= name "") (< room 4)) (clip h CARD) (str-concat h "  " (clip name room)))))
      (defun pad (s n) ;; s cut or filled with spaces to exactly n columns
        (begin
          (set s (clip s n))
          (while (< (string.length s) n) (set s (str-concat s " ")))
          s))
      ;; Text as txwtf stores it is plain, or the rich editor's HTML (a tag in it, as txwtf
      ;; tells them apart). One line of it: the tags out, the common entities decoded, every run
      ;; of white space one space.
      (defun one-line (s)
        (begin
          (set s (text s))
          (if (string.contains s "<")
            (begin
              (set out "")
              (set in-tag nil)
              (set i 0)
              (while (< i (string.length s))
                (set c (string.char-at s i))
                (if in-tag
                  (if (= c ">") (set in-tag nil))
                  (if (= c "<") (begin (set in-tag true) (set out (str-concat out " ")))
                    (set out (str-concat out c))))
                (set i (+ i 1)))
              (set s out)))
          (for e (list (list "&nbsp;" " ") (list "&lt;" "<") (list "&gt;" ">")
                       (list "&quot;" "\"") (list "&#39;" "'") (list "&amp;" "&"))
            (set s (string.replace s (car e) (car (cdr e)))))
          (set s (string.replace (string.replace (string.replace s "\r" " ") "\n" " ") "\t" " "))
          (while (string.contains s "  ") (set s (string.replace s "  " " ")))
          ;; a tag between a word and its punctuation left a space before it
          (for p (list "." "," ";" ":" "!" "?")
            (set s (string.replace s (str-concat " " p) p)))
          (string.trim s)))
      ;; A picture's URL as a request names it: txwtf gives /uploads/... and /static/... from
      ;; the instance's origin, or a whole URL; "" for none.
      (defun picture-url (u)
        (begin
          (set u (text (if (= (type-of u) "nil") "" u)))
          (if (or (string.starts-with u "https://") (string.starts-with u "http://")) u
            (if (string.starts-with u "/") (str-concat (state-get "app.origin") u) ""))))
      ;; Whether a picture URL is a video, as txwtf's web app decides (isVideoMediaUrl): it plays
      ;; .mp4, .webm, .mov and .m4v avatars, banners and backgrounds as muted loops. Until the
      ;; host has a video widget, those keep their placeholder: image: can't draw them.
      (defun video-url? (u)
        (let ((path (string.lower (car (string.split (car (string.split (text u) "?")) "#")))))
          (or (string.ends-with path ".mp4") (string.ends-with path ".webm")
              (string.ends-with path ".mov") (string.ends-with path ".m4v"))))
      ;; The URL for an image: slot: a picture's, or "" for none or a video.
      (defun picture-only (u) (if (video-url? u) "" u))
      ;; The avatar's placeholder: a frame with the initials, 8 x 4 (64 px square) in a terminal.
      (defun initials (name)
        (let ((words (collections.filter (string.split (string.trim name) " ")
                                         (lambda (w) (!= w "")))))
          (string.upper
            (if (= (length words) 0) "?"
              (if (= (length words) 1) (string.substring (car words) 0 1)
                (str-concat (string.substring (car words) 0 1)
                            (string.substring (nth words (- (length words) 1)) 0 1)))))))
      (defun avatar-box (ini)
        (if (has? "term")
          (list "╭──────╮" "│      │" (str-concat "│" (pad (str-concat "  " ini) 6) "│")
                "╰──────╯")
          (list " " (str-concat "(" ini ")") " " " ")))
      (defun show-profile (p)
        (let ((user (text (opt p "username" "")))
              (name (text (opt p "name" ""))))
          (begin
            (state-set "login.username" user) ;; for the form, after signing out
            ;; The badges, as the web app shows them beside the name: an administrator, the
            ;; account's emblems, then its presence (txwtf's raw status) and a disabled account.
            (set badges (list))
            (if (opt p "is_admin" nil) (set badges (append badges "admin")))
            (for e (opt p "emblems" (list))
              (set badges (append badges (text (opt e "name" (opt e "emblem_type" "emblem"))))))
            (if (!= (text (opt p "status" "")) "") (set badges (append badges (text (opt p "status" "")))))
            (if (= (opt p "enabled" true) false) (set badges (append badges "disabled")))
            ;; The counts row: where they last signed in from, joined, posts, views.
            (set stats (list))
            (if (!= (text (opt p "last_login_country" "")) "")
              (set stats (append stats (text (opt p "last_login_country" "")))))
            (if (!= (text (opt p "created_time" "")) "")
              (set stats (append stats (str-concat "Joined "
                                                   (string.substring (text (opt p "created_time" "")) 0 10)))))
            (set stats (append stats (str-concat (text (opt p "post_count" 0)) " posts")))
            (set stats (append stats (str-concat (text (opt p "view_count" 0)) " views")))
            (set groups (collections.map (opt p "groups" (list)) (lambda (g) (text (opt g "group_name" "")))))
            (state-set-tree "me"
              (dict "id" (opt p "id" 0)
                    "username" user
                    "handle" (handle user)
                    "header" (header (handle user) name)
                    "name" name
                    "badges" (if (= (length badges) 0) " " (clip (string.join badges " · ") CARD))
                    "stats" (clip (string.join stats " · ") CARD)
                    "about" (one-line (opt p "description" ""))
                    "about_short" (clip (one-line (opt p "description" "")) CARD)
                    "presence" (text (opt p "status" "-"))
                    ;; A brokered account's local email is a placeholder in .invalid; its real
                    ;; address is its home instance's.
                    "email" (let ((e (text (opt p "email" ""))))
                              (if (string.ends-with e ".invalid") "-" e))
                    "email_verified" (if (opt p "email_verified" nil) "yes" "no")
                    "two_factor" (if (opt p "login_2fa_email_enabled" nil) "on" "off")
                    "avatar_url" (picture-url (opt p "avatar_url" nil))
                    "header_url" (picture-url (opt p "header_image_url" nil))
                    "card_url" (picture-url (opt p "card_image_url" nil))
                    ;; what the image: slots show: the pictures, never a video
                    "avatar_pic" (picture-only (picture-url (opt p "avatar_url" nil)))
                    "header_pic" (picture-only (picture-url (opt p "header_image_url" nil)))
                    "avatar_box" (avatar-box (initials (if (= name "") user name)))
                    ;; Beside the action bar's buttons: [ Feed ][ Refresh ][ Sign out ] take 31 columns.
                    "groups_line" (pad (if (= (length groups) 0) " "
                                         (str-concat "Groups: " (string.join groups ", ")))
                                       (- WIDE 31))
                    "groups" groups)))))
      (defun show-balance (b)
        (state-set-tree "scrip"
          (dict "symbol" (opt b "symbol" "SCRIP")
                "balance" (plain-number (opt b "balance" "0"))
                "value" (dollars (opt b "cents_equivalent" 0)))))

      ;; A tab's page: five rows, always, so the window keeps its height. Each row is a post's
      ;; date, its text on one line, and its counts.
      (defun post-row (q)
        (let ((counts (str-concat "  ↩" (text (opt q "reply_count" 0))
                                  " ♥" (text (opt q "reaction_count" 0))))
              (body (one-line (opt q "content" ""))))
          (begin
            (if (= body "")
              (set body (if (> (length (opt q "attachments" (list))) 0) "(attachment)" "(no text)")))
            (str-concat (string.substring (text (opt q "created_at" "")) 0 10) "  "
                        (pad body (- WIDE 12 (string.length counts))) counts))))
      (defun show-rows (rows)
        (begin
          (while (< (length rows) PAGE) (set rows (append rows " ")))
          (state-set-tree "tab.rows" rows)))
      ;; The tab ui.tab names, from tab.offset: Posts asks for a page of five; Replies, as the
      ;; web app does, asks for twenty posts and replies together and keeps the replies.
      (defun load-tab ()
        (let ((tab (state-get "ui.tab"))
              (off (int (state-get "tab.offset"))))
          (if (= tab "Balances")
            true
            (let ((r (get-authed (str-concat "/social/timeline/user/" (text (state-get "me.id"))
                                             (if (= tab "Posts")
                                               (str-concat "?include_replies=false&limit=" (text PAGE))
                                               "?include_replies=true&limit=20")
                                             "&offset=" (text off)))))
              (if (ok? r)
                (let ((posts (opt (reply-json r) "posts" (list))))
                  (begin
                    (if (= tab "Replies")
                      (set posts (collections.filter posts
                                   (lambda (q) (!= (type-of (opt q "reply_to_id" nil)) "nil")))))
                    (if (> (length posts) PAGE) (set posts (slice posts 0 PAGE)))
                    (show-rows (if (= (length posts) 0)
                                 (list (if (= tab "Posts") "No posts yet." "No replies yet."))
                                 (collections.map posts post-row)))
                    (state-set "tab.more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                    (state-set "tab.page"
                      (if (and (= off 0) (= (state-get "tab.more") "")) ""
                        (str-concat "  Page " (text (+ 1 (int (/ off (if (= tab "Posts") PAGE 20))))))))
                    true))
                (begin
                  (show-rows (list (str-concat "Couldn't load the " (string.lower tab) ".")))
                  (state-set "tab.more" "")
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Couldn't load the " (string.lower tab) " (HTTP "
                                        (str (status r)) ")."))))
                  nil))))))

      ;; Who is signed in: GET /user/. True when it came back.
      (defun load-me ()
        (let ((r (get-authed "/user/")))
          (if (ok? r)
            (begin (show-profile (reply-json r)) true)
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your profile (HTTP " (str (status r)) ")."))))
              nil))))
      ;; The rest of the profile: the balance, then the tab's first page.
      (defun load-profile ()
        (let ((b (get-authed "/billing/scrip/balance")))
          (if (ok? b)
            (begin
              (show-balance (reply-json b))
              (state-set "tab.offset" 0)
              (load-tab))
            (begin
              (state-set-tree "scrip" (dict "symbol" "SCRIP" "balance" "unavailable" "value" "-"))
              (if (session-over? b) (session-over)
                (if (= (status b) 0) (unreachable b)
                  (fail (str-concat "The SCRIP balance isn't available (HTTP "
                                    (str (status b)) ")."))))
              nil))))

      ;; --- the feed: cards ---------------------------------------------------------------
      ;; A card's text is CARDW columns wide: the window's inside, less its scroll bar and the
      ;; card's frame.
      (set CARDW 70)
      (set FEEDPAGE 10)
      ;; s's words in lines of at most n columns; a longer word is cut.
      (defun wrap (s n)
        (begin
          (set lines (list))
          (set line "")
          (for w (string.split s " ")
            (if (!= w "")
              (begin
                (while (> (string.length w) n)
                  (if (!= line "") (begin (set lines (append lines line)) (set line "")))
                  (set lines (append lines (string.substring w 0 n)))
                  (set w (string.substring w n (string.length w))))
                (if (= line "")
                  (set line w)
                  (if (<= (+ (string.length line) 1 (string.length w)) n)
                    (set line (str-concat line " " w))
                    (begin (set lines (append lines line)) (set line w)))))))
          (if (!= line "") (set lines (append lines line)))
          lines))
      ;; Paragraphs, for a post shown whole: the rich editor's </p> and <br> end one.
      (defun paragraphs (s)
        (begin
          (set s (text s))
          (for b (list "</p>" "<br>" "<br/>" "<br />") (set s (string.replace s b "\n")))
          (collections.filter (collections.map (string.split s "\n") one-line)
                              (lambda (p) (!= p "")))))
      (defun nth-or (l k) (if (> (length l) k) (nth l k) ""))
      (defun posted-at (iso) ;; 2026-10-30T22:40:00 -> 2026-10-30 22:40 (txwtf's time, UTC)
        (let ((stamp (text iso)))
          (if (>= (string.length stamp) 16)
            (str-concat (string.substring stamp 0 10) " " (string.substring stamp 11 5))
            stamp)))
      (defun human-size (n)
        (let ((n (int n)))
          (if (< n 1024) (str-concat (text n) " B")
            (if (< n 1048576) (str-concat (text (int (math.round (/ n 1024)))) " KB")
              (str-concat (text (/ (int (math.round (/ n 104857.6))) 10)) " MB")))))
      ;; txwtf gives an attachment's mime type, never a kind.
      (defun kind (mime)
        (if (string.starts-with mime "image/") "image"
          (if (string.starts-with mime "video/") "video"
            (if (string.starts-with mime "audio/") "audio" "file"))))
      (defun media-row (a)
        (if (or (opt a "deleted" nil) (= (opt a "url" "") ""))
          "[deleted attachment]"
          (let ((alt (one-line (opt a "alt_text" ""))))
            (str-concat "[" (kind (text (opt a "mime_type" ""))) "] " (text (opt a "filename" ""))
                        " · " (human-size (opt a "file_size" 0))
                        (if (= alt "") "" (str-concat " · " alt))))))
      (defun counts-of (q)
        (str-concat "↩" (text (opt q "reply_count" 0)) " ⇄" (text (opt q "repost_count" 0))
                    " ♥" (text (opt q "reaction_count" 0)) " · " (text (opt q "view_count" 0))
                    " views"))
      (defun author-name (a)
        (let ((n (text (opt a "name" ""))))
          (if (= n "") (text (opt a "username" "?")) n)))
      ;; What a card shows of a post: a repost shows the post it reposts, under a note.
      (defun shown (q)
        (let ((r (opt q "reposted_post" nil)))
          (if (= (type-of r) "dict") r q)))
      (defun repost-note (q)
        (if (= (type-of (opt q "reposted_post" nil)) "dict")
          (clip (str-concat "⇄ " (author-name (opt q "author" (dict))) " reposted") CARDW)
          ""))
      ;; A repost's own words (a quote) go before the post it reposts.
      (defun body-of (q)
        (let ((own (one-line (opt q "content" "")))
              (orig (one-line (opt (shown q) "content" ""))))
          (if (= (type-of (opt q "reposted_post" nil)) "dict")
            (if (= own "") orig (str-concat own " | " orig))
            own)))
      (defun web-of (q) (str-concat (state-get "app.origin") "/app/post/" (text (opt q "id" 0))))
      (defun feed-card (q)
        (let ((p (shown q))
              (a (opt (shown q) "author" (dict))))
          (begin
            (set lines (wrap (body-of q) CARDW))
            ;; three lines at most: the third ends in ... when there is more
            (if (> (length lines) 3)
              (set lines (list (nth lines 0) (nth lines 1)
                               (clip (str-concat (nth lines 2) " " (nth lines 3)) CARDW))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set ini (str-concat "(" (initials (author-name a)) ")"))
            (dict "id" (opt q "id" 0)
                  "web" (web-of q)
                  "note" (repost-note q)
                  "avatar" ini
                  ;; a picture for the avatar slot; a video avatar keeps the initials
                  "avatar_url" (picture-only (picture-url (opt a "avatar_url" nil)))
                  ;; beside the avatar (4 columns) and a space
                  "head" (clip (str-concat (author-name a) "  " (handle (text (opt a "username" "?"))))
                               (- CARDW 5))
                  "at" (posted-at (opt p "created_at" ""))
                  ;; the first picture, shown inline where the host can
                  "pic" (let ((pics (collections.filter media
                                      (lambda (m) (and (= (kind (text (opt m "mime_type" ""))) "image")
                                                       (!= (opt m "url" "") ""))))))
                          (if (= (length pics) 0) "" (picture-url (opt (nth pics 0) "url" nil))))
                  "l0" (nth-or lines 0)
                  "l1" (nth-or lines 1)
                  "l2" (nth-or lines 2)
                  "m0" (if (> (length media) 0) (clip (media-row (nth media 0)) CARDW) "")
                  "m0_url" (if (> (length media) 0) (picture-url (opt (nth media 0) "url" nil)) "")
                  "m0_kind" (if (> (length media) 0) (kind (text (opt (nth media 0) "mime_type" ""))) "")
                  "m1" (if (> (length media) 1) (clip (media-row (nth media 1)) CARDW) "")
                  "m1_url" (if (> (length media) 1) (picture-url (opt (nth media 1) "url" nil)) "")
                  "m1_kind" (if (> (length media) 1) (kind (text (opt (nth media 1) "mime_type" ""))) "")
                  "mmore" (if (> (length media) 2)
                            (str-concat "+" (text (- (length media) 2)) " more (Open shows them all)")
                            "")
                  ;; the buttons follow the counts: [ Open ] and, with open-url, [ In browser ]
                  "counts" (pad (counts-of q) (- CARDW (if (has? "open-url") 22 8)))))))

      ;; A page of the feed: Following is GET /social/timeline/home, Everyone the public one.
      ;; mode=latest pages cleanly by before_id (the ranked order re-ranks each page). The
      ;; first page replaces the cards; a later one is added below them.
      (defun load-feed (first)
        (let ((everyone (= (state-get "feed.mode") "Everyone")))
          (let ((r (get-authed (str-concat "/social/timeline/" (if everyone "public" "home")
                                           "?mode=latest&limit=" (text FEEDPAGE)
                                           (if first ""
                                             (str-concat "&before_id=" (state-get "feed.before")))))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (begin
                  (set cards (collections.map (opt b "posts" (list)) feed-card))
                  (if first
                    (state-set-tree "feed.items" cards)
                    (begin
                      (set n (int (state-get "feed.items")))
                      (for c cards
                        (state-set-tree (str-concat "feed.items." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "feed.items" n)))
                  (set total (int (state-get "feed.items")))
                  (state-set "feed.before" (text (opt b "next_before_id" "")))
                  (state-set "feed.more" (if (opt b "has_more" nil) "1" ""))
                  (state-set "feed.empty"
                    (if (> total 0) ""
                      (if everyone "No posts yet."
                        "Your feed is empty. Follow people, or Show: Everyone.")))
                  (state-set "feed.tail"
                    (str-concat "  " (text total) (if (= total 1) " post" " posts")
                                (if (= (state-get "feed.more") "1") "" "; no more")))
                  true))
              (begin
                (if (session-over? r) (session-over)
                  (if (= (status r) 0) (unreachable r)
                    (fail (str-concat "Couldn't load the feed (HTTP " (str (status r)) ")."))))
                nil)))))

      ;; One post in full: GET /social/posts/{id}, which also has its reactions.
      (defun show-post (q)
        (let ((p (shown q)))
          (begin
            (set lines (list))
            (for para (if (= (type-of (opt q "reposted_post" nil)) "dict")
                        (append (paragraphs (opt q "content" "")) (body-of (dict "content" (opt p "content" ""))))
                        (paragraphs (opt q "content" "")))
              (for l (wrap para WIDE) (set lines (append lines l))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set reactions (collections.map (opt q "reactions_summary" (list))
                             (lambda (e) (str-concat ":" (text (opt e "emoji" "?")) ": "
                                                     (text (opt e "count" 0))))))
            (state-set-tree "post"
              (dict "id" (opt q "id" 0)
                    "web" (web-of q)
                    "web_note" (if (has? "open-url") "" (clip (str-concat "  " (web-of q)) (- WIDE 9)))
                    "note" (repost-note q)
                    "avatar" (str-concat "(" (initials (author-name (opt p "author" (dict)))) ")")
                    "avatar_url" (picture-only (picture-url (opt (opt p "author" (dict)) "avatar_url" nil)))
                    "head" (clip (str-concat (author-name (opt p "author" (dict))) "  "
                                             (handle (text (opt (opt p "author" (dict)) "username" "?"))))
                                 (- WIDE 6))
                    "at" (posted-at (opt p "created_at" ""))
                    "lines" (if (= (length lines) 0) (list "(no text)") lines)
                    "media" (collections.map media
                              (lambda (m) (dict "row" (clip (media-row m) WIDE)
                                                "url" (picture-url (opt m "url" nil))
                                                "kind" (kind (text (opt m "mime_type" "")))
                                                "where" (clip (str-concat "  " (picture-url (opt m "url" nil)))
                                                              WIDE))))
                    "counts" (counts-of q)
                    "reactions" (if (= (length reactions) 0) ""
                                  (clip (str-concat "Reactions: " (string.join reactions "  ")) WIDE)))))))

      ;; After signing in: who it is, then the feed, the first screen (as the web app's home),
      ;; or the profile the first time when --start profile asks for it.
      (defun load-home ()
        (if (load-me)
          (begin
            (state-set "feed.who" (pad (state-get "me.handle") (- WIDE 35)))
            (if (= (state-get "ui.start") "profile")
              (begin
                (state-set "ui.start" "feed")
                (set ok (load-profile))
                (state-set "ui.screen" "home")
                ok)
              (begin
                (set ok (load-feed true))
                (state-set "ui.screen" "feed")
                ok)))
          nil))

      (defun signed-in-msg () (str-concat "Signed in to " (state-get "app.host") "."))

      ;; A reply from /user/login or /user/login/2fa.
      (defun after-login (r)
        (let ((b (reply-json r)))
          (if (ok? r)
            (if (get-attr r "captured")
              (if (opt b "force_password_change" nil)
                (begin
                  (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
                  (net-auth-forget "txwtf")
                  (to-signin (str-concat "Change your password at " (state-get "app.host")
                                         ", then sign in.")
                             true))
                (begin
                  (state-set "login.challenge" "")
                  (state-set "login.code" "")
                  (if (load-home) (say (signed-in-msg)))))
              (if (opt b "two_factor_required" nil)
                (begin
                  (state-set "login.challenge" (opt b "challenge" ""))
                  (state-set "login.code" "")
                  (state-set "ui.screen" "2fa")
                  (say (str-concat "We emailed you a code. It expires in "
                                   (str (int (/ (opt b "expires_in" 300) 60))) " minutes.")))
                (fail (str-concat "The server sent no session: " (get-attr r "error")))))
            (if (= (status r) 0) (unreachable r)
              (if (= (status r) 429) (fail "Too many attempts. Wait a minute, then try again.")
                (if (= (state-get "ui.screen") "2fa")
                  (begin
                    (state-set "login.code" "")
                    (fail "That code didn't work. Try again, or go Back."))
                  (if (or (= (status r) 400) (= (status r) 401))
                    (fail "Wrong username or password.")
                    (fail (str-concat "Sign-in failed (HTTP " (str (status r)) ").")))))))))

      (try
        (if (= cmd "resume")
          ;; and/or are functions here, not special forms: they evaluate every argument.
          (if (if (net-auth-has? "txwtf" (base)) (load-home) nil)
            (say (signed-in-msg))
            (state-set "ui.screen" (if (= (state-get "ui.screen") "boot") "signin" (state-get "ui.screen"))))
        (if (= cmd "login")
          (let ((u (string.trim (state-get "login.username")))
                (p (state-get "login.password")))
            (begin
              (state-set "login.password" "")
              (if (or (= u "") (= p ""))
                (fail "Enter your username and password.")
                (begin
                  (say "Signing in...")
                  (after-login (post-json "/user/login" (dict "username" u "password" p) true))))))
        (if (= cmd "verify")
          (let ((code (string.trim (state-get "login.code"))))
            (if (= code "")
              (fail "Enter the code from the email.")
              (begin
                (say "Checking the code...")
                (after-login (post-json "/user/login/2fa"
                                        (dict "challenge" (state-get "login.challenge") "code" code)
                                        true)))))
        (if (= cmd "back")
          (to-signin "" nil)
        (if (= cmd "refresh") ;; the screen it was pressed on: the profile, or the feed
          (begin
            (say "Refreshing...")
            (if (= (state-get "ui.screen") "home")
              (if (and (load-me) (load-profile)) (say (str-concat "Updated. " (signed-in-msg))))
              (if (load-home) (say (str-concat "Updated. " (signed-in-msg))))))
        (if (= cmd "profile")
          (begin
            (say "Loading your profile...")
            (if (load-profile) (say ""))
            (if (= (state-get "ui.screen") "feed") (state-set "ui.screen" "home")))
        (if (= cmd "to-feed")
          (begin (state-set "ui.screen" "feed") (say ""))
        (if (= cmd "feed") ;; Following or Everyone
          (begin
            (say (str-concat "Loading " (if (= (state-get "feed.mode") "Everyone")
                                          "everyone's posts..." "your feed...")))
            (if (load-feed true) (say "")))
        (if (= cmd "more")
          (if (= (state-get "feed.more") "1")
            (begin
              (say "Loading more...")
              (state-set "feed.tail" "  Loading more...")
              (if (load-feed nil) (say "")))
            (say "That's the whole feed."))
        (if (= cmd "open")
          (let ((r (get-authed (str-concat "/social/posts/" (text (state-get "post.want"))))))
            (if (ok? r)
              (begin (show-post (reply-json r)) (state-set "ui.screen" "post") (say ""))
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't open the post (HTTP " (str (status r)) ")."))))))
        (if (= cmd "back-to-feed")
          (begin (state-set "ui.screen" "feed") (say ""))
        (if (or (= cmd "tab") (= cmd "older") (= cmd "newer"))
          (let ((step (if (= (state-get "ui.tab") "Posts") PAGE 20))
                (off (int (state-get "tab.offset"))))
            (begin
              (state-set "tab.offset" (if (= cmd "tab") 0
                                        (if (= cmd "older") (+ off step) (math.max 0 (- off step)))))
              (if (!= (state-get "ui.tab") "Balances")
                (begin
                  (say (str-concat "Loading " (string.lower (state-get "ui.tab")) "..."))
                  (if (load-tab) (say ""))))))
        (if (= cmd "signout")
          (begin
            (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
            (net-auth-forget "txwtf")
            (to-signin "Signed out." nil)))))))))))))))
        ;; Nothing in here may raise: an exception this resident doesn't catch ends it, and the
        ;; buttons with it.
        (catch (e)
          (if (= (state-get "ui.screen") "boot") (state-set "ui.screen" "signin"))
          (fail (str-concat "Something went wrong: "
                            (try (text (get-attr e "message")) (catch (e2) "no details"))))))
      (state-set "ui.busy" "")))

# The screens come and go with ui.screen, so there are no windows for a Windows menu to reopen.
windows_menu: false

menubar:
  - menu: nicotina
    items:
      - menu_item: Home feed
        on: (state-set "ui.cmd" "to-feed")
        enabled_when: (and (or (= (state-get "ui.screen") "home") (= (state-get "ui.screen") "post"))
                           (!= (state-get "ui.busy") "1"))
      - menu_item: Profile
        on: (state-set "ui.cmd" "profile")
        enabled_when: (and (= (state-get "ui.screen") "feed") (!= (state-get "ui.busy") "1"))
      - menu_item: Refresh
        on: (state-set "ui.cmd" "refresh")
        enabled_when: (and (or (= (state-get "ui.screen") "home") (= (state-get "ui.screen") "feed"))
                           (!= (state-get "ui.busy") "1"))
      - menu_item: Sign out
        on: (state-set "ui.cmd" "signout")
        enabled_when: (and (or (= (state-get "ui.screen") "home") (= (state-get "ui.screen") "feed")
                               (= (state-get "ui.screen") "post"))
                           (!= (state-get "ui.busy") "1"))
      - separator
      - menu_item: Quit
        on: quit

windows:
  - include: starting_window
  - include: signin_window
  - include: twofactor_window
  - include: feed_window
  - include: post_window
  - include: home_window
  - include: details_window
