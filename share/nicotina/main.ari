# nicotina — a TX.WTF client, written as Ariadne documents.
#
# Sign in to an instance (username, password and the emailed second factor), then use it as the
# TX.WTF web app is used, in one window: the feed and a hashtag's posts, a post with its replies,
# profiles (yours and anyone's, with Follow), the hashtags, your notifications, search, a new
# post, and a viewer for a post's pictures and videos. It never sends you to a web browser. The
# same document runs in stock hosts, unmodified:
#
#   ari run   --net-allow https://tx.wtf --credential-store PATH main.ari [--instance URL]
#   ari run   --backend tvision ... main.ari
#   arigl run --net-allow https://tx.wtf --credential-store PATH main.ari
#
# bin/nicotina passes those flags. In a browser, the arigl-web and ari pages load it with
# ?src=main.ari, and their ariadne.config.json passes --net.
#
# The terminal comes first: every window is laid out for an 80x24 terminal, and ImGui only adds
# to it (the Details window). The sign-in windows are in ui/signin.ari; the TX.WTF window and its
# bar are in ui/app.ari, and its views in ui/feed.ari, ui/home.ari and ui/social.ari.
#
# The host holds the session token, never this document. Sign-in uses capture_auth, so the host
# takes the token out of the reply and keeps it; every later request names the credential with
# auth: and the host adds the header. Sign-out drops it with net-auth-forget. With
# --credential-store the host keeps it across runs, and the next start signs in from it.

meta:
  name: nicotina
  description: A TX.WTF client
  version: 0.0.1
  min_libcvc: 3.7.5

args:
  instance: {type: string, default: "https://tx.wtf", help: "The TX.WTF instance (its base URL)"}
  user: {type: string, help: "Fill in this username on the sign-in form"}
  start: {type: string, default: feed,
          help: "The first view once signed in: feed, profile, tags, alerts, search, compose, post:ID, tag:NAME, user:ID, view:ID[:N] or search:TEXT"}

# Without --net (or --net-allow) the host has no http-request and keeps no credentials, and the
# load fails here, naming what is missing.
requires:
  - net
  - net.auth
  - {name: net.auth.persist, optional: true}
  - {name: spinner, optional: true}    # turns while a request is out; without it, the text alone
  - {name: media.player, optional: true}  # video and audio play; without it, a row each
  - {name: image.url, optional: true}  # the account's pictures; without it, placeholders
  - {name: image.fill, optional: true}  # pictures and video as wide as the card; else a fixed size
  - {name: text.emoji, optional: true}  # a post's :emoji: drawn; without it, the shortcodes
  - json-parse
  - state-set-tree

import:
  - ui/signin.ari
  - ui/app.ari
  - ui/home.ari
  - ui/feed.ari
  - ui/social.ari

init: |
  (set base (string.trim (state-get "args.instance")))
  (while (string.ends-with base "/")
    (set base (string.substring base 0 (- (string.length base) 1))))
  (state-set "app.base" base)
  ;; The instance's host, as a handle names it: no scheme, no path, no default port.
  (set host (string.lower (car (string.split
              (string.replace (string.replace base "https://" "") "http://" "") "/"))))
  (if (and (string.starts-with base "https://") (string.ends-with host ":443"))
    (set host (string.substring host 0 (- (string.length host) 4))))
  (if (and (string.starts-with base "http://") (string.ends-with host ":80"))
    (set host (string.substring host 0 (- (string.length host) 3))))
  (state-set "app.host" host)
  ;; The origin, for the root-relative URLs txwtf gives pictures (/uploads/..., /static/...).
  (state-set "app.origin"
    (if (string.contains base "://")
      (let ((parts (string.split base "://")))
        (str-concat (car parts) "://" (car (string.split (nth parts 1) "/"))))
      base))
  ;; The banner placeholder's row: the profile window's inner width (76 columns, less its frame).
  (set row "")
  (while (< (string.length row) 74) (set row (str-concat row "█")))
  (state-set "ui.banner_row" row)
  (state-set "ui.tab" "Posts")
  (state-set "ui.start" (string.lower (string.trim (state-get "args.start"))))
  ;; Where the window is (main.ari's "go"), and the views before it, for Back.
  (state-set "ui.here" "")
  (state-set "ui.back" "")
  (state-set "ui.nav" "a") ;; which copy of the bar is drawn (ui/app.ari): flipped per view
  ;; What the host can do, asked once. The controller decides from these what each card, post and
  ;; viewer item shows (card-flags, post-flags, item-flags), and a view reads that decision, one
  ;; key a widget, instead of asking (has? ...) on every frame. rich: pictures as wide as the
  ;; line (image.fill) outside a terminal, where the grid is drawn.
  (state-set "app.term" (if (has? "term") "1" ""))
  (state-set "app.pics" (if (has? "image.url") "1" ""))
  (state-set "app.media" (if (has? "media.player") "1" ""))
  (state-set "app.rich" (if (and (has? "image.url") (has? "image.fill") (not (has? "term"))) "1" ""))
  (state-set "app.badge" (if (has? "image.badge") "1" ""))
  (state-set-tree "feed" (dict "items" (list) "mode" "Following" "source" "home" "tag" "" "title" ""
                               "more" "" "before" "" "offset" 0 "empty" "" "tail" ""))
  (state-set-tree "post" (dict "lines" (list) "media" (list) "replies" (list) "tags" ""
                               "parent" "" "mine" "" "focus_reply" "" "reply_text" ""))
  (state-set-tree "tab" (dict "rows" (list) "offset" 0 "more" "" "page" ""))
  (state-set-tree "prof" (dict "self" "" "following" "" "bg_pic_shown" ""))
  (state-set-tree "tags" (dict "rows" (list) "more" "" "offset" 0 "head" ""))
  (state-set-tree "alerts" (dict "rows" (list) "head" "" "badge" ""))
  (state-set-tree "search" (dict "q" "" "rows" (list) "note" "Find posts and people."))
  (state-set-tree "compose" (dict "text" "" "visibility" "Public"
                                  "note" "Text only for now: attaching files comes later."))
  (state-set-tree "viewer" (dict "url" "" "kind" "" "where" "" "row" "" "i" 0))
  (state-set "login.username" (if (state-exists "args.user") (state-get "args.user") ""))
  (state-set "login.password" "")
  (state-set "login.code" "")
  (state-set "login.challenge" "")
  (state-set "ui.busy" "")
  (if (or (string.starts-with base "https://") (string.starts-with base "http://"))
    (begin
      (state-set "ui.screen" "boot")
      (state-set "ui.msg" "")
      (state-set "ui.err" "")
      (state-set "ui.cmd" "resume"))
    (begin
      (state-set "ui.screen" "signin")
      (state-set "ui.msg" "The instance must be an http:// or https:// URL.")
      (state-set "ui.err" "1")
      (state-set "ui.cmd" "")))

# The controller. Buttons and menu items only set ui.cmd; this resident runs the command on the
# next frame, so the requests and the replies' handling live in one place. A resident has no
# per-action step budget, and while a request is out it is parked, not spinning.
#
#   resume   sign in from a credential the host already holds (--credential-store), if any
#   login    POST /user/login, capturing the token
#   verify   POST /user/login/2fa with the emailed code, capturing the token
#   back     on the code screen, back to the sign-in form; signed in, back to the view before
#   home     the feed, forgetting the views before it
#
# Going to a view ("go") loads it, remembers the view it came from, and shows it:
#   feed       the feed feed.mode names (Following, Everyone, Friends): its first page
#   tag        tag.want's posts (GET /social/timeline/tag/{tag}), in the feed's view
#   open       the post post.want names, whole (GET /social/posts/{id}), and its replies
#   profile    your own profile (GET /user/, the balance, the tab's first page)
#   user       user.want's profile (GET /user/profile/{id}), and whether you follow them
#   tags       every hashtag (GET /social/tags); alerts, your notifications (then marked read)
#   search-view, compose: the search and the new-post views; view, a post's media (view.post,
#            view.i) in the viewer
#
# And in a view:
#   refresh  the view again (on your profile, GET /user/ too)
#   more     the feed's next page, added below; more-replies, more-tags the same
#   tab      the profile's tab ui.tab names: its first page, or nothing to load (Balances);
#            older and newer, its next page and the one before
#   like, repost  on card act.i's post: a heart (POST or DELETE .../reactions), a repost (POST
#            /social/posts with repost_id, or DELETE your repost); post-like, post-repost on the
#            post shown; delete, your own post shown
#   reply    post.reply_send as a reply to the post shown; post, compose.send as a new post
#   follow, unfollow  the profile shown (POST /social/follow, DELETE /social/follow/{id})
#   search   search.q (GET /search/search); hit-open and alert-open go where a row points
#   view-prev, view-next  the viewer's other attachments
#   signout  POST /user/logout, then drop the credential
#
# After each, the unread count beside Alerts is asked for again (GET /notifications/count).
on_tick: |
  (if (and (!= (state-get "ui.cmd") "") (!= (state-get "ui.busy") "1"))
    (begin
      (set cmd (state-get "ui.cmd"))
      (state-set "ui.cmd" "")
      (state-set "ui.busy" "1")

      (defun base () (state-get "app.base"))
      ;; The profile window's widths, in columns: inside its frame, and the card's text beside
      ;; the avatar. A tab's page is five rows.
      (set WIDE 74)
      (set CARD 65)
      (set PAGE 5)
      (defun clip (s n)
        (if (> (string.length s) n) (str-concat (string.substring s 0 (- n 3)) "...") s))
      ;; The status line: one row of at most 60 characters, the windows' width.
      (defun say (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" ""))
      (defun fail (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" "1"))
      ;; d's value at k, or dflt when d is no dict, lacks k, or holds null there.
      (defun opt (d k dflt)
        (if (= (type-of d) "dict")
          (try (let ((v (get-attr d k))) (if (= (type-of v) "nil") dflt v)) (catch (e) dflt))
          dflt))
      ;; str quotes a string, so only non-strings go through it.
      (defun text (v) (if (is-string v) v (str v)))
      (defun reply-json (r) (try (json-parse (get-attr r "body")) (catch (e) (dict))))
      (defun status (r) (get-attr r "status"))
      (defun ok? (r) (and (>= (status r) 200) (< (status r) 300)))

      (defun post-json (path payload capture)
        (let ((o (dict "headers" (dict "Content-Type" "application/json"
                                       "Accept" "application/json")
                       "body" (json-encode payload))))
          (begin
            (if capture (set-attr o "capture_auth" (dict "name" "txwtf" "field" "token")))
            (http-request "POST" (str-concat (base) path) o))))
      (defun get-authed (path)
        (http-get (str-concat (base) path)
                  (dict "auth" "txwtf" "headers" (dict "Accept" "application/json"))))
      ;; With a query: the host percent-encodes it.
      (defun get-query (path q)
        (http-get (str-concat (base) path)
                  (dict "auth" "txwtf" "headers" (dict "Accept" "application/json") "query" q)))
      ;; POST (or another verb) with a JSON body, signed in; payload nil sends none.
      (defun send-authed (method path payload)
        (http-request method (str-concat (base) path)
          (if (= (type-of payload) "nil")
            (dict "auth" "txwtf" "headers" (dict "Accept" "application/json"))
            (dict "auth" "txwtf"
                  "headers" (dict "Accept" "application/json" "Content-Type" "application/json")
                  "body" (json-encode payload)))))

      ;; A decimal string as people write it: 1234.5678900000 -> 1234.56789. One in exponent
      ;; form (0E-10) becomes a float, which state-set-tree writes in its shortest form (0).
      (defun plain-number (s)
        (begin
          (set s (text s))
          (if (or (string.contains s "E") (string.contains s "e"))
            (float s)
            (begin
              (if (string.contains s ".")
                (begin
                  (while (string.ends-with s "0")
                    (set s (string.substring s 0 (- (string.length s) 1))))
                  (if (string.ends-with s ".")
                    (set s (string.substring s 0 (- (string.length s) 1))))))
              s))))
      (defun dollars (cents)
        (let ((c (int cents)) (sign ""))
          (begin
            (if (< c 0) (begin (set sign "-") (set c (- 0 c))))
            (set r (% c 100))
            (str-concat sign "$" (str (int (/ (- c r) 100))) "." (if (< r 10) "0" "") (str r)))))

      (defun to-signin (msg is-error)
        (begin
          (state-set "login.password" "")
          (state-set "login.code" "")
          (state-set "login.challenge" "")
          (state-set-tree "me" (dict))
          (state-set-tree "scrip" (dict))
          (state-set "ui.tab" "Posts") ;; the next profile opens at Posts, as the web app's does
          (state-set "ui.here" "")
          (state-set "ui.back" "")
          (state-set-tree "feed" (dict "items" (list) "mode" "Following" "source" "home" "tag" ""
                                       "title" "" "more" "" "before" "" "offset" 0 "empty" ""
                                       "tail" ""))
          (state-set-tree "post" (dict "lines" (list) "media" (list) "replies" (list) "tags" ""
                                       "parent" "" "mine" "" "focus_reply" "" "reply_text" ""))
          (state-set-tree "tab" (dict "rows" (list) "offset" 0 "more" "" "page" ""))
          (state-set-tree "prof" (dict "self" "" "following" "" "bg_pic_shown" ""))
          (state-set-tree "alerts" (dict "rows" (list) "head" "" "badge" ""))
          (state-set-tree "search" (dict "q" "" "rows" (list) "note" "Find posts and people."))
          (state-set "compose.text" "")
          (state-set "ui.screen" "signin")
          (if is-error (fail msg) (say msg))))
      ;; The host refused the token (it expired, or was signed out elsewhere), or holds none.
      (defun session-over? (r)
        (or (= (status r) 401) (= (status r) 403)
            (and (= (status r) 0) (string.contains (get-attr r "error") "no credential"))))
      (defun session-over ()
        (begin
          (net-auth-forget "txwtf")
          (to-signin "Your session has expired. Sign in again." true)))
      (defun unreachable (r)
        (fail (str-concat "Can't reach " (state-get "app.host") ": " (get-attr r "error"))))
      ;; A request that did something (a like, a post) failed. Only a 401 ends the session here:
      ;; a 403 is the instance refusing that one thing.
      (defun act-failed (r what)
        (if (or (= (status r) 401)
                (and (= (status r) 0) (string.contains (get-attr r "error") "no credential")))
          (session-over)
          (if (= (status r) 0) (unreachable r)
            (let ((d (opt (reply-json r) "detail" "")))
              (fail (str-concat "Couldn't " what
                                (if (is-string d) (str-concat ": " d) "")
                                " (HTTP " (str (status r)) ")."))))))

      ;; The full handle: @user@host. A brokered (federated) account's username already ends
      ;; in its home instance (txwtf names it <user>@<home domain>), so it keeps that one.
      (defun handle (u)
        (str-concat "@" u (if (string.contains u "@") "" (str-concat "@" (state-get "app.host")))))
      ;; The card's first row: the handle, then as much of the display name as fits.
      (defun header (h name)
        (let ((room (- CARD (string.length h) 2)))
          (if (or (= name "") (< room 4)) (clip h CARD) (str-concat h "  " (clip name room)))))
      (defun pad (s n) ;; s cut or filled with spaces to exactly n columns
        (begin
          (set s (clip s n))
          (while (< (string.length s) n) (set s (str-concat s " ")))
          s))
      ;; Text as txwtf stores it is plain, or the rich editor's HTML (a tag in it, as txwtf
      ;; tells them apart). One line of it: the tags out, the common entities decoded, every run
      ;; of white space one space.
      (defun one-line (s)
        (begin
          (set s (text s))
          (if (string.contains s "<")
            (begin
              (set out "")
              (set in-tag nil)
              (set i 0)
              (while (< i (string.length s))
                (set c (string.char-at s i))
                (if in-tag
                  (if (= c ">") (set in-tag nil))
                  (if (= c "<") (begin (set in-tag true) (set out (str-concat out " ")))
                    (set out (str-concat out c))))
                (set i (+ i 1)))
              (set s out)))
          (for e (list (list "&nbsp;" " ") (list "&lt;" "<") (list "&gt;" ">")
                       (list "&quot;" "\"") (list "&#39;" "'") (list "&amp;" "&"))
            (set s (string.replace s (car e) (car (cdr e)))))
          (set s (string.replace (string.replace (string.replace s "\r" " ") "\n" " ") "\t" " "))
          (while (string.contains s "  ") (set s (string.replace s "  " " ")))
          ;; a tag between a word and its punctuation left a space before it (a colon only where
          ;; a space follows it: " :smile:" is an emoji's shortcode, kept apart from the word)
          (for p (list "." "," ";" "!" "?")
            (set s (string.replace s (str-concat " " p) p)))
          (set s (string.replace s " : " ": "))
          (string.trim s)))
      ;; A picture's URL as a request names it: txwtf gives /uploads/... and /static/... from
      ;; the instance's origin, or a whole URL; "" for none.
      (defun picture-url (u)
        (begin
          (set u (text (if (= (type-of u) "nil") "" u)))
          (if (or (string.starts-with u "https://") (string.starts-with u "http://")) u
            (if (string.starts-with u "/") (str-concat (state-get "app.origin") u) ""))))
      ;; A post's emoji, from the content_html txwtf renders (render_emoji_html): a custom one is
      ;;   <img class="custom-emoji" src="/social/emojis/12/image" alt=":gear:" ...>
      ;; and a standard one <span class="emoji" title=":100:">💯</span>. A map of their names to
      ;; the picture's URL or the character, for the text's emoji: (the host draws a picture in
      ;; the line, or puts the character in place of the shortcode).
      (defun attr (tag name) ;; the value of name="..." in a tag's text, or ""
        (let ((parts (string.split tag (str-concat name "=\""))))
          (if (> (length parts) 1) (car (string.split (nth parts 1) "\"")) "")))
      (defun shortcode (s) ;; ":gear:" -> "gear", else ""
        (if (and (> (string.length s) 2) (string.starts-with s ":") (string.ends-with s ":"))
          (string.substring s 1 (- (string.length s) 2))
          ""))
      (defun emoji-of (html)
        (let ((m (dict))
              (h (text (if (= (type-of html) "nil") "" html))))
          (begin
            (for part (cdr (string.split h "<img class=\"custom-emoji\""))
              (let ((name (shortcode (attr part "alt")))
                    (src (picture-url (attr part "src"))))
                (if (and (!= name "") (!= src "")) (set-attr m (string.lower name) src))))
            (for part (cdr (string.split h "<span class=\"emoji\""))
              (let ((name (shortcode (attr part "title")))
                    (pieces (string.split part ">")))
                (if (and (!= name "") (> (length pieces) 1))
                  (let ((ch (car (string.split (nth pieces 1) "<"))))
                    (if (!= ch "") (set-attr m (string.lower name) ch))))))
            m)))
      ;; Whether a picture URL is a video, as txwtf's web app decides (isVideoMediaUrl): it plays
      ;; .mp4, .webm, .mov and .m4v avatars, banners and backgrounds as muted loops. Until the
      ;; host has a video widget, those keep their placeholder: image: can't draw them.
      (defun video-url? (u)
        (let ((path (string.lower (car (string.split (car (string.split (text u) "?")) "#")))))
          (or (string.ends-with path ".mp4") (string.ends-with path ".webm")
              (string.ends-with path ".mov") (string.ends-with path ".m4v"))))
      ;; The URL for an image: slot: a picture's, or "" for none or a video.
      (defun picture-only (u) (if (video-url? u) "" u))
      ;; The avatar's placeholder: a frame with the initials, 8 x 4 (64 px square) in a terminal.
      (defun initials (name)
        (let ((words (collections.filter (string.split (string.trim name) " ")
                                         (lambda (w) (!= w "")))))
          (string.upper
            (if (= (length words) 0) "?"
              (if (= (length words) 1) (string.substring (car words) 0 1)
                (str-concat (string.substring (car words) 0 1)
                            (string.substring (nth words (- (length words) 1)) 0 1)))))))
      (defun avatar-box (ini)
        (if (has? "term")
          (list "╭──────╮" "│      │" (str-concat "│" (pad (str-concat "  " ini) 6) "│")
                "╰──────╯")
          (list " " (str-concat "(" ini ")") " " " ")))
      ;; What a profile view shows of an account (GET /user/ for yours, /user/profile/{id} for
      ;; anyone's). bar is how many columns its action bar's buttons take.
      (defun profile-of (p bar)
        (let ((user (text (opt p "username" "")))
              (name (text (opt p "name" ""))))
          (begin
            ;; The badges, as the web app shows them beside the name: an administrator, the
            ;; account's emblems, then its presence (txwtf's raw status) and a disabled account.
            (set badges (list))
            (if (opt p "is_admin" nil) (set badges (append badges "admin")))
            (for e (opt p "emblems" (list))
              (set badges (append badges (text (opt e "name" (opt e "emblem_type" "emblem"))))))
            (if (!= (text (opt p "status" "")) "") (set badges (append badges (text (opt p "status" "")))))
            (if (= (opt p "enabled" true) false) (set badges (append badges "disabled")))
            ;; The counts row: where they last signed in from, joined, posts, views.
            (set stats (list))
            (if (!= (text (opt p "last_login_country" "")) "")
              (set stats (append stats (text (opt p "last_login_country" "")))))
            (if (!= (text (opt p "created_time" "")) "")
              (set stats (append stats (str-concat "Joined "
                                                   (string.substring (text (opt p "created_time" "")) 0 10)))))
            (set stats (append stats (str-concat (text (opt p "post_count" 0)) " posts")))
            (set stats (append stats (str-concat (text (opt p "view_count" 0)) " views")))
            (set groups (collections.map (opt p "groups" (list)) (lambda (g) (text (opt g "group_name" "")))))
            (dict "id" (opt p "id" 0)
                    "username" user
                    "handle" (handle user)
                    "header" (header (handle user) name)
                    "name" name
                    "badges" (if (= (length badges) 0) " " (clip (string.join badges " · ") CARD))
                    "stats" (clip (string.join stats " · ") CARD)
                    "about" (one-line (opt p "description" ""))
                    "about_short" (clip (one-line (opt p "description" "")) CARD)
                    "presence" (text (opt p "status" "-"))
                    ;; A brokered account's local email is a placeholder in .invalid; its real
                    ;; address is its home instance's.
                    "email" (let ((e (text (opt p "email" ""))))
                              (if (string.ends-with e ".invalid") "-" e))
                    "email_verified" (if (opt p "email_verified" nil) "yes" "no")
                    "two_factor" (if (opt p "login_2fa_email_enabled" nil) "on" "off")
                    "avatar_url" (picture-url (opt p "avatar_url" nil))
                    "header_url" (picture-url (opt p "header_image_url" nil))
                    "card_url" (picture-url (opt p "card_image_url" nil))
                    ;; what the image: slots show: the pictures, never a video
                    "avatar_pic" (picture-only (picture-url (opt p "avatar_url" nil)))
                    "header_pic" (picture-only (picture-url (opt p "header_image_url" nil)))
                    "card_pic" (picture-only (picture-url (opt p "card_image_url" nil)))
                    "bg_url" (picture-url (opt p "profile_bg_url" nil))
                    "bg_pic" (picture-only (picture-url (opt p "profile_bg_url" nil)))
                    "avatar_box" (avatar-box (initials (if (= name "") user name)))
                    ;; Beside the action bar's buttons
                    "groups_line" (pad (if (= (length groups) 0) " "
                                         (str-concat "Groups: " (string.join groups ", ")))
                                       (- WIDE bar))
                    "groups" groups))))
      ;; Yours: kept in me.* (the Details window, the sign-in form after signing out), and shown
      ;; in the profile view as prof.*. [ Refresh ][ Sign out ] take 23 columns.
      (defun show-profile (p)
        (let ((d (profile-of p 23)))
          (begin
            (state-set "login.username" (text (opt p "username" "")))
            (state-set-tree "me" d)
            d)))
      (defun show-balance (b)
        (state-set-tree "scrip"
          (dict "symbol" (opt b "symbol" "SCRIP")
                "balance" (plain-number (opt b "balance" "0"))
                "value" (dollars (opt b "cents_equivalent" 0)))))

      ;; A tab's page: five rows, always, so the window keeps its height. Each row is a post's
      ;; date, its text on one line, and its counts, then Open ([ Open ] takes 8 columns).
      (defun post-row (q)
        (let ((counts (str-concat "  ↩" (text (opt q "reply_count" 0))
                                  " ♥" (text (opt q "reaction_count" 0))))
              (body (one-line (opt q "content" ""))))
          (begin
            (if (= body "")
              (set body (if (> (length (opt q "attachments" (list))) 0) "(attachment)" "(no text)")))
            (dict "id" (text (opt q "id" ""))
                  "line" (str-concat (string.substring (text (opt q "created_at" "")) 0 10) "  "
                                     (pad body (- WIDE 21 (string.length counts))) counts " ")))))
      (defun show-rows (rows)
        (begin
          (while (< (length rows) PAGE) (set rows (append rows (dict "id" "" "line" " "))))
          (state-set-tree "tab.rows" rows)))
      (defun note-row (s) (dict "id" "" "line" s))
      ;; The tab ui.tab names, from tab.offset: Posts asks for a page of five; Replies, as the
      ;; web app does, asks for twenty posts and replies together and keeps the replies.
      (defun load-tab ()
        (let ((tab (state-get "ui.tab"))
              (off (int (state-get "tab.offset"))))
          (if (= tab "Balances")
            true
            (let ((r (get-authed (str-concat "/social/timeline/user/" (text (state-get "prof.id"))
                                             (if (= tab "Posts")
                                               (str-concat "?include_replies=false&limit=" (text PAGE))
                                               "?include_replies=true&limit=20")
                                             "&offset=" (text off)))))
              (if (ok? r)
                (let ((posts (opt (reply-json r) "posts" (list))))
                  (begin
                    (if (= tab "Replies")
                      (set posts (collections.filter posts
                                   (lambda (q) (!= (type-of (opt q "reply_to_id" nil)) "nil")))))
                    (if (> (length posts) PAGE) (set posts (slice posts 0 PAGE)))
                    (show-rows (if (= (length posts) 0)
                                 (list (note-row (if (= tab "Posts") "No posts yet." "No replies yet.")))
                                 (collections.map posts post-row)))
                    (state-set "tab.more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                    (state-set "tab.page"
                      (if (and (= off 0) (= (state-get "tab.more") "")) ""
                        (str-concat "  Page " (text (+ 1 (int (/ off (if (= tab "Posts") PAGE 20))))))))
                    true))
                (begin
                  (show-rows (list (note-row (str-concat "Couldn't load the " (string.lower tab) "."))))
                  (state-set "tab.more" "")
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Couldn't load the " (string.lower tab) " (HTTP "
                                        (str (status r)) ")."))))
                  nil))))))

      ;; Who is signed in: GET /user/. True when it came back. With own, the profile view shows
      ;; it too.
      (defun load-me-into (own)
        (let ((r (get-authed "/user/")))
          (if (ok? r)
            (let ((d (show-profile (reply-json r))))
              (begin
                (if own
                  (state-set-tree "prof"
                    (collections.dict-merge d (dict "self" "1" "following" "" "bg_pic_shown" ""))))
                true))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your profile (HTTP " (str (status r)) ")."))))
              nil))))
      (defun load-me () (load-me-into nil))
      ;; Someone else's profile: GET /user/profile/{id}, and whether you follow them. Their tab
      ;; can't be Balances. [ Unfollow ] takes 12 columns.
      (defun load-user (id)
        (let ((r (get-authed (str-concat "/user/profile/" (text id)))))
          (if (ok? r)
            (let ((d (profile-of (reply-json r) 12))
                  (f (get-authed (str-concat "/social/follow/check/" (text id)))))
              (begin
                (state-set-tree "prof"
                  (collections.dict-merge d (dict "self" ""
                                                  "following" (if (and (ok? f) (opt (reply-json f) "is_following" nil)) "1" "")
                                                  "bg_pic_shown" "")))
                (if (= (state-get "ui.tab") "Balances") (state-set "ui.tab" "Posts"))
                (state-set "tab.offset" 0)
                (load-tab)))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load that profile (HTTP " (str (status r)) ")."))))
              nil))))
      ;; The rest of your profile: the balance, then the tab's first page.
      (defun load-profile ()
        (let ((b (get-authed "/billing/scrip/balance")))
          (if (ok? b)
            (begin
              (show-balance (reply-json b))
              (state-set "tab.offset" 0)
              (load-tab))
            (begin
              (state-set-tree "scrip" (dict "symbol" "SCRIP" "balance" "unavailable" "value" "-"))
              (if (session-over? b) (session-over)
                (if (= (status b) 0) (unreachable b)
                  (fail (str-concat "The SCRIP balance isn't available (HTTP "
                                    (str (status b)) ")."))))
              nil))))

      ;; --- the feed: cards ---------------------------------------------------------------
      ;; A card's text is CARDW columns wide: the window's inside, less its scroll bar and the
      ;; card's frame.
      (set CARDW 70)
      (set FEEDPAGE 10)
      ;; s's words in lines of at most n columns; a longer word is cut.
      (defun wrap (s n)
        (begin
          (set lines (list))
          (set line "")
          (for w (string.split s " ")
            (if (!= w "")
              (begin
                (while (> (string.length w) n)
                  (if (!= line "") (begin (set lines (append lines line)) (set line "")))
                  (set lines (append lines (string.substring w 0 n)))
                  (set w (string.substring w n (string.length w))))
                (if (= line "")
                  (set line w)
                  (if (<= (+ (string.length line) 1 (string.length w)) n)
                    (set line (str-concat line " " w))
                    (begin (set lines (append lines line)) (set line w)))))))
          (if (!= line "") (set lines (append lines line)))
          lines))
      ;; Paragraphs, for a post shown whole: the rich editor's </p> and <br> end one.
      (defun paragraphs (s)
        (begin
          (set s (text s))
          (for b (list "</p>" "<br>" "<br/>" "<br />") (set s (string.replace s b "\n")))
          (collections.filter (collections.map (string.split s "\n") one-line)
                              (lambda (p) (!= p "")))))
      (defun nth-or (l k) (if (> (length l) k) (nth l k) ""))
      (defun posted-at (iso) ;; 2026-10-30T22:40:00 -> 2026-10-30 22:40 (txwtf's time, UTC)
        (let ((stamp (text iso)))
          (if (>= (string.length stamp) 16)
            (str-concat (string.substring stamp 0 10) " " (string.substring stamp 11 5))
            stamp)))
      (defun human-size (n)
        (let ((n (int n)))
          (if (< n 1024) (str-concat (text n) " B")
            (if (< n 1048576) (str-concat (text (int (math.round (/ n 1024)))) " KB")
              (str-concat (text (/ (int (math.round (/ n 104857.6))) 10)) " MB")))))
      ;; txwtf gives an attachment's mime type, never a kind.
      (defun kind (mime)
        (if (string.starts-with mime "image/") "image"
          (if (string.starts-with mime "video/") "video"
            (if (string.starts-with mime "audio/") "audio" "file"))))
      (defun media-row (a)
        (if (or (opt a "deleted" nil) (= (opt a "url" "") ""))
          "[deleted attachment]"
          (let ((alt (one-line (opt a "alt_text" ""))))
            (str-concat "[" (kind (text (opt a "mime_type" ""))) "] " (text (opt a "filename" ""))
                        " · " (human-size (opt a "file_size" 0))
                        (if (= alt "") "" (str-concat " · " alt))))))
      ;; A post's pictures and videos, in order, each with its place among what the viewer shows
      ;; (every attachment with a URL but a file): the tiles of its grid.
      (defun tiles-of (media)
        (let ((tiles (list)) (vn 0))
          (begin
            (for m media
              (if (and (!= (kind (text (opt m "mime_type" ""))) "file") (!= (opt m "url" "") ""))
                (begin
                  (if (or (= (kind (text (opt m "mime_type" ""))) "image")
                          (= (kind (text (opt m "mime_type" ""))) "video"))
                    (set tiles (append tiles (dict "url" (picture-url (opt m "url" nil))
                                                   "kind" (kind (text (opt m "mime_type" "")))
                                                   "vi" (text vn)))))
                  (set vn (+ vn 1)))))
            tiles)))
      (defun tile (tiles k f) (if (> (length tiles) k) (opt (nth tiles k) f "") ""))
      ;; The grid, as tx.wtf lays a post's pictures and videos out: gn the tiles it shows (0 to
      ;; 4), g0..g3 each tile's picture, kind and place in the viewer, and gmore "+N" when there
      ;; are more than four (the viewer has them all).
      (defun grid-fields (tiles)
        (let ((n (length tiles)))
          (dict "gn" (text (if (> n 4) 4 n))
                "gmore" (if (> n 4) (str-concat "+" (text (- n 4))) "")
                "gmore_line" (if (> n 4) (str-concat "+" (text (- n 4)) " more: View shows them all") "")
                "g0_url" (tile tiles 0 "url") "g0_kind" (tile tiles 0 "kind") "g0_vi" (tile tiles 0 "vi")
                "g1_url" (tile tiles 1 "url") "g1_kind" (tile tiles 1 "kind") "g1_vi" (tile tiles 1 "vi")
                "g2_url" (tile tiles 2 "url") "g2_kind" (tile tiles 2 "kind") "g2_vi" (tile tiles 2 "vi")
                "g3_url" (tile tiles 3 "url") "g3_kind" (tile tiles 3 "kind") "g3_vi" (tile tiles 3 "vi"))))
      ;; The URL of the first attachment of a kind ("video", "audio"), or "".
      (defun first-of (media k)
        (let ((hits (collections.filter media
                      (lambda (m) (and (= (kind (text (opt m "mime_type" ""))) k)
                                       (!= (opt m "url" "") ""))))))
          (if (= (length hits) 0) "" (picture-url (opt (nth hits 0) "url" nil)))))
      ;; "1" when every attachment is a picture or a video: the grid shows them all, so a card on a
      ;; host that draws the grid needs no rows for them.
      (defun only-visual (media)
        (if (= (length (collections.filter media
                         (lambda (m) (let ((k (kind (text (opt m "mime_type" "")))))
                                       (and (!= k "image") (!= k "video"))))))
               0)
          "1" ""))
      ;; The show/hide decisions, "1" or "" each, from the host's capabilities (app.*, set once
      ;; by init) and the post: the views' visible_when read them.
      (defun flag (b) (if b "1" ""))
      (defun cap (k) (= (state-get (str-concat "app." k)) "1"))
      (defun card-flags (avpic tags pic vid au tiles only m0 viewable)
        (let ((rich (cap "rich")) (term (cap "term")) (pics (cap "pics")) (media (cap "media")))
          (dict "v_avpic" (flag (and pics (!= avpic "")))
                "v_avtxt" (flag (not (and pics (!= avpic ""))))
                "v_tagline" (flag (and term (!= tags "")))
                "v_tagrow" (flag (and (not term) (!= tags "")))
                ;; one picture or video, or a grid: as wide as the line where the host
                ;; measures it (rich), else at fixed sizes; a terminal shows the first picture
                ;; and the first video
                "v_grid" (flag (and rich (> (length tiles) 0)))
                "v_fgrid" (flag (and pics (not rich) (not term) (> (length tiles) 0)))
                "v_pic_t" (flag (and pics term (!= pic "")))
                "v_vid_t" (flag (and media term (!= vid "")))
                "v_audio" (flag (and media (!= au "")))
                ;; no rows where the pictures show every attachment: View moves to the buttons
                "v_rows" (flag (and (!= m0 "") (not (and pics (not term) (= only "1")))))
                "v_viewbtn" (flag (and pics (not term) (= only "1") viewable))
                "v_gmore" (flag (and (> (length tiles) 4) (not (cap "badge")))))))
      (defun post-flags (avpic tiles)
        (let ((pics (cap "pics")))
          (dict "v_avpic" (flag (and pics (!= avpic "")))
                "v_avtxt" (flag (not (and pics (!= avpic ""))))
                "v_grid" (flag (and (cap "rich") (> (length tiles) 0)))
                "v_fgrid" (flag (and pics (not (cap "rich")) (not (cap "term")) (> (length tiles) 0)))
                "v_term" (flag (cap "term"))
                "v_gmore" (flag (and (> (length tiles) 4) (not (cap "badge")))))))
      ;; An attachment's own (a post's, the viewer's): its picture or player as wide as the line
      ;; (_fill), at a fixed size (_fix), in a terminal (_t), its recording's player, and View.
      (defun item-flags (k)
        (let ((term (cap "term")) (pics (cap "pics")) (media (cap "media")) (rich (cap "rich")))
          (dict "v_img_fill" (flag (and rich (= k "image")))
                "v_img_fix" (flag (and pics (not rich) (= k "image")))
                "v_img_t" (flag (and pics term (= k "image")))
                "v_vid_fill" (flag (and media rich (= k "video")))
                "v_vid_fix" (flag (and media (not rich) (= k "video")))
                "v_vid_t" (flag (and media term (= k "video")))
                "v_aud" (flag (and media (= k "audio")))
                "v_view" (flag (!= k "file")))))
      (defun counts-of (q)
        (str-concat "↩" (text (opt q "reply_count" 0)) " ⇄" (text (opt q "repost_count" 0))
                    " ♥" (text (opt q "reaction_count" 0)) " · " (text (opt q "view_count" 0))
                    " views"))
      (defun author-name (a)
        (let ((n (text (opt a "name" ""))))
          (if (= n "") (text (opt a "username" "?")) n)))
      ;; What a card shows of a post: a repost shows the post it reposts, under a note.
      (defun shown (q)
        (let ((r (opt q "reposted_post" nil)))
          (if (= (type-of r) "dict") r q)))
      (defun repost-note (q)
        (if (= (type-of (opt q "reposted_post" nil)) "dict")
          (clip (str-concat "⇄ " (author-name (opt q "author" (dict))) " reposted") CARDW)
          ""))
      ;; A repost's own words (a quote) go before the post it reposts.
      (defun body-of (q)
        (let ((own (one-line (opt q "content" "")))
              (orig (one-line (opt (shown q) "content" ""))))
          (if (= (type-of (opt q "reposted_post" nil)) "dict")
            (if (= own "") orig (str-concat own " | " orig))
            own)))
      (defun web-of (q) (str-concat (state-get "app.origin") "/app/post/" (text (opt q "id" 0))))
      ;; The hashtags in a post's text, each once, in order, as txwtf finds them (#word): the
      ;; options of a radio row, "|" between them, and a line of them.
      (defun hashtags (s)
        (let ((tags (list)))
          (begin
            (for w (string.split (one-line s) " ")
              (begin
                (while (and (> (string.length w) 1)
                            (string.contains ".,;:!?)'\"" (string.substring w (- (string.length w) 1) 1)))
                  (set w (string.substring w 0 (- (string.length w) 1))))
                (if (and (string.starts-with w "#") (> (string.length w) 1)
                         (not (string.contains (string.substring w 1 (- (string.length w) 1)) "#")))
                  (set tags (append tags (string.lower w))))))
            (collections.unique tags))))
      (defun tag-options (q) (string.join (hashtags (str-concat (opt q "content" "") " "
                                                                (opt (shown q) "content" "")))
                                          "|"))
      ;; Whether you liked or reposted it, after its counts.
      (defun yours (p)
        (str-concat (if (opt p "user_has_reacted" nil) " · liked" "")
                    (if (opt p "user_has_reposted" nil) " · reposted" "")))
      (defun feed-card (q)
        (let ((p (shown q))
              (a (opt (shown q) "author" (dict))))
          (begin
            (set lines (wrap (body-of q) CARDW))
            ;; three lines at most: the third ends in ... when there is more
            (if (> (length lines) 3)
              (set lines (list (nth lines 0) (nth lines 1)
                               (clip (str-concat (nth lines 2) " " (nth lines 3)) CARDW))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set ini (str-concat "(" (initials (author-name a)) ")"))
            (set tags (tag-options q))
            ;; View is there for a post with something the viewer shows
            (set viewable (> (length (collections.filter media
                                        (lambda (m) (and (!= (kind (text (opt m "mime_type" ""))) "file")
                                                         (!= (opt m "url" "") ""))))) 0))
            (set tiles (tiles-of media))
            (set avpic (picture-only (picture-url (opt a "avatar_url" nil))))
            ;; the first picture, shown inline where the host can
            (set pic (let ((pics (collections.filter media
                                   (lambda (m) (and (= (kind (text (opt m "mime_type" ""))) "image")
                                                    (!= (opt m "url" "") ""))))))
                       (if (= (length pics) 0) "" (picture-url (opt (nth pics 0) "url" nil)))))
            (set vid (first-of media "video"))
            (set au (first-of media "audio"))
            (set only (only-visual media))
            (set m0 (if (> (length media) 0)
                      (if viewable (str-concat (pad (media-row (nth media 0)) (- CARDW 9)) " ")
                        (clip (media-row (nth media 0)) CARDW))
                      ""))
            (collections.dict-merge
             (collections.dict-merge (grid-fields tiles)
                                     (card-flags avpic tags pic vid au tiles only m0 viewable))
             (dict "id" (opt q "id" 0)
                  ;; the post the buttons act on: a repost's is the post it reposts
                  "pid" (opt p "id" (opt q "id" 0))
                  "liked" (if (opt p "user_has_reacted" nil) "1" "")
                  "reposted" (if (opt p "user_has_reposted" nil) "1" "")
                  "my_repost" (text (opt p "user_repost_id" ""))
                  "web" (web-of p)
                  "note" (repost-note q)
                  "tags" tags
                  "tag_pick" ""
                  "tagline" (clip (string.replace tags "|" "  ") CARDW)
                  "has_media" (if viewable "1" "")
                  "only_visual" only
                  "avatar" ini
                  ;; a picture for the avatar slot; a video avatar keeps the initials
                  "avatar_url" avpic
                  ;; beside the avatar (4 columns) and a space
                  "head" (clip (str-concat (author-name a) "  " (handle (text (opt a "username" "?"))))
                               (- CARDW 5))
                  "at" (posted-at (opt p "created_at" ""))
                  "pic" pic
                  "l0" (nth-or lines 0)
                  "l1" (nth-or lines 1)
                  "l2" (nth-or lines 2)
                  ;; the emoji in its text (a repost's quote and the post it reposts)
                  "emoji" (collections.dict-merge (emoji-of (opt q "content_html" nil))
                                                  (emoji-of (opt p "content_html" nil)))
                  ;; with [ View ] (8 columns) after it, for a post with something to view
                  "m0" m0
                  "m0_url" (if (> (length media) 0) (picture-url (opt (nth media 0) "url" nil)) "")
                  "m0_kind" (if (> (length media) 0) (kind (text (opt (nth media 0) "mime_type" ""))) "")
                  "m1" (if (> (length media) 1) (clip (media-row (nth media 1)) CARDW) "")
                  "m1_url" (if (> (length media) 1) (picture-url (opt (nth media 1) "url" nil)) "")
                  "m1_kind" (if (> (length media) 1) (kind (text (opt (nth media 1) "mime_type" ""))) "")
                  ;; the first video and the first recording, played in the card where the host can
                  "vid_url" vid
                  "au_url" au
                  "mmore" (if (> (length media) 2)
                            (str-concat "+" (text (- (length media) 2)) " more (Open shows them all)")
                            "")
                  ;; the buttons follow the counts: [ Open ][ Reply ][ Like ][ Repost ] take 35
                  ;; columns
                  "counts" (pad (str-concat (counts-of q) (yours p)) (- CARDW 35)))))))

      ;; A page of the feed: Following is GET /social/timeline/home, Everyone the public one,
      ;; Friends /social/timeline/friends. mode=latest pages cleanly by before_id (the ranked
      ;; order re-ranks each page). A hashtag's posts (feed.source "tag") are GET
      ;; /social/timeline/tag/{tag}, paged by offset. The first page replaces the cards; a later
      ;; one is added below them.
      (defun load-feed (first)
        (let ((everyone (= (state-get "feed.mode") "Everyone"))
              (tagged (= (state-get "feed.source") "tag")))
          (let ((r (if tagged
                     (get-query (str-concat "/social/timeline/tag/" (state-get "feed.tag"))
                                (dict "limit" (text FEEDPAGE)
                                      "offset" (text (if first 0 (int (state-get "feed.offset"))))))
                     (get-authed (str-concat "/social/timeline/"
                                             (if everyone "public"
                                               (if (= (state-get "feed.mode") "Friends") "friends" "home"))
                                             "?mode=latest&limit=" (text FEEDPAGE)
                                             (if first ""
                                               (str-concat "&before_id=" (state-get "feed.before"))))))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (begin
                  (set cards (collections.map (opt b "posts" (list)) feed-card))
                  (if first
                    (state-set-tree "feed.items" cards)
                    (begin
                      (set n (int (state-get "feed.items")))
                      (for c cards
                        (state-set-tree (str-concat "feed.items." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "feed.items" n)))
                  (set total (int (state-get "feed.items")))
                  (state-set "feed.before" (text (opt b "next_before_id" "")))
                  (state-set "feed.offset" total)
                  (state-set "feed.more" (if (opt b "has_more" nil) "1" ""))
                  (state-set "feed.empty"
                    (if (> total 0) ""
                      (if tagged (str-concat "No posts name #" (state-get "feed.tag") ".")
                        (if everyone "No posts yet."
                          (if (= (state-get "feed.mode") "Friends")
                            "No posts from friends yet: people you follow who follow you."
                            "Your feed is empty. Follow people, or Show: Everyone.")))))
                  (if tagged
                    (state-set "feed.title"
                      (str-concat "#" (state-get "feed.tag") "  ·  "
                                  (text total) (if (= total 1) " post" " posts")
                                  (if (= (state-get "feed.more") "1") " so far" ""))))
                  (state-set "feed.tail"
                    (str-concat "  " (text total) (if (= total 1) " post" " posts")
                                (if (= (state-get "feed.more") "1") "" "; no more")))
                  true))
              (begin
                (if (session-over? r) (session-over)
                  (if (= (status r) 0) (unreachable r)
                    (fail (str-concat "Couldn't load " (if tagged "the hashtag" "the feed")
                                      " (HTTP " (str (status r)) ")."))))
                nil)))))

      ;; A reply, as the post's view lists it: who and when (and Open, 8 columns), then two
      ;; lines of it.
      (defun reply-row (q)
        (let ((lines (wrap (one-line (opt q "content" "")) WIDE))
              (a (opt q "author" (dict))))
          (begin
            (if (> (length lines) 2)
              (set lines (list (nth lines 0) (clip (str-concat (nth lines 1) " " (nth lines 2)) WIDE))))
            (dict "id" (text (opt q "id" ""))
                  "head" (pad (str-concat (author-name a) "  " (handle (text (opt a "username" "?")))
                                          "  " (posted-at (opt q "created_at" ""))
                                          "  ↩" (text (opt q "reply_count" 0)))
                              (- WIDE 8))
                  "l0" (if (= (length lines) 0) "(no text)" (nth lines 0))
                  "l1" (nth-or lines 1)
                  "emoji" (emoji-of (opt q "content_html" nil))))))
      ;; The post's replies (GET /social/posts/{id}/replies), oldest first: the first page, or the
      ;; next one added below.
      (set REPLYPAGE 10)
      (defun load-replies (first)
        (let ((off (if first 0 (int (state-get "post.replies")))))
          (let ((r (get-query (str-concat "/social/posts/" (text (state-get "post.pid")) "/replies")
                              (dict "limit" (text REPLYPAGE) "offset" (text off)))))
            (if (ok? r)
              (let ((rows (collections.map (opt (reply-json r) "replies" (list)) reply-row)))
                (begin
                  (if first
                    (state-set-tree "post.replies" rows)
                    (begin
                      (set n off)
                      (for c rows
                        (state-set-tree (str-concat "post.replies." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "post.replies" n)))
                  (state-set "post.replies_more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                  (set total (int (state-get "post.replies")))
                  (state-set "post.replies_head"
                    (if (= total 0) "No replies yet."
                      (str-concat (text total) (if (= total 1) " reply" " replies")
                                  (if (= (state-get "post.replies_more") "1") " so far" ""))))
                  true))
              (begin
                (state-set "post.replies_head" "Couldn't load the replies.")
                (state-set "post.replies_more" "")
                true)))))

      ;; A post's attachments, each a row (with View, 8 columns, for what the viewer shows), its
      ;; picture's URL and kind, and vi, its place among what the viewer shows.
      (defun post-media (media)
        (let ((out (list)) (vn 0))
          (begin
            (for m media
              (begin
                (set out (append out
                           (collections.dict-merge
                            (item-flags (kind (text (opt m "mime_type" ""))))
                            (dict "row" (if (= (kind (text (opt m "mime_type" ""))) "file")
                                          (clip (media-row m) WIDE)
                                          (pad (media-row m) (- WIDE 8)))
                                  "url" (picture-url (opt m "url" nil))
                                  "kind" (kind (text (opt m "mime_type" "")))
                                  "vi" (text vn)
                                  "where" (clip (str-concat "  " (picture-url (opt m "url" nil))) WIDE)))))
                (if (and (!= (kind (text (opt m "mime_type" ""))) "file") (!= (opt m "url" "") ""))
                  (set vn (+ vn 1)))))
            out)))

      ;; One post in full: GET /social/posts/{id}, which also has its reactions.
      (defun show-post (q)
        (let ((p (shown q)))
          (begin
            (set lines (list))
            (for para (if (= (type-of (opt q "reposted_post" nil)) "dict")
                        (append (paragraphs (opt q "content" "")) (body-of (dict "content" (opt p "content" ""))))
                        (paragraphs (opt q "content" "")))
              (for l (wrap para WIDE) (set lines (append lines l))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set reactions (collections.map (opt q "reactions_summary" (list))
                             (lambda (e) (str-concat ":" (text (opt e "emoji" "?")) ": "
                                                     (text (opt e "count" 0))))))
            (set parent (opt p "reply_to_id" nil))
            (set author (opt p "author" (dict)))
            (set tiles (tiles-of media))
            (state-set-tree "post"
             (collections.dict-merge
              (collections.dict-merge
               (grid-fields tiles)
               (post-flags (picture-only (picture-url (opt (opt p "author" (dict)) "avatar_url" nil)))
                           tiles))
              (dict "id" (opt q "id" 0)
                    ;; the post the buttons act on: a repost's is the post it reposts
                    "pid" (opt p "id" (opt q "id" 0))
                    "liked" (if (opt p "user_has_reacted" (opt q "user_has_reacted" nil)) "1" "")
                    "reposted" (if (opt p "user_has_reposted" (opt q "user_has_reposted" nil)) "1" "")
                    "my_repost" (text (opt p "user_repost_id" (opt q "user_repost_id" "")))
                    "mine" (if (= (text (opt author "username" "")) (state-get "me.username")) "1" "")
                    "author_id" (text (opt author "id" ""))
                    "parent" (if (= (type-of parent) "nil") "" (text parent))
                    "parent_note" "a post"
                    "tags" (tag-options q)
                    "tag_pick" ""
                    "link" (clip (str-concat "Link: " (web-of p)) WIDE)
                    "web" (web-of p)
                    "note" (repost-note q)
                    "avatar" (str-concat "(" (initials (author-name (opt p "author" (dict)))) ")")
                    "avatar_url" (picture-only (picture-url (opt (opt p "author" (dict)) "avatar_url" nil)))
                    "head" (clip (str-concat (author-name (opt p "author" (dict))) "  "
                                             (handle (text (opt (opt p "author" (dict)) "username" "?"))))
                                 (- WIDE 6))
                    "at" (posted-at (opt p "created_at" ""))
                    "lines" (if (= (length lines) 0) (list "(no text)") lines)
                    "emoji" (collections.dict-merge (emoji-of (opt q "content_html" nil))
                                                    (emoji-of (opt p "content_html" nil)))
                    "media" (post-media media)
                    "counts" (str-concat (counts-of q) (yours p))
                    "reactions" (if (= (length reactions) 0) ""
                                  (clip (str-concat "Reactions: " (string.join reactions "  ")) WIDE))
                    ;; kept across a reload of the same post (after a reply, a like)
                    "focus_reply" (state-get "post.focus_reply")
                    "reply_text" (if (= (text (state-get "post.pid")) (text (opt p "id" (opt q "id" 0))))
                                   (state-get "post.reply_text") "")
                    "replies" (list)
                    "replies_head" ""
                    "replies_more" "")))
            ;; who wrote the post it replies to
            (if (!= (type-of parent) "nil")
              (let ((pr (get-authed (str-concat "/social/posts/" (text parent)))))
                (if (ok? pr)
                  (state-set "post.parent_note"
                    (clip (str-concat " " (author-name (opt (reply-json pr) "author" (dict))) ": "
                                      (one-line (opt (reply-json pr) "content" "")))
                          (- WIDE 15))))))
            (load-replies true))))

      ;; A post, whole, by id: GET /social/posts/{id}, then its replies.
      (defun load-post (id)
        (let ((r (get-authed (str-concat "/social/posts/" (text id)))))
          (if (ok? r)
            (begin (show-post (reply-json r)) true)
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (if (= (status r) 404) "That post is gone."
                          (str-concat "Couldn't open the post (HTTP " (str (status r)) ").")))))
              nil))))

      ;; --- the other views -------------------------------------------------------------
      ;; Every hashtag (GET /social/tags), the most named first: a page of twenty rows, a row's
      ;; name and count, then Open (8 columns).
      (set TAGPAGE 20)
      (defun load-tags (first)
        (let ((off (if first 0 (int (state-get "tags.rows")))))
          (let ((r (get-query "/social/tags" (dict "limit" (text TAGPAGE) "offset" (text off)
                                                   "order_by" "post_count" "order_desc" "true"))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (begin
                  (set rows (collections.map (opt b "tags" (list))
                              (lambda (tg)
                                (let ((n (text (opt tg "post_count" 0))))
                                  (dict "name" (text (opt tg "name" ""))
                                        "line" (pad (str-concat "#" (text (opt tg "name" "")) "  ·  " n
                                                                (if (= n "1") " post" " posts"))
                                                    (- WIDE 8)))))))
                  (if first
                    (state-set-tree "tags.rows" rows)
                    (begin
                      (set n off)
                      (for c rows
                        (state-set-tree (str-concat "tags.rows." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "tags.rows" n)))
                  (set total (int (state-get "tags.rows")))
                  (state-set "tags.more" (if (< total (int (opt b "total" 0))) "1" ""))
                  (state-set "tags.head"
                    (if (= total 0) "No hashtags yet."
                      (str-concat (text (opt b "total" total)) " hashtags, the most named first")))
                  true))
              (begin
                (if (session-over? r) (session-over)
                  (if (= (status r) 0) (unreachable r)
                    (fail (str-concat "Couldn't load the hashtags (HTTP " (str (status r)) ")."))))
                nil)))))

      ;; The unread count beside Alerts (GET /notifications/count). Quiet: it never says a thing,
      ;; and a failure leaves the count as it was.
      (defun load-badge ()
        (let ((r (get-authed "/notifications/count")))
          (if (ok? r)
            (let ((n (int (opt (reply-json r) "unviewed_count" 0))))
              (state-set "alerts.badge" (if (> n 0) (str-concat " " (text n) " new") ""))))))
      ;; Your notifications, newest first, then all of them marked read (POST
      ;; /notifications/viewed), as the web app marks them when its list opens.
      (defun load-alerts ()
        (let ((r (get-query "/notifications/" (dict "limit" "20" "offset" "0"))))
          (if (ok? r)
            (let ((b (reply-json r)))
              (begin
                (set rows (collections.map (opt b "notifications" (list))
                            (lambda (n)
                              (let ((kind (text (opt n "related_type" "")))
                                    (target (text (opt n "related_id" ""))))
                                (begin
                                  (set openable (and (!= target "") (or (= kind "post") (= kind "user"))))
                                  (dict "kind" kind
                                        "target" (if openable target "")
                                        "line" (pad (str-concat (if (opt n "viewed" nil) "  " "● ")
                                                                (one-line (opt n "message" "")))
                                                    (if openable (- WIDE 8) WIDE))
                                        "at" (str-concat "  " (posted-at (opt n "created_at" ""))
                                                         "  " (text (opt n "notification_type" "")))))))))
                (state-set-tree "alerts.rows" rows)
                (set unread (int (opt b "unviewed_count" 0)))
                (state-set "alerts.head"
                  (if (= (length rows) 0) "No notifications."
                    (str-concat (text (opt b "total_count" (length rows))) " notifications"
                                (if (> unread 0) (str-concat ", " (text unread) " new") ""))))
                (if (> unread 0) (send-authed "POST" "/notifications/viewed" (dict)))
                (state-set "alerts.badge" "")
                true))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your notifications (HTTP " (str (status r)) ")."))))
              nil))))

      ;; Posts, people and hashtags (GET /search/search?q=), as txwtf groups them: results.posts,
      ;; .users and .hashtags, each {items, total}. A row each, then Open (8 columns), and a line
      ;; of what it says.
      (defun bucket (results k)
        (let ((items (opt (opt results k (dict)) "items" (list))))
          (if (= (type-of items) "list") items (list))))
      (defun hit-row (h)
        (let ((kind (text (opt h "type" "")))
              (who (opt h "author" nil)))
          (dict "kind" kind
                "id" (text (opt h "id" ""))
                "tag" (string.replace (text (opt h "title" "")) "#" "")
                ;; a post's title is often empty: its author's name then, and the full handle
                "line" (pad (str-concat (if (= kind "user") "[person] "
                                          (if (= kind "hashtag") "[tag] " "[post] "))
                                        (let ((title (one-line (opt h "title" ""))))
                                          (if (or (!= title "") (!= (type-of who) "dict")) title
                                            (author-name who)))
                                        (if (= (type-of who) "dict")
                                          (str-concat " · " (handle (text (opt who "username" ""))))
                                          ""))
                            (- WIDE 8))
                "snippet" (clip (str-concat "  " (one-line (opt h "snippet" ""))) WIDE))))
      (defun run-search ()
        (let ((q (string.trim (state-get "search.q"))))
          (if (< (string.length q) 2)
            (begin (state-set "search.note" "Type two letters or more.") true)
            (let ((r (get-query "/search/search" (dict "q" q "limit" "10"))))
              (if (ok? r)
                (let ((results (opt (reply-json r) "results" (dict))))
                  (begin
                    (set hits (list))
                    (if (= (type-of results) "dict")
                      (for k (list "posts" "users" "hashtags")
                        (for h (bucket results k) (set hits (append hits h)))))
                    (state-set-tree "search.rows" (collections.map hits hit-row))
                    (state-set "search.note"
                      (if (= (length hits) 0) (str-concat "Nothing matches \"" q "\".")
                        (str-concat (text (length hits)) " found for \"" q "\"")))
                    true))
                (begin
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Search failed (HTTP " (str (status r)) ")."))))
                  nil))))))

      ;; The viewer: the attachments of post view.post that it shows (pictures, video and audio),
      ;; at viewer.i.
      (defun viewer-at (i)
        (let ((items (state-get "viewer.n")))
          (if (> (int items) 0)
            (let ((k (% (+ (% (int i) (int items)) (int items)) (int items))))
              (begin
                (state-set "viewer.i" k)
                (state-set "viewer.url" (state-get (str-concat "viewer.items." (text k) ".url")))
                (state-set "viewer.kind" (state-get (str-concat "viewer.items." (text k) ".kind")))
                (state-set-tree "viewer.v"
                  (item-flags (state-get (str-concat "viewer.items." (text k) ".kind"))))
                (state-set "viewer.row" (state-get (str-concat "viewer.items." (text k) ".row")))
                (state-set "viewer.where"
                  (str-concat "  " (text (+ k 1)) " of " (text items))))))))
      (defun load-viewer (pid i)
        (let ((r (get-authed (str-concat "/social/posts/" (text pid)))))
          (if (ok? r)
            (let ((media (opt (shown (reply-json r)) "attachments" (list))))
              (begin
                (if (= (type-of media) "nil") (set media (list)))
                (set shows (collections.filter media
                             (lambda (m) (and (!= (kind (text (opt m "mime_type" ""))) "file")
                                              (!= (opt m "url" "") "")))))
                (state-set-tree "viewer.items"
                  (collections.map shows
                    (lambda (m) (dict "url" (picture-url (opt m "url" nil))
                                      "kind" (kind (text (opt m "mime_type" "")))
                                      "row" (clip (media-row m) WIDE)))))
                (state-set "viewer.n" (length shows))
                (if (= (length shows) 0)
                  (begin (fail "That post has nothing to view.") nil)
                  (begin (viewer-at i) true))))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't open the post (HTTP " (str (status r)) ")."))))
              nil))))

      ;; --- going between views --------------------------------------------------------
      ;; Where the window is: an entry, a view and what it shows (feed, tag|engines, post|312,
      ;; profile|7, tags, alerts, search, compose, viewer|312|0). ui.back holds the entries
      ;; before it, ";" between them, the newest last; it keeps thirty.
      (defun back-list ()
        (let ((s (state-get "ui.back"))) (if (= s "") (list) (string.split s ";"))))
      (defun push-back (entry)
        (let ((l (append (back-list) entry)))
          (state-set "ui.back"
            (string.join (if (> (length l) 30) (slice l (- (length l) 30) (length l)) l) ";"))))
      (defun pop-back ()
        (let ((l (back-list)))
          (if (= (length l) 0) ""
            (begin
              (state-set "ui.back" (string.join (slice l 0 (- (length l) 1)) ";"))
              (nth l (- (length l) 1))))))
      (defun show-screen (s)
        (begin
          (state-set "ui.screen" s)
          ;; the profile's page background, behind the window while a profile is shown
          (state-set "prof.bg_pic_shown" (if (= s "profile") (state-get "prof.bg_pic") ""))))
      ;; Load what an entry shows, and show it. True when it loaded.
      (defun show-entry (entry)
        (let ((parts (string.split entry "|")))
          (let ((view (car parts))
                (arg (nth-or parts 1)))
            (begin
              (set ok nil)
              (if (= view "feed")
                (begin
                  (state-set "feed.source" "home")
                  (say (str-concat "Loading " (if (= (state-get "feed.mode") "Everyone")
                                                "everyone's posts..."
                                                (if (= (state-get "feed.mode") "Friends")
                                                  "your friends' posts..." "your feed..."))))
                  (set ok (load-feed true))))
              (if (= view "tag")
                (begin
                  (state-set "feed.source" "tag")
                  (state-set "feed.tag" arg)
                  (state-set "feed.title" (str-concat "#" arg))
                  (say (str-concat "Loading #" arg "..."))
                  (set ok (load-feed true))))
              (if (= view "post")
                (begin (say "Opening the post...") (set ok (load-post arg))))
              (if (= view "profile")
                (if (= arg (text (state-get "me.id")))
                  (begin
                    (say "Loading your profile...")
                    (set ok (if (load-me-into true) (load-profile) nil)))
                  (begin (say "Loading the profile...") (set ok (load-user arg)))))
              (if (= view "tags")
                (begin (say "Loading the hashtags...") (set ok (load-tags true))))
              (if (= view "alerts")
                (begin (say "Loading your notifications...") (set ok (load-alerts))))
              (if (= view "search") (set ok true))
              (if (= view "compose") (set ok true))
              (if (= view "viewer")
                (set ok (load-viewer arg (int (if (= (nth-or parts 2) "") "0" (nth-or parts 2))))))
              (if ok
                (begin
                  (show-screen (if (= view "tag") "feed" view))
                  (say "")))
              ok))))
      ;; A new view: the other copy of the bar, whose Back takes the focus (ui/app.ari).
      (defun new-view () (state-set "ui.nav" (if (= (state-get "ui.nav") "a") "b" "a")))
      ;; Go to an entry: load it, then remember where the window was, for Back.
      (defun go (entry)
        (let ((was (state-get "ui.here")))
          (if (show-entry entry)
            (begin
              (if (and (!= was "") (!= was entry)) (push-back was))
              (state-set "ui.here" entry)
              (new-view)
              true)
            nil)))
      (defun go-home ()
        (begin
          (state-set "ui.back" "")
          (state-set "ui.here" "")
          (go "feed")))

      ;; After signing in: who it is, then the feed, the first view (as the web app's home), or
      ;; the first time, the view --start names (profile, tags, alerts, search, compose, post:ID,
      ;; tag:NAME, user:ID, view:ID[:N], search:TEXT); a view that won't load leaves the feed.
      (defun load-home ()
        (if (load-me)
          (let ((start (state-get "ui.start")))
            (begin
              (state-set "ui.back" "")
              (state-set "ui.here" "")
              (state-set "ui.start" "feed")
              (set entry
                (if (= start "profile") (str-concat "profile|" (text (state-get "me.id")))
                  (if (string.starts-with start "user:") (str-concat "profile|" (string.substring start 5 (string.length start)))
                    (if (or (string.starts-with start "post:") (string.starts-with start "tag:")
                            (= start "tags") (= start "alerts") (= start "search") (= start "compose"))
                      (string.replace start ":" "|")
                      ;; view:ID or view:ID:N, the viewer at a post's Nth attachment; search:TEXT,
                      ;; the search view, searching for TEXT
                      (if (string.starts-with start "search:")
                        (begin
                          (state-set "search.q" (string.substring start 7 (string.length start)))
                          "search")
                      (if (string.starts-with start "view:")
                        (let ((parts (string.split start ":")))
                          (str-concat "viewer|" (nth-or parts 1) "|"
                                      (if (= (nth-or parts 2) "") "0" (nth-or parts 2))))
                        "feed"))))))
              (if (go entry)
                (begin (if (!= (state-get "search.q") "") (run-search)) true)
                (go "feed"))))
          nil))

      (defun signed-in-msg () (str-concat "Signed in to " (state-get "app.host") "."))

      ;; A reply from /user/login or /user/login/2fa.
      (defun after-login (r)
        (let ((b (reply-json r)))
          (if (ok? r)
            (if (get-attr r "captured")
              (if (opt b "force_password_change" nil)
                (begin
                  (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
                  (net-auth-forget "txwtf")
                  (to-signin (str-concat "Change your password at " (state-get "app.host")
                                         ", then sign in.")
                             true))
                (begin
                  (state-set "login.challenge" "")
                  (state-set "login.code" "")
                  (if (load-home) (say (signed-in-msg)))))
              (if (opt b "two_factor_required" nil)
                (begin
                  (state-set "login.challenge" (opt b "challenge" ""))
                  (state-set "login.code" "")
                  (state-set "ui.screen" "2fa")
                  (say (str-concat "We emailed you a code. It expires in "
                                   (str (int (/ (opt b "expires_in" 300) 60))) " minutes.")))
                (fail (str-concat "The server sent no session: " (get-attr r "error")))))
            (if (= (status r) 0) (unreachable r)
              (if (= (status r) 429) (fail "Too many attempts. Wait a minute, then try again.")
                (if (= (state-get "ui.screen") "2fa")
                  (begin
                    (state-set "login.code" "")
                    (fail "That code didn't work. Try again, or go Back."))
                  (if (or (= (status r) 400) (= (status r) 401))
                    (fail "Wrong username or password.")
                    (fail (str-concat "Sign-in failed (HTTP " (str (status r)) ").")))))))))

      ;; --- doing things -----------------------------------------------------------------
      ;; A heart on post pid, or taken off (liked "1"); a repost of it, or yours taken back.
      (defun toggle-like (pid liked)
        (let ((r (if (= liked "1")
                   (send-authed "DELETE" (str-concat "/social/posts/" (text pid) "/reactions?emoji=heart") nil)
                   (send-authed "POST" (str-concat "/social/posts/" (text pid) "/reactions")
                                (dict "emoji" "heart")))))
          (if (ok? r)
            (begin (say (if (= liked "1") "Like taken back." "Liked.")) true)
            (begin (act-failed r (if (= liked "1") "take the like back" "like it")) nil))))
      (defun toggle-repost (pid reposted mine)
        (let ((r (if (and (= reposted "1") (!= mine ""))
                   (send-authed "DELETE" (str-concat "/social/posts/" mine) nil)
                   (send-authed "POST" "/social/posts" (dict "content" "" "repost_id" (int pid))))))
          (if (ok? r)
            (begin (say (if (= reposted "1") "Repost taken back." "Reposted.")) true)
            (begin (act-failed r (if (= reposted "1") "take the repost back" "repost it")) nil))))
      ;; After either, card i's counts and marks, from the post again.
      (defun refresh-card (i)
        (let ((key (str-concat "feed.items." (text i))))
          (let ((r (get-authed (str-concat "/social/posts/" (text (state-get (str-concat key ".id")))))))
            (if (ok? r)
              (let ((c (feed-card (reply-json r))))
                (begin
                  ;; a repost card's marks are the reposted post's
                  (if (!= (text (get-attr c "pid")) (text (get-attr c "id")))
                    (let ((o (get-authed (str-concat "/social/posts/" (text (get-attr c "pid"))))))
                      (if (ok? o)
                        (let ((op (reply-json o)))
                          (begin
                            (set-attr c "liked" (if (opt op "user_has_reacted" nil) "1" ""))
                            (set-attr c "reposted" (if (opt op "user_has_reposted" nil) "1" ""))
                            (set-attr c "my_repost" (text (opt op "user_repost_id" ""))))))))
                  (for k (list "counts" "liked" "reposted" "my_repost")
                    (state-set (str-concat key "." k) (get-attr c k)))))))))
      ;; A new post, or a reply (reply_to set): POST /social/posts. Its id, or nil.
      (defun publish (content reply-to visibility)
        (let ((r (send-authed "POST" "/social/posts"
                   (if (= reply-to "")
                     (dict "content" content "visibility" visibility)
                     (dict "content" content "visibility" visibility "reply_to_id" (int reply-to))))))
          (if (ok? r)
            (text (opt (reply-json r) "id" ""))
            (begin (act-failed r (if (= reply-to "") "post it" "send the reply")) nil))))

      (try
        (begin
          (if (= cmd "resume")
            ;; and/or are functions here, not special forms: they evaluate every argument.
            (if (if (net-auth-has? "txwtf" (base)) (load-home) nil)
              (say (signed-in-msg))
              (state-set "ui.screen" (if (= (state-get "ui.screen") "boot") "signin" (state-get "ui.screen")))))
          (if (= cmd "login")
            (let ((u (string.trim (state-get "login.username")))
                  (p (state-get "login.password")))
              (begin
                (state-set "login.password" "")
                (if (or (= u "") (= p ""))
                  (fail "Enter your username and password.")
                  (begin
                    (say "Signing in...")
                    (after-login (post-json "/user/login" (dict "username" u "password" p) true)))))))
          (if (= cmd "verify")
            (let ((code (string.trim (state-get "login.code"))))
              (if (= code "")
                (fail "Enter the code from the email.")
                (begin
                  (say "Checking the code...")
                  (after-login (post-json "/user/login/2fa"
                                          (dict "challenge" (state-get "login.challenge") "code" code)
                                          true))))))
          ;; Back: on the code screen, to the sign-in form; signed in, to the view before.
          (if (= cmd "back")
            (if (= (state-get "ui.screen") "2fa")
              (to-signin "" nil)
              (let ((entry (pop-back)))
                (if (= entry "")
                  (say "This is where you started.")
                  (if (show-entry entry) (begin (state-set "ui.here" entry) (new-view)))))))
          (if (= cmd "home") ;; on the feed already: it again, newest first
            (let ((again (and (= (state-get "ui.screen") "feed") (= (state-get "feed.source") "home"))))
              (if (go-home) (if again (say (str-concat "Updated. " (signed-in-msg)))))))
          (if (= cmd "feed") ;; Following, Everyone or Friends: the feed's first page, here
            (if (show-entry "feed") (state-set "ui.here" "feed")))
          (if (= cmd "tag")
            (let ((tg (string.lower (string.trim (string.replace (text (state-get "tag.want")) "#" "")))))
              (if (= tg "") (say "Pick a hashtag first.") (go (str-concat "tag|" tg)))))
          (if (= cmd "open")
            (begin
              (if (= (state-get "post.focus_reply") "1") (state-set "post.reply_text" ""))
              (go (str-concat "post|" (text (state-get "post.want"))))))
          (if (= cmd "profile") (go (str-concat "profile|" (text (state-get "me.id")))))
          (if (= cmd "user")
            (if (= (text (state-get "user.want")) "") (say "No one to show.")
              (go (str-concat "profile|" (text (state-get "user.want"))))))
          (if (= cmd "tags") (go "tags"))
          (if (= cmd "alerts") (go "alerts"))
          (if (= cmd "search-view") (go "search"))
          (if (= cmd "compose") (go "compose"))
          (if (= cmd "view")
            (go (str-concat "viewer|" (text (state-get "view.post")) "|" (text (state-get "view.i")))))
          (if (= cmd "view-prev") (viewer-at (- (int (state-get "viewer.i")) 1)))
          (if (= cmd "view-next") (viewer-at (+ (int (state-get "viewer.i")) 1)))
          (if (= cmd "refresh") ;; the view it was pressed in, again
            (begin
              (say "Refreshing...")
              (if (if (= (state-get "ui.screen") "profile") (load-me) true)
                (if (show-entry (if (= (state-get "ui.here") "") "feed" (state-get "ui.here")))
                  (say (str-concat "Updated. " (signed-in-msg)))))))
          (if (= cmd "more")
            (if (= (state-get "feed.more") "1")
              (begin
                (say "Loading more...")
                (state-set "feed.tail" "  Loading more...")
                (if (load-feed nil) (say "")))
              (say (if (= (state-get "feed.source") "tag") "That's every post with this hashtag."
                     "That's the whole feed."))))
          (if (= cmd "more-replies") (begin (say "Loading more replies...") (if (load-replies nil) (say ""))))
          (if (= cmd "more-tags") (begin (say "Loading more hashtags...") (if (load-tags nil) (say ""))))
          (if (or (= cmd "tab") (= cmd "older") (= cmd "newer"))
            (let ((step (if (= (state-get "ui.tab") "Posts") PAGE 20))
                  (off (int (state-get "tab.offset"))))
              (begin
                (state-set "tab.offset" (if (= cmd "tab") 0
                                          (if (= cmd "older") (+ off step) (math.max 0 (- off step)))))
                (if (!= (state-get "ui.tab") "Balances")
                  (begin
                    (say (str-concat "Loading " (string.lower (state-get "ui.tab")) "..."))
                    (if (load-tab) (say "")))))))
          ;; On a card: act.i names it.
          (if (= cmd "like")
            (let ((key (str-concat "feed.items." (text (state-get "act.i")))))
              (if (toggle-like (state-get (str-concat key ".pid")) (text (state-get (str-concat key ".liked"))))
                (refresh-card (state-get "act.i")))))
          (if (= cmd "repost")
            (let ((key (str-concat "feed.items." (text (state-get "act.i")))))
              (if (toggle-repost (state-get (str-concat key ".pid"))
                                 (text (state-get (str-concat key ".reposted")))
                                 (text (state-get (str-concat key ".my_repost"))))
                (refresh-card (state-get "act.i")))))
          ;; On the post shown.
          (if (= cmd "post-like")
            (if (toggle-like (state-get "post.pid") (text (state-get "post.liked")))
              (load-post (state-get "post.id"))))
          (if (= cmd "post-repost")
            (if (toggle-repost (state-get "post.pid") (text (state-get "post.reposted"))
                               (text (state-get "post.my_repost")))
              (load-post (state-get "post.id"))))
          (if (= cmd "delete")
            (let ((r (send-authed "DELETE" (str-concat "/social/posts/" (text (state-get "post.pid"))) nil)))
              (if (ok? r)
                (let ((entry (pop-back)))
                  (begin
                    (if (show-entry (if (= entry "") "feed" entry))
                      (begin (state-set "ui.here" (if (= entry "") "feed" entry)) (new-view)))
                    (say "Deleted.")))
                (act-failed r "delete it"))))
          (if (= cmd "reply")
            (let ((txt (string.trim (text (state-get "post.reply_send")))))
              (if (= txt "") (say "Write something first.")
                (let ((id (publish txt (text (state-get "post.pid")) "public")))
                  (if id
                    (begin
                      (state-set "post.reply_text" "")
                      (state-set "post.focus_reply" "")
                      (load-post (state-get "post.id"))
                      (new-view) ;; the post again, its reply below: the focus back on Back
                      (say "Replied.")))))))
          (if (= cmd "post")
            (let ((txt (string.trim (text (state-get "compose.send")))))
              (if (= txt "") (say "Write something first.")
                (let ((id (publish txt "" (string.lower (state-get "compose.visibility")))))
                  (if id
                    (begin
                      (state-set "compose.text" "")
                      ;; the new post takes the composer's place: Back goes where it was opened
                      (state-set "ui.here" "")
                      (if (go (str-concat "post|" id)) (say "Posted."))))))))
          (if (or (= cmd "follow") (= cmd "unfollow"))
            (let ((id (text (state-get "prof.id"))))
              (let ((r (if (= cmd "follow")
                         (send-authed "POST" "/social/follow" (dict "user_id" (int id)))
                         (send-authed "DELETE" (str-concat "/social/follow/" id) nil))))
                (if (ok? r)
                  (begin
                    (state-set "prof.following" (if (= cmd "follow") "1" ""))
                    (say (str-concat (if (= cmd "follow") "Following " "Stopped following ")
                                     (state-get "prof.handle") ".")))
                  (act-failed r cmd)))))
          (if (= cmd "search")
            (begin
              (say "Searching...")
              (if (run-search) (say ""))))
          (if (= cmd "hit-open")
            (go (if (= (state-get "hit.kind") "hashtag")
                  (str-concat "tag|" (string.lower (text (state-get "hit.tag"))))
                  (str-concat (if (= (state-get "hit.kind") "user") "profile|" "post|")
                              (text (state-get "hit.id"))))))
          (if (= cmd "alert-open")
            (go (str-concat (if (= (state-get "alert.kind") "user") "profile|" "post|")
                            (text (state-get "alert.target")))))
          (if (= cmd "signout")
            (begin
              (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
              (net-auth-forget "txwtf")
              (to-signin "Signed out." nil)))
          ;; Signed in still: the unread count again.
          (if (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                   (!= (state-get "ui.screen") "boot") (!= cmd "alerts"))
            (load-badge)))
        ;; Nothing in here may raise: an exception this resident doesn't catch ends it, and the
        ;; buttons with it.
        (catch (e)
          (if (= (state-get "ui.screen") "boot") (state-set "ui.screen" "signin"))
          (fail (str-concat "Something went wrong: "
                            (try (text (get-attr e "message")) (catch (e2) "no details"))))))
      (state-set "ui.busy" "")))

# The views come and go with ui.screen, so there are no windows for a Windows menu to reopen.
windows_menu: false

menubar:
  - menu: nicotina
    items:
      - menu_item: Home
        on: (state-set "ui.cmd" "home")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Back
        on: (state-set "ui.cmd" "back")
        enabled_when: (and (!= (state-get "ui.back") "") (!= (state-get "ui.busy") "1"))
      - menu_item: New post
        on: (state-set "ui.cmd" "compose")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Your profile
        on: (state-set "ui.cmd" "profile")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Refresh
        on: (state-set "ui.cmd" "refresh")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Sign out
        on: (state-set "ui.cmd" "signout")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - separator
      - menu_item: Quit
        on: quit

windows:
  - include: starting_window
  - include: signin_window
  - include: twofactor_window
  - include: app_window
  - include: details_window
