# nicotina — a TX.WTF client, written as Ariadne documents. This is the app: its arguments, its
# menu, and the client itself, nicotina.ari, loaded as a module (which another document can load
# the same way; see the top of nicotina.ari). The same document runs in stock hosts, unmodified:
#
#   ari run   --net-allow https://tx.wtf --credential-store PATH main.ari [--instance URL]
#   ari run   --backend tvision ... main.ari
#   arigl run --net-allow https://tx.wtf --credential-store PATH main.ari
#
# bin/nicotina passes those flags. In a browser, the arigl-web and ari pages load it with
# ?src=main.ari, and their ariadne.config.json passes --net.

meta:
  name: nicotina
  description: A TX.WTF client
  version: 0.0.1
  min_libcvc: 3.7.5

args:
  instance: {type: string, default: "https://tx.wtf", help: "The TX.WTF instance (its base URL)"}
  user: {type: string, help: "Fill in this username on the sign-in form"}
  start: {type: string, default: feed,
          help: "The first view once signed in: feed, profile, tags, alerts, search, compose, dms, post:ID, dm:ID, tag:NAME, user:ID, view:ID[:N] or search:TEXT; for an administrator also admin[:users|groups|invites|site|log], auser:ID, agroup:ID or agperm:ID"}

# Without --net (or --net-allow) the host has no http-request and keeps no credentials, and the
# load fails here, naming what is missing. (nicotina.ari lists the rest.)
requires:
  - net
  - net.auth

# The views come and go with ui.screen, so there are no windows for a Windows menu to reopen.
windows_menu: false

menubar:
  - menu: nicotina
    items:
      - menu_item: Home
        on: (state-set "ui.cmd" "home")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Back
        on: (state-set "ui.cmd" "back")
        enabled_when: (and (!= (state-get "ui.back") "") (!= (state-get "ui.busy") "1"))
      - menu_item: Forward
        on: (state-set "ui.cmd" "forward")
        enabled_when: (and (!= (state-get "ui.fwd") "") (!= (state-get "ui.busy") "1"))
      # The window closes with its X; this brings it back.
      - menu_item: Show the window
        on: (state-set "ui.cmd" "show-window")
      - menu_item: New post
        on: (state-set "ui.cmd" "compose")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Messages
        on: (state-set "ui.cmd" "dms")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Your profile
        on: (state-set "ui.cmd" "profile")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      # The instance's administration: for the accounts it makes administrators (ui.admin).
      - menu_item: Admin
        on: (state-set "ui.cmd" "admin")
        enabled_when: (and (= (state-get "ui.admin") "1") (!= (state-get "ui.busy") "1"))
      - menu_item: Refresh
        on: (state-set "ui.cmd" "refresh")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Sign out
        on: (state-set "ui.cmd" "signout")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - separator
      - menu_item: Quit
        on: quit

# The client's view state lives here (ui), where the menu reaches it: the link below needs it to
# exist before the client starts.
init: |
  (state-set "ui.cmd" "")

# The client, with its arguments and its view state: the menu above sets its ui.cmd.
windows:
  - load: nicotina.ari
    as: nicotina
    link:
      args: {to: args, mode: ro}
      ui: {to: ui, mode: rw}
