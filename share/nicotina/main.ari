# nicotina — a TX.WTF client, written as Ariadne documents. This is the app: its arguments, its
# menu, and the client itself, nicotina.ari, loaded as a module (which another document can load
# the same way; see the top of nicotina.ari). The same document runs in stock hosts, unmodified:
#
#   ari run   --net-allow https://tx.wtf --credential-store PATH main.ari [--instance URL]
#   ari run   --backend tvision ... main.ari
#   arigl run --net-allow https://tx.wtf --credential-store PATH main.ari
#
# bin/nicotina passes those flags. In a browser, the arigl-web and ari pages load it with
# ?src=main.ari, and their ariadne.config.json passes --net.

meta:
  name: nicotina
  description: A TX.WTF client
  version: 0.0.1
  min_libcvc: 3.7.5

args:
  instance: {type: string, default: "https://tx.wtf", help: "The TX.WTF instance (its base URL)"}
  user: {type: string, help: "Fill in this username on the sign-in form"}
  start: {type: string, default: feed,
          help: "The first view once signed in: feed, profile, settings, tags, alerts, search, compose, dms, post:ID, dm:ID, tag:NAME, user:ID, view:ID[:N] or search:TEXT; for an administrator also admin[:users|groups|invites|site|log], auser:ID, agroup:ID or agperm:ID"}

# Without --net (or --net-allow) the host has no http-request and keeps no credentials, and the
# load fails here, naming what is missing. (nicotina.ari lists the rest.)
requires:
  - net
  - net.auth

# The views come and go with ui.screen, so there are no windows for a Windows menu to reopen.
windows_menu: false

# The tray's bell shows even with nothing in it (libcvc 4.0.5; an older host takes it as false).
notifications: always

menubar:
  - menu: nicotina
    items:
      - menu_item: Home
        on: (state-set "ui.cmd" "home")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Back
        on: (state-set "ui.cmd" "back")
        enabled_when: (and (!= (state-get "ui.back") "") (!= (state-get "ui.busy") "1"))
      - menu_item: Forward
        on: (state-set "ui.cmd" "forward")
        enabled_when: (and (!= (state-get "ui.fwd") "") (!= (state-get "ui.busy") "1"))
      # The window closes with its X; this brings it back.
      - menu_item: Show the window
        on: (state-set "ui.cmd" "show-window")
      # Its title bar's maximize button, as a menu item: the window fills the screen, or goes
      # back to its size. Where the backend has the button (ui.maximize: ImGui and FTXUI;
      # tvision's zoom box is its own).
      - menu_item: Maximize the window
        on: (state-set "ui.cmd" "maximize")
        enabled_when: (and (has? "ui.maximize")
                           (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot"))
      - menu_item: New post
        on: (state-set "ui.cmd" "compose")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Messages
        on: (state-set "ui.cmd" "dms")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Your profile
        on: (state-set "ui.cmd" "profile")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      # The instance's administration: for the accounts it makes administrators (ui.admin).
      - menu_item: Admin
        on: (state-set "ui.cmd" "admin")
        enabled_when: (and (= (state-get "ui.admin") "1") (!= (state-get "ui.busy") "1"))
      - menu_item: Refresh
        on: (state-set "ui.cmd" "refresh")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - menu_item: Sign out
        on: (state-set "ui.cmd" "signout")
        enabled_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                           (!= (state-get "ui.screen") "boot") (!= (state-get "ui.busy") "1"))
      - separator
      - menu_item: Quit
        on: quit
  # The tray, at the bar's right end, as the web app's bar has its bell (transfix/libcvc#1241, the
  # release after libcvc 4.0.0; an older host loads this as nothing, with a warning):
  #   the mail icon  how many conversations have a message not yet read here; a click opens the
  #                  DMs view
  #   the bell       the host's own, shown always (notifications: always): TX.WTF's notifications
  #                  and the direct messages that came while their conversation wasn't shown
  #                  (nicotina.ari posts them to the host's notification feed). A click on one
  #                  opens what it is about.
  #   you            your avatar, round (it moves when it's an animation or a video: libcvc 4.0.5;
  #                  an older host shows the user glyph); a click opens your profile
  - tray_icon: mail
    badge: (state-get "ui.dm_unread")
    tooltip: Direct messages
    on: (state-set "ui.cmd" "dms")
    visible_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                       (!= (state-get "ui.screen") "boot"))
  - bell
  - tray_icon: user
    icon: (state-get "me.avatar_url")
    tooltip: Your profile
    on: (state-set "ui.cmd" "profile")
    visible_when: (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                       (!= (state-get "ui.screen") "boot"))

# The client's view state lives here (ui), where the menu reaches it: the link below needs it to
# exist before the client starts.
#
# ui.nav_emoji: the instance's custom emoji the bar's buttons and the feed's choices show in place
# of their own, by name (a few names, comma separated: the first the instance has). Where the host
# draws a picture on a button (button.icon) and can fetch the picture, the button shows it; until
# then, or with "" here, the button keeps its own emoji. Change them here.
init: |
  (state-set "ui.cmd" "")
  (state-set-tree "ui.nav_emoji"
    (dict "back" "moonwalk"         "forward" "lambo"        "home" "igloo"
          "tags" "stonks"           "search" "notsureif,philosoraptor"
          "alerts" "alert"          "profile" "guyfawkes"    "compose" "faacts"
          "dms" "yo"                "admin" "godmode"
          "following" "spartans"    "everyone" "this-is-fine" "friends" "shibe"))

# The client, with its arguments and its view state: the menu above sets its ui.cmd.
windows:
  - load: nicotina.ari
    as: nicotina
    link:
      args: {to: args, mode: ro}
      ui: {to: ui, mode: rw}
