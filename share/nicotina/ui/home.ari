# A profile, laid out as the TX.WTF web app lays one out: a view in the TX.WTF window (ui/app.ari),
# and (outside a terminal) the Details window beside it for your own.
#
# The web app's profile is a header banner, then a card (the avatar beside the name, handle,
# badges, description and counts, then the groups and an action bar), then tabs: Posts, Replies
# and, on your own, Balances and Settings (your content filter). profile_view is that, for an 80x24 terminal first: 74 columns wide
# (the banner's crop). It shows prof.*: your own profile (prof.self "1", a copy of me.*) or
# anyone else's (GET /user/profile/{id}), with Follow or Unfollow in its action bar.
#
# The banner and the avatar are the account's own pictures (txwtf's header_image_url and
# avatar_url, resolved against the instance; no sign-in needed), where the host can show a
# picture from a URL (image.url: transfix/libcvc#931). Elsewhere, for an account without a header
# image, and for a video avatar or banner (the web app plays those as muted loops), each slot shows
# a placeholder: the banner the plain colour the web app shows without one, and the avatar a frame
# with the account's initials. An animated GIF or WebP shows its first frame. The card has the
# account's card picture behind it where the host has background: (transfix/libcvc#932); a host
# without it ignores the key.

units:
  # The banner: the header image, cropped to the window's width and two rows (592 x 32 px), as
  # the web app crops it to its banner. Without one, two rows of colour, as the web app's
  # banner without a header image; a window outside a terminal has no block glyphs to spare, so
  # it shows a rule there.
  banner_slot:
    type: group
    children:
      - image: header image
        bind: prof.header_pic
        size: [592, 32]
        fit: cover
        visible_when: (and (has? "image.url") (!= (state-get "prof.header_pic") ""))
      - type: group
        visible_when: (not (and (has? "image.url") (!= (state-get "prof.header_pic") "")))
        children:
          - text: ""
            bind: ui.banner_row
            color: [0.27, 0.33, 0.45]
            visible_when: (has? "term")
          - text: ""
            bind: ui.banner_row
            color: [0.27, 0.33, 0.45]
            visible_when: (has? "term")
          - separator: ""
            visible_when: (not (has? "term"))

  # The avatar: a round picture 64 px square, 8 x 4 cells in a terminal. Without one, an 8 x 4
  # frame with the initials in it. (txwtf always has an avatar URL: its default when the account
  # has none of its own.)
  avatar_slot:
    type: group
    children:
      - image: avatar
        bind: prof.avatar_pic
        size: [64, 64]
        fit: cover
        shape: circle
        visible_when: (and (has? "image.url") (!= (state-get "prof.avatar_pic") ""))
      - type: group
        visible_when: (not (and (has? "image.url") (!= (state-get "prof.avatar_pic") "")))
        children:
          - text: ""
            bind: prof.avatar_box.0
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: prof.avatar_box.1
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: prof.avatar_box.2
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: prof.avatar_box.3
            color: [0.55, 0.6, 0.7]

  profile_view:
    type: group
    children:
      - include: banner_slot
      # The card, over the account's card picture (card_image_url), dimmed as the web app dims it
      # (a host with background:, libcvc 3.7.9 and later; others ignore the key). In a terminal
      # it is half-blocks behind the card's text.
      - type: group
        background: {bind: prof.card_pic, fit: cover, opacity: 0.3, terminal: behind}
        children:
          # The card: the avatar beside who it is.
          - type: group
            layout: {kind: horizontal}
            children:
              - include: avatar_slot
              - text: " "
              - type: group
                children:
                  # The full handle, @user@instance, then the display name, cut to fit.
                  - text: ""
                    bind: prof.header
                  - text: ""
                    bind: prof.badges
                    color: [0.95, 0.75, 0.3]
                  - text: ""
                    bind: '(if (= (state-get "prof.about_short") "") " " (state-get "prof.about_short"))'
                  - text: ""
                    bind: prof.stats
                    color: [0.6, 0.6, 0.6]
          # The groups, and the action bar at the end of the card: on your own profile Refresh
          # and Sign out, and Admin for an instance's administrator (ui/admin.ari); on another's
          # Follow or Unfollow, then Message (a direct message).
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: prof.groups_line
              - button: Refresh
                on: (state-set "ui.cmd" "refresh")
                visible_when: (= (state-get "prof.self") "1")
              - button: Sign out
                on: (state-set "ui.cmd" "signout")
                visible_when: (= (state-get "prof.self") "1")
              - button: Admin
                on: (state-set "ui.cmd" "admin")
                visible_when: (and (= (state-get "prof.self") "1") (= (state-get "ui.admin") "1"))
              - button: Follow
                on: (state-set "ui.cmd" "follow")
                visible_when: (and (!= (state-get "prof.self") "1") (!= (state-get "prof.following") "1"))
              - button: Unfollow
                on: (state-set "ui.cmd" "unfollow")
                visible_when: (and (!= (state-get "prof.self") "1") (= (state-get "prof.following") "1"))
              - button: Message
                on: (state-set "ui.cmd" "dm-with")
                visible_when: (!= (state-get "prof.self") "1")
      # The tabs. Choosing one loads it (main.ari's "tab"). A terminal host draws a radio row's
      # label even when it is empty (a lone ":"), so it has one.
      - radio_row: Show
        bind: ui.tab
        options: (if (= (state-get "prof.self") "1") (list "Posts" "Replies" "Balances" "Settings") (list "Posts" "Replies"))
        on: (state-set "ui.cmd" "tab")
      - separator
      # Posts and Replies, a page of them, newest first. In a window, cards (ui/card.ari), as the
      # feed's; Like and Repost act on tab.items. (Kept shallow: a Windows host's 1 MB stack
      # overflows on a deep enough tree, libcvc before the fix.)
      - text: ""
        bind: tab.empty
        visible_when: (and (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
                           (!= (state-get "app.term") "1") (!= (state-get "tab.empty") ""))
      - include: card_list
        args: {list: tab.items}
      # In a terminal, a row each with Open: a page of five fits 80x24.
      - type: group
        repeat: (state-get "tab.rows")
        visible_when: (and (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
                           (= (state-get "app.term") "1"))
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: tab.rows.{i}.line
              - button: Open
                on: (begin (state-set "post.want" (state-get "tab.rows.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
                visible_when: (!= (state-get "tab.rows.{i}.id") "")
      - type: group
        visible_when: (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - button: Newer
                on: (state-set "ui.cmd" "newer")
                enabled_when: (and (!= (state-get "ui.busy") "1") (> (int (state-get "tab.offset")) 0))
              - button: Older
                on: (state-set "ui.cmd" "older")
                enabled_when: (and (!= (state-get "ui.busy") "1") (= (state-get "tab.more") "1"))
              - text: ""
                bind: tab.page
                color: [0.6, 0.6, 0.6]
      # Balances: the SCRIP balance and what it is worth. Six rows, as the lists take.
      - type: group
        visible_when: (= (state-get "ui.tab") "Balances")
        children:
          - type: group
            layout: {kind: grid, col_widths: [72, auto]}
            children:
              - text: ""
                bind: scrip.symbol
              - text: ""
                bind: scrip.balance
              - text: "Value"
              - text: ""
                bind: scrip.value
          - text: " "
          - text: " "
          - text: " "
          - text: " "
      # Settings: your content filter (GET and PUT /social/settings/read-level). The feeds leave
      # out posts scored below the level picked, a post's score being its likes less its
      # dislikes; your own posts and promoted ones always show. The levels run -10 to 20, as the
      # web app's slider does. Six rows, as the lists take.
      - type: group
        visible_when: (= (state-get "ui.tab") "Settings")
        children:
          - text: ""
            bind: set.head
          - combo: Hide below
            bind: set.level
            options: ["-10  show everything", "-5  hide flagged", "-3  hide flagged (default)",
                      "-1  hide flagged", "0  neutral and up", "1  well received only",
                      "3  well received only", "5  well received only", "10  well received only",
                      "20  only top-rated"]
            values: [-10, -5, -3, -1, 0, 1, 3, 5, 10, 20]
            on: (state-set "ui.cmd" "read-level")
            visible_when: (= (state-get "set.v_level") "1")
          - text: ""
            bind: set.note
            color: [0.6, 0.6, 0.6]
          - text: "Your own posts, and promoted ones, always show."
            visible_when: (= (state-get "set.v_level") "1")
            color: [0.6, 0.6, 0.6]
          - text: " "

  details_window:
    window: Details
    id: details
    closable: true
    pos: [640, 32]
    visible_when: (and (= (state-get "ui.screen") "profile") (= (state-get "prof.self") "1")
                       (not (has? "term")))
    children:
      - text: "Handle"
        bind: me.handle
      - text: "Name"
        bind: me.name
      - text: "Email"
        bind: me.email
      - text: "Email verified"
        bind: me.email_verified
      - text: "Two-step sign-in"
        bind: me.two_factor
      - text: "Presence"
        bind: me.presence
      - text: "Session"
        bind: '(if (has? "net.auth.persist") "kept on this device" "until you quit")'
      - separator
      - text: "About"
      - text: ""
        bind: '(if (= (state-get "me.about") "") "-" (state-get "me.about"))'
      - separator
      - text: "Pictures (on this instance)"
      - text: "Avatar"
        bind: '(if (= (state-get "me.avatar_url") "") "-" (string.replace (state-get "me.avatar_url") (state-get "app.origin") ""))'
      - text: "Header"
        bind: '(if (= (state-get "me.header_url") "") "-" (string.replace (state-get "me.header_url") (state-get "app.origin") ""))'
      - text: "Card"
        bind: '(if (= (state-get "me.card_url") "") "-" (string.replace (state-get "me.card_url") (state-get "app.origin") ""))'
      - text: "Background"
        bind: '(if (= (state-get "me.bg_url") "") "-" (string.replace (state-get "me.bg_url") (state-get "app.origin") ""))'
      - separator
      - text: "Groups"
        bind: me.groups
      - type: group
        repeat: (state-get "me.groups")
        children:
          - text: ""
            bind: me.groups.{i}
