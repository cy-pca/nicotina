# A profile, laid out as the TX.WTF web app lays one out: a view in the TX.WTF window (ui/app.ari),
# and (outside a terminal) the Details window beside it for your own.
#
# The web app's profile is a header banner, then a card (the avatar beside the name, handle,
# badges, description and counts, then the groups and an action bar), then tabs: Posts, Replies
# and, on your own, Balances and Settings (your content filter). profile_view is that, for an 80x24 terminal first: 74 columns wide
# (the banner's crop). It shows prof.*: your own profile (prof.self "1", a copy of me.*) or
# anyone else's (GET /user/profile/{id}), with Follow or Unfollow in its action bar.
#
# The banner and the avatar are the account's own pictures (txwtf's header_image_url and
# avatar_url, resolved against the instance; no sign-in needed), where the host can show a
# picture from a URL (image.url: transfix/libcvc#931). Elsewhere, for an account without a header
# image, and for a video avatar or banner (the web app plays those as muted loops), each slot shows
# a placeholder: the banner the plain colour the web app shows without one, and the avatar a frame
# with the account's initials. An animated GIF or WebP shows its first frame. The card has the
# account's card picture behind it where the host has background: (transfix/libcvc#932); a host
# without it ignores the key.

units:
  # The banner: the header image, cropped to the window's width and two rows (592 x 32 px), as
  # the web app crops it to its banner. Without one, two rows of colour, as the web app's
  # banner without a header image; a window outside a terminal has no block glyphs to spare, so
  # it shows a rule there.
  banner_slot:
    args: {p: prof}
    type: group
    children:
      - image: header image
        bind: "{p}.header_pic"
        size: [592, 32]
        fit: cover
        visible_when: (and (has? "image.url") (!= (state-get "{p}.header_pic") ""))
      - type: group
        visible_when: (not (and (has? "image.url") (!= (state-get "{p}.header_pic") "")))
        children:
          - text: ""
            bind: ui.banner_row
            color: [0.27, 0.33, 0.45]
            visible_when: (has? "term")
          - text: ""
            bind: ui.banner_row
            color: [0.27, 0.33, 0.45]
            visible_when: (has? "term")
          - separator: ""
            visible_when: (not (has? "term"))

  # The avatar: a round picture 64 px square, 8 x 4 cells in a terminal. Without one, an 8 x 4
  # frame with the initials in it. (txwtf always has an avatar URL: its default when the account
  # has none of its own.)
  avatar_slot:
    args: {p: prof}
    type: group
    children:
      - image: avatar
        bind: "{p}.avatar_pic"
        size: [64, 64]
        fit: cover
        shape: circle
        visible_when: (and (has? "image.url") (!= (state-get "{p}.avatar_pic") ""))
      - type: group
        visible_when: (not (and (has? "image.url") (!= (state-get "{p}.avatar_pic") "")))
        children:
          - text: ""
            bind: "{p}.avatar_box.0"
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: "{p}.avatar_box.1"
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: "{p}.avatar_box.2"
            color: [0.55, 0.6, 0.7]
          - text: ""
            bind: "{p}.avatar_box.3"
            color: [0.55, 0.6, 0.7]

  # A profile's card, as its page shows it: the banner, then the card over the account's card
  # picture (card_image_url), dimmed as the web app dims it (a host with background:, libcvc
  # 3.7.9 and later; others ignore the key; in a terminal, half-blocks behind the card's text).
  # P is where its fields are (main.ari's profile-of: prof for the profile view, a search
  # result's for search). ACTIONS "1" ends it with the profile view's action bar.
  profile_card:
    args: {p: prof, actions: "1"}
    type: group
    children:
      - include: banner_slot
        args: {p: "{p}"}
      - type: group
        background: {bind: "{p}.card_pic", fit: cover, opacity: 0.3, terminal: behind}
        children:
          # The card: the avatar beside who it is.
          - type: group
            layout: {kind: horizontal}
            children:
              - include: avatar_slot
                args: {p: "{p}"}
              - text: " "
              - type: group
                children:
                  # The full handle, @user@instance, then the display name, cut to fit.
                  - text: ""
                    bind: "{p}.header"
                  - text: ""
                    bind: "{p}.badges"
                    color: [0.95, 0.75, 0.3]
                  - text: ""
                    bind: '(if (= (state-get "{p}.about_short") "") " " (state-get "{p}.about_short"))'
                  - text: ""
                    bind: "{p}.stats"
                    color: [0.6, 0.6, 0.6]
          # The groups, and on the profile view the action bar at the end of the card: on your
          # own profile Refresh and Sign out, and Admin for an instance's administrator
          # (ui/admin.ari); on another's Follow or Unfollow, then Message (a direct message).
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: "{p}.groups_line"
              - button: Refresh
                on: (state-set "ui.cmd" "refresh")
                visible_when: (and (= "{actions}" "1") (= (state-get "prof.self") "1"))
              - button: Sign out
                on: (state-set "ui.cmd" "signout")
                visible_when: (and (= "{actions}" "1") (= (state-get "prof.self") "1"))
              - button: Admin
                on: (state-set "ui.cmd" "admin")
                visible_when: (and (= "{actions}" "1") (= (state-get "prof.self") "1") (= (state-get "ui.admin") "1"))
              - button: Follow
                on: (state-set "ui.cmd" "follow")
                visible_when: (and (= "{actions}" "1") (!= (state-get "prof.self") "1") (!= (state-get "prof.following") "1"))
              - button: Unfollow
                on: (state-set "ui.cmd" "unfollow")
                visible_when: (and (= "{actions}" "1") (!= (state-get "prof.self") "1") (= (state-get "prof.following") "1"))
              - button: Message
                on: (state-set "ui.cmd" "dm-with")
                visible_when: (and (= "{actions}" "1") (!= (state-get "prof.self") "1"))

  profile_view:
    type: group
    children:
      - include: profile_card
        args: {p: prof, actions: "1"}
      # The tabs. Choosing one loads it (main.ari's "tab"). A terminal host draws a radio row's
      # label even when it is empty (a lone ":"), so it has one.
      - radio_row: Show
        bind: ui.tab
        options: (if (= (state-get "prof.self") "1") (list "Posts" "Replies" "Balances" "Settings") (list "Posts" "Replies"))
        on: (state-set "ui.cmd" "tab")
      - separator
      # Posts and Replies, a page of them, newest first. In a window, cards (ui/card.ari), as the
      # feed's; Like and Repost act on tab.items. (Kept shallow: a Windows host's 1 MB stack
      # overflows on a deep enough tree, libcvc before the fix.)
      - text: ""
        bind: tab.empty
        visible_when: (and (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
                           (!= (state-get "session.caps.term") "1") (!= (state-get "tab.empty") ""))
      - include: card_list
        args: {list: tab.items}
      # In a terminal, a row each with Open: a page of five fits 80x24.
      - type: group
        repeat: (state-get "tab.rows")
        visible_when: (and (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
                           (= (state-get "session.caps.term") "1"))
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: tab.rows.{i}.line
              - button: Open
                on: (begin (state-set "post.want" (state-get "tab.rows.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
                visible_when: (!= (state-get "tab.rows.{i}.id") "")
      - type: group
        visible_when: (or (= (state-get "ui.tab") "Posts") (= (state-get "ui.tab") "Replies"))
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - button: Newer
                on: (state-set "ui.cmd" "newer")
                enabled_when: (and (!= (state-get "ui.busy") "1") (> (int (state-get "tab.offset")) 0))
              - button: Older
                on: (state-set "ui.cmd" "older")
                enabled_when: (and (!= (state-get "ui.busy") "1") (= (state-get "tab.more") "1"))
              - text: ""
                bind: tab.page
                color: [0.6, 0.6, 0.6]
      # Balances: the SCRIP balance and what it is worth. Six rows, as the lists take.
      - type: group
        visible_when: (= (state-get "ui.tab") "Balances")
        children:
          - type: group
            layout: {kind: grid, col_widths: [72, auto]}
            children:
              - text: ""
                bind: scrip.symbol
              - text: ""
                bind: scrip.balance
              - text: "Value"
              - text: ""
                bind: scrip.value
          - text: " "
          - text: " "
          - text: " "
          - text: " "
      # Settings: your content filter (GET and PUT /social/settings/read-level). The feeds leave
      # out posts scored below the level picked, a post's score being its likes less its
      # dislikes; your own posts and promoted ones always show. The levels run -10 to 20, as the
      # web app's slider does. Six rows, as the lists take.
      - type: group
        visible_when: (= (state-get "ui.tab") "Settings")
        children:
          - text: ""
            bind: set.head
          - combo: Hide below
            bind: set.level
            options: ["-10  show everything", "-5  hide flagged", "-3  hide flagged (default)",
                      "-1  hide flagged", "0  neutral and up", "1  well received only",
                      "3  well received only", "5  well received only", "10  well received only",
                      "20  only top-rated"]
            values: [-10, -5, -3, -1, 0, 1, 3, 5, 10, 20]
            on: (state-set "ui.cmd" "read-level")
            visible_when: (= (state-get "set.v_level") "1")
          - text: ""
            bind: set.note
            color: [0.6, 0.6, 0.6]
          - text: "Your own posts, and promoted ones, always show."
            visible_when: (= (state-get "set.v_level") "1")
            color: [0.6, 0.6, 0.6]
          - text: " "
          # Your email address, and whether it is verified, as the web app's Settings has it.
          # Until it is: Send code (POST /email/verify/send) emails a code, which Verify sends
          # back (POST /email/verify). A verified address lets the site turn on the emailed
          # second step at sign-in, and reach you.
          - type: group
            visible_when: (= (state-get "set.v_email") "1")
            children:
              - separator
              - text: ""
                bind: set.email_line
              - type: group
                layout: {kind: horizontal}
                visible_when: (= (state-get "set.v_verify") "1")
                children:
                  - button: Send code
                    on: (state-set "ui.cmd" "email-send")
                    tooltip: Email a code to this address
                  - text: "  "
                  - input_text: Code
                    bind: set.email_code
                  - button: Verify
                    on: (state-set "ui.cmd" "email-verify")
              - text: ""
                bind: set.email_note
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "set.email_note") "")

  details_window:
    window: Details
    id: details
    closable: true
    pos: [640, 32]
    visible_when: (and (= (state-get "ui.screen") "profile") (= (state-get "prof.self") "1")
                       (not (has? "term")))
    children:
      - text: "Handle"
        bind: session.me.handle
      - text: "Name"
        bind: session.me.name
      - text: "Email"
        bind: session.me.email
      - text: "Email verified"
        bind: session.me.email_verified
      - text: "Two-step sign-in"
        bind: session.me.two_factor
      - text: "Presence"
        bind: session.me.presence
      - text: "Session"
        bind: '(if (has? "net.auth.persist") "kept on this device" "until you quit")'
      - separator
      - text: "About"
      - text: ""
        bind: '(if (= (state-get "session.me.about") "") "-" (state-get "session.me.about"))'
      - separator
      - text: "Pictures (on this instance)"
      - text: "Avatar"
        bind: '(if (= (state-get "session.me.avatar_url") "") "-" (string.replace (state-get "session.me.avatar_url") (state-get "session.origin") ""))'
      - text: "Header"
        bind: '(if (= (state-get "session.me.header_url") "") "-" (string.replace (state-get "session.me.header_url") (state-get "session.origin") ""))'
      - text: "Card"
        bind: '(if (= (state-get "session.me.card_url") "") "-" (string.replace (state-get "session.me.card_url") (state-get "session.origin") ""))'
      - text: "Background"
        bind: '(if (= (state-get "session.me.bg_url") "") "-" (string.replace (state-get "session.me.bg_url") (state-get "session.origin") ""))'
      - separator
      - text: "Groups"
        bind: session.me.groups
      - type: group
        repeat: (state-get "session.me.groups")
        children:
          - text: ""
            bind: session.me.groups.{i}

# The profile's functions: the card, the tabs, the balances, your settings, and loading an account.
# nicotina.ari's on_tick calls them; they were defined inside it until 2026-11.
functions: |
  ;; What a profile view shows of an account (GET /user/ for yours, /user/profile/{id} for
  ;; anyone's). bar is how many columns its action bar's buttons take.
  (defun profile-of (p bar)
    (let ((user (text (opt p "username" "")))
          (name (text (opt p "name" ""))))
      (begin
        ;; The badges, as the web app shows them beside the name: an administrator, the
        ;; account's emblems, then its presence (txwtf's raw status) and a disabled account.
        (set badges (list))
        (if (opt p "is_admin" nil) (set badges (append badges "admin")))
        (for e (opt p "emblems" (list))
          (set badges (append badges (text (opt e "name" (opt e "emblem_type" "emblem"))))))
        (if (!= (text (opt p "status" "")) "") (set badges (append badges (text (opt p "status" "")))))
        (if (off? p "enabled") (set badges (append badges "disabled")))
        ;; The counts row: where they last signed in from, joined, posts, views.
        (set stats (list))
        (if (!= (text (opt p "last_login_country" "")) "")
          (set stats (append stats (text (opt p "last_login_country" "")))))
        (if (!= (text (opt p "created_time" "")) "")
          (set stats (append stats (str-concat "Joined "
                                               (string.substring (text (opt p "created_time" "")) 0 10)))))
        (set stats (append stats (str-concat (text (opt p "post_count" 0)) " posts")))
        (set stats (append stats (str-concat (text (opt p "view_count" 0)) " views")))
        (set groups (collections.map (opt p "groups" (list)) (lambda (g) (text (opt g "group_name" "")))))
        (dict "id" (opt p "id" 0)
                "username" user
                "handle" (handle user)
                "header" (header (handle user) name)
                "name" name
                "badges" (if (= (length badges) 0) " " (clip (string.join badges " · ") (CARD)))
                "stats" (clip (string.join stats " · ") (CARD))
                "about" (one-line (opt p "description" ""))
                "about_short" (clip (one-line (opt p "description" "")) (CARD))
                "presence" (text (opt p "status" "-"))
                ;; A brokered account's local email is a placeholder in .invalid; its real
                ;; address is its home instance's.
                "email" (let ((e (text (opt p "email" ""))))
                          (if (string.ends-with e ".invalid") "-" e))
                "email_verified" (if (opt p "email_verified" nil) "yes" "no")
                "two_factor" (if (opt p "login_2fa_email_enabled" nil) "on" "off")
                "avatar_url" (picture-url (opt p "avatar_url" nil))
                "header_url" (picture-url (opt p "header_image_url" nil))
                "card_url" (picture-url (opt p "card_image_url" nil))
                ;; what the image: slots show: the pictures, never a video
                "avatar_pic" (picture-only (picture-url (opt p "avatar_url" nil)))
                "header_pic" (picture-only (picture-url (opt p "header_image_url" nil)))
                "card_pic" (picture-only (picture-url (opt p "card_image_url" nil)))
                "bg_url" (picture-url (opt p "profile_bg_url" nil))
                "bg_pic" (picture-only (picture-url (opt p "profile_bg_url" nil)))
                "avatar_box" (avatar-box (initials (if (= name "") user name)))
                ;; Beside the action bar's buttons (padded to their column in a terminal)
                "groups_line" (col-pad (if (= (length groups) 0) " "
                                         (str-concat "Groups: " (string.join groups ", ")))
                                       (- (WIDE) bar))
                "groups" groups))))
  ;; Yours: kept in me.* (the Details window, the sign-in form after signing out), and shown
  ;; in the profile view as prof.*. [ Refresh ][ Sign out ] take 23 columns, and an
  ;; administrator's [ Admin ] 9 more. Whether you are one is ui.admin (the Admin view's way
  ;; in, and main.ari's menu).
  (defun show-profile (p)
    (let ((admin (if (opt p "is_admin" nil) true nil)))
      (let ((d (profile-of p (if admin 32 23))))
        (begin
          (state-set "login.username" (text (opt p "username" "")))
          (state-set "ui.admin" (if admin "1" ""))
          (state-set-tree "session.me" (collections.dict-merge (nic-account-of "session" p) d))
          d))))
  (defun show-balance (b)
    (state-set-tree "scrip"
      (dict "symbol" (opt b "symbol" "SCRIP")
            "balance" (plain-number (opt b "balance" "0"))
            "value" (dollars (opt b "cents_equivalent" 0)))))

  ;; A tab's page: five rows, always, so the window keeps its height. Each row is a post's
  ;; date, its text on one line, and its counts, then Open ([ Open ] takes 8 columns).
  (defun post-row (q)
    (let ((counts (str-concat "  ↩" (text (opt q "reply_count" 0))
                              " ♥" (text (opt q "reaction_count" 0))))
          (body (one-line (opt q "content" ""))))
      (begin
        (if (= body "")
          (set body (if (> (length (opt q "attachments" (list))) 0) "(attachment)" "(no text)")))
        (dict "id" (text (opt q "id" ""))
              "line" (str-concat (string.substring (text (opt q "created_at" "")) 0 10) "  "
                                 (pad body (- (WIDE) 21 (string.length counts))) counts " ")))))
  (defun show-rows (rows)
    (begin
      (while (< (length rows) (PAGE)) (set rows (append rows (dict "id" "" "line" " "))))
      (state-set-tree "tab.rows" rows)))
  ;; In a window the tab's posts are cards (ui/card.ari's card_list over tab.items); a
  ;; terminal keeps the rows, a page of which fits 80x24.
  ;; None in a terminal, and none on the Balances tab: the list is shown as it is.
  (defun show-cards (posts)
    (state-set-tree "tab.items" (if (cap "term") (list) (collections.map posts feed-card))))
  (defun note-row (s) (dict "id" "" "line" s))
  ;; Your content filter (the Settings tab): GET /social/settings/read-level. A post whose
  ;; score, its likes less its dislikes, is below your level is left out of your feeds
  ;; (txwtf keeps your own posts and promoted ones in). ui/home.ari offers ten levels, -10
  ;; to 20 as the web app's slider goes; one set elsewhere is named in the note.
  (defun level-name (v)
    (if (<= v -10) "show everything"
      (if (< v 0) "hide flagged"
        (if (= v 0) "neutral and up"
          (if (< v 20) "well received only" "only top-rated")))))
  (defun read-level-note (v)
    (str-concat "Hiding posts scored below " (text v) " (" (level-name v) ")"
                (if (= v -3) ", the default." ".")))
  (defun load-read-level ()
    (let ((r (get-authed "/social/settings/read-level")))
      (if (ok? r)
        (let ((v (int (opt (reply-json r) "read_level" -3))))
          (begin
            (state-set "set.level" v)
            (state-set "set.v_level" "1")
            (state-set "set.head" "Your content filter: a post's score is its likes less its dislikes.")
            (state-set "set.note" (read-level-note v))
            true))
        (begin
          (state-set "set.v_level" "")
          (state-set "set.head" "")
          (if (or (= (status r) 404) (= (status r) 405))
            (begin (state-set "set.note" "This server has no content filter.") true)
            (begin
              (state-set "set.note" "Couldn't load your content filter.")
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your content filter (HTTP "
                                    (str (status r)) ")."))))
              nil))))))
  ;; Your email address on the Settings tab (session.me.email, session.me.email_verified: GET /user/), and
  ;; whether Send code and Verify are offered: only until it is verified, and never for a
  ;; brokered account's placeholder address ("-").
  (defun email-settings ()
    (let ((e (sget "session.me.email")) (ok (= (sget "session.me.email_verified") "yes")))
      (begin
        (state-set "set.v_email" (if (or (= e "") (= e "-") (!= (sget "prof.self") "1")) "" "1"))
        (state-set "set.v_verify" (if ok "" "1"))
        (state-set "set.email_line"
          (clip (str-concat "Email: " e (if ok "  · verified" "  · not verified yet")) (WIDE))))))
  ;; The tab ui.tab names, from tab.offset: Posts asks for a page of five; Replies, as the
  ;; web app does, asks for twenty posts and replies together and keeps the replies.
  (defun load-tab ()
    (let ((tab (state-get "ui.tab"))
          (off (int (state-get "tab.offset"))))
      (if (= tab "Balances")
        (begin (show-cards (list)) (state-set "tab.empty" "") true)
      (if (= tab "Settings")
        (begin (show-cards (list)) (state-set "tab.empty" "") (email-settings) (load-read-level))
        (let ((r (get-authed (str-concat "/social/timeline/user/" (text (state-get "prof.id"))
                                         (if (= tab "Posts")
                                           (str-concat "?include_replies=false&limit=" (text (PAGE)))
                                           "?include_replies=true&limit=20")
                                         "&offset=" (text off)))))
          (if (ok? r)
            (let ((posts (opt (reply-json r) "posts" (list))))
              (begin
                (if (= tab "Replies")
                  (set posts (collections.filter posts
                               (lambda (q) (!= (type-of (opt q "reply_to_id" nil)) "nil")))))
                (if (> (length posts) (PAGE)) (set posts (slice posts 0 (PAGE))))
                (show-rows (if (= (length posts) 0)
                             (list (note-row (if (= tab "Posts") "No posts yet." "No replies yet.")))
                             (collections.map posts post-row)))
                (show-cards posts)
                (state-set "tab.empty" (if (= (length posts) 0)
                                         (if (= tab "Posts") "No posts yet." "No replies yet.")
                                         ""))
                (state-set "tab.more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                (state-set "tab.page"
                  (if (and (= off 0) (= (state-get "tab.more") "")) ""
                    (str-concat "  Page " (text (+ 1 (int (/ off (if (= tab "Posts") (PAGE) 20))))))))
                true))
            (begin
              (show-rows (list (note-row (str-concat "Couldn't load the " (string.lower tab) "."))))
              (show-cards (list))
              (state-set "tab.empty" (str-concat "Couldn't load the " (string.lower tab) "."))
              (state-set "tab.more" "")
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load the " (string.lower tab) " (HTTP "
                                    (str (status r)) ")."))))
              nil)))))))

  ;; Who is signed in: GET /user/. True when it came back. With own, the profile view shows
  ;; it too.
  (defun load-me-into (own)
    (let ((r (get-authed "/user/")))
      (if (ok? r)
        (let ((d (show-profile (reply-json r))))
          (begin
            (if own
              (state-set-tree "prof"
                (collections.dict-merge d (dict "self" "1" "following" "" "bg_pic_shown" ""))))
            true))
        (begin
          (if (session-over? r) (session-over)
            (if (= (status r) 0) (unreachable r)
              (fail (str-concat "Couldn't load your profile (HTTP " (str (status r)) ")."))))
          nil))))
  (defun load-me () (load-me-into nil))
  ;; Someone else's profile: GET /user/profile/{id}, and whether you follow them. Their tab
  ;; can't be Balances. [ Unfollow ][ Message ] take 23 columns.
  (defun load-user (id)
    (let ((r (get-authed (str-concat "/user/profile/" (text id)))))
      (if (ok? r)
        (let ((d (profile-of (reply-json r) 23))
              (f (get-authed (str-concat "/social/follow/check/" (text id)))))
          (begin
            (state-set-tree "prof"
              (collections.dict-merge d (dict "self" ""
                                              "following" (if (and (ok? f) (opt (reply-json f) "is_following" nil)) "1" "")
                                              "bg_pic_shown" "")))
            (if (or (= (state-get "ui.tab") "Balances") (= (state-get "ui.tab") "Settings"))
              (state-set "ui.tab" "Posts"))
            (state-set "tab.offset" 0)
            (load-tab)))
        (begin
          (if (session-over? r) (session-over)
            (if (= (status r) 0) (unreachable r)
              (fail (str-concat "Couldn't load that profile (HTTP " (str (status r)) ")."))))
          nil))))
  ;; The rest of your profile: the balance, then the tab's first page.
  (defun load-profile ()
    (let ((b (get-authed "/billing/scrip/balance")))
      (if (ok? b)
        (begin
          (show-balance (reply-json b))
          (state-set "tab.offset" 0)
          (load-tab))
        (begin
          (state-set-tree "scrip" (dict "symbol" "SCRIP" "balance" "unavailable" "value" "-"))
          (if (session-over? b) (session-over)
            (if (= (status b) 0) (unreachable b)
              (fail (str-concat "The SCRIP balance isn't available (HTTP "
                                (str (status b)) ")."))))
          nil))))
