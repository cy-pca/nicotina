# The rest of the TX.WTF window's views (ui/app.ari): the hashtags, your notifications, search,
# a new post, and the viewer. Each list is rows of text with an Open button: a button's label is
# fixed in a document, so the row's text says what Open goes to.

units:
  # Every hashtag, by how many posts name it (GET /social/tags). Open shows its posts.
  tags_view:
    type: group
    children:
      - text: ""
        bind: tags.head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "tags.rows")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: tags.rows.{i}.line
              - button: Open
                on: (begin (state-set "tag.want" (state-get "tags.rows.{i}.name")) (state-set "ui.cmd" "tag"))
      - button: More tags
        on: (state-set "ui.cmd" "more-tags")
        visible_when: (= (state-get "tags.more") "1")

  # Your notifications, newest first (GET /notifications/): what happened, and when. Open goes to
  # the post or the person it is about. Opening the view marks them read, as the web app does.
  alerts_view:
    type: group
    children:
      - text: ""
        bind: alerts.head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "alerts.rows")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: alerts.rows.{i}.line
              - button: Open
                on: (begin (state-set "alert.kind" (state-get "alerts.rows.{i}.kind")) (state-set "alert.target" (state-get "alerts.rows.{i}.target")) (state-set "ui.cmd" "alert-open"))
                visible_when: (!= (state-get "alerts.rows.{i}.target") "")
          - text: ""
            bind: alerts.rows.{i}.at
            color: [0.6, 0.6, 0.6]

  # Posts, people and hashtags (GET /search/search?q=). Enter in the field, or Search, asks.
  search_view:
    type: group
    children:
      - input_text: Find
        bind: search.q
        on: (state-set "ui.cmd" "search")
        autofocus: true
      - button: Search
        on: (state-set "ui.cmd" "search")
      - text: ""
        bind: search.note
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "search.rows")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: search.rows.{i}.line
              - button: Open
                on: (begin (state-set "hit.kind" (state-get "search.rows.{i}.kind")) (state-set "hit.id" (state-get "search.rows.{i}.id")) (state-set "hit.tag" (state-get "search.rows.{i}.tag")) (state-set "ui.cmd" "hit-open"))
          - text: ""
            bind: search.rows.{i}.snippet
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "search.rows.{i}.snippet") "")

  # A new post (POST /social/posts): who may see it, then the text. Enter posts it; Shift+Enter
  # (Alt+Enter in a terminal) starts a new line; ImGui adds a Post button. Where the host can pick
  # and upload a file (app.attach: libcvc 3.7.14), Attach adds files, each listed with a Remove,
  # and posting uploads them first, the bar showing how far; the Post beside Attach posts what is
  # written with them, or the files alone. Elsewhere a post is text only. After Attach or Remove
  # the focus is back in the text, as the reply box takes it (feed.ari): the controller flips
  # compose.focus, and the copy of the field that appears has autofocus.
  compose_view:
    type: group
    children:
      - radio_row: Who sees it
        bind: compose.visibility
        options: [Public, Followers, Private]
      - message_input: Post
        bind: compose.text
        hint: What's happening? (Enter posts it)
        max_length: 4096
        max_lines: 8
        send: Post
        autofocus: true
        on: (begin (state-set "compose.send" (get-attr event "text")) (state-set "ui.cmd" "post"))
        visible_when: (!= (state-get "compose.focus") "b")
      - message_input: Post
        bind: compose.text
        hint: What's happening? (Enter posts it)
        max_length: 4096
        max_lines: 8
        send: Post
        autofocus: true
        on: (begin (state-set "compose.send" (get-attr event "text")) (state-set "ui.cmd" "post"))
        visible_when: (= (state-get "compose.focus") "b")
      - type: group
        id: c_files
        visible_when: (= (state-get "app.attach") "1")
        children:
          - type: group
            repeat: (state-get "compose.files")
            layout: {kind: horizontal}
            children:
              - button: Remove
                on: (begin (state-set "compose.drop" "{i}") (state-set "ui.cmd" "detach"))
                disabled_when: (= (state-get "compose.uploading") "1")
              - text: ""
                bind: compose.files.{i}.label
          - type: group
            layout: {kind: horizontal}
            children:
              - button: Attach
                on: (state-set "ui.cmd" "attach")
                disabled_when: (= (state-get "compose.uploading") "1")
                tooltip: Pick files to attach to the post
              - button: Post
                on: (begin (state-set "compose.send" (state-get "compose.text")) (state-set "ui.cmd" "post"))
                visible_when: (> (int (state-get "compose.files")) 0)
                disabled_when: (= (state-get "compose.uploading") "1")
          - progress: ""
            bind: compose.progress
            visible_when: (= (state-get "compose.uploading") "1")
      - text: "Text only: this host can't attach files."
        visible_when: (!= (state-get "app.attach") "1")
        color: [0.6, 0.6, 0.6]
      - text: ""
        bind: compose.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "compose.note") "")

  # A post's pictures and videos, one at a time, as wide as the window at their own shape (at most
  # 720 px tall) where the host measures the line (image.fill), else in a 592 x 720 px box (592 x
  # 320, 74 x 10 cells, in a terminal). Where the host can (fullscreen: libcvc 3.7.13), a picture
  # fills the screen when clicked and a video has a Full screen button; Esc comes back. Prev and
  # Next step through them; Back closes the viewer. A video here has its controls (the feed's and
  # the post's have none), loops, and starts with its sound on: opening it was the click a browser
  # wants first.
  viewer_view:
    type: group
    children:
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Prev
            on: (state-set "ui.cmd" "view-prev")
          - button: Next
            on: (state-set "ui.cmd" "view-next")
          - text: ""
            bind: viewer.where
            color: [0.6, 0.6, 0.6]
      - image: ""
        bind: viewer.url
        fullscreen: true
        size: "100%"
        max_height: 720
        visible_when: (= (state-get "viewer.v.v_img_fill") "1")
      - image: ""
        bind: viewer.url
        fullscreen: true
        size: [592, 720]
        fit: contain
        visible_when: (= (state-get "viewer.v.v_img_w") "1")
      - image: ""
        bind: viewer.url
        fullscreen: true
        size: [592, 320]
        fit: contain
        visible_when: (= (state-get "viewer.v.v_img_t") "1")
      - video: video
        src: (state-get "viewer.url")
        size: "100%"
        max_height: 720
        autoplay: true
        loop: true
        bind: viewer.player
        fullscreen: true
        visible_when: (= (state-get "viewer.v.v_vid_fill") "1")
      - video: video
        src: (state-get "viewer.url")
        size: [592, 720]
        fit: contain
        autoplay: true
        loop: true
        bind: viewer.player
        fullscreen: true
        visible_when: (= (state-get "viewer.v.v_vid_w") "1")
      - video: video
        src: (state-get "viewer.url")
        size: [592, 333]
        fit: contain
        autoplay: true
        loop: true
        bind: viewer.player
        fullscreen: true
        visible_when: (= (state-get "viewer.v.v_vid_t") "1")
      - audio: recording
        src: (state-get "viewer.url")
        bind: viewer.player
        visible_when: (= (state-get "viewer.v.v_aud") "1")
      - text: ""
        bind: viewer.row
        color: [0.45, 0.75, 0.85]
