# A post as a card, a list of cards, and a post's pictures and videos: components the views share
# (ui/feed.ari's feed and hashtag views, ui/home.ari's profile, the post view). Each takes args,
# so one card serves any list:
#
#   - include: card_list           # every card of LIST, a repeat over (state-get LIST)
#     args: {list: tab.items}
#   - include: media_grid          # the pictures and videos of the post at P
#     args: {p: post, pid: post.pid}
#
# A card's state is what main.ari's feed-card makes of a post (LIST.{i}.*), with the show/hide
# decisions card-flags makes for it (v_*). Like and Repost name the card by its list and index
# (act.list, act.i), so the controller acts on the right one whichever view shows it.

units:
  media_grid:
    args: {p: post, pid: post.pid}
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "{p}.gn") "1")
        children:
          - image: ""
            bind: "{p}.g0_url"
            size: "100%"
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "{p}.g0_kind") "image")
          - video: video
            src: (state-get "{p}.g0_url")
            size: "100%"
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: "{p}.g0_player"
            on_click: (if (has? "ui.group_click") (state-set "{p}.g0_player.playing" (if (= (state-get "{p}.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "{p}.g0_kind") "video")
      # Two side by side, three in a row, four two by two: each tile fills its column.
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "{p}.gn") "2")
        children:
          - include: media_tile_0
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_1
            args: {p: "{p}", pid: "{pid}"}
      - type: group
        layout: {kind: grid, col_widths: ["34%", "33%", "33%"]}
        visible_when: (= (state-get "{p}.gn") "3")
        children:
          - include: media_tile_0
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_1
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_2
            args: {p: "{p}", pid: "{pid}"}
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "{p}.gn") "4")
        children:
          - include: media_tile_0
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_1
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_2
            args: {p: "{p}", pid: "{pid}"}
          - include: media_tile_3
            args: {p: "{p}", pid: "{pid}"}
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: "{p}.gmore_line"
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "{p}.v_gmore") "1")

  media_tile_0:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g0_url"
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "image")
      - video: video
        src: (state-get "{p}.g0_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g0_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "video")

  media_tile_1:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g1_url"
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "image")
      - video: video
        src: (state-get "{p}.g1_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g1_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "video")

  media_tile_2:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g2_url"
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "image")
      - video: video
        src: (state-get "{p}.g2_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g2_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "video")

  media_tile_3:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g3_url"
        size: ["100%", 180]
        fit: cover
        badge: (state-get "{p}.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g3_kind") "image")
      - video: video
        src: (state-get "{p}.g3_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "{p}.gmore")
        bind: "{p}.g3_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g3_kind") "video")

  media_fgrid:
    args: {p: post, pid: post.pid}
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "{p}.gn") "1")
        children:
          - image: ""
            bind: "{p}.g0_url"
            size: 592
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "{p}.g0_kind") "image")
          - video: video
            src: (state-get "{p}.g0_url")
            size: 592
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: "{p}.g0_player"
            on_click: (if (has? "ui.group_click") (state-set "{p}.g0_player.playing" (if (= (state-get "{p}.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "{p}.g0_kind") "video")
      # Two side by side, three in a row, four two by two: 592 px across, as the line is.
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "{p}.gn") "2")
        children:
          - include: media_ftile_0_292
            args: {p: "{p}", pid: "{pid}"}
          - include: media_ftile_1_292
            args: {p: "{p}", pid: "{pid}"}
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "{p}.gn") "3")
        children:
          - include: media_ftile_0_194
            args: {p: "{p}", pid: "{pid}"}
          - include: media_ftile_1_194
            args: {p: "{p}", pid: "{pid}"}
          - include: media_ftile_2_194
            args: {p: "{p}", pid: "{pid}"}
      - type: group
        visible_when: (= (state-get "{p}.gn") "4")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - include: media_ftile_0_292
                args: {p: "{p}", pid: "{pid}"}
              - include: media_ftile_1_292
                args: {p: "{p}", pid: "{pid}"}
          - type: group
            layout: {kind: horizontal}
            children:
              - include: media_ftile_2_292
                args: {p: "{p}", pid: "{pid}"}
              - include: media_ftile_3_292
                args: {p: "{p}", pid: "{pid}"}
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: "{p}.gmore_line"
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "{p}.v_gmore") "1")

  media_ftile_0_292:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g0_url"
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "image")
      - video: video
        src: (state-get "{p}.g0_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g0_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "video")

  media_ftile_1_292:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g1_url"
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "image")
      - video: video
        src: (state-get "{p}.g1_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g1_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "video")

  media_ftile_2_292:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g2_url"
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "image")
      - video: video
        src: (state-get "{p}.g2_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g2_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "video")

  media_ftile_3_292:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g3_url"
        size: [292, 180]
        fit: cover
        badge: (state-get "{p}.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g3_kind") "image")
      - video: video
        src: (state-get "{p}.g3_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "{p}.gmore")
        bind: "{p}.g3_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g3_kind") "video")

  media_ftile_0_194:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g0_url"
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "image")
      - video: video
        src: (state-get "{p}.g0_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g0_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g0_kind") "video")

  media_ftile_1_194:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g1_url"
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "image")
      - video: video
        src: (state-get "{p}.g1_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g1_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g1_kind") "video")

  media_ftile_2_194:
    args: {p: post, pid: post.pid}
    type: group
    children:
      - image: ""
        bind: "{p}.g2_url"
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "image")
      - video: video
        src: (state-get "{p}.g2_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{p}.g2_player"
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "{pid}")) (state-set "view.i" (state-get "{p}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "{p}.g2_kind") "video")

  post_card:
    args: {list: feed.items}
    type: group
    layout: {kind: grid, col_widths: ["100%"], borders: {show: outer}}
    children:
      - text: ""
        bind: "{list}.{i}.note"
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "{list}.{i}.note") "")
      # The author's avatar, round, 32 px (4 x 2 cells), or the initials; then who, and when.
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: "{list}.{i}.avatar_url"
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (= (state-get "{list}.{i}.v_avpic") "1")
          - text: ""
            bind: "{list}.{i}.avatar"
            color: [0.55, 0.6, 0.7]
            visible_when: (= (state-get "{list}.{i}.v_avtxt") "1")
          - text: " "
          - type: group
            children:
              - text: ""
                bind: "{list}.{i}.head"
              - text: ""
                bind: "{list}.{i}.at"
                color: [0.6, 0.6, 0.6]
      - text: ""
        bind: "{list}.{i}.l0"
        emoji: "{list}.{i}.emoji"
        visible_when: (!= (state-get "{list}.{i}.l0") "")
      - text: ""
        bind: "{list}.{i}.l1"
        emoji: "{list}.{i}.emoji"
        visible_when: (!= (state-get "{list}.{i}.l1") "")
      - text: ""
        bind: "{list}.{i}.l2"
        emoji: "{list}.{i}.emoji"
        visible_when: (!= (state-get "{list}.{i}.l2") "")
      # Its hashtags: text in a terminal, a row to click elsewhere.
      - text: ""
        bind: "{list}.{i}.tagline"
        color: [0.45, 0.65, 0.95]
        visible_when: (= (state-get "{list}.{i}.v_tagline") "1")
      - radio_row: Tags
        bind: "{list}.{i}.tag_pick"
        options: (string.split (state-get "{list}.{i}.tags") "|")
        on: (begin (state-set "tag.want" (state-get "{list}.{i}.tag_pick")) (state-set "ui.cmd" "tag"))
        visible_when: (= (state-get "{list}.{i}.v_tagrow") "1")
      # Where a click on a group is its own, outside a terminal, each hashtag is a chip to click.
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "{list}.{i}.v_chips") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t0")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t0") "")
            children:
              - text: ""
                bind: "{list}.{i}.t0"
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t1")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t1") "")
            children:
              - text: ""
                bind: "{list}.{i}.t1"
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t2")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t2") "")
            children:
              - text: ""
                bind: "{list}.{i}.t2"
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t3")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t3") "")
            children:
              - text: ""
                bind: "{list}.{i}.t3"
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t4")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t4") "")
            children:
              - text: ""
                bind: "{list}.{i}.t4"
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "{list}.{i}.t5")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "{list}.{i}.t5") "")
            children:
              - text: ""
                bind: "{list}.{i}.t5"
                color: [0.45, 0.65, 0.95]
          - text: ""
            bind: "{list}.{i}.tmore"
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "{list}.{i}.tmore") "")
      # Its pictures and videos: one as wide as the card at its own shape, two or more a grid
      # (media_grid where the host measures the line, media_fgrid at fixed sizes elsewhere outside a
      # terminal). A terminal shows the first picture (192 x 112 px, 24 x 7 cells) and the first
      # video.
      - type: group
        visible_when: (= (state-get "{list}.{i}.v_grid") "1")
        children:
          - include: media_grid
            args: {p: "{list}.{i}", pid: "{list}.{i}.pid"}
      - type: group
        visible_when: (= (state-get "{list}.{i}.v_fgrid") "1")
        children:
          - include: media_fgrid
            args: {p: "{list}.{i}", pid: "{list}.{i}.pid"}
      - image: ""
        bind: "{list}.{i}.pic"
        size: [192, 112]
        fit: contain
        visible_when: (= (state-get "{list}.{i}.v_pic_t") "1")
      - video: video
        src: (state-get "{list}.{i}.vid_url")
        size: [192, 108]
        fit: contain
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: "{list}.{i}.player"
        visible_when: (= (state-get "{list}.{i}.v_vid_t") "1")
      # The first recording, with its controls, where the host has a player (media.player:
      # ari-media and arigl; transfix/libcvc#935).
      - audio: recording
        src: (state-get "{list}.{i}.au_url")
        bind: "{list}.{i}.recording"
        visible_when: (= (state-get "{list}.{i}.v_audio") "1")
      # The attachments: two rows at most, and how many more there are. View, on the first row
      # of a post with something to view, opens the viewer. Where the grid shows every attachment
      # (pictures and videos only) there are no rows, and View is among the buttons below.
      - type: group
        visible_when: (= (state-get "{list}.{i}.v_rows") "1")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: "{list}.{i}.m0"
                color: [0.45, 0.75, 0.85]
              - button: View
                on: (begin (state-set "view.post" (state-get "{list}.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
                visible_when: (= (state-get "{list}.{i}.has_media") "1")
          - text: ""
            bind: "{list}.{i}.m1"
            color: [0.45, 0.75, 0.85]
            visible_when: (!= (state-get "{list}.{i}.m1") "")
          - text: ""
            bind: "{list}.{i}.mmore"
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "{list}.{i}.mmore") "")
      # Where a click on a group is its own, outside a terminal: the counts are icons to press,
      # reply (the post, its reply box focused), repost and like, green and red once you have;
      # the card itself opens the post.
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "{list}.{i}.v_click") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "post.want" (state-get "{list}.{i}.pid")) (state-set "post.focus_reply" "1") (state-set "ui.cmd" "open")))
            hover: highlight
            children:
              - text: ""
                bind: "{list}.{i}.c_reply"
                color: [0.6, 0.6, 0.6]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "act.list" "{list}") (state-set "act.i" "{i}") (state-set "ui.cmd" "repost")))
            hover: highlight
            children:
              - text: ""
                bind: "{list}.{i}.c_repost"
                color: [0.4, 0.8, 0.5]
                visible_when: (= (state-get "{list}.{i}.reposted") "1")
              - text: ""
                bind: "{list}.{i}.c_repost"
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "{list}.{i}.reposted") "1")
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "act.list" "{list}") (state-set "act.i" "{i}") (state-set "ui.cmd" "like")))
            hover: highlight
            children:
              - text: ""
                bind: "{list}.{i}.c_like"
                color: [0.95, 0.35, 0.4]
                visible_when: (= (state-get "{list}.{i}.liked") "1")
              - text: ""
                bind: "{list}.{i}.c_like"
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "{list}.{i}.liked") "1")
          - text: ""
            bind: "{list}.{i}.c_views"
            color: [0.6, 0.6, 0.6]
          - button: View
            on: (begin (state-set "view.post" (state-get "{list}.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
            visible_when: (= (state-get "{list}.{i}.v_viewbtn") "1")
      # Elsewhere the counts, then the buttons. Never disabled, and never hidden once shown: a
      # terminal that loses the focused widget scrolls back to the top. The controller takes one
      # command at a time, so a press while busy waits its turn.
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "{list}.{i}.v_btns") "1")
        children:
          - text: ""
            bind: "{list}.{i}.counts"
            color: [0.6, 0.6, 0.6]
          - button: Open
            on: (begin (state-set "post.want" (state-get "{list}.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - button: Reply
            on: (begin (state-set "post.want" (state-get "{list}.{i}.pid")) (state-set "post.focus_reply" "1") (state-set "ui.cmd" "open"))
          - button: Like
            on: (begin (state-set "act.list" "{list}") (state-set "act.i" "{i}") (state-set "ui.cmd" "like"))
          - button: Repost
            on: (begin (state-set "act.list" "{list}") (state-set "act.i" "{i}") (state-set "ui.cmd" "repost"))
          - button: View
            on: (begin (state-set "view.post" (state-get "{list}.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
            visible_when: (= (state-get "{list}.{i}.v_viewbtn") "1")

  card_list:
    args: {list: feed.items}
    type: group
    repeat: (state-get "{list}")
    children:
      # Outside a terminal, where a click on a group is its own (ui.group_click), the whole
      # card opens its post; a click on its pictures, icons or hashtags is theirs.
      - type: group
        visible_when: (= (state-get "{list}.{i}.v_click") "1")
        on_click: (if (has? "ui.group_click") (begin (state-set "post.want" (state-get "{list}.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open")))
        children:
          - include: post_card
            args: {list: "{list}"}
      - type: group
        visible_when: (= (state-get "{list}.{i}.v_btns") "1")
        children:
          - include: post_card
            args: {list: "{list}"}

