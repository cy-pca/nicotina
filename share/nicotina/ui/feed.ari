# The feed, and one post in full: two of the views in the main window (ui/app.ari). The card,
# the list of cards and the media grid are components in ui/card.ari, which a profile's posts use
# too; what follows describes them.
#
# feed_view is the view after signing in, as the web app's home is: the posts of the people you
# follow (or everyone's, or your friends'), newest first, each a card. The same view shows one
# hashtag's posts (feed.source "tag"). A card is a bordered group: a header (the author's avatar,
# name, handle and time), the text (three lines at most), its hashtags, the attachments, and the
# counts with the card's buttons: Open (the whole post), Reply, Like and Repost. A post with
# pictures, video or a recording has View too (the viewer), on its first attachment's row, or
# among the buttons where the grid shows every attachment.
#
# Terminal first: the window is as wide as its cards (74 columns in a terminal, the cards' text 70)
# and at most 86% of the screen tall (21 rows in an 80x24 terminal; more in a bigger one, or a
# window). Its cards don't fit at once, so the window scrolls: a terminal keeps the focused widget
# in view, and each card's buttons are focusable, so Tab walks the feed card by card. Load more,
# at the end, fetches the next page and adds it below.
#
# Avatars and pictures show where the host can fetch a picture from a URL (image.url:
# transfix/libcvc#931); txwtf's /uploads/... and /static/... need no sign-in. Elsewhere an avatar
# is the author's initials. An attachment also has a row naming it (its kind, file name, size and
# alt text), except where the grid below shows them all. Video and audio play in the card and the
# post where the host has a player (video: and audio:); elsewhere they are rows. A video plays by
# itself, muted and looping, as the web app's feed does (a browser plays sound only after a click
# on the page, and ten cards' sound at once would be noise), with no controls: View has them, and
# a click on it pauses or plays it. A recording keeps its controls.
# Outside a terminal the pictures and videos are laid out as tx.wtf lays them out: one is the
# whole picture or video, as wide as the post at its own shape; two or more are a grid of up to
# four, "+N" on the fourth for the rest. Where the host measures the line (image.fill: ImGui,
# transfix/libcvc#1052) they fill it, and a video plays while it is in view; elsewhere the grid is
# 592 px across. A terminal shows the first picture and the first video, small. A post's emoji
# (text.emoji, transfix/libcvc#1056) come from its content_html: a custom one is drawn as its
# picture in the line (a terminal keeps its :name:), a standard one's shortcode becomes its
# character. Where the host draws rich text (text.runs, transfix/libcvc#1180) the text is read
# from content_html too: bold, italic and code, its paragraphs, and its mentions, hashtags and
# URLs links (main.ari's open-link follows one: a hashtag's posts, a profile, a post here; any
# other link is copied), each a Tab stop in a terminal. A card shows three lines of it, cut with
# an ellipsis; elsewhere a card shows its first three lines, plain.
#
# What a card or a post shows (its avatar, its picture, its player, its rows) the controller
# decides once, as it builds the card (main.ari's card-flags, post-flags and item-flags, from the
# host's capabilities, asked once at start as app.*). Each widget's visible_when reads that one
# key: a predicate runs on every frame, so it stays a single state read.
#
# Hashtags: where a click on a group is its own (ui.group_click), outside a terminal, each is a
# chip to click. Elsewhere a button's label is fixed in an Ariadne document, so a post's hashtags
# are a radio row, whose options a program computes; outside a terminal clicking one opens that
# hashtag's posts. A terminal moves a radio's choice with the arrow keys, so there the card lists
# them as text, and the post's view has the row and an Open tag button.

units:
  # The feed: Following is GET /social/timeline/home, Everyone /social/timeline/public, Friends
  # /social/timeline/friends; a hashtag's posts are GET /social/timeline/tag/{tag}.
  feed_view:
    type: group
    children:
      - radio_row: Show
        bind: feed.mode
        options: [Following, Everyone, Friends]
        on: (state-set "ui.cmd" "feed")
        visible_when: (and (!= (state-get "feed.source") "tag") (!= (state-get "app.icons") "1"))
      - radio_row: Show
        bind: feed.mode_pick
        options: ["👥 Following", "🌐 Everyone", "🤝 Friends"]
        on: (begin (state-set "feed.mode" (if (string.ends-with (state-get "feed.mode_pick") "Following") "Following" (if (string.ends-with (state-get "feed.mode_pick") "Everyone") "Everyone" "Friends"))) (state-set "ui.cmd" "feed"))
        visible_when: (and (!= (state-get "feed.source") "tag") (= (state-get "app.icons") "1"))
      - text: ""
        bind: feed.title
        color: [0.45, 0.65, 0.95]
        visible_when: (= (state-get "feed.source") "tag")
      - separator
      - text: ""
        bind: feed.empty
        visible_when: (!= (state-get "feed.empty") "")
      - include: card_list
        args: {list: feed.items}
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.empty") "")
        children:
          - button: Load more    # never disabled either; at the end it says so
            on: (state-set "ui.cmd" "more")
          - text: ""
            bind: feed.tail
            color: [0.6, 0.6, 0.6]

  # One post in full: every line of its text, every attachment, the reactions (GET
  # /social/posts/{id}, which has them; the feed doesn't), the post it replies to, its replies
  # (GET /social/posts/{id}/replies) and a box to reply in.
  post_view:
    type: group
    children:
      - text: ""
        bind: post.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "post.note") "")
      # What it replies to: a button to it, and who wrote it.
      - type: group
        layout: {kind: horizontal}
        visible_when: (!= (state-get "post.parent") "")
        children:
          - button: In reply to
            on: (begin (state-set "post.want" (state-get "post.parent")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - text: ""
            bind: post.parent_note
            color: [0.6, 0.6, 0.6]
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: post.avatar_url
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (= (state-get "post.v_avpic") "1")
          - text: ""
            bind: post.avatar
            color: [0.55, 0.6, 0.7]
            visible_when: (= (state-get "post.v_avtxt") "1")
          - text: " "
          - type: group
            children:
              - text: ""
                bind: post.head
              - text: ""
                bind: post.at
                color: [0.6, 0.6, 0.6]
      # Its text: rich text where the host draws it (text.runs), the window's text width (74
      # columns, 8 px each), its links followed as a card's are; elsewhere its lines, plain.
      - text: ""
        runs: post.runs
        emoji: post.emoji
        size: 592
        on_link: (begin (state-set "link.href" (get-attr event "href")) (state-set "ui.cmd" "link"))
        visible_when: (= (state-get "post.v_runs") "1")
      - type: group
        repeat: (state-get "post.lines")
        children:
          - text: ""
            bind: post.lines.{i}
            emoji: post.emoji
      # Its hashtags: chips to click where a click on a group is its own (outside a terminal);
      # elsewhere a radio row, clicked (outside a terminal), or picked and Open tag (in one).
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "post.v_chips") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t0")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t0") "")
            children:
              - text: ""
                bind: post.t0
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t1")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t1") "")
            children:
              - text: ""
                bind: post.t1
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t2")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t2") "")
            children:
              - text: ""
                bind: post.t2
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t3")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t3") "")
            children:
              - text: ""
                bind: post.t3
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t4")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t4") "")
            children:
              - text: ""
                bind: post.t4
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t5")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t5") "")
            children:
              - text: ""
                bind: post.t5
                color: [0.45, 0.65, 0.95]
          - text: ""
            bind: post.tmore
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "post.tmore") "")
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "post.v_tagrow") "1")
        children:
          - radio_row: Tags
            bind: post.tag_pick
            options: (string.split (state-get "post.tags") "|")
            on: (if (not (has? "term")) (begin (state-set "tag.want" (state-get "post.tag_pick")) (state-set "ui.cmd" "tag")))
          - text: "  "
            visible_when: (= (state-get "post.v_term") "1")
          - button: Open tag
            on: (begin (state-set "tag.want" (state-get "post.tag_pick")) (state-set "ui.cmd" "tag"))
            visible_when: (= (state-get "post.v_term") "1")
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto]}
        visible_when: (= (state-get "post.v_click") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "post.focus_reply" "1"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_reply
                color: [0.6, 0.6, 0.6]
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "ui.cmd" "post-repost"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_repost
                color: [0.4, 0.8, 0.5]
                visible_when: (= (state-get "post.reposted") "1")
              - text: ""
                bind: post.c_repost
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "post.reposted") "1")
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "ui.cmd" "post-like"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_like
                color: [0.95, 0.35, 0.4]
                visible_when: (= (state-get "post.liked") "1")
              - text: ""
                bind: post.c_like
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "post.liked") "1")
          - text: ""
            bind: post.c_views
            color: [0.6, 0.6, 0.6]
      - text: ""
        bind: post.counts
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "post.v_btns") "1")
      - text: ""
        bind: post.reactions
        visible_when: (!= (state-get "post.reactions") "")
      # What you can do with it. Delete is there for your own posts only.
      - type: group
        layout: {kind: horizontal}
        children:
          # Nothing here takes the focus by itself: Back, pressed again and again, walks back
          # through the views, and a post shown again mustn't catch an Enter meant for Back.
          - button: Like
            on: (state-set "ui.cmd" "post-like")
            visible_when: (= (state-get "post.v_btns") "1")
          - button: Repost
            on: (state-set "ui.cmd" "post-repost")
            visible_when: (= (state-get "post.v_btns") "1")
          - button: Author
            on: (begin (state-set "user.want" (state-get "post.author_id")) (state-set "ui.cmd" "user"))
          - button: Delete
            on: (state-set "ui.cmd" "delete")
            visible_when: (= (state-get "post.mine") "1")
      # Its address on the instance, and Copy link where the host has a clipboard
      # (clipboard-set: libcvc 3.7.13).
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Copy link
            on: (begin (clipboard-set (state-get "post.web")) (state-set "ui.cmd" "copied"))
            visible_when: (= (state-get "app.clip") "1")
          - text: ""
            bind: post.link
            color: [0.6, 0.6, 0.6]
      # Its pictures and videos, laid out as a card's are (post_grid, post_fgrid).
      - type: group
        visible_when: (= (state-get "post.v_grid") "1")
        children:
          - include: media_grid
            args: {p: post, pid: post.pid}
      - type: group
        visible_when: (= (state-get "post.v_fgrid") "1")
        children:
          - include: media_fgrid
            args: {p: post, pid: post.pid}
      # Each attachment: its row, and View, which opens the viewer at it. In a terminal its
      # picture or video follows (384 x 216 px); a recording has its player everywhere.
      - type: group
        repeat: (state-get "post.media")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: post.media.{i}.row
                color: [0.45, 0.75, 0.85]
              - button: View
                on: (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.media.{i}.vi")) (state-set "ui.cmd" "view"))
                visible_when: (= (state-get "post.media.{i}.v_view") "1")
          - image: ""
            bind: post.media.{i}.url
            size: [384, 216]
            fit: contain
            visible_when: (= (state-get "post.media.{i}.v_img_t") "1")
          - video: video
            src: (state-get "post.media.{i}.url")
            size: [384, 216]
            fit: contain
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: post.media.{i}.player
            visible_when: (= (state-get "post.media.{i}.v_vid_t") "1")
          - audio: recording
            src: (state-get "post.media.{i}.url")
            bind: post.media.{i}.player
            visible_when: (= (state-get "post.media.{i}.v_aud") "1")
      - separator
      # The replies, oldest first: who and when, two lines of each, and Open.
      - text: ""
        bind: post.replies_head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "post.replies")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: post.replies.{i}.head
              - button: Open
                on: (begin (state-set "post.want" (state-get "post.replies.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - text: ""
            runs: post.replies.{i}.runs
            emoji: post.replies.{i}.emoji
            max_lines: 2
            size: 592
            on_link: (begin (state-set "link.href" (get-attr event "href")) (state-set "ui.cmd" "link"))
            visible_when: (= (state-get "post.replies.{i}.v_runs") "1")
          - text: ""
            bind: post.replies.{i}.l0
            emoji: post.replies.{i}.emoji
            visible_when: (!= (state-get "post.replies.{i}.l0") "")
          - text: ""
            bind: post.replies.{i}.l1
            emoji: post.replies.{i}.emoji
            visible_when: (!= (state-get "post.replies.{i}.l1") "")
      - button: More replies
        on: (state-set "ui.cmd" "more-replies")
        visible_when: (= (state-get "post.replies_more") "1")
      # The reply box. Enter sends it (Shift+Enter, or Alt+Enter in a terminal, starts a new
      # line); ImGui adds a Reply button. Reply on a card opens the post with the box focused: the
      # same box, shown with autofocus (one of the two is drawn at a time).
      - message_input: Reply
        bind: post.reply_text
        hint: Write a reply (Enter sends it)
        max_length: 4096
        max_lines: 6
        send: Reply
        on: (begin (state-set "post.reply_send" (get-attr event "text")) (state-set "ui.cmd" "reply"))
        visible_when: (!= (state-get "post.focus_reply") "1")
      - message_input: Reply
        bind: post.reply_text
        hint: Write a reply (Enter sends it)
        max_length: 4096
        max_lines: 6
        send: Reply
        autofocus: true
        on: (begin (state-set "post.reply_send" (get-attr event "text")) (state-set "ui.cmd" "reply"))
        visible_when: (= (state-get "post.focus_reply") "1")
