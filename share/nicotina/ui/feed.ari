# The feed, and one post in full: two of the views in the TX.WTF window (ui/app.ari).
#
# feed_view is the view after signing in, as the web app's home is: the posts of the people you
# follow (or everyone's, or your friends'), newest first, each a card. The same view shows one
# hashtag's posts (feed.source "tag"). A card is a bordered group: a header (the author's avatar,
# name, handle and time), the text (three lines at most), its hashtags, the attachments, and the
# counts with the card's buttons: Open (the whole post), Reply, Like and Repost. A post with
# pictures, video or a recording has View too (the viewer), on its first attachment's row, or
# among the buttons where the grid shows every attachment.
#
# Terminal first: the window is as wide as its cards (74 columns in a terminal, the cards' text 70)
# and at most 86% of the screen tall (21 rows in an 80x24 terminal; more in a bigger one, or a
# window). Its cards don't fit at once, so the window scrolls: a terminal keeps the focused widget
# in view, and each card's buttons are focusable, so Tab walks the feed card by card. Load more,
# at the end, fetches the next page and adds it below.
#
# Avatars and pictures show where the host can fetch a picture from a URL (image.url:
# transfix/libcvc#931); txwtf's /uploads/... and /static/... need no sign-in. Elsewhere an avatar
# is the author's initials. An attachment also has a row naming it (its kind, file name, size and
# alt text), except where the grid below shows them all. Video and audio play in the card and the
# post where the host has a player (video: and audio:); elsewhere they are rows. A video plays by
# itself, muted and looping, as the web app's feed does (a browser plays sound only after a click
# on the page, and ten cards' sound at once would be noise), with no controls: View has them, and
# a click on it pauses or plays it. A recording keeps its controls.
# Outside a terminal the pictures and videos are laid out as tx.wtf lays them out: one is the
# whole picture or video, as wide as the post at its own shape; two or more are a grid of up to
# four, "+N" on the fourth for the rest. Where the host measures the line (image.fill: ImGui,
# transfix/libcvc#1052) they fill it, and a video plays while it is in view; elsewhere the grid is
# 592 px across. A terminal shows the first picture and the first video, small. A post's emoji (text.emoji, transfix/libcvc#1056)
# come from its content_html: a custom one is drawn as its picture in the line (a terminal keeps
# its :name:), a standard one's shortcode becomes its character.
#
# What a card or a post shows (its avatar, its picture, its player, its rows) the controller
# decides once, as it builds the card (main.ari's card-flags, post-flags and item-flags, from the
# host's capabilities, asked once at start as app.*). Each widget's visible_when reads that one
# key: a predicate runs on every frame, so it stays a single state read.
#
# Hashtags: a button's label is fixed in an Ariadne document, so a post's hashtags are a radio
# row, whose options a program computes. Outside a terminal, clicking one opens that hashtag's
# posts. A terminal moves a radio's choice with the arrow keys, so there the card lists them as
# text, and the post's view has the row and an Open tag button.

units:
  # The media grid, as tx.wtf's: a card's (card_grid, card_fgrid) and a post's (post_grid,
  # post_fgrid), from main.ari's grid-fields: gn tiles (1 to 4), each a picture or a video (g0..g3),
  # and gmore, "+N", over the fourth when there are more. One is the whole picture or video, as
  # wide as the post at its own shape. Two or more are tiles cropped to their cells, 180 px tall:
  # two side by side, three in a row, four two by two. _grid is for a host that measures the line
  # (image.fill: libcvc 3.7.13), each tile filling its column; _fgrid for one that doesn't, at
  # fixed sizes 592 px across. A video plays by itself, muted and looping, with no controls: the
  # viewer (View) has them. A click on a lone video pauses or plays it; a click on a picture, or
  # on a tile, opens the viewer at it. (Clicks need a host whose handlers see {i}: ui.group_click,
  # libcvc 3.7.13.)
  card_grid:
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "feed.items.{i}.gn") "1")
        children:
          - image: ""
            bind: feed.items.{i}.g0_url
            size: "100%"
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "feed.items.{i}.g0_kind") "image")
          - video: video
            src: (state-get "feed.items.{i}.g0_url")
            size: "100%"
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: feed.items.{i}.g0_player
            on_click: (if (has? "ui.group_click") (state-set "feed.items.{i}.g0_player.playing" (if (= (state-get "feed.items.{i}.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "feed.items.{i}.g0_kind") "video")
      # Two side by side, three in a row, four two by two: each tile fills its column.
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "feed.items.{i}.gn") "2")
        children:
          - include: card_tile_0
          - include: card_tile_1
      - type: group
        layout: {kind: grid, col_widths: ["34%", "33%", "33%"]}
        visible_when: (= (state-get "feed.items.{i}.gn") "3")
        children:
          - include: card_tile_0
          - include: card_tile_1
          - include: card_tile_2
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "feed.items.{i}.gn") "4")
        children:
          - include: card_tile_0
          - include: card_tile_1
          - include: card_tile_2
          - include: card_tile_3
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: feed.items.{i}.gmore_line
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "feed.items.{i}.v_gmore") "1")
  card_tile_0:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g0_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g0_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "video")
  card_tile_1:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g1_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g1_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "video")
  card_tile_2:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g2_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g2_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "video")
  card_tile_3:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g3_url
        size: ["100%", 180]
        fit: cover
        badge: (state-get "feed.items.{i}.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g3_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g3_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "feed.items.{i}.gmore")
        bind: feed.items.{i}.g3_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g3_kind") "video")
  card_fgrid:
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "feed.items.{i}.gn") "1")
        children:
          - image: ""
            bind: feed.items.{i}.g0_url
            size: 592
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "feed.items.{i}.g0_kind") "image")
          - video: video
            src: (state-get "feed.items.{i}.g0_url")
            size: 592
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: feed.items.{i}.g0_player
            on_click: (if (has? "ui.group_click") (state-set "feed.items.{i}.g0_player.playing" (if (= (state-get "feed.items.{i}.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "feed.items.{i}.g0_kind") "video")
      # Two side by side, three in a row, four two by two: 592 px across, as the line is.
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.items.{i}.gn") "2")
        children:
          - include: card_ftile_0_292
          - include: card_ftile_1_292
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.items.{i}.gn") "3")
        children:
          - include: card_ftile_0_194
          - include: card_ftile_1_194
          - include: card_ftile_2_194
      - type: group
        visible_when: (= (state-get "feed.items.{i}.gn") "4")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - include: card_ftile_0_292
              - include: card_ftile_1_292
          - type: group
            layout: {kind: horizontal}
            children:
              - include: card_ftile_2_292
              - include: card_ftile_3_292
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: feed.items.{i}.gmore_line
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "feed.items.{i}.v_gmore") "1")
  card_ftile_0_292:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g0_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g0_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "video")
  card_ftile_1_292:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g1_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g1_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "video")
  card_ftile_2_292:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g2_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g2_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "video")
  card_ftile_3_292:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g3_url
        size: [292, 180]
        fit: cover
        badge: (state-get "feed.items.{i}.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g3_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g3_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "feed.items.{i}.gmore")
        bind: feed.items.{i}.g3_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g3_kind") "video")
  card_ftile_0_194:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g0_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g0_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g0_kind") "video")
  card_ftile_1_194:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g1_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g1_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g1_kind") "video")
  card_ftile_2_194:
    type: group
    children:
      - image: ""
        bind: feed.items.{i}.g2_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "image")
      - video: video
        src: (state-get "feed.items.{i}.g2_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" (state-get "feed.items.{i}.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "feed.items.{i}.g2_kind") "video")
  post_grid:
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "post.gn") "1")
        children:
          - image: ""
            bind: post.g0_url
            size: "100%"
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "post.g0_kind") "image")
          - video: video
            src: (state-get "post.g0_url")
            size: "100%"
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: post.g0_player
            on_click: (if (has? "ui.group_click") (state-set "post.g0_player.playing" (if (= (state-get "post.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "post.g0_kind") "video")
      # Two side by side, three in a row, four two by two: each tile fills its column.
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "post.gn") "2")
        children:
          - include: post_tile_0
          - include: post_tile_1
      - type: group
        layout: {kind: grid, col_widths: ["34%", "33%", "33%"]}
        visible_when: (= (state-get "post.gn") "3")
        children:
          - include: post_tile_0
          - include: post_tile_1
          - include: post_tile_2
      - type: group
        layout: {kind: grid, col_widths: ["50%", "50%"]}
        visible_when: (= (state-get "post.gn") "4")
        children:
          - include: post_tile_0
          - include: post_tile_1
          - include: post_tile_2
          - include: post_tile_3
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: post.gmore_line
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "post.v_gmore") "1")
  post_tile_0:
    type: group
    children:
      - image: ""
        bind: post.g0_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "image")
      - video: video
        src: (state-get "post.g0_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "video")
  post_tile_1:
    type: group
    children:
      - image: ""
        bind: post.g1_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "image")
      - video: video
        src: (state-get "post.g1_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "video")
  post_tile_2:
    type: group
    children:
      - image: ""
        bind: post.g2_url
        size: ["100%", 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "image")
      - video: video
        src: (state-get "post.g2_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "video")
  post_tile_3:
    type: group
    children:
      - image: ""
        bind: post.g3_url
        size: ["100%", 180]
        fit: cover
        badge: (state-get "post.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g3_kind") "image")
      - video: video
        src: (state-get "post.g3_url")
        size: ["100%", 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "post.gmore")
        bind: post.g3_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g3_kind") "video")
  post_fgrid:
    type: group
    children:
      # One: the whole picture or video, as wide as the post at its own shape.
      - type: group
        visible_when: (= (state-get "post.gn") "1")
        children:
          - image: ""
            bind: post.g0_url
            size: 592
            on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
            visible_when: (= (state-get "post.g0_kind") "image")
          - video: video
            src: (state-get "post.g0_url")
            size: 592
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: post.g0_player
            on_click: (if (has? "ui.group_click") (state-set "post.g0_player.playing" (if (= (state-get "post.g0_player.playing") "1") "0" "1")))
            visible_when: (= (state-get "post.g0_kind") "video")
      # Two side by side, three in a row, four two by two: 592 px across, as the line is.
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "post.gn") "2")
        children:
          - include: post_ftile_0_292
          - include: post_ftile_1_292
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "post.gn") "3")
        children:
          - include: post_ftile_0_194
          - include: post_ftile_1_194
          - include: post_ftile_2_194
      - type: group
        visible_when: (= (state-get "post.gn") "4")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - include: post_ftile_0_292
              - include: post_ftile_1_292
          - type: group
            layout: {kind: horizontal}
            children:
              - include: post_ftile_2_292
              - include: post_ftile_3_292
      # How many more there are: over the fourth tile where the host draws a label over a picture
      # (image.badge), else under the grid.
      - text: ""
        bind: post.gmore_line
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "post.v_gmore") "1")
  post_ftile_0_292:
    type: group
    children:
      - image: ""
        bind: post.g0_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "image")
      - video: video
        src: (state-get "post.g0_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "video")
  post_ftile_1_292:
    type: group
    children:
      - image: ""
        bind: post.g1_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "image")
      - video: video
        src: (state-get "post.g1_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "video")
  post_ftile_2_292:
    type: group
    children:
      - image: ""
        bind: post.g2_url
        size: [292, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "image")
      - video: video
        src: (state-get "post.g2_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "video")
  post_ftile_3_292:
    type: group
    children:
      - image: ""
        bind: post.g3_url
        size: [292, 180]
        fit: cover
        badge: (state-get "post.gmore")
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g3_kind") "image")
      - video: video
        src: (state-get "post.g3_url")
        size: [292, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        badge: (state-get "post.gmore")
        bind: post.g3_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g3_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g3_kind") "video")
  post_ftile_0_194:
    type: group
    children:
      - image: ""
        bind: post.g0_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "image")
      - video: video
        src: (state-get "post.g0_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g0_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g0_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g0_kind") "video")
  post_ftile_1_194:
    type: group
    children:
      - image: ""
        bind: post.g1_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "image")
      - video: video
        src: (state-get "post.g1_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g1_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g1_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g1_kind") "video")
  post_ftile_2_194:
    type: group
    children:
      - image: ""
        bind: post.g2_url
        size: [194, 180]
        fit: cover
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "image")
      - video: video
        src: (state-get "post.g2_url")
        size: [194, 180]
        fit: cover
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: post.g2_player
        on_click: (if (has? "ui.group_click") (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.g2_vi")) (state-set "ui.cmd" "view")))
        visible_when: (= (state-get "post.g2_kind") "video")

  # A card: feed.items.{i} holds what main.ari's feed-card made of a post. Its one column is as
  # wide as the window ("100%"), so a picture or a video filling it is as wide as the card.
  post_card:
    type: group
    layout: {kind: grid, col_widths: ["100%"], borders: {show: outer}}
    children:
      - text: ""
        bind: feed.items.{i}.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "feed.items.{i}.note") "")
      # The author's avatar, round, 32 px (4 x 2 cells), or the initials; then who, and when.
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: feed.items.{i}.avatar_url
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (= (state-get "feed.items.{i}.v_avpic") "1")
          - text: ""
            bind: feed.items.{i}.avatar
            color: [0.55, 0.6, 0.7]
            visible_when: (= (state-get "feed.items.{i}.v_avtxt") "1")
          - text: " "
          - type: group
            children:
              - text: ""
                bind: feed.items.{i}.head
              - text: ""
                bind: feed.items.{i}.at
                color: [0.6, 0.6, 0.6]
      - text: ""
        bind: feed.items.{i}.l0
        emoji: feed.items.{i}.emoji
        visible_when: (!= (state-get "feed.items.{i}.l0") "")
      - text: ""
        bind: feed.items.{i}.l1
        emoji: feed.items.{i}.emoji
        visible_when: (!= (state-get "feed.items.{i}.l1") "")
      - text: ""
        bind: feed.items.{i}.l2
        emoji: feed.items.{i}.emoji
        visible_when: (!= (state-get "feed.items.{i}.l2") "")
      # Its hashtags: text in a terminal, a row to click elsewhere.
      - text: ""
        bind: feed.items.{i}.tagline
        color: [0.45, 0.65, 0.95]
        visible_when: (= (state-get "feed.items.{i}.v_tagline") "1")
      - radio_row: Tags
        bind: feed.items.{i}.tag_pick
        options: (string.split (state-get "feed.items.{i}.tags") "|")
        on: (begin (state-set "tag.want" (state-get "feed.items.{i}.tag_pick")) (state-set "ui.cmd" "tag"))
        visible_when: (= (state-get "feed.items.{i}.v_tagrow") "1")
      # Where a click on a group is its own, outside a terminal, each hashtag is a chip to click.
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "feed.items.{i}.v_chips") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t0")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t0") "")
            children:
              - text: ""
                bind: feed.items.{i}.t0
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t1")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t1") "")
            children:
              - text: ""
                bind: feed.items.{i}.t1
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t2")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t2") "")
            children:
              - text: ""
                bind: feed.items.{i}.t2
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t3")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t3") "")
            children:
              - text: ""
                bind: feed.items.{i}.t3
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t4")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t4") "")
            children:
              - text: ""
                bind: feed.items.{i}.t4
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "feed.items.{i}.t5")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "feed.items.{i}.t5") "")
            children:
              - text: ""
                bind: feed.items.{i}.t5
                color: [0.45, 0.65, 0.95]
          - text: ""
            bind: feed.items.{i}.tmore
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "feed.items.{i}.tmore") "")
      # Its pictures and videos: one as wide as the card at its own shape, two or more a grid
      # (card_grid where the host measures the line, card_fgrid at fixed sizes elsewhere outside a
      # terminal). A terminal shows the first picture (192 x 112 px, 24 x 7 cells) and the first
      # video.
      - type: group
        visible_when: (= (state-get "feed.items.{i}.v_grid") "1")
        children:
          - include: card_grid
      - type: group
        visible_when: (= (state-get "feed.items.{i}.v_fgrid") "1")
        children:
          - include: card_fgrid
      - image: ""
        bind: feed.items.{i}.pic
        size: [192, 112]
        fit: contain
        visible_when: (= (state-get "feed.items.{i}.v_pic_t") "1")
      - video: video
        src: (state-get "feed.items.{i}.vid_url")
        size: [192, 108]
        fit: contain
        controls: false
        autoplay: true
        muted: true
        loop: true
        bind: feed.items.{i}.player
        visible_when: (= (state-get "feed.items.{i}.v_vid_t") "1")
      # The first recording, with its controls, where the host has a player (media.player:
      # ari-media and arigl; transfix/libcvc#935).
      - audio: recording
        src: (state-get "feed.items.{i}.au_url")
        bind: feed.items.{i}.recording
        visible_when: (= (state-get "feed.items.{i}.v_audio") "1")
      # The attachments: two rows at most, and how many more there are. View, on the first row
      # of a post with something to view, opens the viewer. Where the grid shows every attachment
      # (pictures and videos only) there are no rows, and View is among the buttons below.
      - type: group
        visible_when: (= (state-get "feed.items.{i}.v_rows") "1")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: feed.items.{i}.m0
                color: [0.45, 0.75, 0.85]
              - button: View
                on: (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
                visible_when: (= (state-get "feed.items.{i}.has_media") "1")
          - text: ""
            bind: feed.items.{i}.m1
            color: [0.45, 0.75, 0.85]
            visible_when: (!= (state-get "feed.items.{i}.m1") "")
          - text: ""
            bind: feed.items.{i}.mmore
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "feed.items.{i}.mmore") "")
      # Where a click on a group is its own, outside a terminal: the counts are icons to press,
      # reply (the post, its reply box focused), repost and like, green and red once you have;
      # the card itself opens the post.
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "feed.items.{i}.v_click") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "post.want" (state-get "feed.items.{i}.pid")) (state-set "post.focus_reply" "1") (state-set "ui.cmd" "open")))
            hover: highlight
            children:
              - text: ""
                bind: feed.items.{i}.c_reply
                color: [0.6, 0.6, 0.6]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "act.i" "{i}") (state-set "ui.cmd" "repost")))
            hover: highlight
            children:
              - text: ""
                bind: feed.items.{i}.c_repost
                color: [0.4, 0.8, 0.5]
                visible_when: (= (state-get "feed.items.{i}.reposted") "1")
              - text: ""
                bind: feed.items.{i}.c_repost
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "feed.items.{i}.reposted") "1")
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "act.i" "{i}") (state-set "ui.cmd" "like")))
            hover: highlight
            children:
              - text: ""
                bind: feed.items.{i}.c_like
                color: [0.95, 0.35, 0.4]
                visible_when: (= (state-get "feed.items.{i}.liked") "1")
              - text: ""
                bind: feed.items.{i}.c_like
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "feed.items.{i}.liked") "1")
          - text: ""
            bind: feed.items.{i}.c_views
            color: [0.6, 0.6, 0.6]
          - button: View
            on: (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
            visible_when: (= (state-get "feed.items.{i}.v_viewbtn") "1")
      # Elsewhere the counts, then the buttons. Never disabled, and never hidden once shown: a
      # terminal that loses the focused widget scrolls back to the top. The controller takes one
      # command at a time, so a press while busy waits its turn.
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.items.{i}.v_btns") "1")
        children:
          - text: ""
            bind: feed.items.{i}.counts
            color: [0.6, 0.6, 0.6]
          - button: Open
            on: (begin (state-set "post.want" (state-get "feed.items.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - button: Reply
            on: (begin (state-set "post.want" (state-get "feed.items.{i}.pid")) (state-set "post.focus_reply" "1") (state-set "ui.cmd" "open"))
          - button: Like
            on: (begin (state-set "act.i" "{i}") (state-set "ui.cmd" "like"))
          - button: Repost
            on: (begin (state-set "act.i" "{i}") (state-set "ui.cmd" "repost"))
          - button: View
            on: (begin (state-set "view.post" (state-get "feed.items.{i}.pid")) (state-set "view.i" 0) (state-set "ui.cmd" "view"))
            visible_when: (= (state-get "feed.items.{i}.v_viewbtn") "1")

  # The feed: Following is GET /social/timeline/home, Everyone /social/timeline/public, Friends
  # /social/timeline/friends; a hashtag's posts are GET /social/timeline/tag/{tag}.
  feed_view:
    type: group
    children:
      - radio_row: Show
        bind: feed.mode
        options: [Following, Everyone, Friends]
        on: (state-set "ui.cmd" "feed")
        visible_when: (!= (state-get "feed.source") "tag")
      - text: ""
        bind: feed.title
        color: [0.45, 0.65, 0.95]
        visible_when: (= (state-get "feed.source") "tag")
      - separator
      - text: ""
        bind: feed.empty
        visible_when: (!= (state-get "feed.empty") "")
      - type: group
        repeat: (state-get "feed.items")
        children:
          # Outside a terminal, where a click on a group is its own (ui.group_click), the whole
          # card opens its post; a click on its pictures, icons or hashtags is theirs.
          - type: group
            visible_when: (= (state-get "feed.items.{i}.v_click") "1")
            on_click: (if (has? "ui.group_click") (begin (state-set "post.want" (state-get "feed.items.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open")))
            children:
              - include: post_card
          - type: group
            visible_when: (= (state-get "feed.items.{i}.v_btns") "1")
            children:
              - include: post_card
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.empty") "")
        children:
          - button: Load more    # never disabled either; at the end it says so
            on: (state-set "ui.cmd" "more")
          - text: ""
            bind: feed.tail
            color: [0.6, 0.6, 0.6]

  # One post in full: every line of its text, every attachment, the reactions (GET
  # /social/posts/{id}, which has them; the feed doesn't), the post it replies to, its replies
  # (GET /social/posts/{id}/replies) and a box to reply in.
  post_view:
    type: group
    children:
      - text: ""
        bind: post.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "post.note") "")
      # What it replies to: a button to it, and who wrote it.
      - type: group
        layout: {kind: horizontal}
        visible_when: (!= (state-get "post.parent") "")
        children:
          - button: In reply to
            on: (begin (state-set "post.want" (state-get "post.parent")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - text: ""
            bind: post.parent_note
            color: [0.6, 0.6, 0.6]
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: post.avatar_url
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (= (state-get "post.v_avpic") "1")
          - text: ""
            bind: post.avatar
            color: [0.55, 0.6, 0.7]
            visible_when: (= (state-get "post.v_avtxt") "1")
          - text: " "
          - type: group
            children:
              - text: ""
                bind: post.head
              - text: ""
                bind: post.at
                color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "post.lines")
        children:
          - text: ""
            bind: post.lines.{i}
            emoji: post.emoji
      # Its hashtags: chips to click where a click on a group is its own (outside a terminal);
      # elsewhere a radio row, clicked (outside a terminal), or picked and Open tag (in one).
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto, auto, auto, auto]}
        visible_when: (= (state-get "post.v_chips") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t0")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t0") "")
            children:
              - text: ""
                bind: post.t0
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t1")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t1") "")
            children:
              - text: ""
                bind: post.t1
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t2")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t2") "")
            children:
              - text: ""
                bind: post.t2
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t3")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t3") "")
            children:
              - text: ""
                bind: post.t3
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t4")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t4") "")
            children:
              - text: ""
                bind: post.t4
                color: [0.45, 0.65, 0.95]
          - type: group
            on_click: (if (has? "ui.group_click") (begin (state-set "tag.want" (state-get "post.t5")) (state-set "ui.cmd" "tag")))
            hover: highlight
            visible_when: (!= (state-get "post.t5") "")
            children:
              - text: ""
                bind: post.t5
                color: [0.45, 0.65, 0.95]
          - text: ""
            bind: post.tmore
            color: [0.6, 0.6, 0.6]
            visible_when: (!= (state-get "post.tmore") "")
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "post.v_tagrow") "1")
        children:
          - radio_row: Tags
            bind: post.tag_pick
            options: (string.split (state-get "post.tags") "|")
            on: (if (not (has? "term")) (begin (state-set "tag.want" (state-get "post.tag_pick")) (state-set "ui.cmd" "tag")))
          - text: "  "
            visible_when: (= (state-get "post.v_term") "1")
          - button: Open tag
            on: (begin (state-set "tag.want" (state-get "post.tag_pick")) (state-set "ui.cmd" "tag"))
            visible_when: (= (state-get "post.v_term") "1")
      - type: group
        layout: {kind: horizontal, col_widths: [auto, auto, auto, auto]}
        visible_when: (= (state-get "post.v_click") "1")
        children:
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "post.focus_reply" "1"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_reply
                color: [0.6, 0.6, 0.6]
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "ui.cmd" "post-repost"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_repost
                color: [0.4, 0.8, 0.5]
                visible_when: (= (state-get "post.reposted") "1")
              - text: ""
                bind: post.c_repost
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "post.reposted") "1")
          - type: group
            on_click: (if (has? "ui.group_click") (state-set "ui.cmd" "post-like"))
            hover: highlight
            children:
              - text: ""
                bind: post.c_like
                color: [0.95, 0.35, 0.4]
                visible_when: (= (state-get "post.liked") "1")
              - text: ""
                bind: post.c_like
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "post.liked") "1")
          - text: ""
            bind: post.c_views
            color: [0.6, 0.6, 0.6]
      - text: ""
        bind: post.counts
        color: [0.6, 0.6, 0.6]
        visible_when: (= (state-get "post.v_btns") "1")
      - text: ""
        bind: post.reactions
        visible_when: (!= (state-get "post.reactions") "")
      # What you can do with it. Delete is there for your own posts only.
      - type: group
        layout: {kind: horizontal}
        children:
          # Nothing here takes the focus by itself: Back, pressed again and again, walks back
          # through the views, and a post shown again mustn't catch an Enter meant for Back.
          - button: Like
            on: (state-set "ui.cmd" "post-like")
            visible_when: (= (state-get "post.v_btns") "1")
          - button: Repost
            on: (state-set "ui.cmd" "post-repost")
            visible_when: (= (state-get "post.v_btns") "1")
          - button: Author
            on: (begin (state-set "user.want" (state-get "post.author_id")) (state-set "ui.cmd" "user"))
          - button: Delete
            on: (state-set "ui.cmd" "delete")
            visible_when: (= (state-get "post.mine") "1")
      # Its address on the instance, and Copy link where the host has a clipboard
      # (clipboard-set: libcvc 3.7.13).
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Copy link
            on: (begin (clipboard-set (state-get "post.web")) (state-set "ui.cmd" "copied"))
            visible_when: (= (state-get "app.clip") "1")
          - text: ""
            bind: post.link
            color: [0.6, 0.6, 0.6]
      # Its pictures and videos, laid out as a card's are (post_grid, post_fgrid).
      - type: group
        visible_when: (= (state-get "post.v_grid") "1")
        children:
          - include: post_grid
      - type: group
        visible_when: (= (state-get "post.v_fgrid") "1")
        children:
          - include: post_fgrid
      # Each attachment: its row, and View, which opens the viewer at it. In a terminal its
      # picture or video follows (384 x 216 px); a recording has its player everywhere.
      - type: group
        repeat: (state-get "post.media")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: post.media.{i}.row
                color: [0.45, 0.75, 0.85]
              - button: View
                on: (begin (state-set "view.post" (state-get "post.pid")) (state-set "view.i" (state-get "post.media.{i}.vi")) (state-set "ui.cmd" "view"))
                visible_when: (= (state-get "post.media.{i}.v_view") "1")
          - image: ""
            bind: post.media.{i}.url
            size: [384, 216]
            fit: contain
            visible_when: (= (state-get "post.media.{i}.v_img_t") "1")
          - video: video
            src: (state-get "post.media.{i}.url")
            size: [384, 216]
            fit: contain
            controls: false
            autoplay: true
            muted: true
            loop: true
            bind: post.media.{i}.player
            visible_when: (= (state-get "post.media.{i}.v_vid_t") "1")
          - audio: recording
            src: (state-get "post.media.{i}.url")
            bind: post.media.{i}.player
            visible_when: (= (state-get "post.media.{i}.v_aud") "1")
      - separator
      # The replies, oldest first: who and when, two lines of each, and Open.
      - text: ""
        bind: post.replies_head
        color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "post.replies")
        children:
          - type: group
            layout: {kind: horizontal}
            children:
              - text: ""
                bind: post.replies.{i}.head
              - button: Open
                on: (begin (state-set "post.want" (state-get "post.replies.{i}.id")) (state-set "post.focus_reply" "") (state-set "ui.cmd" "open"))
          - text: ""
            bind: post.replies.{i}.l0
            emoji: post.replies.{i}.emoji
          - text: ""
            bind: post.replies.{i}.l1
            emoji: post.replies.{i}.emoji
            visible_when: (!= (state-get "post.replies.{i}.l1") "")
      - button: More replies
        on: (state-set "ui.cmd" "more-replies")
        visible_when: (= (state-get "post.replies_more") "1")
      # The reply box. Enter sends it (Shift+Enter, or Alt+Enter in a terminal, starts a new
      # line); ImGui adds a Reply button. Reply on a card opens the post with the box focused: the
      # same box, shown with autofocus (one of the two is drawn at a time).
      - message_input: Reply
        bind: post.reply_text
        hint: Write a reply (Enter sends it)
        max_length: 4096
        max_lines: 6
        send: Reply
        on: (begin (state-set "post.reply_send" (get-attr event "text")) (state-set "ui.cmd" "reply"))
        visible_when: (!= (state-get "post.focus_reply") "1")
      - message_input: Reply
        bind: post.reply_text
        hint: Write a reply (Enter sends it)
        max_length: 4096
        max_lines: 6
        send: Reply
        autofocus: true
        on: (begin (state-set "post.reply_send" (get-attr event "text")) (state-set "ui.cmd" "reply"))
        visible_when: (= (state-get "post.focus_reply") "1")
