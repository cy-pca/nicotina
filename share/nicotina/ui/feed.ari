# The home feed, and one post in full.
#
# feed_window is the screen after signing in, as the web app's home is: the posts of the people
# you follow (or everyone's), newest first, each a card. A card is a bordered group: a header
# (the author's avatar, name, handle and time), the text (three lines at most), the
# attachments, and the counts with an Open button. Open shows the whole post (post_window).
#
# Terminal first: the window is 76 columns wide and 86% of the screen tall (21 rows in an 80x24
# terminal; more in a bigger one, or a window). Its cards don't fit at once, so the window
# scrolls: a terminal keeps the focused widget in view, and each card's Open button is one, so
# Tab walks the feed card by card. (Ariadne has no scrolling region inside a window yet, so the
# header scrolls away with the cards.) Load more, at the end, fetches the next page and adds it
# below.
#
# Avatars and pictures show where the host can fetch a picture from a URL (image.url:
# transfix/libcvc#931); txwtf's /uploads/... and /static/... need no sign-in. Elsewhere an avatar
# is the author's initials. Every attachment also has a row naming it (its kind, file name, size
# and alt text). Video and audio play in the card and the post (video: and audio:, with their
# controls) where the host has a player; elsewhere they are rows too.
# A host with open-url (transfix/libcvc#916) also gets an "In browser" button that opens the post
# in the web app.

units:
  # A card: feed.items.{i} holds what main.ari's feed-card made of a post.
  post_card:
    type: group
    layout: {kind: grid, col_widths: [auto], borders: {show: outer}}
    children:
      - text: ""
        bind: feed.items.{i}.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "feed.items.{i}.note") "")
      # The author's avatar, round, 32 px (4 x 2 cells), or the initials; then who, and when.
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: feed.items.{i}.avatar_url
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (and (has? "image.url") (!= (state-get "feed.items.{i}.avatar_url") ""))
          - text: ""
            bind: feed.items.{i}.avatar
            color: [0.55, 0.6, 0.7]
            visible_when: (not (and (has? "image.url") (!= (state-get "feed.items.{i}.avatar_url") "")))
          - text: " "
          - type: group
            children:
              - text: ""
                bind: feed.items.{i}.head
              - text: ""
                bind: feed.items.{i}.at
                color: [0.6, 0.6, 0.6]
      - text: ""
        bind: feed.items.{i}.l0
        visible_when: (!= (state-get "feed.items.{i}.l0") "")
      - text: ""
        bind: feed.items.{i}.l1
        visible_when: (!= (state-get "feed.items.{i}.l1") "")
      - text: ""
        bind: feed.items.{i}.l2
        visible_when: (!= (state-get "feed.items.{i}.l2") "")
      # The first picture, inline (192 x 112 px, 24 x 7 cells), where the host can show one.
      - image: ""
        bind: feed.items.{i}.pic
        size: [192, 112]
        fit: contain
        visible_when: (and (has? "image.url") (!= (state-get "feed.items.{i}.pic") ""))
      # The first video or recording, with its controls (play/pause, seek, mute), where the host
      # has a player (media.player: ari-media and arigl; transfix/libcvc#935). The lean ari, and
      # a host without the widgets, show the rows below; "In browser" opens the post.
      - video: video
        src: (state-get "feed.items.{i}.av_url")
        size: [192, 108]
        fit: contain
        bind: feed.items.{i}.player
        visible_when: (and (has? "media.player") (= (state-get "feed.items.{i}.av_kind") "video"))
      - audio: recording
        src: (state-get "feed.items.{i}.av_url")
        bind: feed.items.{i}.player
        visible_when: (and (has? "media.player") (= (state-get "feed.items.{i}.av_kind") "audio"))
      # The attachments: two rows at most, and how many more there are.
      - text: ""
        bind: feed.items.{i}.m0
        color: [0.45, 0.75, 0.85]
        visible_when: (!= (state-get "feed.items.{i}.m0") "")
      - text: ""
        bind: feed.items.{i}.m1
        color: [0.45, 0.75, 0.85]
        visible_when: (!= (state-get "feed.items.{i}.m1") "")
      - text: ""
        bind: feed.items.{i}.mmore
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "feed.items.{i}.mmore") "")
      - type: group
        layout: {kind: horizontal}
        children:
          - text: ""
            bind: feed.items.{i}.counts
            color: [0.6, 0.6, 0.6]
          # Never disabled: a terminal that loses the focused widget scrolls back to the top.
          # The controller takes one command at a time, so a press while busy waits its turn.
          - button: Open
            on: (begin (state-set "post.want" (state-get "feed.items.{i}.id")) (state-set "ui.cmd" "open"))
          - button: In browser
            on: (open-url (state-get "feed.items.{i}.web"))
            visible_when: (has? "open-url")

  feed_window:
    window: Home
    id: feed
    pos: [16, 32]
    size: [608, "86%"]
    visible_when: (= (state-get "ui.screen") "feed")
    children:
      - type: group
        layout: {kind: horizontal}
        children:
          - text: ""
            bind: feed.who
          - button: Profile
            on: (state-set "ui.cmd" "profile")
            enabled_when: (!= (state-get "ui.busy") "1")
          - button: Refresh
            on: (state-set "ui.cmd" "refresh")
            enabled_when: (!= (state-get "ui.busy") "1")
          - button: Sign out
            on: (state-set "ui.cmd" "signout")
            enabled_when: (!= (state-get "ui.busy") "1")
      # Following is GET /social/timeline/home, Everyone /social/timeline/public.
      - radio_row: Show
        bind: feed.mode
        options: [Following, Everyone]
        on: (state-set "ui.cmd" "feed")
      - include: status_line
      - separator
      - text: ""
        bind: feed.empty
        visible_when: (!= (state-get "feed.empty") "")
      - type: group
        repeat: (state-get "feed.items")
        children:
          - include: post_card
      - type: group
        layout: {kind: horizontal}
        visible_when: (= (state-get "feed.empty") "")
        children:
          - button: Load more    # never disabled either; at the end it says so
            on: (state-set "ui.cmd" "more")
          - text: ""
            bind: feed.tail
            color: [0.6, 0.6, 0.6]

  # One post in full: every line of its text, every attachment with its URL, and the reactions
  # (GET /social/posts/{id}, which has them; the feed doesn't).
  post_window:
    window: Post
    id: post
    pos: [16, 32]
    size: [608, "86%"]
    visible_when: (= (state-get "ui.screen") "post")
    children:
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Back
            on: (state-set "ui.cmd" "back-to-feed")
            autofocus: true
          - button: In browser
            on: (open-url (state-get "post.web"))
            visible_when: (has? "open-url")
          - text: ""
            bind: post.web_note
            color: [0.6, 0.6, 0.6]
      - include: status_line
      - separator
      - text: ""
        bind: post.note
        color: [0.6, 0.6, 0.6]
        visible_when: (!= (state-get "post.note") "")
      - type: group
        layout: {kind: horizontal}
        children:
          - image: ""
            bind: post.avatar_url
            size: [32, 32]
            fit: cover
            shape: circle
            visible_when: (and (has? "image.url") (!= (state-get "post.avatar_url") ""))
          - text: ""
            bind: post.avatar
            color: [0.55, 0.6, 0.7]
            visible_when: (not (and (has? "image.url") (!= (state-get "post.avatar_url") "")))
          - text: " "
          - type: group
            children:
              - text: ""
                bind: post.head
              - text: ""
                bind: post.at
                color: [0.6, 0.6, 0.6]
      - type: group
        repeat: (state-get "post.lines")
        children:
          - text: ""
            bind: post.lines.{i}
      - text: ""
        bind: post.counts
        color: [0.6, 0.6, 0.6]
      - text: ""
        bind: post.reactions
        visible_when: (!= (state-get "post.reactions") "")
      # Each attachment: its row and its URL, then the picture (384 x 216 px, 48 x 13 cells)
      # where the host can show one.
      - type: group
        repeat: (state-get "post.media")
        children:
          - text: ""
            bind: post.media.{i}.row
            color: [0.45, 0.75, 0.85]
          - text: ""
            bind: post.media.{i}.where
            color: [0.6, 0.6, 0.6]
          - image: ""
            bind: post.media.{i}.url
            size: [384, 216]
            fit: contain
            visible_when: (and (has? "image.url") (= (state-get "post.media.{i}.kind") "image"))
          - video: video
            src: (state-get "post.media.{i}.url")
            size: [384, 216]
            fit: contain
            bind: post.media.{i}.player
            visible_when: (and (has? "media.player") (= (state-get "post.media.{i}.kind") "video"))
          - audio: recording
            src: (state-get "post.media.{i}.url")
            bind: post.media.{i}.player
            visible_when: (and (has? "media.player") (= (state-get "post.media.{i}.kind") "audio"))
