# The signed-in client: one window, as the TX.WTF web app is one page. A bar of buttons along its
# top goes to each part, and below it the window shows one view at a time:
#
#   feed      the home feed (Following, Everyone, Friends), or one hashtag's posts
#   post      one post in full, the post it replies to, its replies, and a reply box
#   profile   anyone's profile: yours (with Balances and the Details window), or another's
#   tags      every hashtag, by how many posts name it
#   alerts    your notifications
#   search    posts and people
#   compose   a new post
#   viewer    a post's pictures and videos, one at a time, as wide as the window
#   admin     for the instance's administrators: its users, groups, invite codes, settings and
#             system log; auser, agroup and agperm, one account, one group and its permissions
#             (ui/admin.ari)
#
# Going to a view remembers the one it came from, and Back returns to it (main.ari's "back").
# Home starts over at the feed. The window is the feed's width (74 columns in a terminal) and 86%
# of the screen tall; a view taller than that scrolls.
#
# Each new view starts with the focus on Back, so Enter, pressed again and again, walks back, and
# Tab walks into the view from its top. (A terminal host names a widget by its label and repeat
# index, so without this the focus could land on a same-named button of the new view.) The bar
# is drawn twice, one copy at a time: main.ari flips ui.nav between "a" and "b" whenever the
# view changes, and the copy that appears gives its Back the focus (autofocus:). A view's own
# autofocus (the search field, a new post's text, the reply box) comes later in the window and
# takes it from Back.
#
# Each copy of the bar and each view is a group with an id:, which scopes its widgets' identities
# (ImGui's IDs): the bar's Search and the search view's Search button are two buttons, not one ID
# drawn twice.

units:
  # The bar: words (nav_words), or where a window draws emoji (app.icons: libcvc 3.7.13) symbols,
  # as the web app's (nav_icons), each with its word as a tooltip, and Forward beside Back.
  nav_bar:
    type: group
    children:
      - type: group
        visible_when: (= (state-get "app.icons") "1")
        children:
          - include: nav_icons
      - type: group
        visible_when: (!= (state-get "app.icons") "1")
        children:
          - include: nav_words

  nav_icons:
    type: group
    layout: {kind: horizontal}
    children:
      - button: "←"
        on: (state-set "ui.cmd" "back")
        tooltip: Back
        autofocus: true
      - button: "→"
        on: (state-set "ui.cmd" "forward")
        tooltip: Forward
      - button: "🏠"
        on: (state-set "ui.cmd" "home")
        tooltip: Home
      - button: "#"
        on: (state-set "ui.cmd" "tags")
        tooltip: Hashtags
      - button: "🔍"
        on: (state-set "ui.cmd" "search-view")
        tooltip: Search
      - button: "🔔"
        on: (state-set "ui.cmd" "alerts")
        tooltip: Alerts
      - button: "👤"
        on: (state-set "ui.cmd" "profile")
        tooltip: Profile
      - button: "✏"
        on: (state-set "ui.cmd" "compose")
        tooltip: New post
      - button: "🛠"
        on: (state-set "ui.cmd" "admin")
        tooltip: Admin
        visible_when: (= (state-get "ui.admin") "1")
      - text: ""
        bind: alerts.badge
        color: [0.95, 0.75, 0.3]

  # In words. A terminal draws a button as its label in brackets, so the bar is 63 columns; the
  # unread count follows it. (Forward is in the nicotina menu here: the bar has no room for it,
  # nor for Admin, which an administrator finds on their profile and in the menu.)
  nav_words:
    type: group
    layout: {kind: horizontal}
    children:
      - button: Back
        on: (state-set "ui.cmd" "back")
        autofocus: true
      - button: Home
        on: (state-set "ui.cmd" "home")
      - button: Tags
        on: (state-set "ui.cmd" "tags")
      - button: Search
        on: (state-set "ui.cmd" "search-view")
      - button: Alerts
        on: (state-set "ui.cmd" "alerts")
      - button: Profile
        on: (state-set "ui.cmd" "profile")
      - button: Post
        on: (state-set "ui.cmd" "compose")
      - text: ""
        bind: alerts.badge
        color: [0.95, 0.75, 0.3]

  # The window, titled by the site it is signed in to (app.title: GET /site/title, else its host).
  # Its X closes it (the nicotina menu's Show the window brings it back), its arrow folds it into
  # its title bar.
  app_window:
    window: TX.WTF
    bind: app.title
    id: app
    closable: true
    pos: [16, 32]
    size: [auto, "86%"]    # as wide as what it shows, 86% tall: what does not fit scrolls
    visible_when: (and (!= (state-get "ui.screen") "boot") (!= (state-get "ui.screen") "signin")
                       (!= (state-get "ui.screen") "2fa"))
    # The account's page background (profile_bg_url), faint, behind a profile in ImGui, as the
    # web app puts it behind the page. A terminal shows none: the card's is enough there.
    background: {bind: prof.bg_pic_shown, fit: cover, opacity: 0.25, terminal: none}
    children:
      - type: group
        id: nav_a
        visible_when: (!= (state-get "ui.nav") "b")
        children:
          - include: nav_bar
      - type: group
        id: nav_b
        visible_when: (= (state-get "ui.nav") "b")
        children:
          - include: nav_bar
      - include: status_line
      - separator
      - type: group
        id: v_feed
        visible_when: (= (state-get "ui.screen") "feed")
        children:
          - include: feed_view
      - type: group
        id: v_post
        visible_when: (= (state-get "ui.screen") "post")
        children:
          - include: post_view
      - type: group
        id: v_profile
        visible_when: (= (state-get "ui.screen") "profile")
        children:
          - include: profile_view
      - type: group
        id: v_tags
        visible_when: (= (state-get "ui.screen") "tags")
        children:
          - include: tags_view
      - type: group
        id: v_alerts
        visible_when: (= (state-get "ui.screen") "alerts")
        children:
          - include: alerts_view
      - type: group
        id: v_search
        visible_when: (= (state-get "ui.screen") "search")
        children:
          - include: search_view
      - type: group
        id: v_compose
        visible_when: (= (state-get "ui.screen") "compose")
        children:
          - include: compose_view
      - type: group
        id: v_viewer
        visible_when: (= (state-get "ui.screen") "viewer")
        children:
          - include: viewer_view
      - type: group
        id: v_admin
        visible_when: (= (state-get "ui.screen") "admin")
        children:
          - include: admin_view
      - type: group
        id: v_auser
        visible_when: (= (state-get "ui.screen") "auser")
        children:
          - include: auser_view
      - type: group
        id: v_agroup
        visible_when: (= (state-get "ui.screen") "agroup")
        children:
          - include: agroup_view
      - type: group
        id: v_agperm
        visible_when: (= (state-get "ui.screen") "agperm")
        children:
          - include: agperm_view
