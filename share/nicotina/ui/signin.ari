# The signed-out windows: starting up, the sign-in form, a new account's form, and the emailed
# code. main.ari imports these units and runs the commands their buttons set (ui.cmd).
#
# Laid out for the terminal first (8 x 16 px cells): every window opens at column 2, row 2, and
# fits what it shows. The controller keeps its messages to 60 characters, so a window stays within
# 80 columns. A window that closes and opens again (the sign-in form after signing out) fits what
# it shows then, in every host (tvision since transfix/libcvc#930).

units:
  # The controller's last word, info as is and errors in red; no row while there is none.
  # While a request is out (ui.busy) a spinner turns beside it ("Signing in...", "Checking the
  # code...", "Refreshing..."). The spinner turns by the host's frame clock, since the
  # controller is parked on the request. A host without the spinner widget shows the line alone.
  status_line:
    type: group
    children:
      - spinner: ""
        bind: ui.msg
        visible_when: (and (= (state-get "ui.busy") "1") (has? "spinner"))
      - text: ""
        bind: ui.msg
        visible_when: (and (!= (state-get "ui.msg") "") (!= (state-get "ui.err") "1") (not (and (= (state-get "ui.busy") "1") (has? "spinner"))))
      - text: ""
        bind: ui.msg
        color: [1.0, 0.45, 0.4]
        visible_when: (and (!= (state-get "ui.msg") "") (= (state-get "ui.err") "1") (not (and (= (state-get "ui.busy") "1") (has? "spinner"))))

  starting_window:
    window: nicotina
    id: starting
    pos: [16, 32]
    visible_when: (= (state-get "ui.screen") "boot")
    children:
      - spinner: ""
        bind: '(string.join (list "Connecting to" (state-get "session.host") "...") " ")'
        visible_when: (has? "spinner")
      - text: ""
        bind: '(string.join (list "Connecting to" (state-get "session.host") "...") " ")'
        visible_when: (not (has? "spinner"))

  signin_window:
    window: Sign in to TX.WTF
    bind: app.signin_title
    id: signin
    pos: [16, 32]
    visible_when: (= (state-get "ui.screen") "signin")
    children:
      # The site to sign in to: the TX.WTF fleet's sites main.ari offers (fleet.labels, one a
      # line: an https:// site's host, else its URL), --instance's first. A pick moves the form
      # there (ui.cmd "site"), unless another window is signed in there already.
      - combo: Site
        bind: ui.site_pick
        options: (string.split (state-get "fleet.labels") "\n")
        on: (state-set "ui.cmd" "site")
        enabled_when: (!= (state-get "ui.busy") "1")
      # The picked site as its own sign-in page shows it (site_info: GET /social/site-info): its
      # logo, where the host draws pictures and may reach it, beside its name, tagline and txwtf
      # version. Nothing while it is asked, or when the site doesn't say.
      - type: group
        layout: {kind: horizontal}
        visible_when: (!= (state-get "session.site_info.name") "")
        children:
          - image: ""
            bind: session.site_info.logo
            size: [48, 48]
            fit: contain
            visible_when: (!= (state-get "session.site_info.logo") "")
          - text: " "            # a terminal's gap; a window spaces its items itself
            visible_when: (and (!= (state-get "session.site_info.logo") "") (= (state-get "session.caps.term") "1"))
          - type: group
            children:
              - text: ""
                bind: session.site_info.name
              - text: ""
                bind: session.site_info.tagline
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "session.site_info.tagline") "")
              - text: ""
                bind: session.site_info.version
                color: [0.6, 0.6, 0.6]
                visible_when: (!= (state-get "session.site_info.version") "")
      - separator
      - input_text: Username
        bind: login.username
        autofocus: true          # each time the form opens, so a person can type at once
      # Masked (a bullet per character in a terminal, ImGui's password field in a window). The
      # value still sits in login.password while it is typed; the controller clears it as soon
      # as it sends it, whatever the outcome.
      - input_text: Password
        bind: login.password
        password: true
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Sign in
            on: (state-set "ui.cmd" "login")
            enabled_when: (!= (state-get "ui.busy") "1")
          # While another site's window is open (main.ari's peers): this form can go.
          - button: Close
            on: (state-set "ui.cmd" "close")
            enabled_when: (!= (state-get "ui.busy") "1")
            visible_when: (and (state-exists "peers.open") (> (int (state-get "peers.open")) 1))
      - include: status_line
      # Advanced options: how long the session lasts before you sign in again (txwtf's
      # expire_delta, an hour unless you pick more). Under the button, as the web app has them, so
      # Tab from the password still reaches Sign in. The pick stays while nicotina runs.
      - checkbox: Advanced options
        bind: login.advanced
      - combo: Session
        bind: login.expire
        options: ["1 hour (default)", "4 hours", "8 hours", "12 hours", "1 day", "1 week",
                  "30 days"]
        values: [3600, 14400, 28800, 43200, 86400, 604800, 2592000]
        visible_when: (= (state-get "login.advanced") "1")
      # A new account at the picked site, as the web app's Register (ui.cmd "signup"): last, so
      # Tab from the password still reaches Sign in first.
      - type: group
        layout: {kind: horizontal}
        children:
          - text: "No account here? "
            color: [0.6, 0.6, 0.6]
          - button: Create an account
            on: (state-set "ui.cmd" "signup")
            enabled_when: (!= (state-get "ui.busy") "1")

  # A new account (POST /user/register), as the web app's Register form: who, the password twice,
  # and an invite code, which an invite-only site requires (GET /invite/mode says which; the field
  # is there either way, as the web app's). Create account makes it, then signs in to it and
  # opens Settings, where the email address is verified.
  register_window:
    window: Create an account
    bind: app.register_title
    id: register
    pos: [16, 32]
    visible_when: (= (state-get "ui.screen") "register")
    children:
      - text: ""
        bind: reg.site
        color: [0.6, 0.6, 0.6]
      - separator
      - input_text: Username
        bind: reg.username
        autofocus: true
      - input_text: Name
        bind: reg.name
      - input_text: Email
        bind: reg.email
      # Masked, as the sign-in form's; the controller clears both as soon as it sends them.
      - input_text: Password
        bind: reg.password
        password: true
      - input_text: Password again
        bind: reg.password2
        password: true
      - input_text: Invite code
        bind: reg.invite
      - text: ""
        bind: reg.invite_note
        color: [0.6, 0.6, 0.6]
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Create account
            on: (state-set "ui.cmd" "signup-send")
            enabled_when: (!= (state-get "ui.busy") "1")
          - button: Back
            on: (state-set "ui.cmd" "signup-back")
            enabled_when: (!= (state-get "ui.busy") "1")
      - include: status_line

  twofactor_window:
    window: Two-step verification
    id: twofactor
    pos: [16, 32]
    visible_when: (= (state-get "ui.screen") "2fa")
    children:
      - text: ""
        bind: '(string.join (list "Signing in as" (state-get "login.username")) " ")'
      - separator
      - input_text: Code
        bind: login.code
        autofocus: true
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Verify
            on: (state-set "ui.cmd" "verify")
            enabled_when: (!= (state-get "ui.busy") "1")
          - button: Back
            on: (state-set "ui.cmd" "back")
            enabled_when: (!= (state-get "ui.busy") "1")
      - include: status_line

# The sign-in forms' functions: signing in, the emailed code, a new account, the site's own page,
# resuming a kept session, and a session that ended.
# nicotina.ari's on_tick calls them; they were defined inside it until 2026-11.
functions: |
  (defun to-signin (msg is-error)
    (begin
      (state-set "login.password" "")
      (state-set "login.code" "")
      (state-set "login.challenge" "")
      (state-set-tree "session.me" (dict))
      (state-set-tree "scrip" (dict))
      (state-set "ui.tab" "Posts") ;; the next profile opens at Posts, as the web app's does
      (state-set "ui.here" "")
      (state-set "ui.back" "")
      (state-set-tree "feed" (dict "items" (list) "mode" "Following" "source" "home" "tag" ""
                                   "title" "" "more" "" "before" "" "offset" 0 "empty" ""
                                   "tail" ""))
      (state-set-tree "post" (dict "lines" (list) "media" (list) "replies" (list) "tags" ""
                                   "parent" "" "mine" "" "focus_reply" "" "reply_text" ""
                                   "can_delete" "" "confirm" ""))
      (state-set-tree "set" (dict "level" -3 "head" "" "note" "" "v_level" "" "v_email" ""
                                  "v_verify" "" "email_line" "" "email_code" "" "email_note" ""))
      (state-set "reg.password" "")
      (state-set "reg.password2" "")
      (state-set-tree "tab" (dict "rows" (list) "items" (list) "offset" 0 "more" "" "page" ""))
      (state-set-tree "prof" (dict "self" "" "following" "" "bg_pic_shown" ""))
      (state-set-tree "alerts" (dict "rows" (list) "head" "" "badge" "" "badge_n" ""))
      (state-set-tree "search" (dict "q" "" "posts" (list) "people" (list) "tags" (list)
                                     "head_people" "" "head_tags" "" "head_posts" ""
                                     "note" "Find posts, people and hashtags."))
      ;; another account's posts are not this one's to show
      (state-delete "cache")
      (state-set "compose.text" "")
      (state-set-tree "compose.files" (list))
      (state-set-tree "dm.rows" (list))
      (state-set-tree "dm.lines" (list))
      (state-set "dm.draft" "")
      (state-set "dm.pass" "")
      ;; another account's mailboxes, and what was being written, are not the next one's
      (if (has? "file-forget")
        (for f (if (state-exists "mail.new.files") (range (int (state-get "mail.new.files"))) (list))
          (file-forget (state-get (str-concat "mail.new.files." (text f) ".handle")))))
      (state-set-tree "mail" (dict "loaded" "" "none" "" "acct_ids" "" "acct_opts" "" "v_accts" ""
                                   "acct" "" "acct_pick" "" "acct_line" "" "folder" "INBOX"
                                   "folder_pick" "Inbox" "folder_opts" "" "head" "" "rows" (list)
                                   "page" "" "offset" 0 "total" 0 "want" "" "att_i" ""
                                   "save_error" ""
                                   "msg" (dict "lines" (list) "atts" (list) "draft" "" "vpid" "mail")
                                   "new" (dict "from" "" "to" "" "cc" "" "subject" "" "body" ""
                                               "files" (list) "focus" "to" "note" ""
                                               "uploading" "" "progress" 0 "draft" ""
                                               "draft_folder" "")))
      ;; what's new is the next account's: no polling until it signs in, and this one's
      ;; entries out of the host's notification feed
      (state-set-tree "session.news" (dict "on" "" "next" 0 "alert_n" "" "alert_max" 0 "alert_ids" ""
                                   "dm_primed" ""))
      (state-set "session.dm.unread" "")
      (state-set-tree "dm.seen" (dict))
      (state-set-tree "dm.feed" (dict))
      (state-set "session.dm.count" "")
      (state-set "app.site_emoji" "")
      (state-set "app.site_emoji_id" "")
      (state-set-tree "nav.icon" (dict))
      (if (feed?) (notify-clear-all))
      ;; the next account to sign in may not be an administrator
      (state-set "ui.admin" "")
      (state-set "admin.uq" "")
      (state-set "admin.tab" "Users")
      (state-set "ui.screen" "signin")
      (if is-error (fail msg) (say msg))))
  ;; The host refused the token (it expired, or was signed out elsewhere), or holds none.
  (defun session-over? (r)
    (or (= (status r) 401) (= (status r) 403)
        (and (= (status r) 0) (string.contains (get-attr r "error") "no credential"))))
  (defun session-over ()
    (begin
      (net-auth-forget (cred))
      (to-signin "Your session has expired. Sign in again." true)))
  (defun unreachable (r)
    (fail (str-concat "Can't reach " (state-get "session.host") ": " (get-attr r "error"))))
  ;; The site as its own sign-in page shows it (GET /social/site-info, no sign-in needed): its
  ;; title, tagline (description), txwtf version and logo, for the sign-in form (site_info),
  ;; and the title for the windows' titles, as the web app's. An instance without site-info
  ;; answers GET /site/title (a JSON string) at least. The title is the host when the site has
  ;; none or doesn't answer; the form then shows nothing of it. The logo (an uploaded one
  ;; first, a path on the instance or a URL) only where the host draws pictures and may reach
  ;; it: cvcpkg.com's is on cvcpkg.org, which the page may not.
  (defun load-site-info ()
    (begin
      (state-set-tree "session.site_info" (dict "name" "" "tagline" "" "version" "" "logo" ""))
      (let ((r (http-get (str-concat (base) "/social/site-info")
                         (dict "headers" (dict "Accept" "application/json")))))
        (let ((d (if (ok? r) (reply-json r) (dict))))
          (let ((name (string.trim (text (opt d "title" ""))))
                (logo (picture-url (opt d "logo_file_url" (opt d "logo" nil))))
                (version (string.trim (text (opt d "version" "")))))
            (begin
              (if (= name "")
                (let ((rt (http-get (str-concat (base) "/site/title")
                                    (dict "headers" (dict "Accept" "application/json")))))
                  (set name (if (ok? rt) (string.trim (text (reply-json rt))) ""))))
              (if (= name "{}") (set name ""))
              ;; and/or evaluate every argument: net-allowed? only sees a URL.
              (if (and (= (state-get "session.caps.pics") "1") (!= logo ""))
                (if (not (net-allowed? logo)) (set logo ""))
                (set logo ""))
              (state-set-tree "session.site_info"
                (dict "name" (clip name 60)
                      "tagline" (clip (string.trim (text (opt d "description" ""))) 60)
                      "version" (if (= version "") "" (str-concat "txwtf " version))
                      "logo" logo))
              (if (= name "") (set name (state-get "session.host")))
              (state-set "app.title" name)
              (state-set "ui.title" name)
              (state-set "app.signin_title" (str-concat "Sign in to " name))))))))

  ;; Sign in as u with p: POST /user/login, capturing the token under this site's own name.
  (defun log-in (u p)
    (begin
      (say "Signing in...")
      ;; the new session is kept under this site's own name, never the name one site's
      ;; session had before nicotina knew more than one (site-cred)
      (if (= (cred) "txwtf") (net-auth-forget "txwtf"))
      (state-set "session.cred" (site-cred-name (base)))
      ;; expire_delta: the session's length in seconds (Advanced options); it holds through
      ;; the emailed code too, which txwtf keeps with the challenge
      (after-login (post-json "/user/login"
                              (dict "username" u "password" p
                                    "expire_delta" (int (state-get "login.expire")))
                              true))))

  ;; --- a new account (ui/signin.ari's register_window) --------------------------------
  ;; The form, at the site picked: whether the site is invite-only (GET /invite/mode, public;
  ;; a site without it is taken as open), and the fields empty.
  (defun signup-form ()
    (let ((r (http-get (str-concat (base) "/invite/mode")
                       (dict "headers" (dict "Accept" "application/json")))))
      (let ((only (if (ok? r) (opt (reply-json r) "invite_only" nil) nil)))
        (begin
          (state-set-tree "reg" (dict "username" "" "name" "" "email" "" "password" ""
                                      "password2" "" "invite" "" "invite_only" (if only "1" "")
                                      "invite_note" (if only "This site is invite-only: an invite code is required."
                                                      "An invite code, if you have one (optional).")
                                      "site" (clip (str-concat "At " (state-get "app.title")
                                                               (if (= (state-get "app.title") (state-get "session.host")) ""
                                                                 (str-concat " (" (state-get "session.host") ")")))
                                                   60)))
          (state-set "app.register_title" (clip (str-concat "Create an account at " (state-get "session.host")) 60))
          (state-set "ui.screen" "register")
          (say "")))))
  ;; Why txwtf refused a new account: its detail is "message (Code)" (map_txwtf_errors); the
  ;; codes a person can act on in words of their own, the rest as txwtf says them.
  (defun reg-refused (r)
    (let ((d (detail-of r)))
      (let ((code (if (string.ends-with d ")") (car (string.split (nth-or (string.split d "(") 1) ")")) ""))
            (msg (string.trim (car (string.split d "(")))))
        (if (= (status r) 0) (unreachable r)
          (if (= (status r) 429) (fail "Too many attempts. Wait a minute, then try again.")
            (fail (clip (if (= code "UsernameExists") "That username is taken: pick another."
                          (if (= code "EmailExists") "That email address has an account here already."
                            (if (= code "InviteRequired") "This site needs an invite code."
                              (if (= code "InvalidInviteCode") (str-concat "That invite code won't do: " msg)
                                (if (= code "PasswordMismatch") "The two passwords differ."
                                  (if (= code "InvalidIdentifier")
                                    "A username is letters, digits, _ and -, starting with a letter."
                                    (if (or (= code "PasswordTooShort") (= code "PasswordTooLong")
                                            (string.starts-with code "Password"))
                                      (str-concat "The password: " msg)
                                      (if (= code "InvalidEmail") (str-concat "That email address won't do: " msg)
                                        (if (= (status r) 422) "Check the email address: it isn't one."
                                          (str-concat "Couldn't create the account: "
                                                      (if (= d "") (str-concat "HTTP " (str (status r))) msg)))))))))))
                        60)))))))

  ;; Start at the site: its title, then its session if the host keeps one, else the form (or,
  ;; for --start signup, a new account's form).
  (defun resume ()
    ;; and/or are functions here, not special forms: they evaluate every argument.
    (if (begin (load-site-info) (if (net-auth-has? (cred) (base)) (load-home) nil))
      (say (signed-in-msg))
      (if (and (= (state-get "ui.start") "signup") (!= (state-get "ui.screen") "signin"))
        (begin (state-set "ui.start" "feed") (signup-form))
        (state-set "ui.screen" (if (= (state-get "ui.screen") "boot") "signin" (state-get "ui.screen"))))))
