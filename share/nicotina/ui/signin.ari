# The signed-out windows: starting up, the sign-in form, and the emailed code. main.ari imports
# these units and runs the commands their buttons set (ui.cmd).
#
# Laid out for the terminal first (8 x 16 px cells): every window opens at column 2, row 2, and
# is 62 columns wide, so it fits 80 columns. The controller keeps its messages to 60 characters.
# The width is fixed, and the status row always there, for the tvision host: it refits a window
# that opens, but one that closes and opens again in the same run (the sign-in form after
# signing out) comes back at its first size, which would cut off a message that wasn't there.

units:
  # The controller's last word, info as is and errors in red. Always one row, even when empty
  # (see the top of this file).
  # While a request is out (ui.busy) a spinner turns beside it ("Signing in...", "Checking the
  # code...", "Refreshing..."). The spinner turns by the host's frame clock, since the
  # controller is parked on the request. A host without the spinner widget shows the line alone.
  status_line:
    type: group
    children:
      - spinner: ""
        bind: ui.msg
        visible_when: (and (= (state-get "ui.busy") "1") (has? "spinner"))
      - text: ""
        bind: '(if (= (state-get "ui.msg") "") " " (state-get "ui.msg"))'
        visible_when: (and (!= (state-get "ui.err") "1") (not (and (= (state-get "ui.busy") "1") (has? "spinner"))))
      - text: ""
        bind: ui.msg
        color: [1.0, 0.45, 0.4]
        visible_when: (and (= (state-get "ui.err") "1") (not (and (= (state-get "ui.busy") "1") (has? "spinner"))))

  starting_window:
    window: nicotina
    id: starting
    pos: [16, 32]
    size: [496, auto]
    visible_when: (= (state-get "ui.screen") "boot")
    children:
      - spinner: ""
        bind: '(string.join (list "Connecting to" (state-get "app.host") "...") " ")'
        visible_when: (has? "spinner")
      - text: ""
        bind: '(string.join (list "Connecting to" (state-get "app.host") "...") " ")'
        visible_when: (not (has? "spinner"))

  signin_window:
    window: Sign in to TX.WTF
    id: signin
    pos: [16, 32]
    size: [496, auto]
    visible_when: (= (state-get "ui.screen") "signin")
    children:
      - text: "Instance"
        bind: app.base
      - separator
      - input_text: Username
        bind: login.username
        autofocus: true          # each time the form opens, so a person can type at once
      # Masked (a bullet per character in a terminal, ImGui's password field in a window). The
      # value still sits in login.password while it is typed; the controller clears it as soon
      # as it sends it, whatever the outcome.
      - input_text: Password
        bind: login.password
        password: true
      - button: Sign in
        on: (state-set "ui.cmd" "login")
        enabled_when: (!= (state-get "ui.busy") "1")
      - include: status_line

  twofactor_window:
    window: Two-step verification
    id: twofactor
    pos: [16, 32]
    size: [496, auto]
    visible_when: (= (state-get "ui.screen") "2fa")
    children:
      - text: ""
        bind: '(string.join (list "Signing in as" (state-get "login.username")) " ")'
      - separator
      - input_text: Code
        bind: login.code
        autofocus: true
      - type: group
        layout: {kind: horizontal}
        children:
          - button: Verify
            on: (state-set "ui.cmd" "verify")
            enabled_when: (!= (state-get "ui.busy") "1")
          - button: Back
            on: (state-set "ui.cmd" "back")
            enabled_when: (!= (state-get "ui.busy") "1")
      - include: status_line
