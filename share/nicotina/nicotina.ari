# nicotina.ari — the TX.WTF client itself, as a module: its windows (ui/*.ari), the controller that
# talks to the instance (on_tick), and what it needs from its host (requires). main.ari is the
# app around it; another document can load it the same way, into a window system of its own:
#
#   windows:
#     - load: nicotina.ari            # or its path under the other document
#       as: nicotina
#       link:
#         args: {to: args, mode: ro}  # args.instance (the site's base URL), args.user, args.start
#         ui: {to: ui, mode: rw}      # its view state, and ui.cmd, the commands it takes
#
# A loaded module is sandboxed to its own state; the links are how it reads its arguments and how
# the loader's menus reach it. Its commands are what its buttons set on ui.cmd: home, back, forward,
# refresh, compose, profile, signout, show-window (the main window again after its X), and more
# (the controller below lists them).
#
# Sign in to an instance (username, password and the emailed second factor), then use it as the
# TX.WTF web app is used, in one window: the feed and a hashtag's posts, a post with its replies,
# profiles (yours and anyone's, with Follow), the hashtags, your notifications, search, a new
# post, a viewer for a post's pictures and videos, and your direct messages, the end-to-end
# encrypted ones too where the host keeps keys. It never sends you to a web browser.
#
# The terminal comes first: every window is laid out for an 80x24 terminal, and ImGui only adds
# to it (the Details window). The sign-in windows are in ui/signin.ari; the main window and its
# bar are in ui/app.ari, and its views in ui/feed.ari, ui/home.ari, ui/social.ari, ui/card.ari
# and ui/dm.ari.
#
# The host holds the session token, never this document. Sign-in uses capture_auth, so the host
# takes the token out of the reply and keeps it; every later request names the credential with
# auth: and the host adds the header. Sign-out drops it with net-auth-forget. With
# --credential-store the host keeps it across runs, and the next start signs in from it.
#
# End-to-end encrypted DMs work the same way: with --e2ee-store the host keeps this account's
# keys and sessions (the e2ee-* verbs), seals what is sent and opens what comes, and this document
# only names its handle. Without that, an encrypted conversation stays locked, saying why.

meta:
  name: nicotina
  description: A TX.WTF client
  version: 0.0.1
  min_libcvc: 3.7.5

# Without --net (or --net-allow) the host has no http-request and keeps no credentials, and the
# load fails here, naming what is missing.
requires:
  - net
  - net.auth
  - {name: net.auth.persist, optional: true}
  - {name: spinner, optional: true}    # turns while a request is out; without it, the text alone
  - {name: media.player, optional: true}  # video and audio play; without it, a row each
  - {name: image.url, optional: true}  # the account's pictures; without it, placeholders
  - {name: image.fill, optional: true}  # pictures and video as wide as the card; else a fixed size
  - {name: text.emoji, optional: true}  # a post's :emoji: drawn; without it, the shortcodes
  - {name: text.runs, optional: true}  # a post's text rich, its links followed; else plain lines
  - {name: ui.group_click, optional: true}  # a card, its icons and hashtags clickable; else buttons
  - {name: clipboard-set, optional: true}  # Copy link; without it, the link as text
  - {name: ui.fullscreen, optional: true}  # the viewer's Full screen; without it, the window
  - {name: image.badge, optional: true}  # "+N" over the grid's last tile; else a line under it
  - {name: e2ee-seal, optional: true}  # end-to-end encrypted DMs; without it they stay locked
  - {name: file-pick, optional: true}  # Attach on a new post; without it, a post is text only
  - {name: http-upload, optional: true}  # ... and the upload of what Attach picked
  - {name: file-forget, optional: true}  # ... and Remove, letting go of a picked file
  - json-parse
  - state-set-tree

import:
  - ui/card.ari
  - ui/signin.ari
  - ui/app.ari
  - ui/home.ari
  - ui/feed.ari
  - ui/social.ari
  - ui/dm.ari
  - ui/admin.ari

init: |
  (set base (string.trim (state-get "args.instance")))
  (while (string.ends-with base "/")
    (set base (string.substring base 0 (- (string.length base) 1))))
  (state-set "app.base" base)
  ;; The instance's host, as a handle names it: no scheme, no path, no default port.
  (set host (string.lower (car (string.split
              (string.replace (string.replace base "https://" "") "http://" "") "/"))))
  (if (and (string.starts-with base "https://") (string.ends-with host ":443"))
    (set host (string.substring host 0 (- (string.length host) 4))))
  (if (and (string.starts-with base "http://") (string.ends-with host ":80"))
    (set host (string.substring host 0 (- (string.length host) 3))))
  (state-set "app.host" host)
  ;; The origin, for the root-relative URLs txwtf gives pictures (/uploads/..., /static/...).
  (state-set "app.origin"
    (if (string.contains base "://")
      (let ((parts (string.split base "://")))
        (str-concat (car parts) "://" (car (string.split (nth parts 1) "/"))))
      base))
  ;; The banner placeholder's row: the profile window's inner width (76 columns, less its frame).
  (set row "")
  (while (< (string.length row) 74) (set row (str-concat row "█")))
  (state-set "ui.banner_row" row)
  (state-set "ui.tab" "Posts")
  (state-set "ui.start" (string.lower (string.trim (state-get "args.start"))))
  ;; Where the window is (main.ari's "go"), and the views before it, for Back.
  (state-set "ui.here" "")
  (state-set "ui.back" "")
  (state-set "ui.fwd" "")
  ;; The window is titled by the site (GET /site/title, asked at start), its host until then.
  (state-set "app.title" host)
  (state-set "app.signin_title" (str-concat "Sign in to " host))
  (state-set "ui.nav" "a") ;; which copy of the bar is drawn (ui/app.ari): flipped per view
  ;; What the host can do, asked once. The controller decides from these what each card, post and
  ;; viewer item shows (card-flags, post-flags, item-flags), and a view reads that decision, one
  ;; key a widget, instead of asking (has? ...) on every frame. rich: pictures as wide as the
  ;; line (image.fill) outside a terminal, where the grid is drawn.
  (state-set "app.term" (if (has? "term") "1" ""))
  (state-set "app.pics" (if (has? "image.url") "1" ""))
  (state-set "app.media" (if (has? "media.player") "1" ""))
  (state-set "app.rich" (if (and (has? "image.url") (has? "image.fill") (not (has? "term"))) "1" ""))
  (state-set "app.badge" (if (has? "image.badge") "1" ""))
  ;; clicks: a group's click is its own and its handlers see {i} (ui.group_click, libcvc 3.7.13)
  (state-set "app.clicks" (if (has? "ui.group_click") "1" ""))
  (state-set "app.clip" (if (has? "clipboard-set") "1" ""))
  ;; runs: a post's text as rich text, its mentions, hashtags and URLs links (text.runs,
  ;; transfix/libcvc#1180); elsewhere its lines, plain
  (state-set "app.runs" (if (has? "text.runs") "1" ""))
  ;; attach: a new post's files, picked with the host's file picker and uploaded from the host
  ;; (file-pick and http-upload, libcvc 3.7.14); elsewhere a post is text only
  (state-set "app.attach" (if (and (has? "file-pick") (has? "http-upload")) "1" ""))
  ;; icons: the bar's buttons and the feed's choices as symbols (a back arrow, a house, ...),
  ;; where a window draws emoji (text.emoji: libcvc 3.7.13); elsewhere words
  (state-set "app.icons" (if (and (has? "text.emoji") (not (has? "term"))) "1" ""))
  (state-set-tree "feed" (dict "items" (list) "mode" "Following" "mode_pick" "👥 Following"
                               "source" "home" "tag" "" "title" ""
                               "more" "" "before" "" "offset" 0 "empty" "" "tail" ""))
  (state-set-tree "post" (dict "lines" (list) "media" (list) "replies" (list) "tags" ""
                               "parent" "" "mine" "" "focus_reply" "" "reply_text" ""
                               "can_delete" "" "confirm" ""))
  (state-set-tree "tab" (dict "rows" (list) "items" (list) "offset" 0 "more" "" "page" ""))
  ;; Your content filter, the profile's Settings tab: the read level (txwtf's default -3).
  (state-set-tree "set" (dict "level" -3 "head" "" "note" "" "v_level" ""))
  (state-set-tree "prof" (dict "self" "" "following" "" "bg_pic_shown" ""))
  (state-set-tree "tags" (dict "rows" (list) "more" "" "offset" 0 "head" ""))
  (state-set-tree "alerts" (dict "rows" (list) "head" "" "badge" "" "badge_n" ""))
  (state-set-tree "search" (dict "q" "" "rows" (list) "note" "Find posts and people."))
  (state-set-tree "compose" (dict "text" "" "visibility" "Public" "files" (list) "drop" ""
                                  "uploading" "" "progress" 0 "focus" "a" "note" ""))
  (state-set-tree "viewer" (dict "url" "" "kind" "" "where" "" "row" "" "i" 0))
  (state-set-tree "dm" (dict "rows" (list) "head" "" "e2ee" "" "keys_line" "" "keys_note" ""
                             "pass" "" "want" "" "lines" (list) "draft" "" "send" ""
                             "conv" (dict "id" "" "title" "" "sub" "" "note" "" "can_send" ""
                                          "can_encrypt" "" "encrypted" "")))
  ;; The Admin view (ui/admin.ari): ui.admin is "1" for an account the instance makes an
  ;; administrator (is_admin, from GET /user/), where main.ari's menu reads it too.
  (state-set "ui.admin" "")
  (state-set-tree "admin" (dict "tab" "Users" "uq" "" "uoff" 0 "ioff" 0 "loff" 0 "log_event" 0
                                "users" (list) "groups" (list) "invites" (list) "log" (list)
                                "users_head" "" "groups_head" "" "invites_head" "" "log_head" ""
                                "signup" "Open" "gname" "" "gdesc" "" "iuses" "" "inote" ""
                                "prev" "" "next" "" "page" ""))
  (state-set-tree "auser" (dict "id" "" "header" "" "state" "" "email" "" "seen" "" "counts" ""
                                "groups" "" "note" "" "self" "" "enabled" "" "admin" "" "tfa" ""))
  (state-set-tree "agroup" (dict "id" "" "name" "" "head" "" "about" "" "members" (list)
                                 "add" "" "pick" "" "confirm" ""))
  (state-set-tree "site" (dict "title" "" "about" "" "tz" "" "was_title" "" "was_about" ""
                               "was_tz" "" "groups" "" "pw" ""))
  (state-set-tree "agperm" (dict "id" "" "name" "" "head" "" "q" "" "grant" "" "off" 0
                                 "rows" (list) "pick" "" "pick_name" ""))
  (state-set "login.username" (if (state-exists "args.user") (state-get "args.user") ""))
  (state-set "login.password" "")
  (state-set "login.code" "")
  (state-set "login.challenge" "")
  (state-set "ui.busy" "")
  (if (or (string.starts-with base "https://") (string.starts-with base "http://"))
    (begin
      (state-set "ui.screen" "boot")
      (state-set "ui.msg" "")
      (state-set "ui.err" "")
      (state-set "ui.cmd" "resume"))
    (begin
      (state-set "ui.screen" "signin")
      (state-set "ui.msg" "The instance must be an http:// or https:// URL.")
      (state-set "ui.err" "1")
      (state-set "ui.cmd" "")))

# The controller. Buttons and menu items only set ui.cmd; this resident runs the command on the
# next frame, so the requests and the replies' handling live in one place. A resident has no
# per-action step budget, and while a request is out it is parked, not spinning.
#
#   resume   sign in from a credential the host already holds (--credential-store), if any
#   login    POST /user/login, capturing the token
#   verify   POST /user/login/2fa with the emailed code, capturing the token
#   back     on the code screen, back to the sign-in form; signed in, back to the view before
#   home     the feed, forgetting the views before it
#
# Going to a view ("go") loads it, remembers the view it came from, and shows it:
#   feed       the feed feed.mode names (Following, Everyone, Friends): its first page
#   tag        tag.want's posts (GET /social/timeline/tag/{tag}), in the feed's view
#   open       the post post.want names, whole (GET /social/posts/{id}), and its replies
#   profile    your own profile (GET /user/, the balance, the tab's first page)
#   user       user.want's profile (GET /user/profile/{id}), and whether you follow them
#   tags       every hashtag (GET /social/tags); alerts, your notifications (then marked read)
#   search-view, compose: the search and the new-post views; view, a post's media (view.post,
#            view.i) in the viewer
#   dms      your conversations (GET /social/dm/conversations); dm-open, dm.want's (its messages,
#            plaintext or opened by the host); dm-with, the one with the profile shown (POST
#            /social/dm/conversations?other_user_id=, made if need be)
#
# And in a view:
#   refresh  the view again (on your profile, GET /user/ too)
#   more     the feed's next page, added below; more-replies, more-tags the same
#   tab      the profile's tab ui.tab names: its first page, nothing to load (Balances), or
#            your content filter (Settings: GET /social/settings/read-level); older and newer,
#            its next page and the one before
#   read-level  set.level as your content filter (PUT /social/settings/read-level): the feeds
#            hide posts whose score (likes less dislikes) is below it
#   like, dislike, repost  on card act.i's post: a heart (POST or DELETE .../reactions), a
#            thumbs-down (POST or DELETE .../dislike; txwtf keeps one of the two), a repost
#            (POST /social/posts with repost_id, or DELETE your repost); post-like,
#            post-dislike, post-repost on the post shown
#   delete   the post shown: your own at once; for an administrator someone else's, once asked
#            (delete-yes, delete-keep). txwtf before atx-crypto-club/txwtf#324 refuses that one
#   reply    post.reply_send as a reply to the post shown; post, compose.send as a new post,
#            with the files compose.files lists (each uploaded first: POST /social/files, or the
#            resumable upload for one over 8 MiB), or compose.text when the view's Post sent it
#   attach   the host's file picker: the files picked join compose.files; detach drops the one
#            compose.drop names
#   follow, unfollow  the profile shown (POST /social/follow, DELETE /social/follow/{id})
#   search   search.q (GET /search/search); hit-open and alert-open go where a row points
#   view-prev, view-next  the viewer's other attachments
#   link     link.href, a link in a post's text: a hashtag's posts, a profile or a post here;
#            anything else copied (open-link)
#   dm-send  dm.send in the conversation shown (sealed by the host in an encrypted one);
#            dm-encrypt turns its encryption on (POST /e2ee/dm/conversations/{id}/encrypt);
#            dm-backup, dm-restore, dm-new-keys the keys (PUT and GET /e2ee/backup, POST /e2ee/keys)
#   signout  POST /user/logout, then drop the credential
#
# For an administrator (ui.admin, the account's is_admin), the Admin view (ui/admin.ari):
#   admin    the view, at the part admin.tab names; admin-tab another part, in place; admin-find,
#            admin-prev, admin-next, admin-log-filter its list again
#   auser, agroup  one account, one group; auser-disable, -enable, -admin, -unadmin, -2fa-off
#            change the account; group-create, agroup-add, -remove, -lead, -unlead, -delete
#            (which asks: agroup-delete-yes, agroup-keep) the groups; agperm a group's
#            permissions, agperm-find, -grant, -revoke them; invite-mode, invite-new,
#            invite-off, invite-on the sign-up setting and the codes; site-save the settings
#
# After each, the unread count beside Alerts is asked for again (GET /notifications/count).
on_tick: |
  (if (and (!= (state-get "ui.cmd") "") (!= (state-get "ui.busy") "1"))
    (begin
      (set cmd (state-get "ui.cmd"))
      (state-set "ui.cmd" "")
      (state-set "ui.busy" "1")

      (defun base () (state-get "app.base"))
      ;; The profile window's widths, in columns: inside its frame, and the card's text beside
      ;; the avatar. A tab's page is five rows.
      (set WIDE 74)
      (set CARD 65)
      (set PAGE 5)
      (defun clip (s n)
        (if (> (string.length s) n) (str-concat (string.substring s 0 (- n 3)) "...") s))
      ;; The status line: one row of at most 60 characters, the windows' width.
      (defun say (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" ""))
      (defun fail (msg) (state-set "ui.msg" (clip msg 60)) (state-set "ui.err" "1"))
      ;; d's value at k, or dflt when d is no dict, lacks k, or holds null there.
      (defun opt (d k dflt)
        (if (= (type-of d) "dict")
          (try (let ((v (get-attr d k))) (if (= (type-of v) "nil") dflt v)) (catch (e) dflt))
          dflt))
      ;; Whether d has k and it is false. JSON's false reads as nil here, so (opt d k true) can't
      ;; tell a false from a missing key: an account's "enabled" needs this.
      (defun off? (d k)
        (if (and (= (type-of d) "dict")
                 (> (length (collections.filter (collections.dict-keys d) (lambda (x) (= x k)))) 0))
          (not (get-attr d k))
          nil))
      ;; str quotes a string, so only non-strings go through it.
      (defun text (v) (if (is-string v) v (str v)))
      (defun reply-json (r) (try (json-parse (get-attr r "body")) (catch (e) (dict))))
      (defun status (r) (get-attr r "status"))
      (defun ok? (r) (and (>= (status r) 200) (< (status r) 300)))

      (defun post-json (path payload capture)
        (let ((o (dict "headers" (dict "Content-Type" "application/json"
                                       "Accept" "application/json")
                       "body" (json-encode payload))))
          (begin
            (if capture (set-attr o "capture_auth" (dict "name" "txwtf" "field" "token")))
            (http-request "POST" (str-concat (base) path) o))))
      (defun get-authed (path)
        (http-get (str-concat (base) path)
                  (dict "auth" "txwtf" "headers" (dict "Accept" "application/json"))))
      ;; With a query: the host percent-encodes it.
      (defun get-query (path q)
        (http-get (str-concat (base) path)
                  (dict "auth" "txwtf" "headers" (dict "Accept" "application/json") "query" q)))
      ;; POST (or another verb) with a JSON body, signed in; payload nil sends none.
      (defun send-authed (method path payload)
        (http-request method (str-concat (base) path)
          (if (= (type-of payload) "nil")
            (dict "auth" "txwtf" "headers" (dict "Accept" "application/json"))
            (dict "auth" "txwtf"
                  "headers" (dict "Accept" "application/json" "Content-Type" "application/json")
                  "body" (json-encode payload)))))

      ;; A decimal string as people write it: 1234.5678900000 -> 1234.56789. One in exponent
      ;; form (0E-10) becomes a float, which state-set-tree writes in its shortest form (0).
      (defun plain-number (s)
        (begin
          (set s (text s))
          (if (or (string.contains s "E") (string.contains s "e"))
            (float s)
            (begin
              (if (string.contains s ".")
                (begin
                  (while (string.ends-with s "0")
                    (set s (string.substring s 0 (- (string.length s) 1))))
                  (if (string.ends-with s ".")
                    (set s (string.substring s 0 (- (string.length s) 1))))))
              s))))
      (defun dollars (cents)
        (let ((c (int cents)) (sign ""))
          (begin
            (if (< c 0) (begin (set sign "-") (set c (- 0 c))))
            (set r (% c 100))
            (str-concat sign "$" (str (int (/ (- c r) 100))) "." (if (< r 10) "0" "") (str r)))))

      (defun to-signin (msg is-error)
        (begin
          (state-set "login.password" "")
          (state-set "login.code" "")
          (state-set "login.challenge" "")
          (state-set-tree "me" (dict))
          (state-set-tree "scrip" (dict))
          (state-set "ui.tab" "Posts") ;; the next profile opens at Posts, as the web app's does
          (state-set "ui.here" "")
          (state-set "ui.back" "")
          (state-set-tree "feed" (dict "items" (list) "mode" "Following" "source" "home" "tag" ""
                                       "title" "" "more" "" "before" "" "offset" 0 "empty" ""
                                       "tail" ""))
          (state-set-tree "post" (dict "lines" (list) "media" (list) "replies" (list) "tags" ""
                                       "parent" "" "mine" "" "focus_reply" "" "reply_text" ""
                                       "can_delete" "" "confirm" ""))
          (state-set-tree "set" (dict "level" -3 "head" "" "note" "" "v_level" ""))
          (state-set-tree "tab" (dict "rows" (list) "items" (list) "offset" 0 "more" "" "page" ""))
          (state-set-tree "prof" (dict "self" "" "following" "" "bg_pic_shown" ""))
          (state-set-tree "alerts" (dict "rows" (list) "head" "" "badge" "" "badge_n" ""))
          (state-set-tree "search" (dict "q" "" "rows" (list) "note" "Find posts and people."))
          (state-set "compose.text" "")
          (state-set-tree "compose.files" (list))
          (state-set-tree "dm.rows" (list))
          (state-set-tree "dm.lines" (list))
          (state-set "dm.draft" "")
          (state-set "dm.pass" "")
          ;; the next account to sign in may not be an administrator
          (state-set "ui.admin" "")
          (state-set "admin.uq" "")
          (state-set "admin.tab" "Users")
          (state-set "ui.screen" "signin")
          (if is-error (fail msg) (say msg))))
      ;; The host refused the token (it expired, or was signed out elsewhere), or holds none.
      (defun session-over? (r)
        (or (= (status r) 401) (= (status r) 403)
            (and (= (status r) 0) (string.contains (get-attr r "error") "no credential"))))
      (defun session-over ()
        (begin
          (net-auth-forget "txwtf")
          (to-signin "Your session has expired. Sign in again." true)))
      (defun unreachable (r)
        (fail (str-concat "Can't reach " (state-get "app.host") ": " (get-attr r "error"))))
      ;; A request that did something (a like, a post) failed. Only a 401 ends the session here:
      ;; a 403 is the instance refusing that one thing.
      (defun act-failed (r what)
        (if (or (= (status r) 401)
                (and (= (status r) 0) (string.contains (get-attr r "error") "no credential")))
          (session-over)
          (if (= (status r) 0) (unreachable r)
            (let ((d (opt (reply-json r) "detail" "")))
              (fail (str-concat "Couldn't " what
                                (if (is-string d) (str-concat ": " d) "")
                                " (HTTP " (str (status r)) ")."))))))

      ;; The full handle: @user@host. A brokered (federated) account's username already ends
      ;; in its home instance (txwtf names it <user>@<home domain>), so it keeps that one.
      (defun handle (u)
        (str-concat "@" u (if (string.contains u "@") "" (str-concat "@" (state-get "app.host")))))
      ;; The card's first row: the handle, then as much of the display name as fits.
      (defun header (h name)
        (let ((room (- CARD (string.length h) 2)))
          (if (or (= name "") (< room 4)) (clip h CARD) (str-concat h "  " (clip name room)))))
      (defun pad (s n) ;; s cut or filled with spaces to exactly n columns
        (begin
          (set s (clip s n))
          (while (< (string.length s) n) (set s (str-concat s " ")))
          s))
      ;; Text as txwtf stores it is plain, or the rich editor's HTML (a tag in it, as txwtf
      ;; tells them apart). One line of it: the tags out, the common entities decoded, every run
      ;; of white space one space.
      (defun one-line (s)
        (begin
          (set s (text s))
          (if (string.contains s "<")
            (begin
              (set out "")
              (set in-tag nil)
              (set i 0)
              (while (< i (string.length s))
                (set c (string.char-at s i))
                (if in-tag
                  (if (= c ">") (set in-tag nil))
                  (if (= c "<") (begin (set in-tag true) (set out (str-concat out " ")))
                    (set out (str-concat out c))))
                (set i (+ i 1)))
              (set s out)))
          (for e (list (list "&nbsp;" " ") (list "&lt;" "<") (list "&gt;" ">")
                       (list "&quot;" "\"") (list "&#39;" "'") (list "&amp;" "&"))
            (set s (string.replace s (car e) (car (cdr e)))))
          (set s (string.replace (string.replace (string.replace s "\r" " ") "\n" " ") "\t" " "))
          (while (string.contains s "  ") (set s (string.replace s "  " " ")))
          ;; a tag between a word and its punctuation left a space before it (a colon only where
          ;; a space follows it: " :smile:" is an emoji's shortcode, kept apart from the word)
          (for p (list "." "," ";" "!" "?")
            (set s (string.replace s (str-concat " " p) p)))
          (set s (string.replace s " : " ": "))
          (string.trim s)))
      ;; A picture's URL as a request names it: txwtf gives /uploads/... and /static/... from
      ;; the instance's origin, or a whole URL; "" for none.
      (defun picture-url (u)
        (begin
          (set u (text (if (= (type-of u) "nil") "" u)))
          (if (or (string.starts-with u "https://") (string.starts-with u "http://")) u
            (if (string.starts-with u "/") (str-concat (state-get "app.origin") u) ""))))
      ;; A post's emoji, from the content_html txwtf renders (render_emoji_html): a custom one is
      ;;   <img class="custom-emoji" src="/social/emojis/12/image" alt=":gear:" ...>
      ;; and a standard one <span class="emoji" title=":100:">💯</span>. A map of their names to
      ;; the picture's URL or the character, for the text's emoji: (the host draws a picture in
      ;; the line, or puts the character in place of the shortcode).
      (defun attr (tag name) ;; the value of name="..." in a tag's text, or ""
        (let ((parts (string.split tag (str-concat name "=\""))))
          (if (> (length parts) 1) (car (string.split (nth parts 1) "\"")) "")))
      (defun shortcode (s) ;; ":gear:" -> "gear", else ""
        (if (and (> (string.length s) 2) (string.starts-with s ":") (string.ends-with s ":"))
          (string.substring s 1 (- (string.length s) 2))
          ""))
      (defun emoji-of (html)
        (let ((m (dict))
              (h (text (if (= (type-of html) "nil") "" html))))
          (begin
            (for part (cdr (string.split h "<img class=\"custom-emoji\""))
              (let ((name (shortcode (attr part "alt")))
                    (src (picture-url (attr part "src"))))
                (if (and (!= name "") (!= src "")) (set-attr m (string.lower name) src))))
            (for part (cdr (string.split h "<span class=\"emoji\""))
              (let ((name (shortcode (attr part "title")))
                    (pieces (string.split part ">")))
                (if (and (!= name "") (> (length pieces) 1))
                  (let ((ch (car (string.split (nth pieces 1) "<"))))
                    (if (!= ch "") (set-attr m (string.lower name) ch))))))
            m)))
      ;; A post's text as rich text runs (text.runs: transfix/libcvc#1180), read from the same
      ;; content_html: <strong> and <b> bold, <em> and <i> italic, <code> and <pre> code, an <a>
      ;; a link to its href (txwtf's mention is /user/NAME, its hashtag /tag/NAME, a URL itself),
      ;; </p>, <br> and an item a new line, a custom emoji its :name: (the text's emoji: draws
      ;; it). A run is a string, or {text, style, href}: what a text's runs: takes. Without
      ;; content_html (a reposted post's brief, a locked post), the plain text, its @names,
      ;; #tags and URLs linked as txwtf links them.
      (defun unescape (s)
        (begin
          (for e (list (list "&nbsp;" " ") (list "&lt;" "<") (list "&gt;" ">")
                       (list "&quot;" "\"") (list "&#39;" "'") (list "&#x27;" "'") (list "&amp;" "&"))
            (set s (string.replace s (car e) (car (cdr e)))))
          s))
      (defun run-style (b i c)
        (string.trim (str-concat (if (> b 0) "bold " "") (if (> i 0) "italic " "")
                                 (if (> c 0) "code" ""))))
      ;; (text style href) pieces, in order, as runs: neighbours alike joined, a plain one a
      ;; string, the paragraph's leading and trailing line breaks dropped.
      (defun merge-runs (parts)
        (begin
          (set out (list))
          (set txt "")
          (set st "")
          (set hr "")
          (for p parts
            (if (!= (car p) "")
              (if (and (= (nth p 1) st) (= (nth p 2) hr))
                (set txt (str-concat txt (car p)))
                (begin
                  (if (!= txt "") (set out (append out (run-item txt st hr))))
                  (set txt (car p))
                  (set st (nth p 1))
                  (set hr (nth p 2))))))
          (while (string.ends-with txt "\n")
            (set txt (string.substring txt 0 (- (string.length txt) 1))))
          (if (!= txt "") (set out (append out (run-item txt st hr))))
          out))
      (defun run-item (txt st hr)
        (if (= hr "")
          (if (= st "") txt (dict "text" txt "style" st))
          (if (= st "") (dict "text" txt "href" hr) (dict "text" txt "style" st "href" hr))))
      (defun html-runs (h)
        (begin
          (set parts (list))
          (set b 0)
          (set i 0)
          (set c 0)
          (set href "")
          (set lead true) ;; nothing written yet: a line break here is dropped
          ;; each piece a tag and the text after it; the text before the first tag has none
          (set split (string.split h "<"))
          (set pieces (list (str-concat ">" (car split))))
          (for pc (cdr split) (set pieces (append pieces pc)))
          (for piece pieces
            (begin
              (set gt (string.split piece ">"))
              (set tag (string.trim (car gt)))
              (set after (string.join (cdr gt) ">"))
              (set name (string.lower (car (string.split tag " "))))
              (if (string.ends-with name "/")
                (set name (string.substring name 0 (- (string.length name) 1))))
              (if (or (= name "strong") (= name "b")) (set b (+ b 1)))
              (if (or (= name "/strong") (= name "/b")) (set b (math.max 0 (- b 1))))
              (if (or (= name "em") (= name "i")) (set i (+ i 1)))
              (if (or (= name "/em") (= name "/i")) (set i (math.max 0 (- i 1))))
              (if (or (= name "code") (= name "pre")) (set c (+ c 1)))
              (if (or (= name "/code") (= name "/pre")) (set c (math.max 0 (- c 1))))
              (if (= name "a") (set href (unescape (attr tag "href"))))
              (if (= name "/a") (set href ""))
              (if (and (not lead)
                       (string.contains "|br|/p|/div|/h1|/h2|/h3|/h4|/h5|/h6|/blockquote|/pre|/li|"
                                        (str-concat "|" name "|")))
                (set parts (append parts (list "\n" "" ""))))
              (if (= name "li") (set parts (append parts (list "• " "" ""))))
              (if (and (= name "img") (string.contains tag "custom-emoji"))
                (set parts (append parts (list (attr tag "alt") (run-style b i c) href))))
              ;; the text after the tag: entities decoded, the source's line breaks spaces
              ;; (outside code)
              (set after (unescape after))
              (if (= c 0)
                (set after (string.replace (string.replace (string.replace after "\r" "") "\n" " ")
                                           "\t" " ")))
              (if (= c 0)
                (while (and lead (string.starts-with after " "))
                  (set after (string.substring after 1 (- (string.length after) 1)))))
              (if (!= after "") (set lead nil))
              (if (and (= name "img") (string.contains tag "custom-emoji")) (set lead nil))
              (set parts (append parts (list after (run-style b i c) href)))))
          (merge-runs parts)))
      ;; A word of plain text as txwtf links it: a URL (its trailing punctuation too, as txwtf's
      ;; pattern takes it), or a #tag or @name without its trailing punctuation.
      (defun word-parts (w)
        (if (or (string.starts-with w "https://") (string.starts-with w "http://"))
          (list (list w "" w))
          (if (and (> (string.length w) 1)
                   (or (string.starts-with w "#") (string.starts-with w "@")))
            (begin
              (set core w)
              (set tail "")
              (set going true)
              (while going
                (if (> (string.length core) 2)
                  (let ((ch (string.substring core (- (string.length core) 1) 1)))
                    (if (string.contains ".,;:!?)'\"" ch)
                      (begin
                        (set tail (str-concat ch tail))
                        (set core (string.substring core 0 (- (string.length core) 1))))
                      (set going nil)))
                  (set going nil)))
              (list (list core ""
                          (str-concat (if (string.starts-with core "#") "/tag/" "/user/")
                                      (string.substring core 1 (- (string.length core) 1))))
                    (list tail "" "")))
            (list (list w "" "")))))
      (defun plain-runs (s)
        (begin
          (set parts (list))
          (set first-line true)
          (for line (string.split (string.replace (text s) "\r" "") "\n")
            (begin
              (if (not first-line) (set parts (append parts (list "\n" "" ""))))
              (set first-line nil)
              (set first-word true)
              (for w (string.split line " ")
                (begin
                  (if (not first-word) (set parts (append parts (list " " "" ""))))
                  (set first-word nil)
                  (for p (word-parts w) (set parts (append parts p)))))))
          (merge-runs parts)))
      ;; Whether a post's text is drawn as rich text here (app.runs, asked once at start).
      (defun rich? () (= (state-get "app.runs") "1"))
      (defun runs-of (html plain)
        (let ((h (text (if (= (type-of html) "nil") "" html))))
          (if (= (string.trim h) "") (plain-runs (text (if (= (type-of plain) "nil") "" plain)))
            (html-runs h))))
      ;; A post's runs as a card or the post's view shows them: a repost's own words (a quote)
      ;; before the post it reposts, " | " between, as body-of does.
      (defun post-runs (q)
        (let ((p (shown q))
              (own (runs-of (opt q "content_html" nil) (opt q "content" ""))))
          (if (= (type-of (opt q "reposted_post" nil)) "dict")
            (let ((orig (runs-of (opt p "content_html" nil) (opt p "content" ""))))
              (if (= (length own) 0) orig
                (begin
                  (set all own)
                  (set all (append all " | "))
                  (for r orig (set all (append all r)))
                  all)))
            own)))
      ;; Whether a picture URL is a video, as txwtf's web app decides (isVideoMediaUrl): it plays
      ;; .mp4, .webm, .mov and .m4v avatars, banners and backgrounds as muted loops. Until the
      ;; host has a video widget, those keep their placeholder: image: can't draw them.
      (defun video-url? (u)
        (let ((path (string.lower (car (string.split (car (string.split (text u) "?")) "#")))))
          (or (string.ends-with path ".mp4") (string.ends-with path ".webm")
              (string.ends-with path ".mov") (string.ends-with path ".m4v"))))
      ;; The URL for an image: slot: a picture's, or "" for none or a video.
      (defun picture-only (u) (if (video-url? u) "" u))
      ;; The avatar's placeholder: a frame with the initials, 8 x 4 (64 px square) in a terminal.
      (defun initials (name)
        (let ((words (collections.filter (string.split (string.trim name) " ")
                                         (lambda (w) (!= w "")))))
          (string.upper
            (if (= (length words) 0) "?"
              (if (= (length words) 1) (string.substring (car words) 0 1)
                (str-concat (string.substring (car words) 0 1)
                            (string.substring (nth words (- (length words) 1)) 0 1)))))))
      (defun avatar-box (ini)
        (if (has? "term")
          (list "╭──────╮" "│      │" (str-concat "│" (pad (str-concat "  " ini) 6) "│")
                "╰──────╯")
          (list " " (str-concat "(" ini ")") " " " ")))
      ;; What a profile view shows of an account (GET /user/ for yours, /user/profile/{id} for
      ;; anyone's). bar is how many columns its action bar's buttons take.
      (defun profile-of (p bar)
        (let ((user (text (opt p "username" "")))
              (name (text (opt p "name" ""))))
          (begin
            ;; The badges, as the web app shows them beside the name: an administrator, the
            ;; account's emblems, then its presence (txwtf's raw status) and a disabled account.
            (set badges (list))
            (if (opt p "is_admin" nil) (set badges (append badges "admin")))
            (for e (opt p "emblems" (list))
              (set badges (append badges (text (opt e "name" (opt e "emblem_type" "emblem"))))))
            (if (!= (text (opt p "status" "")) "") (set badges (append badges (text (opt p "status" "")))))
            (if (off? p "enabled") (set badges (append badges "disabled")))
            ;; The counts row: where they last signed in from, joined, posts, views.
            (set stats (list))
            (if (!= (text (opt p "last_login_country" "")) "")
              (set stats (append stats (text (opt p "last_login_country" "")))))
            (if (!= (text (opt p "created_time" "")) "")
              (set stats (append stats (str-concat "Joined "
                                                   (string.substring (text (opt p "created_time" "")) 0 10)))))
            (set stats (append stats (str-concat (text (opt p "post_count" 0)) " posts")))
            (set stats (append stats (str-concat (text (opt p "view_count" 0)) " views")))
            (set groups (collections.map (opt p "groups" (list)) (lambda (g) (text (opt g "group_name" "")))))
            (dict "id" (opt p "id" 0)
                    "username" user
                    "handle" (handle user)
                    "header" (header (handle user) name)
                    "name" name
                    "badges" (if (= (length badges) 0) " " (clip (string.join badges " · ") CARD))
                    "stats" (clip (string.join stats " · ") CARD)
                    "about" (one-line (opt p "description" ""))
                    "about_short" (clip (one-line (opt p "description" "")) CARD)
                    "presence" (text (opt p "status" "-"))
                    ;; A brokered account's local email is a placeholder in .invalid; its real
                    ;; address is its home instance's.
                    "email" (let ((e (text (opt p "email" ""))))
                              (if (string.ends-with e ".invalid") "-" e))
                    "email_verified" (if (opt p "email_verified" nil) "yes" "no")
                    "two_factor" (if (opt p "login_2fa_email_enabled" nil) "on" "off")
                    "avatar_url" (picture-url (opt p "avatar_url" nil))
                    "header_url" (picture-url (opt p "header_image_url" nil))
                    "card_url" (picture-url (opt p "card_image_url" nil))
                    ;; what the image: slots show: the pictures, never a video
                    "avatar_pic" (picture-only (picture-url (opt p "avatar_url" nil)))
                    "header_pic" (picture-only (picture-url (opt p "header_image_url" nil)))
                    "card_pic" (picture-only (picture-url (opt p "card_image_url" nil)))
                    "bg_url" (picture-url (opt p "profile_bg_url" nil))
                    "bg_pic" (picture-only (picture-url (opt p "profile_bg_url" nil)))
                    "avatar_box" (avatar-box (initials (if (= name "") user name)))
                    ;; Beside the action bar's buttons
                    "groups_line" (pad (if (= (length groups) 0) " "
                                         (str-concat "Groups: " (string.join groups ", ")))
                                       (- WIDE bar))
                    "groups" groups))))
      ;; Yours: kept in me.* (the Details window, the sign-in form after signing out), and shown
      ;; in the profile view as prof.*. [ Refresh ][ Sign out ] take 23 columns, and an
      ;; administrator's [ Admin ] 9 more. Whether you are one is ui.admin (the Admin view's way
      ;; in, and main.ari's menu).
      (defun show-profile (p)
        (let ((admin (if (opt p "is_admin" nil) true nil)))
          (let ((d (profile-of p (if admin 32 23))))
            (begin
              (state-set "login.username" (text (opt p "username" "")))
              (state-set "ui.admin" (if admin "1" ""))
              (state-set-tree "me" d)
              d))))
      (defun show-balance (b)
        (state-set-tree "scrip"
          (dict "symbol" (opt b "symbol" "SCRIP")
                "balance" (plain-number (opt b "balance" "0"))
                "value" (dollars (opt b "cents_equivalent" 0)))))

      ;; A tab's page: five rows, always, so the window keeps its height. Each row is a post's
      ;; date, its text on one line, and its counts, then Open ([ Open ] takes 8 columns).
      (defun post-row (q)
        (let ((counts (str-concat "  ↩" (text (opt q "reply_count" 0))
                                  " ♥" (text (opt q "reaction_count" 0))))
              (body (one-line (opt q "content" ""))))
          (begin
            (if (= body "")
              (set body (if (> (length (opt q "attachments" (list))) 0) "(attachment)" "(no text)")))
            (dict "id" (text (opt q "id" ""))
                  "line" (str-concat (string.substring (text (opt q "created_at" "")) 0 10) "  "
                                     (pad body (- WIDE 21 (string.length counts))) counts " ")))))
      (defun show-rows (rows)
        (begin
          (while (< (length rows) PAGE) (set rows (append rows (dict "id" "" "line" " "))))
          (state-set-tree "tab.rows" rows)))
      ;; In a window the tab's posts are cards (ui/card.ari's card_list over tab.items); a
      ;; terminal keeps the rows, a page of which fits 80x24.
      ;; None in a terminal, and none on the Balances tab: the list is shown as it is.
      (defun show-cards (posts)
        (state-set-tree "tab.items" (if (cap "term") (list) (collections.map posts feed-card))))
      (defun note-row (s) (dict "id" "" "line" s))
      ;; Your content filter (the Settings tab): GET /social/settings/read-level. A post whose
      ;; score, its likes less its dislikes, is below your level is left out of your feeds
      ;; (txwtf keeps your own posts and promoted ones in). ui/home.ari offers ten levels, -10
      ;; to 20 as the web app's slider goes; one set elsewhere is named in the note.
      (defun level-name (v)
        (if (<= v -10) "show everything"
          (if (< v 0) "hide flagged"
            (if (= v 0) "neutral and up"
              (if (< v 20) "well received only" "only top-rated")))))
      (defun read-level-note (v)
        (str-concat "Hiding posts scored below " (text v) " (" (level-name v) ")"
                    (if (= v -3) ", the default." ".")))
      (defun load-read-level ()
        (let ((r (get-authed "/social/settings/read-level")))
          (if (ok? r)
            (let ((v (int (opt (reply-json r) "read_level" -3))))
              (begin
                (state-set "set.level" v)
                (state-set "set.v_level" "1")
                (state-set "set.head" "Your content filter: a post's score is its likes less its dislikes.")
                (state-set "set.note" (read-level-note v))
                true))
            (begin
              (state-set "set.v_level" "")
              (state-set "set.head" "")
              (if (or (= (status r) 404) (= (status r) 405))
                (begin (state-set "set.note" "This server has no content filter.") true)
                (begin
                  (state-set "set.note" "Couldn't load your content filter.")
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Couldn't load your content filter (HTTP "
                                        (str (status r)) ")."))))
                  nil))))))
      ;; The tab ui.tab names, from tab.offset: Posts asks for a page of five; Replies, as the
      ;; web app does, asks for twenty posts and replies together and keeps the replies.
      (defun load-tab ()
        (let ((tab (state-get "ui.tab"))
              (off (int (state-get "tab.offset"))))
          (if (= tab "Balances")
            (begin (show-cards (list)) (state-set "tab.empty" "") true)
          (if (= tab "Settings")
            (begin (show-cards (list)) (state-set "tab.empty" "") (load-read-level))
            (let ((r (get-authed (str-concat "/social/timeline/user/" (text (state-get "prof.id"))
                                             (if (= tab "Posts")
                                               (str-concat "?include_replies=false&limit=" (text PAGE))
                                               "?include_replies=true&limit=20")
                                             "&offset=" (text off)))))
              (if (ok? r)
                (let ((posts (opt (reply-json r) "posts" (list))))
                  (begin
                    (if (= tab "Replies")
                      (set posts (collections.filter posts
                                   (lambda (q) (!= (type-of (opt q "reply_to_id" nil)) "nil")))))
                    (if (> (length posts) PAGE) (set posts (slice posts 0 PAGE)))
                    (show-rows (if (= (length posts) 0)
                                 (list (note-row (if (= tab "Posts") "No posts yet." "No replies yet.")))
                                 (collections.map posts post-row)))
                    (show-cards posts)
                    (state-set "tab.empty" (if (= (length posts) 0)
                                             (if (= tab "Posts") "No posts yet." "No replies yet.")
                                             ""))
                    (state-set "tab.more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                    (state-set "tab.page"
                      (if (and (= off 0) (= (state-get "tab.more") "")) ""
                        (str-concat "  Page " (text (+ 1 (int (/ off (if (= tab "Posts") PAGE 20))))))))
                    true))
                (begin
                  (show-rows (list (note-row (str-concat "Couldn't load the " (string.lower tab) "."))))
                  (show-cards (list))
                  (state-set "tab.empty" (str-concat "Couldn't load the " (string.lower tab) "."))
                  (state-set "tab.more" "")
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Couldn't load the " (string.lower tab) " (HTTP "
                                        (str (status r)) ")."))))
                  nil)))))))

      ;; Who is signed in: GET /user/. True when it came back. With own, the profile view shows
      ;; it too.
      (defun load-me-into (own)
        (let ((r (get-authed "/user/")))
          (if (ok? r)
            (let ((d (show-profile (reply-json r))))
              (begin
                (if own
                  (state-set-tree "prof"
                    (collections.dict-merge d (dict "self" "1" "following" "" "bg_pic_shown" ""))))
                true))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your profile (HTTP " (str (status r)) ")."))))
              nil))))
      (defun load-me () (load-me-into nil))
      ;; Someone else's profile: GET /user/profile/{id}, and whether you follow them. Their tab
      ;; can't be Balances. [ Unfollow ][ Message ] take 23 columns.
      (defun load-user (id)
        (let ((r (get-authed (str-concat "/user/profile/" (text id)))))
          (if (ok? r)
            (let ((d (profile-of (reply-json r) 23))
                  (f (get-authed (str-concat "/social/follow/check/" (text id)))))
              (begin
                (state-set-tree "prof"
                  (collections.dict-merge d (dict "self" ""
                                                  "following" (if (and (ok? f) (opt (reply-json f) "is_following" nil)) "1" "")
                                                  "bg_pic_shown" "")))
                (if (or (= (state-get "ui.tab") "Balances") (= (state-get "ui.tab") "Settings"))
                  (state-set "ui.tab" "Posts"))
                (state-set "tab.offset" 0)
                (load-tab)))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load that profile (HTTP " (str (status r)) ")."))))
              nil))))
      ;; The rest of your profile: the balance, then the tab's first page.
      (defun load-profile ()
        (let ((b (get-authed "/billing/scrip/balance")))
          (if (ok? b)
            (begin
              (show-balance (reply-json b))
              (state-set "tab.offset" 0)
              (load-tab))
            (begin
              (state-set-tree "scrip" (dict "symbol" "SCRIP" "balance" "unavailable" "value" "-"))
              (if (session-over? b) (session-over)
                (if (= (status b) 0) (unreachable b)
                  (fail (str-concat "The SCRIP balance isn't available (HTTP "
                                    (str (status b)) ")."))))
              nil))))

      ;; --- the feed: cards ---------------------------------------------------------------
      ;; A card's text is CARDW columns wide: the window's inside, less its scroll bar and the
      ;; card's frame.
      (set CARDW 70)
      (set FEEDPAGE 10)
      ;; s's words in lines of at most n columns; a longer word is cut.
      (defun wrap (s n)
        (begin
          (set lines (list))
          (set line "")
          (for w (string.split s " ")
            (if (!= w "")
              (begin
                (while (> (string.length w) n)
                  (if (!= line "") (begin (set lines (append lines line)) (set line "")))
                  (set lines (append lines (string.substring w 0 n)))
                  (set w (string.substring w n (string.length w))))
                (if (= line "")
                  (set line w)
                  (if (<= (+ (string.length line) 1 (string.length w)) n)
                    (set line (str-concat line " " w))
                    (begin (set lines (append lines line)) (set line w)))))))
          (if (!= line "") (set lines (append lines line)))
          lines))
      ;; Paragraphs, for a post shown whole: the rich editor's </p> and <br> end one.
      (defun paragraphs (s)
        (begin
          (set s (text s))
          (for b (list "</p>" "<br>" "<br/>" "<br />") (set s (string.replace s b "\n")))
          (collections.filter (collections.map (string.split s "\n") one-line)
                              (lambda (p) (!= p "")))))
      (defun nth-or (l k) (if (> (length l) k) (nth l k) ""))
      (defun posted-at (iso) ;; 2026-10-30T22:40:00 -> 2026-10-30 22:40 (txwtf's time, UTC)
        (let ((stamp (text iso)))
          (if (>= (string.length stamp) 16)
            (str-concat (string.substring stamp 0 10) " " (string.substring stamp 11 5))
            stamp)))
      (defun human-size (n)
        (let ((n (int n)))
          (if (< n 1024) (str-concat (text n) " B")
            (if (< n 1048576) (str-concat (text (int (math.round (/ n 1024)))) " KB")
              (str-concat (text (/ (int (math.round (/ n 104857.6))) 10)) " MB")))))
      ;; txwtf gives an attachment's mime type, never a kind.
      (defun kind (mime)
        (if (string.starts-with mime "image/") "image"
          (if (string.starts-with mime "video/") "video"
            (if (string.starts-with mime "audio/") "audio" "file"))))
      (defun media-row (a)
        (if (or (opt a "deleted" nil) (= (opt a "url" "") ""))
          "[deleted attachment]"
          (let ((alt (one-line (opt a "alt_text" ""))))
            (str-concat "[" (kind (text (opt a "mime_type" ""))) "] " (text (opt a "filename" ""))
                        " · " (human-size (opt a "file_size" 0))
                        (if (= alt "") "" (str-concat " · " alt))))))
      ;; A post's pictures and videos, in order, each with its place among what the viewer shows
      ;; (every attachment with a URL but a file): the tiles of its grid.
      (defun tiles-of (media)
        (let ((tiles (list)) (vn 0))
          (begin
            (for m media
              (if (and (!= (kind (text (opt m "mime_type" ""))) "file") (!= (opt m "url" "") ""))
                (begin
                  (if (or (= (kind (text (opt m "mime_type" ""))) "image")
                          (= (kind (text (opt m "mime_type" ""))) "video"))
                    (set tiles (append tiles (dict "url" (picture-url (opt m "url" nil))
                                                   "kind" (kind (text (opt m "mime_type" "")))
                                                   "vi" (text vn)))))
                  (set vn (+ vn 1)))))
            tiles)))
      (defun tile (tiles k f) (if (> (length tiles) k) (opt (nth tiles k) f "") ""))
      ;; The grid, as tx.wtf lays a post's pictures and videos out: gn the tiles it shows (0 to
      ;; 4), g0..g3 each tile's picture, kind and place in the viewer, and gmore "+N" when there
      ;; are more than four (the viewer has them all).
      (defun grid-fields (tiles)
        (let ((n (length tiles)))
          (dict "gn" (text (if (> n 4) 4 n))
                "gmore" (if (> n 4) (str-concat "+" (text (- n 4))) "")
                "gmore_line" (if (> n 4) (str-concat "+" (text (- n 4)) " more: View shows them all") "")
                "g0_url" (tile tiles 0 "url") "g0_kind" (tile tiles 0 "kind") "g0_vi" (tile tiles 0 "vi")
                "g1_url" (tile tiles 1 "url") "g1_kind" (tile tiles 1 "kind") "g1_vi" (tile tiles 1 "vi")
                "g2_url" (tile tiles 2 "url") "g2_kind" (tile tiles 2 "kind") "g2_vi" (tile tiles 2 "vi")
                "g3_url" (tile tiles 3 "url") "g3_kind" (tile tiles 3 "kind") "g3_vi" (tile tiles 3 "vi"))))
      ;; The URL of the first attachment of a kind ("video", "audio"), or "".
      (defun first-of (media k)
        (let ((hits (collections.filter media
                      (lambda (m) (and (= (kind (text (opt m "mime_type" ""))) k)
                                       (!= (opt m "url" "") ""))))))
          (if (= (length hits) 0) "" (picture-url (opt (nth hits 0) "url" nil)))))
      ;; "1" when every attachment is a picture or a video: the grid shows them all, so a card on a
      ;; host that draws the grid needs no rows for them.
      (defun only-visual (media)
        (if (= (length (collections.filter media
                         (lambda (m) (let ((k (kind (text (opt m "mime_type" "")))))
                                       (and (!= k "image") (!= k "video"))))))
               0)
          "1" ""))
      ;; The show/hide decisions, "1" or "" each, from the host's capabilities (app.*, set once
      ;; by init) and the post: the views' visible_when read them.
      (defun flag (b) (if b "1" ""))
      (defun cap (k) (= (state-get (str-concat "app." k)) "1"))
      (defun card-flags (avpic tags pic vid au tiles only m0 viewable)
        (let ((rich (cap "rich")) (term (cap "term")) (pics (cap "pics")) (media (cap "media")))
          (dict "v_avpic" (flag (and pics (!= avpic "")))
                "v_avtxt" (flag (not (and pics (!= avpic ""))))
                ;; outside a terminal, where a click on a group is its own: the card opens its
                ;; post, its count icons act, its hashtags are chips; elsewhere the buttons, and
                ;; the hashtags a radio row (a line of them in a terminal)
                "v_click" (flag (and (cap "clicks") (not term)))
                "v_btns" (flag (not (and (cap "clicks") (not term))))
                "v_chips" (flag (and (cap "clicks") (not term) (!= tags "")))
                "v_tagline" (flag (and term (!= tags "")))
                "v_tagrow" (flag (and (not term) (not (cap "clicks")) (!= tags "")))
                ;; one picture or video, or a grid: as wide as the line where the host
                ;; measures it (rich), else at fixed sizes; a terminal shows the first picture
                ;; and the first video
                "v_grid" (flag (and rich (> (length tiles) 0)))
                "v_fgrid" (flag (and pics (not rich) (not term) (> (length tiles) 0)))
                "v_pic_t" (flag (and pics term (!= pic "")))
                "v_vid_t" (flag (and media term (!= vid "")))
                "v_audio" (flag (and media (!= au "")))
                ;; no rows where the pictures show every attachment: View moves to the buttons
                "v_rows" (flag (and (!= m0 "") (not (and pics (not term) (= only "1")))))
                "v_viewbtn" (flag (and pics (not term) (= only "1") viewable))
                "v_gmore" (flag (and (> (length tiles) 4) (not (cap "badge")))))))
      (defun post-flags (avpic tiles tags)
        (let ((pics (cap "pics")) (click (and (cap "clicks") (not (cap "term")))))
          (dict "v_avpic" (flag (and pics (!= avpic "")))
                "v_avtxt" (flag (not (and pics (!= avpic ""))))
                "v_click" (flag click)
                "v_btns" (flag (not click))
                "v_chips" (flag (and click (!= tags "")))
                "v_tagrow" (flag (and (not click) (!= tags "")))
                "v_grid" (flag (and (cap "rich") (> (length tiles) 0)))
                "v_fgrid" (flag (and pics (not (cap "rich")) (not (cap "term")) (> (length tiles) 0)))
                "v_term" (flag (cap "term"))
                "v_gmore" (flag (and (> (length tiles) 4) (not (cap "badge")))))))
      ;; An attachment's own (a post's, the viewer's): its picture or player as wide as the line
      ;; (_fill), at a fixed size (_fix), in a terminal (_t), its recording's player, and View.
      (defun item-flags (k)
        (let ((term (cap "term")) (pics (cap "pics")) (media (cap "media")) (rich (cap "rich")))
          (dict "v_img_fill" (flag (and rich (= k "image")))
                "v_img_fix" (flag (and pics (not rich) (= k "image")))
                "v_img_w" (flag (and pics (not rich) (not term) (= k "image")))
                "v_img_t" (flag (and pics term (= k "image")))
                "v_vid_fill" (flag (and media rich (= k "video")))
                "v_vid_fix" (flag (and media (not rich) (= k "video")))
                "v_vid_w" (flag (and media (not rich) (not term) (= k "video")))
                "v_vid_t" (flag (and media term (= k "video")))
                "v_aud" (flag (and media (= k "audio")))
                "v_view" (flag (!= k "file")))))
      ;; Its hashtags as chips: t0..t5, and tmore for the rest.
      (defun chip-fields (tags)
        (let ((l (if (= tags "") (list) (string.split tags "|"))))
          (dict "t0" (nth-or l 0) "t1" (nth-or l 1) "t2" (nth-or l 2)
                "t3" (nth-or l 3) "t4" (nth-or l 4) "t5" (nth-or l 5)
                "tmore" (if (> (length l) 6) (str-concat "+" (text (- (length l) 6))) ""))))
      ;; Its counts as icons to press: reply, repost (green once you have), like (red once you
      ;; have), dislike (blue once you have), and the views. txwtf tells only a post's author
      ;; how many dislike it (dislike_count); everyone else sees the icon alone.
      (defun icon-fields (q)
        (let ((dc (opt q "dislike_count" nil)))
          (dict "c_reply" (str-concat " ↩ " (text (opt q "reply_count" 0)) " ")
                "c_repost" (str-concat " ⇄ " (text (opt q "repost_count" 0)) " ")
                "c_like" (str-concat " ♥ " (text (opt q "reaction_count" 0)) " ")
                "c_dislike" (if (= (type-of dc) "nil") " ▼ " (str-concat " ▼ " (text dc) " "))
                "c_views" (str-concat "· " (text (opt q "view_count" 0)) " views"))))
      (defun merge4 (a b c d)
        (collections.dict-merge (collections.dict-merge (collections.dict-merge a b) c) d))
      ;; The site's own name (GET /site/title, a JSON string, no sign-in needed): the window's
      ;; title, as the web app's. Its host when the site has none or doesn't answer.
      (defun load-site-title ()
        (let ((r (http-get (str-concat (base) "/site/title")
                           (dict "headers" (dict "Accept" "application/json")))))
          (let ((name (if (ok? r) (string.trim (text (reply-json r))) "")))
            (begin
              (if (or (= name "") (= name "{}")) (set name (state-get "app.host")))
              (state-set "app.title" name)
              (state-set "app.signin_title" (str-concat "Sign in to " name))))))
      (defun counts-of (q)
        (str-concat "↩" (text (opt q "reply_count" 0)) " ⇄" (text (opt q "repost_count" 0))
                    " ♥" (text (opt q "reaction_count" 0)) " · " (text (opt q "view_count" 0))
                    " views"))
      (defun author-name (a)
        (let ((n (text (opt a "name" ""))))
          (if (= n "") (text (opt a "username" "?")) n)))
      ;; What a card shows of a post: a repost shows the post it reposts, under a note.
      (defun shown (q)
        (let ((r (opt q "reposted_post" nil)))
          (if (= (type-of r) "dict") r q)))
      (defun repost-note (q)
        (if (= (type-of (opt q "reposted_post" nil)) "dict")
          (clip (str-concat "⇄ " (author-name (opt q "author" (dict))) " reposted") CARDW)
          ""))
      ;; A repost's own words (a quote) go before the post it reposts.
      (defun body-of (q)
        (let ((own (one-line (opt q "content" "")))
              (orig (one-line (opt (shown q) "content" ""))))
          (if (= (type-of (opt q "reposted_post" nil)) "dict")
            (if (= own "") orig (str-concat own " | " orig))
            own)))
      (defun web-of (q) (str-concat (state-get "app.origin") "/app/post/" (text (opt q "id" 0))))
      ;; The hashtags in a post's text, each once, in order, as txwtf finds them (#word): the
      ;; options of a radio row, "|" between them, and a line of them.
      (defun hashtags (s)
        (let ((tags (list)))
          (begin
            (for w (string.split (one-line s) " ")
              (begin
                (while (and (> (string.length w) 1)
                            (string.contains ".,;:!?)'\"" (string.substring w (- (string.length w) 1) 1)))
                  (set w (string.substring w 0 (- (string.length w) 1))))
                (if (and (string.starts-with w "#") (> (string.length w) 1)
                         (not (string.contains (string.substring w 1 (- (string.length w) 1)) "#")))
                  (set tags (append tags (string.lower w))))))
            (collections.unique tags))))
      (defun tag-options (q) (string.join (hashtags (str-concat (opt q "content" "") " "
                                                                (opt (shown q) "content" "")))
                                          "|"))
      ;; Whether you liked, disliked or reposted it, after its counts.
      (defun yours (p)
        (str-concat (if (opt p "user_has_reacted" nil) " · liked" "")
                    (if (opt p "user_has_disliked" nil) " · disliked" "")
                    (if (opt p "user_has_reposted" nil) " · reposted" "")))
      (defun feed-card (q)
        (let ((p (shown q))
              (a (opt (shown q) "author" (dict))))
          (begin
            (set lines (wrap (body-of q) CARDW))
            ;; three lines at most: the third ends in ... when there is more
            (if (> (length lines) 3)
              (set lines (list (nth lines 0) (nth lines 1)
                               (clip (str-concat (nth lines 2) " " (nth lines 3)) CARDW))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set ini (str-concat "(" (initials (author-name a)) ")"))
            (set tags (tag-options q))
            ;; View is there for a post with something the viewer shows
            (set viewable (> (length (collections.filter media
                                        (lambda (m) (and (!= (kind (text (opt m "mime_type" ""))) "file")
                                                         (!= (opt m "url" "") ""))))) 0))
            (set tiles (tiles-of media))
            (set avpic (picture-only (picture-url (opt a "avatar_url" nil))))
            ;; the first picture, shown inline where the host can
            (set pic (let ((pics (collections.filter media
                                   (lambda (m) (and (= (kind (text (opt m "mime_type" ""))) "image")
                                                    (!= (opt m "url" "") ""))))))
                       (if (= (length pics) 0) "" (picture-url (opt (nth pics 0) "url" nil)))))
            (set vid (first-of media "video"))
            (set au (first-of media "audio"))
            (set only (only-visual media))
            (set m0 (if (> (length media) 0)
                      (if viewable (str-concat (pad (media-row (nth media 0)) (- CARDW 9)) " ")
                        (clip (media-row (nth media 0)) CARDW))
                      ""))
            (collections.dict-merge
             (merge4 (grid-fields tiles)
                     (card-flags avpic tags pic vid au tiles only m0 viewable)
                     (chip-fields tags)
                     (icon-fields q))
             (dict "id" (opt q "id" 0)
                  ;; the post the buttons act on: a repost's is the post it reposts
                  "pid" (opt p "id" (opt q "id" 0))
                  "liked" (if (opt p "user_has_reacted" nil) "1" "")
                  "disliked" (if (opt p "user_has_disliked" nil) "1" "")
                  "reposted" (if (opt p "user_has_reposted" nil) "1" "")
                  "my_repost" (text (opt p "user_repost_id" ""))
                  "web" (web-of p)
                  "note" (repost-note q)
                  "tags" tags
                  "tag_pick" ""
                  "tagline" (clip (string.replace tags "|" "  ") CARDW)
                  "has_media" (if viewable "1" "")
                  "only_visual" only
                  "avatar" ini
                  ;; a picture for the avatar slot; a video avatar keeps the initials
                  "avatar_url" avpic
                  ;; beside the avatar (4 columns) and a space
                  "head" (clip (str-concat (author-name a) "  " (handle (text (opt a "username" "?"))))
                               (- CARDW 5))
                  "at" (posted-at (opt p "created_at" ""))
                  "pic" pic
                  ;; its text: rich text where the host draws it (three lines of the card's
                  ;; width, ui/card.ari), else its first three lines, plain
                  "v_runs" (if (rich?) "1" "")
                  "runs" (if (rich?) (post-runs q) (list))
                  "l0" (if (rich?) "" (nth-or lines 0))
                  "l1" (if (rich?) "" (nth-or lines 1))
                  "l2" (if (rich?) "" (nth-or lines 2))
                  ;; the emoji in its text (a repost's quote and the post it reposts)
                  "emoji" (collections.dict-merge (emoji-of (opt q "content_html" nil))
                                                  (emoji-of (opt p "content_html" nil)))
                  ;; with [ View ] (8 columns) after it, for a post with something to view
                  "m0" m0
                  "m0_url" (if (> (length media) 0) (picture-url (opt (nth media 0) "url" nil)) "")
                  "m0_kind" (if (> (length media) 0) (kind (text (opt (nth media 0) "mime_type" ""))) "")
                  "m1" (if (> (length media) 1) (clip (media-row (nth media 1)) CARDW) "")
                  "m1_url" (if (> (length media) 1) (picture-url (opt (nth media 1) "url" nil)) "")
                  "m1_kind" (if (> (length media) 1) (kind (text (opt (nth media 1) "mime_type" ""))) "")
                  ;; the first video and the first recording, played in the card where the host can
                  "vid_url" vid
                  "au_url" au
                  "mmore" (if (> (length media) 2)
                            (str-concat "+" (text (- (length media) 2)) " more (Open shows them all)")
                            "")
                  ;; the buttons follow the counts: [ Open ][ Reply ][ Like ][ Repost ] take 35
                  ;; columns
                  "counts" (pad (str-concat (counts-of q) (yours p)) (- CARDW 35)))))))

      ;; A page of the feed: Following is GET /social/timeline/home, Everyone the public one,
      ;; Friends /social/timeline/friends. mode=latest pages cleanly by before_id (the ranked
      ;; order re-ranks each page). A hashtag's posts (feed.source "tag") are GET
      ;; /social/timeline/tag/{tag}, paged by offset. The first page replaces the cards; a later
      ;; one is added below them.
      (defun load-feed (first)
        (let ((everyone (= (state-get "feed.mode") "Everyone"))
              (tagged (= (state-get "feed.source") "tag")))
          (let ((r (if tagged
                     (get-query (str-concat "/social/timeline/tag/" (state-get "feed.tag"))
                                (dict "limit" (text FEEDPAGE)
                                      "offset" (text (if first 0 (int (state-get "feed.offset"))))))
                     (get-authed (str-concat "/social/timeline/"
                                             (if everyone "public"
                                               (if (= (state-get "feed.mode") "Friends") "friends" "home"))
                                             "?mode=latest&limit=" (text FEEDPAGE)
                                             (if first ""
                                               (str-concat "&before_id=" (state-get "feed.before"))))))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (begin
                  (set cards (collections.map (opt b "posts" (list)) feed-card))
                  (if first
                    (state-set-tree "feed.items" cards)
                    (begin
                      (set n (int (state-get "feed.items")))
                      (for c cards
                        (state-set-tree (str-concat "feed.items." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "feed.items" n)))
                  (set total (int (state-get "feed.items")))
                  (state-set "feed.before" (text (opt b "next_before_id" "")))
                  (state-set "feed.offset" total)
                  (state-set "feed.more" (if (opt b "has_more" nil) "1" ""))
                  (state-set "feed.empty"
                    (if (> total 0) ""
                      (if tagged (str-concat "No posts name #" (state-get "feed.tag") ".")
                        (if everyone "No posts yet."
                          (if (= (state-get "feed.mode") "Friends")
                            "No posts from friends yet: people you follow who follow you."
                            "Your feed is empty. Follow people, or Show: Everyone.")))))
                  (if tagged
                    (state-set "feed.title"
                      (str-concat "#" (state-get "feed.tag") "  ·  "
                                  (text total) (if (= total 1) " post" " posts")
                                  (if (= (state-get "feed.more") "1") " so far" ""))))
                  (state-set "feed.tail"
                    (str-concat "  " (text total) (if (= total 1) " post" " posts")
                                (if (= (state-get "feed.more") "1") "" "; no more")))
                  true))
              (begin
                (if (session-over? r) (session-over)
                  (if (= (status r) 0) (unreachable r)
                    (fail (str-concat "Couldn't load " (if tagged "the hashtag" "the feed")
                                      " (HTTP " (str (status r)) ")."))))
                nil)))))

      ;; A reply, as the post's view lists it: who and when (and Open, 8 columns), then two
      ;; lines of it.
      (defun reply-row (q)
        (let ((lines (wrap (one-line (opt q "content" "")) WIDE))
              (a (opt q "author" (dict))))
          (begin
            (if (> (length lines) 2)
              (set lines (list (nth lines 0) (clip (str-concat (nth lines 1) " " (nth lines 2)) WIDE))))
            (dict "id" (text (opt q "id" ""))
                  "head" (pad (str-concat (author-name a) "  " (handle (text (opt a "username" "?")))
                                          "  " (posted-at (opt q "created_at" ""))
                                          "  ↩" (text (opt q "reply_count" 0)))
                              (- WIDE 8))
                  ;; two lines of it: rich text where the host draws it, else plain
                  "v_runs" (if (rich?) "1" "")
                  "runs" (if (rich?)
                           (let ((rs (runs-of (opt q "content_html" nil) (opt q "content" ""))))
                             (if (= (length rs) 0) (list "(no text)") rs))
                           (list))
                  "l0" (if (rich?) "" (if (= (length lines) 0) "(no text)" (nth lines 0)))
                  "l1" (if (rich?) "" (nth-or lines 1))
                  "emoji" (emoji-of (opt q "content_html" nil))))))
      ;; The post's replies (GET /social/posts/{id}/replies), oldest first: the first page, or the
      ;; next one added below.
      (set REPLYPAGE 10)
      (defun load-replies (first)
        (let ((off (if first 0 (int (state-get "post.replies")))))
          (let ((r (get-query (str-concat "/social/posts/" (text (state-get "post.pid")) "/replies")
                              (dict "limit" (text REPLYPAGE) "offset" (text off)))))
            (if (ok? r)
              (let ((rows (collections.map (opt (reply-json r) "replies" (list)) reply-row)))
                (begin
                  (if first
                    (state-set-tree "post.replies" rows)
                    (begin
                      (set n off)
                      (for c rows
                        (state-set-tree (str-concat "post.replies." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "post.replies" n)))
                  (state-set "post.replies_more" (if (opt (reply-json r) "has_more" nil) "1" ""))
                  (set total (int (state-get "post.replies")))
                  (state-set "post.replies_head"
                    (if (= total 0) "No replies yet."
                      (str-concat (text total) (if (= total 1) " reply" " replies")
                                  (if (= (state-get "post.replies_more") "1") " so far" ""))))
                  true))
              (begin
                (state-set "post.replies_head" "Couldn't load the replies.")
                (state-set "post.replies_more" "")
                true)))))

      ;; A post's attachments, each a row (with View, 8 columns, for what the viewer shows), its
      ;; picture's URL and kind, and vi, its place among what the viewer shows.
      (defun post-media (media)
        (let ((out (list)) (vn 0))
          (begin
            (for m media
              (begin
                (set out (append out
                           (collections.dict-merge
                            (item-flags (kind (text (opt m "mime_type" ""))))
                            (dict "row" (if (= (kind (text (opt m "mime_type" ""))) "file")
                                          (clip (media-row m) WIDE)
                                          (pad (media-row m) (- WIDE 8)))
                                  "url" (picture-url (opt m "url" nil))
                                  "kind" (kind (text (opt m "mime_type" "")))
                                  "vi" (text vn)
                                  "where" (clip (str-concat "  " (picture-url (opt m "url" nil))) WIDE)))))
                (if (and (!= (kind (text (opt m "mime_type" ""))) "file") (!= (opt m "url" "") ""))
                  (set vn (+ vn 1)))))
            out)))

      ;; One post in full: GET /social/posts/{id}, which also has its reactions.
      (defun show-post (q)
        (let ((p (shown q)))
          (begin
            (set lines (list))
            (for para (if (= (type-of (opt q "reposted_post" nil)) "dict")
                        (append (paragraphs (opt q "content" "")) (body-of (dict "content" (opt p "content" ""))))
                        (paragraphs (opt q "content" "")))
              (for l (wrap para WIDE) (set lines (append lines l))))
            (set media (opt p "attachments" (list)))
            (if (= (type-of media) "nil") (set media (list)))
            (set reactions (collections.map (opt q "reactions_summary" (list))
                             (lambda (e) (str-concat ":" (text (opt e "emoji" "?")) ": "
                                                     (text (opt e "count" 0))))))
            (set parent (opt p "reply_to_id" nil))
            (set author (opt p "author" (dict)))
            (set tiles (tiles-of media))
            (set tags (tag-options q))
            (state-set-tree "post"
             (collections.dict-merge
              (merge4
               (grid-fields tiles)
               (post-flags (picture-only (picture-url (opt (opt p "author" (dict)) "avatar_url" nil)))
                           tiles tags)
               (chip-fields tags)
               (icon-fields q))
              (dict "id" (opt q "id" 0)
                    ;; the post the buttons act on: a repost's is the post it reposts
                    "pid" (opt p "id" (opt q "id" 0))
                    "liked" (if (opt p "user_has_reacted" (opt q "user_has_reacted" nil)) "1" "")
                    "disliked" (if (opt p "user_has_disliked" (opt q "user_has_disliked" nil)) "1" "")
                    "reposted" (if (opt p "user_has_reposted" (opt q "user_has_reposted" nil)) "1" "")
                    "my_repost" (text (opt p "user_repost_id" (opt q "user_repost_id" "")))
                    "mine" (if (= (text (opt author "username" "")) (state-get "me.username")) "1" "")
                    ;; Delete: your own post, or anyone's for an administrator (who is asked
                    ;; first: confirm)
                    "can_delete" (if (or (= (text (opt author "username" "")) (state-get "me.username"))
                                         (admin?))
                                   "1" "")
                    "confirm" ""
                    "author_handle" (handle (text (opt author "username" "?")))
                    "author_id" (text (opt author "id" ""))
                    "parent" (if (= (type-of parent) "nil") "" (text parent))
                    "parent_note" "a post"
                    "tags" tags
                    "tag_pick" ""
                    "link" (clip (str-concat "Link: " (web-of p)) WIDE)
                    "web" (web-of p)
                    "note" (repost-note q)
                    "avatar" (str-concat "(" (initials (author-name (opt p "author" (dict)))) ")")
                    "avatar_url" (picture-only (picture-url (opt (opt p "author" (dict)) "avatar_url" nil)))
                    "head" (clip (str-concat (author-name (opt p "author" (dict))) "  "
                                             (handle (text (opt (opt p "author" (dict)) "username" "?"))))
                                 (- WIDE 6))
                    "at" (posted-at (opt p "created_at" ""))
                    ;; its text: rich text where the host draws it, else its lines, plain
                    "v_runs" (if (rich?) "1" "")
                    "runs" (if (rich?)
                             (let ((rs (post-runs q))) (if (= (length rs) 0) (list "(no text)") rs))
                             (list))
                    "lines" (if (rich?) (list) (if (= (length lines) 0) (list "(no text)") lines))
                    "emoji" (collections.dict-merge (emoji-of (opt q "content_html" nil))
                                                    (emoji-of (opt p "content_html" nil)))
                    "media" (post-media media)
                    "counts" (str-concat (counts-of q) (yours p))
                    "reactions" (if (= (length reactions) 0) ""
                                  (clip (str-concat "Reactions: " (string.join reactions "  ")) WIDE))
                    ;; kept across a reload of the same post (after a reply, a like)
                    "focus_reply" (state-get "post.focus_reply")
                    "reply_text" (if (= (text (state-get "post.pid")) (text (opt p "id" (opt q "id" 0))))
                                   (state-get "post.reply_text") "")
                    "replies" (list)
                    "replies_head" ""
                    "replies_more" "")))
            ;; who wrote the post it replies to
            (if (!= (type-of parent) "nil")
              (let ((pr (get-authed (str-concat "/social/posts/" (text parent)))))
                (if (ok? pr)
                  (state-set "post.parent_note"
                    (clip (str-concat " " (author-name (opt (reply-json pr) "author" (dict))) ": "
                                      (one-line (opt (reply-json pr) "content" "")))
                          (- WIDE 15))))))
            (load-replies true))))

      ;; A post, whole, by id: GET /social/posts/{id}, then its replies.
      (defun load-post (id)
        (let ((r (get-authed (str-concat "/social/posts/" (text id)))))
          (if (ok? r)
            (begin (show-post (reply-json r)) true)
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (if (= (status r) 404) "That post is gone."
                          (str-concat "Couldn't open the post (HTTP " (str (status r)) ").")))))
              nil))))

      ;; --- the other views -------------------------------------------------------------
      ;; Every hashtag (GET /social/tags), the most named first: a page of twenty rows, a row's
      ;; name and count, then Open (8 columns).
      (set TAGPAGE 20)
      (defun load-tags (first)
        (let ((off (if first 0 (int (state-get "tags.rows")))))
          (let ((r (get-query "/social/tags" (dict "limit" (text TAGPAGE) "offset" (text off)
                                                   "order_by" "post_count" "order_desc" "true"))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (begin
                  (set rows (collections.map (opt b "tags" (list))
                              (lambda (tg)
                                (let ((n (text (opt tg "post_count" 0))))
                                  (dict "name" (text (opt tg "name" ""))
                                        "line" (pad (str-concat "#" (text (opt tg "name" "")) "  ·  " n
                                                                (if (= n "1") " post" " posts"))
                                                    (- WIDE 8)))))))
                  (if first
                    (state-set-tree "tags.rows" rows)
                    (begin
                      (set n off)
                      (for c rows
                        (state-set-tree (str-concat "tags.rows." (text n)) c)
                        (set n (+ n 1)))
                      (state-set "tags.rows" n)))
                  (set total (int (state-get "tags.rows")))
                  (state-set "tags.more" (if (< total (int (opt b "total" 0))) "1" ""))
                  (state-set "tags.head"
                    (if (= total 0) "No hashtags yet."
                      (str-concat (text (opt b "total" total)) " hashtags, the most named first")))
                  true))
              (begin
                (if (session-over? r) (session-over)
                  (if (= (status r) 0) (unreachable r)
                    (fail (str-concat "Couldn't load the hashtags (HTTP " (str (status r)) ")."))))
                nil)))))

      ;; The unread count beside Alerts (GET /notifications/count). Quiet: it never says a thing,
      ;; and a failure leaves the count as it was.
      (defun load-badge ()
        (let ((r (get-authed "/notifications/count")))
          (if (ok? r)
            (let ((n (int (opt (reply-json r) "unviewed_count" 0))))
              (begin
                ;; " 2 new" beside the icons; " 2" beside the words, which fill a terminal's row
                (state-set "alerts.badge" (if (> n 0) (str-concat " " (text n) " new") ""))
                (state-set "alerts.badge_n" (if (> n 0) (str-concat " " (text n)) "")))))))
      ;; Your notifications, newest first, then all of them marked read (POST
      ;; /notifications/viewed), as the web app marks them when its list opens.
      (defun load-alerts ()
        (let ((r (get-query "/notifications/" (dict "limit" "20" "offset" "0"))))
          (if (ok? r)
            (let ((b (reply-json r)))
              (begin
                (set rows (collections.map (opt b "notifications" (list))
                            (lambda (n)
                              (let ((kind (text (opt n "related_type" "")))
                                    (target (text (opt n "related_id" ""))))
                                (begin
                                  (set openable (and (!= target "") (or (= kind "post") (= kind "user"))))
                                  (dict "kind" kind
                                        "target" (if openable target "")
                                        "line" (pad (str-concat (if (opt n "viewed" nil) "  " "● ")
                                                                (one-line (opt n "message" "")))
                                                    (if openable (- WIDE 8) WIDE))
                                        "at" (str-concat "  " (posted-at (opt n "created_at" ""))
                                                         "  " (text (opt n "notification_type" "")))))))))
                (state-set-tree "alerts.rows" rows)
                (set unread (int (opt b "unviewed_count" 0)))
                (state-set "alerts.head"
                  (if (= (length rows) 0) "No notifications."
                    (str-concat (text (opt b "total_count" (length rows))) " notifications"
                                (if (> unread 0) (str-concat ", " (text unread) " new") ""))))
                (if (> unread 0) (send-authed "POST" "/notifications/viewed" (dict)))
                (state-set "alerts.badge" "")
                (state-set "alerts.badge_n" "")
                true))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your notifications (HTTP " (str (status r)) ")."))))
              nil))))

      ;; Posts, people and hashtags (GET /search/search?q=), as txwtf groups them: results.posts,
      ;; .users and .hashtags, each {items, total}. A row each, then Open (8 columns), and a line
      ;; of what it says.
      (defun bucket (results k)
        (let ((items (opt (opt results k (dict)) "items" (list))))
          (if (= (type-of items) "list") items (list))))
      (defun hit-row (h)
        (let ((kind (text (opt h "type" "")))
              (who (opt h "author" nil)))
          (dict "kind" kind
                "id" (text (opt h "id" ""))
                "tag" (string.replace (text (opt h "title" "")) "#" "")
                ;; a post's title is often empty: its author's name then, and the full handle
                "line" (pad (str-concat (if (= kind "user") "[person] "
                                          (if (= kind "hashtag") "[tag] " "[post] "))
                                        (let ((title (one-line (opt h "title" ""))))
                                          (if (or (!= title "") (!= (type-of who) "dict")) title
                                            (author-name who)))
                                        (if (= (type-of who) "dict")
                                          (str-concat " · " (handle (text (opt who "username" ""))))
                                          ""))
                            (- WIDE 8))
                "snippet" (clip (str-concat "  " (one-line (opt h "snippet" ""))) WIDE))))
      (defun run-search ()
        (let ((q (string.trim (state-get "search.q"))))
          (if (< (string.length q) 2)
            (begin (state-set "search.note" "Type two letters or more.") true)
            (let ((r (get-query "/search/search" (dict "q" q "limit" "10"))))
              (if (ok? r)
                (let ((results (opt (reply-json r) "results" (dict))))
                  (begin
                    (set hits (list))
                    (if (= (type-of results) "dict")
                      (for k (list "posts" "users" "hashtags")
                        (for h (bucket results k) (set hits (append hits h)))))
                    (state-set-tree "search.rows" (collections.map hits hit-row))
                    (state-set "search.note"
                      (if (= (length hits) 0) (str-concat "Nothing matches \"" q "\".")
                        (str-concat (text (length hits)) " found for \"" q "\"")))
                    true))
                (begin
                  (if (session-over? r) (session-over)
                    (if (= (status r) 0) (unreachable r)
                      (fail (str-concat "Search failed (HTTP " (str (status r)) ")."))))
                  nil))))))

      ;; The viewer: the attachments of post view.post that it shows (pictures, video and audio),
      ;; at viewer.i.
      (defun viewer-at (i)
        (let ((items (state-get "viewer.n")))
          (if (> (int items) 0)
            (let ((k (% (+ (% (int i) (int items)) (int items)) (int items))))
              (begin
                (state-set "viewer.i" k)
                (state-set "viewer.url" (state-get (str-concat "viewer.items." (text k) ".url")))
                (state-set "viewer.kind" (state-get (str-concat "viewer.items." (text k) ".kind")))
                (state-set-tree "viewer.v"
                  (item-flags (state-get (str-concat "viewer.items." (text k) ".kind"))))
                (state-set "viewer.row" (state-get (str-concat "viewer.items." (text k) ".row")))
                (state-set "viewer.where"
                  (str-concat "  " (text (+ k 1)) " of " (text items))))))))
      (defun load-viewer (pid i)
        (let ((r (get-authed (str-concat "/social/posts/" (text pid)))))
          (if (ok? r)
            (let ((media (opt (shown (reply-json r)) "attachments" (list))))
              (begin
                (if (= (type-of media) "nil") (set media (list)))
                (set shows (collections.filter media
                             (lambda (m) (and (!= (kind (text (opt m "mime_type" ""))) "file")
                                              (!= (opt m "url" "") "")))))
                (state-set-tree "viewer.items"
                  (collections.map shows
                    (lambda (m) (dict "url" (picture-url (opt m "url" nil))
                                      "kind" (kind (text (opt m "mime_type" "")))
                                      "row" (clip (media-row m) WIDE)))))
                (state-set "viewer.n" (length shows))
                (if (= (length shows) 0)
                  (begin (fail "That post has nothing to view.") nil)
                  (begin (viewer-at i) true))))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't open the post (HTTP " (str (status r)) ")."))))
              nil))))

      ;; --- the instance's administration (ui/admin.ari) ----------------------------------
      ;; For an administrator (ui.admin): the accounts, the groups, invite codes, the site's
      ;; settings and the system log. txwtf answers a missing permission with 401 and a detail
      ;; ending in (AccessDenied), so those 401s are a refusal here, not a session that ended.
      (set USERPAGE 6)
      (set LISTPAGE 10)
      ;; JSON's false for a request's body: the literal false reads as nil (json-encode: null,
      ;; which txwtf takes for "leave it as it is"); (not true) is the bool.
      (set NO (not true))
      (defun admin? () (= (state-get "ui.admin") "1"))
      (defun refused? (r)
        (if (= (status r) 401)
          (string.contains (text (opt (reply-json r) "detail" "")) "AccessDenied")
          nil))
      (defun admin-load-failed (r what)
        (if (refused? r) (fail (str-concat "This account may not see " what " here."))
          (if (session-over? r) (session-over)
            (if (= (status r) 0) (unreachable r)
              (fail (str-concat "Couldn't load " what " (HTTP " (str (status r)) ")."))))))
      (defun admin-failed (r what)
        (if (refused? r) (fail (str-concat "This account may not " what " here."))
          (act-failed r what)))
      ;; A request that changes something: true when the instance took it.
      (defun admin-send (method path payload what)
        (let ((r (send-authed method path payload)))
          (if (ok? r) true (begin (admin-failed r what) nil))))
      (defun left (s n) (let ((s (text s))) (if (> (string.length s) n) (string.substring s 0 n) s)))
      (defun plural (n one many) (str-concat (text n) " " (if (= (int n) 1) one many)))
      ;; Prev, Next and "Page 2 of 3" for a list at offset off of total, per to a page.
      (defun pager (off per total)
        (begin
          (state-set "admin.prev" (if (> off 0) "1" ""))
          (state-set "admin.next" (if (< (+ off per) total) "1" ""))
          (state-set "admin.page"
            (if (<= total per) ""
              (str-concat "  Page " (text (+ 1 (int (/ off per)))) " of "
                          (text (int (/ (+ total (- per 1)) per))))))))
      (defun no-pager () (begin (state-set "admin.prev" "") (state-set "admin.next" "")
                                (state-set "admin.page" "")))

      ;; Users: GET /user/list, newest first, the usernames with admin.uq in them. A row is
      ;; @user and name, when they joined, and what they are (cells 35, 11 and 14 columns wide:
      ;; ui/admin.ari's col_widths, which a browser window's natural width holds), then Open.
      (defun user-flags (u)
        (let ((f (list)))
          (begin
            (if (opt u "is_admin" nil) (set f (append f "admin")))
            (if (off? u "enabled") (set f (append f "disabled")))
            (string.join f " "))))
      (defun user-row (u)
        (dict "id" (text (opt u "id" ""))
              "who" (clip (str-concat "@" (text (opt u "username" "")) "  " (text (opt u "name" "")))
                          33)
              "joined" (left (opt u "created_time" "") 10)
              "flags" (clip (user-flags u) 14)))
      (defun load-admin-users ()
        (let ((q (string.trim (text (state-get "admin.uq"))))
              (off (int (state-get "admin.uoff"))))
          (let ((r (get-query "/user/list"
                     (collections.dict-merge
                      (dict "limit" (text USERPAGE) "offset" (text off)
                            "order_by" "created_time" "order_desc" "true")
                      (if (= q "") (dict) (dict "username" q))))))
            (if (ok? r)
              (let ((b (reply-json r)))
                (let ((users (opt b "users" (list))) (total (int (opt b "total_count" 0))))
                  (begin
                    (state-set-tree "admin.users" (collections.map users user-row))
                    (state-set "admin.users_head"
                      (if (= total 0)
                        (if (= q "") "No accounts." (str-concat "No username has \"" q "\" in it."))
                        (str-concat (plural total "account" "accounts")
                                    (if (= q "") ", the newest first"
                                      (str-concat " with \"" q "\" in the username")))))
                    (pager off USERPAGE total)
                    true)))
              (begin (admin-load-failed r "the accounts") nil)))))

      ;; One account: GET /user/profile/{id}, which shows an administrator its email and state.
      (defun load-auser (id)
        (let ((r (get-authed (str-concat "/user/profile/" (text id)))))
          (if (ok? r)
            (let ((p (reply-json r)))
              (let ((mine (= (text (opt p "id" "")) (text (state-get "me.id"))))
                    (enabled (not (off? p "enabled")))
                    (admin (if (opt p "is_admin" nil) true nil))
                    (tfa (if (opt p "login_2fa_email_enabled" nil) true nil))
                    (groups (collections.map (opt p "groups" (list))
                              (lambda (g) (str-concat (text (opt g "group_name" ""))
                                                      (if (opt g "is_group_admin" nil) " (its admin)" ""))))))
                (begin
                  (set email (text (opt p "email" "")))
                  (set seen (list (str-concat "Joined " (left (opt p "created_time" "") 10))))
                  (if (!= (text (opt p "last_login" "")) "")
                    (set seen (append seen (str-concat "last signed in " (posted-at (opt p "last_login" ""))))))
                  (if (!= (text (opt p "last_login_country" "")) "")
                    (set seen (append seen (str-concat "from " (text (opt p "last_login_country" ""))))))
                  (state-set-tree "auser"
                    (dict "id" (text (opt p "id" ""))
                          "username" (text (opt p "username" ""))
                          "header" (clip (str-concat (handle (text (opt p "username" ""))) "  "
                                                     (text (opt p "name" "")))
                                         WIDE)
                          "state" (str-concat "Account: " (if enabled "active" "disabled")
                                              " · Administrator: " (if admin "yes" "no")
                                              " · Two-step sign-in: " (if tfa "on" "off"))
                          "email" (clip (str-concat "Email: "
                                                    ;; a brokered account's is a placeholder
                                                    (if (string.ends-with email ".invalid")
                                                      "- (signs in at its home instance)"
                                                      (if (= email "") "-"
                                                        (str-concat email (if (opt p "email_verified" nil)
                                                                            ", verified" ", not verified")))))
                                        WIDE)
                          "seen" (clip (string.join seen " · ") WIDE)
                          "counts" (str-concat (plural (opt p "post_count" 0) "post" "posts") " · "
                                               (plural (opt p "view_count" 0) "view" "views"))
                          "groups" (clip (str-concat "Groups: " (if (= (length groups) 0) "none"
                                                                  (string.join groups ", ")))
                                         WIDE)
                          "note" (if mine "Your own account: Disable and Remove admin aren't offered." "")
                          "self" (flag mine)
                          "enabled" (flag enabled)
                          "admin" (flag admin)
                          "tfa" (flag tfa)))
                  true)))
            (begin (admin-load-failed r "that account") nil))))

      ;; Groups: GET /group/all. A row is its name and what it is for (cells 20 and 38 columns
      ;; wide), then Open.
      (defun load-admin-groups ()
        (let ((r (get-authed "/group/all")))
          (if (ok? r)
            (let ((gs (reply-json r)))
              (begin
                (if (!= (type-of gs) "list") (set gs (list)))
                (state-set-tree "admin.groups"
                  (collections.map gs
                    (lambda (g)
                      (dict "id" (text (opt g "id" ""))
                            "name" (clip (text (opt g "name" "")) 18)
                            "about" (clip (one-line (opt g "desc" "")) 38)))))
                (state-set "admin.groups_head"
                  (if (= (length gs) 0) "No groups yet." (plural (length gs) "group" "groups")))
                (no-pager)
                true))
            (begin (admin-load-failed r "the groups") nil))))
      ;; One group: GET /group/?group_id= for its name, GET /group/members for who is in it.
      ;; A member's row is @user and name (and "group admin"), a cell 44 columns wide, then its
      ;; two buttons (24 columns).
      (defun load-agroup (id)
        (let ((g (get-query "/group/" (dict "group_id" (text id)))))
          (if (ok? g)
            (let ((m (get-query "/group/members" (dict "group_id" (text id)))))
              (if (ok? m)
                (let ((members (reply-json m)) (name (text (opt (reply-json g) "name" ""))))
                  (begin
                    (if (!= (type-of members) "list") (set members (list)))
                    (state-set-tree "agroup"
                      (dict "id" (text id)
                            "name" name
                            "head" (clip (str-concat name "  ·  " (plural (length members) "member" "members"))
                                         WIDE)
                            "about" (let ((d (one-line (opt (reply-json g) "desc" ""))))
                                      (clip (if (= d "") "No description." d) WIDE))
                            "members"
                            (collections.map members
                              (lambda (u)
                                (dict "uid" (text (opt u "user_id" ""))
                                      "handle" (str-concat "@" (text (opt u "username" "")))
                                      "lead" (flag (opt u "is_group_admin" nil))
                                      "line" (clip (str-concat "@" (text (opt u "username" "")) "  "
                                                               (text (opt u "name" ""))
                                                               (if (opt u "is_group_admin" nil) "  · group admin" ""))
                                                   44))))
                            "add" (if (= (text (state-get "agroup.id")) (text id)) (state-get "agroup.add") "")
                            "pick" ""
                            "confirm" ""))
                    true))
                (begin (admin-load-failed m "that group's members") nil)))
            (begin (admin-load-failed g "that group") nil))))
      ;; The @username of the group's member uid, as its row has it.
      (defun member-handle (uid)
        (begin
          (set found "a member")
          (set i 0)
          (while (< i (int (state-get "agroup.members")))
            (if (= (text (state-get (str-concat "agroup.members." (text i) ".uid"))) (text uid))
              (set found (state-get (str-concat "agroup.members." (text i) ".handle"))))
            (set i (+ i 1)))
          found))

      ;; Invites: who may sign up (GET /invite/mode), then your codes, the used-up and turned-off
      ;; ones too. A row is the code, its uses, its state and its note (cells 13, 13, 17 and 13
      ;; columns wide), then Turn off or Turn on.
      (defun invite-row (c)
        (let ((most (opt c "max_uses" nil)) (used (text (opt c "use_count" 0))))
          (dict "id" (text (opt c "id" ""))
                "active" (flag (opt c "is_active" nil))
                "code" (clip (text (opt c "code" "")) 12)
                "uses" (clip (if (= (type-of most) "nil") (str-concat used " used")
                               (str-concat used " of " (text most) " used"))
                             12)
                "state" (if (opt c "is_active" nil)
                          (if (= (text (opt c "expires_at" "")) "") "on"
                            (str-concat "until " (left (opt c "expires_at" "") 10)))
                          "off")
                "note" (clip (one-line (opt c "note" "")) 13))))
      (defun load-admin-invites ()
        (let ((m (get-authed "/invite/mode")))
          (if (ok? m)
            (let ((off (int (state-get "admin.ioff"))))
              (begin
                (state-set "admin.signup" (if (opt (reply-json m) "invite_only" nil) "Invite only" "Open"))
                (let ((r (get-query "/invite/codes" (dict "include_inactive" "true"
                                                          "limit" (text LISTPAGE) "offset" (text off)))))
                  (if (ok? r)
                    (let ((codes (opt (reply-json r) "codes" (list)))
                          (total (int (opt (reply-json r) "total_count" 0))))
                      (begin
                        (state-set-tree "admin.invites" (collections.map codes invite-row))
                        (state-set "admin.invites_head"
                          (str-concat (if (= (state-get "admin.signup") "Open")
                                        "Anyone may sign up. " "Signing up takes an invite code. ")
                                      (if (= total 0) "You have no codes."
                                        (str-concat "Your " (plural total "code" "codes") ":"))))
                        (pager off LISTPAGE total)
                        true))
                    (begin (admin-load-failed r "your invite codes") nil)))))
            (begin (admin-load-failed m "the sign-up setting") nil))))

      ;; Site: GET /site/... (title, description and time zone to change; the groups new accounts
      ;; and administrators are in, and the password rules, to read).
      (defun site-get (k dflt)
        (let ((r (get-authed (str-concat "/site/" k))))
          (if (ok? r)
            (let ((v (reply-json r))) (if (or (= (type-of v) "dict") (= (type-of v) "nil")) dflt v))
            dflt)))
      (defun on? (v) (= (text v) "1"))
      (defun load-admin-site ()
        (let ((r (get-authed "/site/title")))
          (if (ok? r)
            (begin
              (set title (text (reply-json r)))
              (set about (text (site-get "description" "")))
              (set tz (text (site-get "timezone" "")))
              (set rules (list))
              (if (on? (site-get "password/min_length_enabled" 0))
                (set rules (append rules (str-concat (text (site-get "password/min_length" 8))
                                                     " characters or more"))))
              (for k (list (list "digit" "a digit") (list "upper" "a capital letter")
                           (list "lower" "a small letter") (list "special_symbols" "a symbol"))
                (if (on? (site-get (str-concat "password/" (car k) "_enabled") 0))
                  (set rules (append rules (nth k 1)))))
              (state-set-tree "site"
                (dict "title" title "about" about "tz" tz
                      "was_title" title "was_about" about "was_tz" tz
                      "groups" (clip (str-concat "New accounts join "
                                                 (text (site-get "default_user_group" "-"))
                                                 "; the administrators' group is "
                                                 (text (site-get "admin_group" "-")) ".")
                                     WIDE)
                      "pw" (clip (str-concat "Passwords: "
                                             (if (= (length rules) 0) "anything goes"
                                               (string.join rules ", ")) ".")
                                 WIDE)))
              (no-pager)
              true)
            (begin (admin-load-failed r "the site's settings") nil))))

      ;; Log: GET /logs/, newest first, a page of ten, one kind of event (admin.log_event) or all.
      ;; A row is when, who, the event's name (as the web app names them) and what it says (cells
      ;; 17, 13, 19 and 17 columns wide).
      (set EVENTS (list "" "User Login" "User Create" "User Update" "User Logout" "Setting Change"
                        "Deactivate Session" "Launch Session" "Group Create" "Group Delete"
                        "Group Add User" "Group Remove User" "Group Add Permission"
                        "Group Remove Permission" "Group Update Description" "Stats Job Started"
                        "Stats Job Completed" "Stats Job Failed" "Retention Job Started"
                        "Retention Job Completed" "Retention Job Failed" "Job Started"
                        "Job Completed" "Job Failed" "Notification Email Job Started"
                        "Notification Email Job Completed" "Notification Email Job Failed"
                        "Email Verification Sent" "Email Verified"))
      (defun event-name (c)
        (let ((n (int c)))
          (if (and (> n 0) (< n (length EVENTS))) (nth EVENTS n) (str-concat "Event " (text n)))))
      (defun log-row (e)
        (dict "at" (posted-at (opt e "event_time" ""))
              "who" (let ((u (text (opt e "username" "")))) (if (= u "") "-" (clip u 12)))
              "what" (clip (event-name (opt e "event_code" 0)) 18)
              "desc" (clip (one-line (opt e "event_desc" "")) 17)))
      (defun load-admin-log ()
        (let ((off (int (state-get "admin.loff"))) (ev (int (state-get "admin.log_event"))))
          (let ((r (get-query "/logs/"
                     (collections.dict-merge
                      (dict "limit" (text LISTPAGE) "offset" (text off) "order_desc" "true")
                      (if (= ev 0) (dict) (dict "event_code" (text ev)))))))
            (if (ok? r)
              (let ((entries (opt (reply-json r) "entries" (list)))
                    (total (int (opt (reply-json r) "total_count" 0))))
                (begin
                  (state-set-tree "admin.log" (collections.map entries log-row))
                  (state-set "admin.log_head"
                    (if (= total 0) "Nothing logged."
                      (str-concat (plural total "event" "events")
                                  (if (= ev 0) "" (str-concat ": " (event-name ev)))
                                  ", the newest first")))
                  (pager off LISTPAGE total)
                  true))
              (begin (admin-load-failed r "the system log") nil)))))

      ;; The part of the Admin view a key names (users, groups, invites, site, log).
      (defun admin-key (tab) (string.lower tab))
      (defun load-admin-part (key)
        (begin
          (state-set "admin.tab" (if (= key "groups") "Groups" (if (= key "invites") "Invites"
                                   (if (= key "site") "Site" (if (= key "log") "Log" "Users")))))
          (say (str-concat "Loading the " (if (= key "groups") "groups" (if (= key "invites") "invite codes"
                                            (if (= key "site") "site's settings"
                                              (if (= key "log") "system log" "accounts"))))
                           "..."))
          (if (= key "groups") (load-admin-groups)
            (if (= key "invites") (load-admin-invites)
              (if (= key "site") (load-admin-site)
                (if (= key "log") (load-admin-log) (load-admin-users)))))))
      (defun not-admin () (begin (fail "That's for the instance's administrators.") nil))

      ;; One group's permissions: GET /group/perms (their codes), named by GET /perms/codes (every
      ;; permission's name and code), sorted by name, those with agperm.q in their name, a page of
      ;; ten from agperm.off.
      (defun load-agperm (gid)
        (let ((g (get-query "/group/" (dict "group_id" (text gid))))
              (r (get-query "/group/perms" (dict "group_id" (text gid))))
              (c (get-authed "/perms/codes")))
          (if (and (ok? g) (ok? r) (ok? c))
            (let ((codes (reply-json c)) (have (reply-json r))
                  (q (string.lower (string.trim (text (state-get "agperm.q")))))
                  (off (int (state-get "agperm.off")))
                  (name (text (opt (reply-json g) "name" ""))))
              (begin
                (set names (dict)) ;; a code (as text) -> its name
                (for k (collections.dict-keys codes) (set-attr names (text (get-attr codes k)) k))
                (if (!= (type-of have) "list") (set have (list)))
                (set found (list))
                (for code have
                  (let ((n (opt names (text code) (str-concat "Permission " (text code)))))
                    (if (or (= q "") (string.contains (string.lower n) q))
                      (set found (append found n)))))
                (set found (collections.sort found))
                (set total (length found))
                (if (>= off total) (set off 0))
                (state-set-tree "agperm"
                  (dict "id" (text gid)
                        "name" name
                        "head" (clip (str-concat name ": "
                                                 (if (= q "")
                                                   (str-concat (plural (length have) "permission" "permissions")
                                                               ", what its members may do")
                                                   (str-concat (text total) " of " (plural (length have) "permission" "permissions")
                                                               " with \"" (string.trim (text (state-get "agperm.q")))
                                                               "\" in the name")))
                                     WIDE)
                        "q" (state-get "agperm.q")
                        "grant" (state-get "agperm.grant")
                        "off" off
                        "rows" (collections.map (slice found off (if (> (+ off LISTPAGE) total) total (+ off LISTPAGE)))
                                 (lambda (n) (dict "name" n "code" (text (opt codes n 0)))))
                        "pick" ""
                        "pick_name" ""))
                (pager off LISTPAGE total)
                true))
            (begin
              (admin-load-failed (if (ok? g) (if (ok? r) c r) g) "that group's permissions")
              nil))))

      ;; --- going between views --------------------------------------------------------
      ;; Where the window is: an entry, a view and what it shows (feed, tag|engines, post|312,
      ;; profile|7, tags, alerts, search, compose, viewer|312|0). ui.back holds the entries
      ;; before it, ";" between them, the newest last; it keeps thirty.
      (defun back-list ()
        (let ((s (state-get "ui.back"))) (if (= s "") (list) (string.split s ";"))))
      (defun push-back (entry)
        (let ((l (append (back-list) entry)))
          (state-set "ui.back"
            (string.join (if (> (length l) 30) (slice l (- (length l) 30) (length l)) l) ";"))))
      (defun pop-back ()
        (let ((l (back-list)))
          (if (= (length l) 0) ""
            (begin
              (state-set "ui.back" (string.join (slice l 0 (- (length l) 1)) ";"))
              (nth l (- (length l) 1))))))
      (defun show-screen (s)
        (begin
          (state-set "ui.screen" s)
          ;; the profile's page background, behind the window while a profile is shown
          (state-set "prof.bg_pic_shown" (if (= s "profile") (state-get "prof.bg_pic") ""))))
      ;; Load what an entry shows, and show it. True when it loaded.
      (defun show-entry (entry)
        (let ((parts (string.split entry "|")))
          (let ((view (car parts))
                (arg (nth-or parts 1)))
            (begin
              (set ok nil)
              (if (= view "feed")
                (begin
                  (state-set "feed.source" "home")
                  (say (str-concat "Loading " (if (= (state-get "feed.mode") "Everyone")
                                                "everyone's posts..."
                                                (if (= (state-get "feed.mode") "Friends")
                                                  "your friends' posts..." "your feed..."))))
                  (set ok (load-feed true))))
              (if (= view "tag")
                (begin
                  (state-set "feed.source" "tag")
                  (state-set "feed.tag" arg)
                  (state-set "feed.title" (str-concat "#" arg))
                  (say (str-concat "Loading #" arg "..."))
                  (set ok (load-feed true))))
              (if (= view "post")
                (begin (say "Opening the post...") (set ok (load-post arg))))
              (if (= view "profile")
                (if (= arg (text (state-get "me.id")))
                  (begin
                    (say "Loading your profile...")
                    (set ok (if (load-me-into true) (load-profile) nil)))
                  (begin (say "Loading the profile...") (set ok (load-user arg)))))
              (if (= view "tags")
                (begin (say "Loading the hashtags...") (set ok (load-tags true))))
              (if (= view "alerts")
                (begin (say "Loading your notifications...") (set ok (load-alerts))))
              (if (= view "search") (set ok true))
              (if (= view "dms")
                (begin (say "Loading your messages...") (set ok (load-dms))))
              (if (= view "dm")
                (begin (say "Opening the conversation...") (set ok (load-dm arg))))
              (if (= view "compose") (set ok true))
              (if (= view "viewer")
                (set ok (load-viewer arg (int (if (= (nth-or parts 2) "") "0" (nth-or parts 2))))))
              ;; the Admin view (admin|users ...), one account (auser|7), one group (agroup|2)
              (if (= view "admin")
                (set ok (if (admin?) (load-admin-part (if (= arg "") "users" arg)) (not-admin))))
              (if (= view "auser")
                (set ok (if (admin?) (begin (say "Loading the account...") (load-auser arg)) (not-admin))))
              (if (= view "agroup")
                (set ok (if (admin?) (begin (say "Loading the group...") (load-agroup arg)) (not-admin))))
              (if (= view "agperm")
                (set ok (if (admin?) (begin (say "Loading its permissions...") (load-agperm arg)) (not-admin))))
              (if ok
                (begin
                  (show-screen (if (= view "tag") "feed" view))
                  (say "")))
              ok))))
      ;; A new view: the other copy of the bar, whose Back takes the focus (ui/app.ari).
      (defun new-view () (state-set "ui.nav" (if (= (state-get "ui.nav") "a") "b" "a")))
      ;; Go to an entry: load it, then remember where the window was, for Back.
      (defun go (entry)
        (let ((was (state-get "ui.here")))
          (if (show-entry entry)
            (begin
              (if (and (!= was "") (!= was entry)) (push-back was))
              (state-set "ui.fwd" "")
              (state-set "ui.here" entry)
              (new-view)
              true)
            nil)))
      (defun go-home ()
        (begin
          (state-set "ui.back" "")
          (state-set "ui.fwd" "")
          (state-set "ui.here" "")
          (go "feed")))
      ;; A link in a post's text (text.runs), followed in the app where it leads somewhere the
      ;; app shows: a hashtag's posts (/tag/NAME), a person's profile (/user/NAME, the account
      ;; GET /user/by-username/{name} names), a post or a profile by id (/app/post/ID,
      ;; /app/profile/ID), on this instance whether the href is a path or a whole URL. nicotina
      ;; never opens a browser: any other link is copied (Copy link), or shown where the host
      ;; has no clipboard.
      (defun copy-link (url)
        (if (= (state-get "app.clip") "1")
          (begin (clipboard-set url) (say (str-concat "Link copied: " url)))
          (say (str-concat "Link: " url))))
      (defun open-link (href)
        (let ((h (text href)))
          (begin
            (set path h)
            (for pre (list (base) (state-get "app.origin"))
              (if (and (!= pre "") (string.starts-with path (str-concat pre "/")))
                (set path (string.substring path (string.length pre)
                                            (- (string.length path) (string.length pre))))))
            (if (string.starts-with path "/app/")
              (set path (string.substring path 4 (- (string.length path) 4))))
            (set seg (if (string.starts-with path "/")
                       (string.split (car (string.split (car (string.split path "?")) "#")) "/")
                       (list)))
            (set kind (if (= (length seg) 3) (nth seg 1) ""))
            (set arg (if (= (length seg) 3) (nth seg 2) ""))
            (if (and (= kind "tag") (!= arg ""))
              (go (str-concat "tag|" (string.lower arg)))
              (if (and (= kind "user") (!= arg ""))
                (let ((r (get-authed (str-concat "/user/by-username/" arg))))
                  (if (ok? r)
                    (go (str-concat "profile|" (text (opt (reply-json r) "id" ""))))
                    (if (session-over? r) (session-over)
                      (if (= (status r) 0) (unreachable r)
                        (fail (str-concat "Couldn't find @" arg " (HTTP " (str (status r)) ")."))))))
                (if (and (or (= kind "post") (= kind "profile")) (!= arg ""))
                  (go (str-concat kind "|" arg))
                  (copy-link (if (string.starts-with h "/") (str-concat (state-get "app.origin") h)
                               h))))))))

      ;; After signing in: who it is, then the feed, the first view (as the web app's home), or
      ;; the first time, the view --start names (profile, settings, tags, alerts, search, compose, post:ID,
      ;; tag:NAME, user:ID, view:ID[:N], search:TEXT; for an administrator admin[:PART],
      ;; auser:ID, agroup:ID); a view that won't load leaves the feed.
      (defun load-home ()
        (if (load-me)
          (let ((start (state-get "ui.start")))
            (begin
              (state-set "ui.back" "")
              (state-set "ui.here" "")
              (state-set "ui.start" "feed")
              (set entry
                (if (= start "profile") (str-concat "profile|" (text (state-get "me.id")))
                (if (= start "settings")
                  (begin (state-set "ui.tab" "Settings") (str-concat "profile|" (text (state-get "me.id"))))
                  (if (string.starts-with start "user:") (str-concat "profile|" (string.substring start 5 (string.length start)))
                    (if (or (string.starts-with start "post:") (string.starts-with start "tag:")
                            (= start "tags") (= start "alerts") (= start "search") (= start "compose")
                            (= start "dms") (string.starts-with start "dm:")
                            (= start "admin") (string.starts-with start "admin:")
                            (string.starts-with start "auser:") (string.starts-with start "agroup:")
                            (string.starts-with start "agperm:"))
                      (string.replace start ":" "|")
                      ;; view:ID or view:ID:N, the viewer at a post's Nth attachment; search:TEXT,
                      ;; the search view, searching for TEXT
                      (if (string.starts-with start "search:")
                        (begin
                          (state-set "search.q" (string.substring start 7 (string.length start)))
                          "search")
                      (if (string.starts-with start "view:")
                        (let ((parts (string.split start ":")))
                          (str-concat "viewer|" (nth-or parts 1) "|"
                                      (if (= (nth-or parts 2) "") "0" (nth-or parts 2))))
                        "feed")))))))
              (if (go entry)
                (begin (if (!= (state-get "search.q") "") (run-search)) true)
                (go "feed"))))
          nil))

      (defun signed-in-msg () (str-concat "Signed in to " (state-get "app.host") "."))

      ;; A reply from /user/login or /user/login/2fa.
      (defun after-login (r)
        (let ((b (reply-json r)))
          (if (ok? r)
            (if (get-attr r "captured")
              (if (opt b "force_password_change" nil)
                (begin
                  (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
                  (net-auth-forget "txwtf")
                  (to-signin (str-concat "Change your password at " (state-get "app.host")
                                         ", then sign in.")
                             true))
                (begin
                  (state-set "login.challenge" "")
                  (state-set "login.code" "")
                  (if (load-home) (say (signed-in-msg)))))
              (if (opt b "two_factor_required" nil)
                (begin
                  (state-set "login.challenge" (opt b "challenge" ""))
                  (state-set "login.code" "")
                  (state-set "ui.screen" "2fa")
                  (say (str-concat "We emailed you a code. It expires in "
                                   (str (int (/ (opt b "expires_in" 300) 60))) " minutes.")))
                (fail (str-concat "The server sent no session: " (get-attr r "error")))))
            (if (= (status r) 0) (unreachable r)
              (if (= (status r) 429) (fail "Too many attempts. Wait a minute, then try again.")
                ;; an administrator turned the account off (txwtf's DisabledUser): after the
                ;; password, or after the emailed code
                (if (string.contains (text (opt b "detail" "")) "DisabledUser")
                  (begin
                    (if (= (state-get "ui.screen") "2fa") (to-signin "" nil))
                    (fail "This account is disabled. Ask the site's administrators."))
                  (if (= (state-get "ui.screen") "2fa")
                    (begin
                      (state-set "login.code" "")
                      (fail "That code didn't work. Try again, or go Back."))
                    (if (or (= (status r) 400) (= (status r) 401))
                      (fail "Wrong username or password.")
                      (fail (str-concat "Sign-in failed (HTTP " (str (status r)) ")."))))))))))

      ;; --- direct messages (ui/dm.ari) ---------------------------------------------------
      ;; The conversations: GET /social/dm/conversations, latest first. A conversation's other
      ;; person comes from GET /user/profile/{id}, kept in dm.who for the run.
      ;;
      ;; An encrypted conversation (is_encrypted) goes through the host's e2ee-* verbs (libcvc
      ;; 3.7.14, with --e2ee-store): the host keeps this account's keys and sessions, and this
      ;; document names them by a handle, e2ee-handle, never holding a key. Its messages are
      ;; GET /e2ee/dm/conversations/{id}/messages, opened in the order they were sent; a new one is
      ;; sealed by the host and POSTed there. Where the host can't (no verbs, or its key store
      ;; would not open), an encrypted conversation stays locked and says why.
      (set DMPAGE 30)
      (defun e2ee-here ()
        (if (has? "e2ee-seal") (get-attr (e2ee-status) "ok") nil))
      (defun e2ee-why ()
        (if (has? "e2ee-status")
          (let ((e (get-attr (e2ee-status) "error")))
            (if (= e "") "the host's key store did not open" e))
          "this host has no end-to-end encryption (libcvc 3.7.14 and --e2ee-store)"))
      ;; The account's handle in the host's key store: txwtf.<host>.<user id>, in the characters
      ;; a handle may have.
      (defun e2ee-handle ()
        (begin
          (set s (str-concat "txwtf." (state-get "app.host") "." (text (state-get "me.id"))))
          (set out "")
          (set i 0)
          (while (< i (string.length s))
            (set c (string.char-at s i))
            (set out (str-concat out (if (string.contains "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" c) c "-")))
            (set i (+ i 1)))
          (if (> (string.length out) 64) (string.substring out 0 64) out)))
      ;; Someone in a conversation: {username handle name}, asked once a run.
      (defun dm-who (id)
        (let ((key (str-concat "dm.who." (text id))))
          (if (state-exists (str-concat key ".username"))
            (dict "username" (state-get (str-concat key ".username"))
                  "handle" (state-get (str-concat key ".handle"))
                  "name" (state-get (str-concat key ".name")))
            (let ((r (get-authed (str-concat "/user/profile/" (text id)))))
              (let ((p (if (ok? r) (reply-json r) (dict))))
                (let ((w (dict "username" (text (opt p "username" (str-concat "user " (text id))))
                               "handle" (handle (text (opt p "username" (str-concat "user" (text id)))))
                               "name" (one-line (opt p "name" "")))))
                  (begin
                    (if (ok? r) (state-set-tree key w))
                    w)))))))
      (defun dm-peer (c) ;; the other person's id in conversation c
        (if (= (text (opt c "participant_1_id" "")) (text (state-get "me.id")))
          (text (opt c "participant_2_id" "")) (text (opt c "participant_1_id" ""))))
      (defun load-dms ()
        (let ((r (get-query "/social/dm/conversations" (dict "limit" "50" "offset" "0"))))
          (if (ok? r)
            (let ((convs (reply-json r)))
              (begin
                (if (!= (type-of convs) "list") (set convs (list)))
                (set rows (collections.map convs
                            (lambda (c)
                              (let ((w (if (opt c "is_group" nil)
                                         (dict "handle" (str-concat "Group: " (one-line (opt c "name" ""))) "name" "")
                                         (dm-who (dm-peer c)))))
                                (dict "id" (text (opt c "id" ""))
                                      "line" (pad (header (get-attr w "handle") (get-attr w "name")) (- WIDE 8))
                                      "at" (str-concat "  " (posted-at (opt c "last_message_at" (opt c "created_at" "")))
                                                       (if (opt c "is_encrypted" nil) "  · end-to-end encrypted" "")))))))
                (state-set-tree "dm.rows" rows)
                (state-set "dm.head" (pad (if (= (length rows) 0)
                                            "No conversations yet: Message on a profile starts one."
                                            (str-concat (text (length rows)) " conversations"))
                                          (- WIDE 13)))
                (load-dm-keys-line)
                true))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't load your messages (HTTP " (str (status r)) ")."))))
              nil))))
      ;; Under the list: what the host does with encrypted conversations, and its key here.
      (defun load-dm-keys-line ()
        (if (e2ee-here)
          (let ((mine (e2ee-identity (e2ee-handle))))
            (begin
              (state-set "dm.e2ee" "1")
              (state-set "dm.keys_line"
                (if (= (type-of mine) "nil")
                  "Keys: none on this device yet (made when you first need them)."
                  (str-concat "Your key: " (get-attr mine "fingerprint"))))
              (state-set "dm.keys_note"
                (if (get-attr (e2ee-status) "persistent")
                  "Kept by this host, on this device. Back them up to read them elsewhere."
                  "Kept by this host for this run only (no --e2ee-store file)."))))
          (begin
            (state-set "dm.e2ee" "")
            (state-set "dm.keys_line" "Encrypted conversations stay locked here:")
            (state-set "dm.keys_note" (clip (e2ee-why) WIDE)))))

      ;; The account's keys at the instance (GET /e2ee/keys/me) against this host's: "ok", made
      ;; and published first if neither has any; "elsewhere" when the instance has another
      ;; device's (Restore from a backup, or New keys); nil, with the status line saying why.
      (defun e2ee-keys ()
        (let ((h (e2ee-handle)))
          (let ((mine (e2ee-identity h)) (r (get-authed "/e2ee/keys/me")))
            (if (= (status r) 404)
              (let ((id (if (= (type-of mine) "nil") (e2ee-create h 20) mine)))
                (let ((p (send-authed "POST" "/e2ee/keys" (get-attr id "publish"))))
                  (if (ok? p) "ok" (begin (act-failed p "publish your encryption keys") nil))))
              (if (ok? r)
                (let ((pub (reply-json r)))
                  (if (= (type-of mine) "nil") "elsewhere"
                    (if (!= (text (opt pub "identity_key_ed25519" "")) (get-attr mine "identity_key_ed25519"))
                      "elsewhere"
                      (begin
                        ;; fewer than five one-time prekeys left at the instance: twenty more
                        (if (< (int (opt pub "available_one_time_prekeys" 0)) 5)
                          (send-authed "POST" "/e2ee/keys/one-time" (e2ee-prekeys h 20)))
                        "ok"))))
                (begin (act-failed r "check your encryption keys") nil))))))

      ;; One conversation: its person, its messages oldest first (the newest DMPAGE), and what
      ;; can be done in it. dm.lines are lines of text, each message a header row and its words.
      (defun dm-conversation (id)
        (let ((r (get-query "/social/dm/conversations" (dict "limit" "100" "offset" "0"))))
          (if (ok? r)
            (let ((found (collections.filter (let ((l (reply-json r))) (if (= (type-of l) "list") l (list)))
                           (lambda (c) (= (text (opt c "id" "")) (text id))))))
              (if (= (length found) 0) (begin (fail "That conversation isn't yours.") nil) (car found)))
            (begin
              (if (session-over? r) (session-over)
                (if (= (status r) 0) (unreachable r)
                  (fail (str-concat "Couldn't open the conversation (HTTP " (str (status r)) ")."))))
              nil))))
      ;; A message as rows: when and who (dim), then its words, wrapped, indented two columns.
      (defun dm-lines (who at txt dim)
        (begin
          (set rows (list (dict "text" (str-concat (posted-at at) "  " who) "dim" "1")))
          (for l (wrap (one-line txt) (- WIDE 4))
            (set rows (append rows (dict "text" (str-concat "  " l) "dim" dim))))
          rows))
      (defun dm-note (txt dim) (list (dict "text" txt "dim" dim)))
      (defun load-dm (id)
        (let ((c (dm-conversation id)))
          (if (= (type-of c) "nil") nil
            (let ((peer (dm-peer c)) (enc (opt c "is_encrypted" nil)))
              (let ((w (dm-who peer)))
                (begin
                  (state-set-tree "dm.conv"
                    (dict "id" (text id) "peer" peer "username" (get-attr w "username")
                          "title" (header (get-attr w "handle") (get-attr w "name"))
                          "sub" (if enc "End-to-end encrypted: the server sees ciphertext only."
                                  "Not encrypted: the server can read these messages.")
                          "encrypted" (if enc "1" "") "can_send" "" "can_encrypt" "" "note" ""))
                  (set rows (if enc (load-dm-sealed id) (load-dm-plain id)))
                  (if (= (type-of rows) "nil") nil
                    (begin
                      (state-set-tree "dm.lines" rows)
                      (send-authed "POST" (str-concat "/social/dm/conversations/" (text id) "/read") (dict))
                      true))))))))
      (defun load-dm-plain (id)
        (let ((r (get-query (str-concat "/social/dm/conversations/" (text id) "/messages")
                            (dict "limit" (text DMPAGE)))))
          (if (ok? r)
            (let ((msgs (reply-json r)) (me (text (state-get "me.id"))))
              (begin
                (if (!= (type-of msgs) "list") (set msgs (list)))
                (set out (list))
                (for m (collections.reverse msgs)
                  (for l (dm-lines (if (= (text (opt m "sender_id" "")) me) "you"
                                     (get-attr (dm-who (opt m "sender_id" "")) "handle"))
                                   (opt m "created_at" "") (opt m "content" "") "")
                    (set out (append out l))))
                (state-set "dm.conv.can_send" "1")
                (state-set "dm.conv.can_encrypt" (if (e2ee-here) "1" ""))
                (if (= (length msgs) 0) (dm-note "No messages yet." "1") out)))
            (begin (act-failed r "load the messages") nil))))
      (defun load-dm-sealed (id)
        (if (not (e2ee-here))
          (list (dict "text" "These messages are end-to-end encrypted, and stay locked here:" "dim" "")
                (dict "text" (str-concat "  " (clip (e2ee-why) (- WIDE 2))) "dim" "1"))
          (let ((keys (e2ee-keys)))
            (if (= (type-of keys) "nil") nil
              (if (= keys "elsewhere")
                (begin
                  (state-set "dm.conv.note" "Keys: on another device")
                  (list (dict "text" "This account's encryption keys are on another device." "dim" "")
                        (dict "text" "  Restore them from your backup under DMs, or make new ones." "dim" "1")))
                (let ((r (get-query (str-concat "/e2ee/dm/conversations/" (text id) "/messages")
                                    (dict "limit" (text DMPAGE)))))
                  (if (ok? r)
                    (let ((msgs (opt (reply-json r) "messages" (list))) (h (e2ee-handle)) (me (text (state-get "me.id"))))
                      (begin
                        (if (!= (type-of msgs) "list") (set msgs (list)))
                        (set out (list))
                        (for m (collections.reverse msgs)
                          (let ((o (e2ee-open h (text id) m))
                                (who (if (= (text (opt m "sender_id" "")) me) "you"
                                       (get-attr (dm-who (opt m "sender_id" "")) "handle"))))
                            (let ((st (get-attr o "status")))
                              (for l (dm-lines who (opt m "created_at" "")
                                               (if (get-attr o "ok") (get-attr o "text")
                                                 (if (= st "own") "(sent from another device: its text is there)"
                                                   (if (= st "no-session") "(encrypted on another device: read it there)"
                                                     (if (= st "locked") "(locked: a paid message)"
                                                       (str-concat "(could not be decrypted: " (get-attr o "error") ")")))))
                                               (if (get-attr o "ok") "" "1"))
                                (set out (append out l))))))
                        ;; Send only from a session this host holds, or into a conversation with no
                        ;; encrypted messages yet: a new session where another device holds one
                        ;; would break the other person's copy of it.
                        (if (or (e2ee-session? h (text id)) (= (length msgs) 0))
                          (state-set "dm.conv.can_send" "1")
                          (state-set "dm.conv.note"
                            "Its session is on another device: write from there."))
                        (if (= (length msgs) 0) (dm-note "No messages yet." "1") out)))
                    (begin (act-failed r "load the encrypted messages") nil))))))))

      ;; Send dm.send in the conversation shown: plaintext, or sealed by the host. True when sent.
      (defun dm-send (txt)
        (let ((id (state-get "dm.conv.id")) (peer (state-get "dm.conv.peer")))
          (if (!= (state-get "dm.conv.encrypted") "1")
            (let ((r (send-authed "POST" (str-concat "/social/dm/conversations/" id "/messages")
                                  (dict "content" txt))))
              (if (ok? r) true (begin (act-failed r "send it") nil)))
            (let ((h (e2ee-handle)))
              (let ((s (e2ee-seal h id (int peer) txt)))
                (begin
                  (if (get-attr s "need_bundle")
                    (let ((b (get-authed (str-concat "/e2ee/keys/" (state-get "dm.conv.username")))))
                      (if (ok? b)
                        (set s (e2ee-seal h id (int peer) txt (reply-json b)))
                        (set s (dict "ok" nil "need_bundle" nil "body" nil
                                     "error" (if (= (status b) 409)
                                               (str-concat (state-get "dm.conv.username") " has no encryption keys yet")
                                               (str-concat "no keys (HTTP " (str (status b)) ")")))))))
                  (if (get-attr s "ok")
                    (let ((r (send-authed "POST" (str-concat "/e2ee/dm/conversations/" id "/messages")
                                          (get-attr s "body"))))
                      (if (ok? r)
                        (begin (e2ee-sent h (int (opt (reply-json r) "id" 0)) txt) true)
                        (begin (act-failed r "send it") nil)))
                    (begin (fail (str-concat "Couldn't encrypt it: " (get-attr s "error"))) nil))))))))

      ;; Keys: a passphrase backup of this host's (PUT /e2ee/backup), taking them from one (GET),
      ;; or new keys in place of another device's.
      (defun dm-pass ()
        (let ((p (state-get "dm.pass"))) (begin (state-set "dm.pass" "") p)))
      (defun dm-backup ()
        (let ((p (dm-pass)) (h (e2ee-handle)))
          (if (< (string.length p) 8) (fail "A backup passphrase is at least 8 characters.")
            (if (= (type-of (e2ee-identity h)) "nil") (fail "There are no keys on this device to back up.")
              (begin
                (say "Backing up your keys (this takes a moment)...")
                (let ((b (e2ee-backup h p)))
                  (if (get-attr b "ok")
                    (let ((r (send-authed "PUT" "/e2ee/backup" (get-attr b "body"))))
                      (if (ok? r) (say "Your keys are backed up, under that passphrase.")
                        (act-failed r "store the backup")))
                    (fail (str-concat "Couldn't back them up: " (get-attr b "error"))))))))))
      (defun dm-restore ()
        (let ((p (dm-pass)) (h (e2ee-handle)))
          (let ((r (get-authed "/e2ee/backup")))
            (if (= (status r) 404) (fail "There is no backup of your keys at this instance.")
              (if (not (ok? r)) (act-failed r "fetch the backup")
                (begin
                  (say "Restoring your keys (this takes a moment)...")
                  (e2ee-forget h)
                  (let ((k (e2ee-restore h (reply-json r) p)))
                    (if (get-attr k "ok")
                      (begin
                        (send-authed "POST" "/e2ee/keys/one-time" (e2ee-prekeys h 20))
                        (load-dm-keys-line)
                        (say "Your keys are restored on this device."))
                      (fail (str-concat "Couldn't restore them: " (get-attr k "error")))))))))))
      (defun dm-new-keys ()
        (let ((h (e2ee-handle)))
          (begin
            (e2ee-forget h)
            (let ((p (send-authed "POST" "/e2ee/keys" (get-attr (e2ee-create h 20) "publish"))))
              (if (ok? p)
                (begin (load-dm-keys-line) (say "New keys published. Older encrypted messages stay unreadable here."))
                (act-failed p "publish your new keys"))))))

      ;; --- doing things -----------------------------------------------------------------
      ;; A heart on post pid, or taken off (liked "1"); a repost of it, or yours taken back.
      (defun toggle-like (pid liked)
        (let ((r (if (= liked "1")
                   (send-authed "DELETE" (str-concat "/social/posts/" (text pid) "/reactions?emoji=heart") nil)
                   (send-authed "POST" (str-concat "/social/posts/" (text pid) "/reactions")
                                (dict "emoji" "heart")))))
          (if (ok? r)
            (begin (say (if (= liked "1") "Like taken back." "Liked.")) true)
            (begin (act-failed r (if (= liked "1") "take the like back" "like it")) nil))))
      ;; A thumbs-down on post pid, or taken off (disliked "1"). txwtf keeps a like or a dislike,
      ;; not both: either clears the other.
      (defun toggle-dislike (pid disliked)
        (let ((r (send-authed (if (= disliked "1") "DELETE" "POST")
                              (str-concat "/social/posts/" (text pid) "/dislike")
                              (if (= disliked "1") nil (dict)))))
          (if (ok? r)
            (begin (say (if (= disliked "1") "Dislike taken back." "Disliked.")) true)
            (begin (act-failed r (if (= disliked "1") "take the dislike back" "dislike it")) nil))))
      (defun toggle-repost (pid reposted mine)
        (let ((r (if (and (= reposted "1") (!= mine ""))
                   (send-authed "DELETE" (str-concat "/social/posts/" mine) nil)
                   (send-authed "POST" "/social/posts" (dict "content" "" "repost_id" (int pid))))))
          (if (ok? r)
            (begin (say (if (= reposted "1") "Repost taken back." "Reposted.")) true)
            (begin (act-failed r (if (= reposted "1") "take the repost back" "repost it")) nil))))
      ;; After either, card i of LIST's counts and marks, from the post again.
      (defun refresh-card (lst i)
        (let ((key (str-concat lst "." (text i))))
          (let ((r (get-authed (str-concat "/social/posts/" (text (state-get (str-concat key ".id")))))))
            (if (ok? r)
              (let ((c (feed-card (reply-json r))))
                (begin
                  ;; a repost card's marks are the reposted post's
                  (if (!= (text (get-attr c "pid")) (text (get-attr c "id")))
                    (let ((o (get-authed (str-concat "/social/posts/" (text (get-attr c "pid"))))))
                      (if (ok? o)
                        (let ((op (reply-json o)))
                          (begin
                            (set-attr c "liked" (if (opt op "user_has_reacted" nil) "1" ""))
                            (set-attr c "disliked" (if (opt op "user_has_disliked" nil) "1" ""))
                            (set-attr c "reposted" (if (opt op "user_has_reposted" nil) "1" ""))
                            (set-attr c "my_repost" (text (opt op "user_repost_id" ""))))))))
                  (for k (list "counts" "liked" "disliked" "reposted" "my_repost"
                               "c_reply" "c_repost" "c_like" "c_dislike" "c_views")
                    (state-set (str-concat key "." k) (get-attr c k)))))))))
      ;; Delete the post shown (DELETE /social/posts/{id}), then go back where you came from. A
      ;; txwtf before atx-crypto-club/txwtf#324 refuses an administrator someone else's post
      ;; (403, PostAccessDenied).
      (defun delete-shown (done)
        (let ((r (send-authed "DELETE" (str-concat "/social/posts/" (text (state-get "post.pid"))) nil)))
          (if (ok? r)
            (let ((entry (pop-back)))
              (begin
                (if (show-entry (if (= entry "") "feed" entry))
                  (begin (state-set "ui.here" (if (= entry "") "feed" entry)) (new-view)))
                (say done)))
            (if (and (= (status r) 403) (!= (state-get "post.mine") "1"))
              (say "This server doesn't let its administrators delete others' posts.")
              (act-failed r "delete it")))))
      ;; The list the card pressed is in (act.list): the feed's when a terminal's buttons, which
      ;; don't name one, were pressed.
      (defun card-list ()
        (let ((l (text (state-get "act.list")))) (if (= l "") "feed.items" l)))
      ;; A new post, or a reply (reply_to set): POST /social/posts, with the ids of the files it
      ;; attaches (attachment_ids), if any. Its id, or nil.
      (defun publish (content reply-to visibility ids)
        (let ((payload (if (= reply-to "")
                         (dict "content" content "visibility" visibility)
                         (dict "content" content "visibility" visibility
                               "reply_to_id" (int reply-to)))))
          (begin
            (if (> (length ids) 0) (set-attr payload "attachment_ids" ids))
            (let ((r (send-authed "POST" "/social/posts" payload)))
              (if (ok? r)
                (text (opt (reply-json r) "id" ""))
                (begin (act-failed r (if (= reply-to "") "post it" "send the reply")) nil))))))
      ;; The files a new post attaches (compose.files), as dicts: handle, name, size, type. (A set
      ;; inside a let binds the let's own name, so the loop's variables are all this let's.)
      (defun compose-files ()
        (let ((out (list)) (n (int (state-get "compose.files"))) (at ""))
          (begin
            (for i (range n)
              (begin
                (set at (str-concat "compose.files." (text i) "."))
                (set out (append out (dict "handle" (state-get (str-concat at "handle"))
                                           "name" (state-get (str-concat at "name"))
                                           "size" (int (state-get (str-concat at "size")))
                                           "type" (state-get (str-concat at "type"))
                                           "label" (state-get (str-concat at "label")))))))
            out)))
      ;; One file, uploaded as the web app uploads it: in one multipart POST /social/files, or,
      ;; over 8 MiB, in the resumable upload's chunks (POST /social/files/resumable, then a PATCH
      ;; per chunk at its Upload-Offset, which the host resumes after a dropped one, then POST
      ;; .../complete). The host reads the file and sends it; compose.progress shows how far it
      ;; is. Its id, or nil (the status line says why).
      (defun upload-file (f)
        (let ((h (get-attr f "handle")) (size (int (get-attr f "size")))
              (what (str-concat "upload " (get-attr f "name"))))
          (if (<= size 8388608)
            (let ((r (http-upload (str-concat (base) "/social/files") h
                       (dict "auth" "txwtf" "headers" (dict "Accept" "application/json")
                             "progress" "compose.progress"))))
              (if (get-attr r "done") (opt (reply-json r) "id" nil)
                (begin (act-failed r what) nil)))
            (let ((s (send-authed "POST" "/social/files/resumable"
                       (dict "filename" (get-attr f "name") "total_size" size
                             "mime_type" (get-attr f "type")))))
              (if (not (ok? s)) (begin (act-failed s what) nil)
                (let ((url (str-concat (base) "/social/files/resumable/"
                                       (text (opt (reply-json s) "upload_id" ""))))
                      (chunk (int (opt (reply-json s) "chunk_size" 8388608))))
                  (let ((r (http-upload url h
                             (dict "as" "chunks" "chunk_size" chunk "status_url" url
                                   "auth" "txwtf" "headers" (dict "Accept" "application/json")
                                   "progress" "compose.progress"))))
                    (if (not (get-attr r "done")) (begin (act-failed r what) nil)
                      (let ((c (send-authed "POST" (str-concat "/social/files/resumable/"
                                                               (text (opt (reply-json s) "upload_id" ""))
                                                               "/complete")
                                            (dict))))
                        (if (ok? c) (opt (reply-json c) "id" nil)
                          (begin (act-failed c what) nil)))))))))))
      ;; The focus back in a new post's text: the other copy of the field appears, with autofocus.
      (defun compose-refocus ()
        (state-set "compose.focus" (if (= (state-get "compose.focus") "b") "a" "b")))
      ;; Every file of a new post, one after another: their ids, or nil when one failed.
      (defun upload-all (files)
        (let ((ids (list)) (i 0) (n (length files)) (f nil) (id nil))
          (begin
            (state-set "compose.uploading" "1")
            (while (and (!= (type-of ids) "nil") (< i n))
              (begin
                (set f (nth files i))
                (say (str-concat "Uploading " (get-attr f "name")
                                 (if (> n 1) (str-concat " (" (text (+ i 1)) " of " (text n) ")") "")
                                 "..."))
                (state-set "compose.progress" 0)
                (set id (upload-file f))
                (if (= (type-of id) "nil") (set ids nil) (set ids (append ids id)))
                (set i (+ i 1))))
            (state-set "compose.uploading" "")
            ids)))

      (try
        (begin
          (if (= cmd "resume")
            ;; and/or are functions here, not special forms: they evaluate every argument.
            (if (begin (load-site-title) (if (net-auth-has? "txwtf" (base)) (load-home) nil))
              (say (signed-in-msg))
              (state-set "ui.screen" (if (= (state-get "ui.screen") "boot") "signin" (state-get "ui.screen")))))
          (if (= cmd "login")
            (let ((u (string.trim (state-get "login.username")))
                  (p (state-get "login.password")))
              (begin
                (state-set "login.password" "")
                (if (or (= u "") (= p ""))
                  (fail "Enter your username and password.")
                  (begin
                    (say "Signing in...")
                    (after-login (post-json "/user/login" (dict "username" u "password" p) true)))))))
          (if (= cmd "verify")
            (let ((code (string.trim (state-get "login.code"))))
              (if (= code "")
                (fail "Enter the code from the email.")
                (begin
                  (say "Checking the code...")
                  (after-login (post-json "/user/login/2fa"
                                          (dict "challenge" (state-get "login.challenge") "code" code)
                                          true))))))
          ;; Back: on the code screen, to the sign-in form; signed in, to the view before, and
          ;; Forward returns to where Back left.
          (if (= cmd "back")
            (if (= (state-get "ui.screen") "2fa")
              (to-signin "" nil)
              (let ((entry (pop-back)) (was (state-get "ui.here")))
                (if (= entry "")
                  (say "This is where you started.")
                  (if (show-entry entry)
                    (begin
                      (if (!= was "")
                        (state-set "ui.fwd" (if (= (state-get "ui.fwd") "") was
                                              (str-concat (state-get "ui.fwd") ";" was))))
                      (state-set "ui.here" entry)
                      (new-view)))))))
          (if (= cmd "forward")
            (let ((l (if (= (state-get "ui.fwd") "") (list) (string.split (state-get "ui.fwd") ";")))
                  (was (state-get "ui.here")))
              (if (= (length l) 0)
                (say "Nothing to go forward to.")
                (let ((entry (nth l (- (length l) 1))))
                  (if (show-entry entry)
                    (begin
                      (state-set "ui.fwd" (string.join (slice l 0 (- (length l) 1)) ";"))
                      (if (!= was "") (push-back was))
                      (state-set "ui.here" entry)
                      (new-view)))))))
          (if (= cmd "home") ;; on the feed already: it again, newest first
            (let ((again (and (= (state-get "ui.screen") "feed") (= (state-get "feed.source") "home"))))
              (if (go-home) (if again (say (str-concat "Updated. " (signed-in-msg)))))))
          (if (= cmd "feed") ;; Following, Everyone or Friends: the feed's first page, here
            (if (show-entry "feed") (state-set "ui.here" "feed")))
          (if (= cmd "tag")
            (let ((tg (string.lower (string.trim (string.replace (text (state-get "tag.want")) "#" "")))))
              (if (= tg "") (say "Pick a hashtag first.") (go (str-concat "tag|" tg)))))
          (if (= cmd "open")
            (begin
              (if (= (state-get "post.focus_reply") "1") (state-set "post.reply_text" ""))
              (go (str-concat "post|" (text (state-get "post.want"))))))
          (if (= cmd "profile") (go (str-concat "profile|" (text (state-get "me.id")))))
          (if (= cmd "user")
            (if (= (text (state-get "user.want")) "") (say "No one to show.")
              (go (str-concat "profile|" (text (state-get "user.want"))))))
          (if (= cmd "tags") (go "tags"))
          ;; the main window again, after its X closed it (a menu's "Show the window")
          (if (= cmd "show-window")
            (begin (state-set "tree.app.open" 1) (state-set "tree.app.raise" "1")))
          (if (= cmd "copied") (say "Link copied."))
          ;; a link in a post's text: link.href (open-link)
          (if (= cmd "link") (open-link (state-get "link.href")))
          (if (= cmd "alerts") (go "alerts"))
          (if (= cmd "search-view") (go "search"))
          (if (= cmd "compose") (go "compose"))
          (if (= cmd "view")
            (go (str-concat "viewer|" (text (state-get "view.post")) "|" (text (state-get "view.i")))))
          (if (= cmd "view-prev") (viewer-at (- (int (state-get "viewer.i")) 1)))
          (if (= cmd "view-next") (viewer-at (+ (int (state-get "viewer.i")) 1)))
          (if (= cmd "refresh") ;; the view it was pressed in, again
            (begin
              (say "Refreshing...")
              (if (if (= (state-get "ui.screen") "profile") (load-me) true)
                (if (show-entry (if (= (state-get "ui.here") "") "feed" (state-get "ui.here")))
                  (say (str-concat "Updated. " (signed-in-msg)))))))
          (if (= cmd "more")
            (if (= (state-get "feed.more") "1")
              (begin
                (say "Loading more...")
                (state-set "feed.tail" "  Loading more...")
                (if (load-feed nil) (say "")))
              (say (if (= (state-get "feed.source") "tag") "That's every post with this hashtag."
                     "That's the whole feed."))))
          (if (= cmd "more-replies") (begin (say "Loading more replies...") (if (load-replies nil) (say ""))))
          (if (= cmd "more-tags") (begin (say "Loading more hashtags...") (if (load-tags nil) (say ""))))
          (if (or (= cmd "tab") (= cmd "older") (= cmd "newer"))
            (let ((step (if (= (state-get "ui.tab") "Posts") PAGE 20))
                  (off (int (state-get "tab.offset"))))
              (begin
                (state-set "tab.offset" (if (= cmd "tab") 0
                                          (if (= cmd "older") (+ off step) (math.max 0 (- off step)))))
                (if (!= (state-get "ui.tab") "Balances")
                  (begin
                    (say (str-concat "Loading " (string.lower (state-get "ui.tab")) "..."))
                    (if (load-tab) (say "")))))))
          ;; The Settings tab's level: PUT /social/settings/read-level, then the note again.
          (if (= cmd "read-level")
            (let ((v (int (state-get "set.level"))))
              (let ((r (send-authed "PUT" "/social/settings/read-level" (dict "read_level" v))))
                (if (ok? r)
                  (let ((got (int (opt (reply-json r) "read_level" v))))
                    (begin
                      (state-set "set.note" (read-level-note got))
                      (say (str-concat "Content filter: " (level-name got) "."))))
                  (act-failed r "change your content filter")))))
          ;; On a card: act.list and act.i name it (the feed's, a hashtag's or a profile's).
          (if (= cmd "like")
            (let ((key (str-concat (card-list) "." (text (state-get "act.i")))))
              (if (toggle-like (state-get (str-concat key ".pid")) (text (state-get (str-concat key ".liked"))))
                (refresh-card (card-list) (state-get "act.i")))))
          (if (= cmd "dislike")
            (let ((key (str-concat (card-list) "." (text (state-get "act.i")))))
              (if (toggle-dislike (state-get (str-concat key ".pid"))
                                  (text (state-get (str-concat key ".disliked"))))
                (refresh-card (card-list) (state-get "act.i")))))
          (if (= cmd "repost")
            (let ((key (str-concat (card-list) "." (text (state-get "act.i")))))
              (if (toggle-repost (state-get (str-concat key ".pid"))
                                 (text (state-get (str-concat key ".reposted")))
                                 (text (state-get (str-concat key ".my_repost"))))
                (refresh-card (card-list) (state-get "act.i")))))
          ;; On the post shown.
          (if (= cmd "post-like")
            (if (toggle-like (state-get "post.pid") (text (state-get "post.liked")))
              (load-post (state-get "post.id"))))
          (if (= cmd "post-dislike")
            (if (toggle-dislike (state-get "post.pid") (text (state-get "post.disliked")))
              (load-post (state-get "post.id"))))
          (if (= cmd "post-repost")
            (if (toggle-repost (state-get "post.pid") (text (state-get "post.reposted"))
                               (text (state-get "post.my_repost")))
              (load-post (state-get "post.id"))))
          ;; Delete: your own post at once. Someone else's, for an administrator, once asked:
          ;; txwtf records it as deleted by an administrator.
          (if (= cmd "delete")
            (if (= (state-get "post.mine") "1")
              (delete-shown "Deleted.")
              (if (admin?)
                (begin
                  (state-set "post.confirm" "1")
                  ;; (60 columns: txwtf records it as deleted by an administrator)
                  (say (str-concat "Delete " (state-get "post.author_handle")
                                   "'s post as an administrator?")))
                (say "Only its author can delete this post."))))
          (if (= cmd "delete-yes")
            (begin
              (state-set "post.confirm" "")
              (delete-shown (str-concat "Deleted " (state-get "post.author_handle") "'s post."))))
          (if (= cmd "delete-keep")
            (begin (state-set "post.confirm" "") (say "Kept.")))
          (if (= cmd "reply")
            (let ((txt (string.trim (text (state-get "post.reply_send")))))
              (if (= txt "") (say "Write something first.")
                (let ((id (publish txt (text (state-get "post.pid")) "public" (list))))
                  (if id
                    (begin
                      (state-set "post.reply_text" "")
                      (state-set "post.focus_reply" "")
                      (load-post (state-get "post.id"))
                      (new-view) ;; the post again, its reply below: the focus back on Back
                      (say "Replied.")))))))
          (if (= cmd "post")
            (let ((txt (string.trim (text (state-get "compose.send"))))
                  (files (compose-files)))
              (if (and (= txt "") (= (length files) 0)) (say "Write something first.")
                (let ((ids (upload-all files)))
                  (if (!= (type-of ids) "nil")
                    (let ((id (publish txt "" (string.lower (state-get "compose.visibility")) ids)))
                      (if id
                        (begin
                          (state-set "compose.text" "")
                          (state-set-tree "compose.files" (list))
                          ;; the new post takes the composer's place: Back goes where it was opened
                          (state-set "ui.here" "")
                          (if (go (str-concat "post|" id)) (say "Posted."))))))))))
          ;; The host's file picker (the system's dialog, a browser's, or in a terminal an Open
          ;; file window): the files picked join the post's. The program waits while it is open.
          (if (= cmd "attach")
            (let ((picked (file-pick (dict "multiple" true "title" "Attach to the post")))
                  (files (compose-files)))
              (if (= (length picked) 0) (say "")
                (begin
                  (for f picked
                    (set files (append files
                                 (dict "handle" (get-attr f "handle") "name" (get-attr f "name")
                                       "size" (get-attr f "size") "type" (get-attr f "type")
                                       "label" (str-concat (get-attr f "name") " · "
                                                           (human-size (get-attr f "size")))))))
                  (state-set-tree "compose.files" files)
                  (compose-refocus)
                  (say (str-concat (text (length files))
                                   (if (= (length files) 1) " file" " files") " to attach."))))))
          (if (= cmd "detach")
            (let ((drop (int (state-get "compose.drop"))) (files (compose-files)) (kept (list)))
              (begin
                (for i (range (length files))
                  (if (= i drop) (file-forget (get-attr (nth files i) "handle"))
                    (set kept (append kept (nth files i)))))
                (state-set-tree "compose.files" kept)
                (compose-refocus)
                (say ""))))
          (if (or (= cmd "follow") (= cmd "unfollow"))
            (let ((id (text (state-get "prof.id"))))
              (let ((r (if (= cmd "follow")
                         (send-authed "POST" "/social/follow" (dict "user_id" (int id)))
                         (send-authed "DELETE" (str-concat "/social/follow/" id) nil))))
                (if (ok? r)
                  (begin
                    (state-set "prof.following" (if (= cmd "follow") "1" ""))
                    (say (str-concat (if (= cmd "follow") "Following " "Stopped following ")
                                     (state-get "prof.handle") ".")))
                  (act-failed r cmd)))))
          (if (= cmd "search")
            (begin
              (say "Searching...")
              (if (run-search) (say ""))))
          (if (= cmd "hit-open")
            (go (if (= (state-get "hit.kind") "hashtag")
                  (str-concat "tag|" (string.lower (text (state-get "hit.tag"))))
                  (str-concat (if (= (state-get "hit.kind") "user") "profile|" "post|")
                              (text (state-get "hit.id"))))))
          (if (= cmd "alert-open")
            (go (str-concat (if (= (state-get "alert.kind") "user") "profile|" "post|")
                            (text (state-get "alert.target")))))
          (if (= cmd "dms") (go "dms"))
          (if (= cmd "dm-open") (go (str-concat "dm|" (text (state-get "dm.want")))))
          (if (= cmd "dm-with")
            (let ((r (send-authed "POST" (str-concat "/social/dm/conversations?other_user_id="
                                                     (text (state-get "prof.id"))) nil)))
              (if (ok? r) (go (str-concat "dm|" (text (opt (reply-json r) "id" ""))))
                (act-failed r "start the conversation"))))
          (if (= cmd "dm-send")
            (let ((txt (string.trim (text (state-get "dm.send")))))
              (if (= txt "") (say "Write something first.")
                (if (dm-send txt)
                  (begin
                    (state-set "dm.draft" "")
                    (load-dm (state-get "dm.conv.id"))
                    (new-view)
                    (say "Sent."))))))
          (if (= cmd "dm-encrypt")
            (if (not (e2ee-here)) (fail (clip (e2ee-why) 60))
              (let ((keys (e2ee-keys)))
                (if (= keys "elsewhere") (fail "Your keys are on another device: restore them first.")
                  (if (= keys "ok")
                    (let ((r (send-authed "POST" (str-concat "/e2ee/dm/conversations/"
                                                             (state-get "dm.conv.id") "/encrypt") nil)))
                      (if (ok? r)
                        (begin (load-dm (state-get "dm.conv.id")) (say "This conversation is end-to-end encrypted now."))
                        (act-failed r "encrypt it"))))))))
          (if (= cmd "dm-backup") (if (e2ee-here) (dm-backup) (fail (clip (e2ee-why) 60))))
          (if (= cmd "dm-restore") (if (e2ee-here) (dm-restore) (fail (clip (e2ee-why) 60))))
          (if (= cmd "dm-new-keys") (if (e2ee-here) (dm-new-keys) (fail (clip (e2ee-why) 60))))
          (if (= cmd "signout")
            (begin
              (http-request "POST" (str-concat (base) "/user/logout") (dict "auth" "txwtf"))
              (net-auth-forget "txwtf")
              (to-signin "Signed out." nil)))

          ;; --- the Admin view (ui/admin.ari), for an administrator ---------------------------
          (if (= cmd "admin") ;; the part last shown, from its first page
            (if (admin?)
              (begin
                (state-set "admin.uoff" 0) (state-set "admin.ioff" 0) (state-set "admin.loff" 0)
                (go (str-concat "admin|" (admin-key (state-get "admin.tab")))))
              (not-admin)))
          (if (= cmd "admin-tab") ;; another part, in place (as a profile's tab)
            (let ((e (str-concat "admin|" (admin-key (state-get "admin.tab")))))
              (begin
                (state-set "admin.uoff" 0) (state-set "admin.ioff" 0) (state-set "admin.loff" 0)
                (if (show-entry e) (state-set "ui.here" e)))))
          (if (= cmd "admin-find")
            (begin (state-set "admin.uoff" 0) (if (load-admin-users) (say ""))))
          (if (= cmd "admin-log-filter")
            (begin (state-set "admin.loff" 0) (if (load-admin-log) (say ""))))
          (if (or (= cmd "admin-prev") (= cmd "admin-next"))
            (let ((tab (if (= (state-get "ui.screen") "agperm") "agperm" (state-get "admin.tab"))))
              (let ((k (if (= tab "Users") "admin.uoff" (if (= tab "Invites") "admin.ioff"
                         (if (= tab "agperm") "agperm.off" "admin.loff"))))
                    (per (if (= tab "Users") USERPAGE LISTPAGE)))
                (begin
                  (state-set k (if (= cmd "admin-next") (+ (int (state-get k)) per)
                                 (math.max 0 (- (int (state-get k)) per))))
                  (if (if (= tab "agperm") (load-agperm (state-get "agperm.id"))
                        (load-admin-part (admin-key tab)))
                    (say ""))))))
          ;; A group's permissions: from its view, from their first page; found; granted by name;
          ;; revoked.
          (if (= cmd "agperm")
            (begin
              (state-set "agperm.q" "") (state-set "agperm.grant" "") (state-set "agperm.off" 0)
              (go (str-concat "agperm|" (text (state-get "agroup.id"))))))
          (if (= cmd "agperm-find")
            (begin (state-set "agperm.off" 0) (if (load-agperm (state-get "agperm.id")) (say ""))))
          (if (= cmd "agperm-grant")
            (let ((want (string.trim (text (state-get "agperm.grant"))))
                  (gid (int (state-get "agperm.id"))))
              (if (= want "") (say "Type a permission's name first.")
                (let ((c (get-authed "/perms/codes")))
                  (if (ok? c)
                    (let ((hits (collections.filter (collections.dict-keys (reply-json c))
                                  (lambda (k) (= (string.lower k) (string.lower want))))))
                      (if (= (length hits) 0) (fail (str-concat "No permission is called " want "."))
                        (if (admin-send "POST" "/perms/"
                                        (dict "group_id" gid
                                              "permission_codes" (list (get-attr (reply-json c) (nth hits 0))))
                                        "grant permissions")
                          (begin
                            (state-set "agperm.grant" "")
                            (if (load-agperm gid)
                              (say (str-concat (state-get "agperm.name") " grants " (nth hits 0) " now.")))))))
                    (admin-load-failed c "the permissions"))))))
          (if (= cmd "agperm-revoke")
            (let ((gid (int (state-get "agperm.id"))) (what (text (state-get "agperm.pick_name"))))
              (if (admin-send "DELETE" (str-concat "/perms/?group_id=" (text gid))
                              (list (int (state-get "agperm.pick")))
                              "revoke permissions")
                (if (load-agperm gid)
                  (say (str-concat (state-get "agperm.name") " no longer grants " what "."))))))
          (if (= cmd "auser") (go (str-concat "auser|" (text (state-get "auser.want")))))
          (if (= cmd "agroup") (go (str-concat "agroup|" (text (state-get "agroup.want")))))
          ;; One account: the change, then the account as the instance has it now.
          (if (or (= cmd "auser-disable") (= cmd "auser-enable") (= cmd "auser-admin")
                  (= cmd "auser-unadmin") (= cmd "auser-2fa-off"))
            (let ((id (int (state-get "auser.id")))
                  (who (str-concat "@" (state-get "auser.username"))))
              (if (if (or (= cmd "auser-admin") (= cmd "auser-unadmin"))
                    (admin-send "PUT" "/group/user/sysadmin"
                                (dict "user_id" id "is_admin" (if (= cmd "auser-admin") true NO))
                                "change who is an administrator")
                    (admin-send "PUT" "/user/update"
                                (if (= cmd "auser-2fa-off")
                                  (dict "user_id" id "login_2fa_email_enabled" NO)
                                  (dict "user_id" id "enabled" (if (= cmd "auser-enable") true NO)))
                                "change that account"))
                (if (load-auser id)
                  (say (str-concat who
                         (if (= cmd "auser-disable") " is disabled: signed out, and can't sign in."
                           (if (= cmd "auser-enable") " can sign in again."
                             (if (= cmd "auser-admin") " is an administrator now."
                               (if (= cmd "auser-unadmin") " is no longer an administrator."
                                 " signs in without two-step sign-in now."))))))))))
          ;; Groups: a new one; one group's members added, removed, made its admins or not; and
          ;; the group deleted, once Delete group has asked.
          (if (= cmd "group-create")
            (let ((name (string.trim (text (state-get "admin.gname"))))
                  (about (string.trim (text (state-get "admin.gdesc")))))
              (if (= name "") (say "Name the group first.")
                (if (admin-send "POST" "/group/"
                                (if (= about "") (dict "group_name" name)
                                  (dict "group_name" name "description" about))
                                "create groups")
                  (begin
                    (state-set "admin.gname" "")
                    (state-set "admin.gdesc" "")
                    (if (load-admin-groups) (say (str-concat "Created the group " name "."))))))))
          (if (= cmd "agroup-add")
            (let ((who (string.trim (text (state-get "agroup.add")))))
              (begin
                (if (string.starts-with who "@") (set who (string.substring who 1 (- (string.length who) 1))))
                (if (= who "") (say "Type a username first.")
                  ;; the account by its exact username: GET /user/list finds the usernames with
                  ;; the text in them
                  (let ((u (get-query "/user/list" (dict "username" who "limit" "50" "offset" "0"))))
                    (if (ok? u)
                      (let ((hits (collections.filter (opt (reply-json u) "users" (list))
                                    (lambda (x) (= (string.lower (text (opt x "username" "")))
                                                   (string.lower who))))))
                        (if (= (length hits) 0) (fail (str-concat "No account is called " who "."))
                          (if (admin-send "POST" "/group/user"
                                          (dict "group_id" (int (state-get "agroup.id"))
                                                "user_id" (int (opt (nth hits 0) "id" 0))
                                                "is_group_admin" NO)
                                          "add members")
                            (begin
                              (state-set "agroup.add" "")
                              (if (load-agroup (state-get "agroup.id"))
                                (say (str-concat "Added @" who " to " (state-get "agroup.name") ".")))))))
                      (admin-load-failed u "the accounts")))))))
          (if (or (= cmd "agroup-remove") (= cmd "agroup-lead") (= cmd "agroup-unlead"))
            (let ((gid (int (state-get "agroup.id")))
                  (uid (int (state-get "agroup.pick")))
                  (who (member-handle (state-get "agroup.pick"))))
              (if (if (= cmd "agroup-remove")
                    (admin-send "DELETE" "/group/user" (dict "group_id" gid "user_id" uid)
                                "remove members")
                    (admin-send "PUT" "/group/user/admin"
                                (dict "group_id" gid "user_id" uid
                                      "is_group_admin" (if (= cmd "agroup-lead") true NO))
                                "change a group's admins"))
                (if (load-agroup gid)
                  (say (str-concat who
                         (if (= cmd "agroup-remove") (str-concat " is out of " (state-get "agroup.name") ".")
                           (if (= cmd "agroup-lead") (str-concat " is an admin of " (state-get "agroup.name") ".")
                             (str-concat " is no longer an admin of " (state-get "agroup.name") ".")))))))))
          (if (= cmd "agroup-delete")
            (begin
              (state-set "agroup.confirm" "1")
              (say (str-concat "Delete " (state-get "agroup.name") "? Its members' accounts stay."))))
          (if (= cmd "agroup-keep")
            (begin (state-set "agroup.confirm" "") (say "Kept it.")))
          (if (= cmd "agroup-delete-yes")
            (let ((name (state-get "agroup.name")))
              (let ((r (http-request "DELETE" (str-concat (base) "/group/")
                         (dict "auth" "txwtf" "headers" (dict "Accept" "application/json")
                               "query" (dict "group_name" name)))))
                (if (ok? r)
                  (let ((entry (pop-back)))
                    (begin
                      (state-set "agroup.confirm" "")
                      (if (= entry "") (set entry "admin|groups"))
                      (if (show-entry entry) (begin (state-set "ui.here" entry) (new-view)))
                      (say (str-concat "Deleted the group " name "."))))
                  (admin-failed r "delete groups")))))
          ;; Invites: who may sign up, and your codes.
          (if (= cmd "invite-mode")
            (let ((only (= (state-get "admin.signup") "Invite only")))
              (if (admin-send "PUT" "/invite/mode" (dict "invite_only" (if only true NO))
                              "change who may sign up")
                (if (load-admin-invites)
                  (say (if only "Signing up takes an invite code now." "Anyone may sign up now.")))
                (load-admin-invites)))) ;; refused: the choice back to what the instance says
          (if (= cmd "invite-new")
            (let ((uses (string.trim (text (state-get "admin.iuses"))))
                  (note (string.trim (text (state-get "admin.inote")))))
              (let ((n (if (= uses "") 0 (try (int uses) (catch (e) 0)))))
                (if (and (!= uses "") (< n 1))
                  (fail "Uses is a number, 1 or more; blank for no limit.")
                  (let ((r (send-authed "POST" "/invite/codes"
                             (collections.dict-merge (if (= uses "") (dict) (dict "max_uses" n))
                                                     (if (= note "") (dict) (dict "note" note))))))
                    (if (ok? r)
                      (begin
                        (state-set "admin.iuses" "")
                        (state-set "admin.inote" "")
                        (state-set "admin.ioff" 0)
                        (if (load-admin-invites)
                          (say (str-concat "New code: " (text (opt (reply-json r) "code" ""))))))
                      (admin-failed r "make invite codes")))))))
          (if (or (= cmd "invite-off") (= cmd "invite-on"))
            (let ((id (text (state-get "invite.want"))))
              (if (admin-send (if (= cmd "invite-off") "DELETE" "POST")
                              (str-concat "/invite/codes/" id (if (= cmd "invite-off") "" "/reactivate"))
                              nil
                              (if (= cmd "invite-off") "turn invite codes off" "turn invite codes on"))
                (if (load-admin-invites)
                  (say (if (= cmd "invite-off") "That code is off: it signs no one up now."
                         "That code is on again."))))))
          ;; Site: what has changed of the title, description and time zone, saved.
          (if (= cmd "site-save")
            (begin
              (set saved (list))
              (set saving true)
              (for f (list (list "title" "title") (list "about" "description") (list "tz" "timezone"))
                (if saving
                  (let ((now (string.trim (text (state-get (str-concat "site." (car f))))))
                        (was (text (state-get (str-concat "site.was_" (car f))))))
                    (if (!= now was)
                      (if (admin-send "PUT" (str-concat "/site/" (nth f 1)) (dict (nth f 1) now)
                                      "change the site's settings")
                        (set saved (append saved (nth f 1)))
                        (set saving nil))))))
              (if saving
                (if (= (length saved) 0) (say "Nothing to save: nothing has changed.")
                  (begin
                    (load-site-title) ;; the window's title, if that was it
                    (if (load-admin-site)
                      (say (str-concat "Saved the " (string.join saved ", ") "."))))))))
          ;; Signed in still: the unread count again.
          (if (and (!= (state-get "ui.screen") "signin") (!= (state-get "ui.screen") "2fa")
                   (!= (state-get "ui.screen") "boot") (!= cmd "alerts"))
            (load-badge)))
        ;; Nothing in here may raise: an exception this resident doesn't catch ends it, and the
        ;; buttons with it.
        (catch (e)
          (if (= (state-get "ui.screen") "boot") (state-set "ui.screen" "signin"))
          (fail (str-concat "Something went wrong: "
                            (try (text (get-attr e "message")) (catch (e2) "no details"))))))
      (state-set "ui.busy" "")))

windows:
  - include: starting_window
  - include: signin_window
  - include: twofactor_window
  - include: app_window
  - include: details_window
